@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using CyberPolygon.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Авторизация | КиберПолигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-input: #131924;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --warning-color: #e5c07b;
        --danger-color: #e06c75;
    }

    /* Обертка на весь экран */
    .cyber-login-wrapper {
        background-color: var(--bg-main);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Основной контейнер авторизации */
    .cyber-login-container {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
        overflow: hidden;
        width: 100%;
        max-width: 1000px;
        min-height: 550px;
    }

    /* Левая панель с логотипом */
    .cyber-left-panel {
        background: linear-gradient(135deg, #1a2332 0%, #131924 100%);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        position: relative;
        text-align: center;
    }

    .cyber-title {
        color: var(--text-light);
        font-weight: bold;
        letter-spacing: 1px;
    }

    /* Правая панель с формой */
    .cyber-right-panel {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 40px 10%;
        background-color: var(--bg-card);
    }

    .form-header {
        color: var(--accent-light-blue);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: bold;
        text-transform: uppercase;
    }

    /* Стилизация полей ввода */
    .form-floating > .form-control.cyber-input {
        background-color: var(--bg-input);
        border: 1px solid var(--border-color);
        color: var(--text-light);
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .form-floating > .form-control.cyber-input:focus {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.2);
        }

    .form-floating > label {
        color: var(--text-muted);
    }

    .form-floating > .form-control.cyber-input:focus ~ label,
    .form-floating > .form-control.cyber-input:not(:placeholder-shown) ~ label {
        color: var(--accent-cyan);
        opacity: 0.9;
    }

    /* Автозаполнение браузера */
    .form-floating > .form-control.cyber-input:-webkit-autofill {
        -webkit-box-shadow: 0 0 0 1000px var(--bg-input) inset !important;
        -webkit-text-fill-color: var(--text-light) !important;
        transition: background-color 5000s ease-in-out 0s;
    }

    /* Чекбокс */
    .cyber-checkbox {
        background-color: var(--bg-input);
        border: 1px solid var(--border-color);
        cursor: pointer;
        width: 18px;
        height: 18px;
        border-radius: 4px;
    }

        .cyber-checkbox:checked {
            background-color: var(--accent-cyan);
            border-color: var(--accent-cyan);
        }

    .checkbox-label {
        color: var(--text-muted);
        cursor: pointer;
        user-select: none;
        font-size: 0.95rem;
    }

    /* Кнопка входа */
    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 14px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 1px;
        width: 100%;
        margin-top: 10px;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(78, 195, 209, 0.4);
        }

    .cyber-hr {
        border-top: 1px solid var(--border-color);
        margin: 20px 0;
    }

    /* Блок вывода ошибки */
    .error-alert {
        background-color: rgba(224, 108, 117, 0.1);
        border: 1px solid var(--danger-color);
        color: var(--danger-color);
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        font-weight: 500;
    }
</style>

<div class="cyber-login-wrapper">
    <RadzenRow Gap="0" class="cyber-login-container">

        @* Левая часть (Брендирование) *@
        <RadzenColumn Size="12" SizeMD="6" class="cyber-left-panel">
            <div class="mb-4">
                <img src="images/logo.png" alt="Logo" style="max-width: 280px; height: auto;" />
            </div>

            <h2 class="cyber-title mb-2" style="font-size: 2.2rem; text-transform: uppercase;">Добро пожаловать</h2>
            <h3 class="cyber-title mb-4" style="font-size: 1.5rem; color: var(--accent-light-blue);">В КиберПолигон</h3>

            <p style="color: var(--text-muted); font-size: 0.95rem;">
                СИСТЕМА АВТОРИЗАЦИИ // ИАО<br />
                Введите свои учетные данные для доступа к инфраструктуре.
            </p>
        </RadzenColumn>

        @* Правая часть (Форма авторизации) *@
        <RadzenColumn Size="12" SizeMD="6" class="cyber-right-panel">
            <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />

                <h3 class="form-header">
                    <RadzenIcon Icon="lock" Style="font-size: 1.8rem;" /> ТЕРМИНАЛ ДОСТУПА
                </h3>

                <hr class="cyber-hr" />

                @* ВЫВОД ОШИБКИ АВТОРИЗАЦИИ *@
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-alert">
                        <RadzenIcon Icon="error_outline" Style="font-size: 1.2rem;" />
                        <span>@errorMessage</span>
                    </div>
                }

                <ValidationSummary class="mb-3" style="color: var(--danger-color); font-size: 0.85rem;" role="alert" />

                <div class="form-floating mb-4">
                    <InputText @bind-Value="Input.UserName" id="Input.UserName" class="form-control cyber-input" autocomplete="username webauthn" aria-required="true" placeholder="name@example.com" />
                    <label for="Input.UserName">Логин (Идентификатор)</label>
                    <ValidationMessage For="() => Input.UserName" style="color: var(--danger-color); font-size: 0.8rem; margin-top: 5px;" />
                </div>

                <div class="form-floating mb-4">
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control cyber-input" autocomplete="current-password" aria-required="true" placeholder="пароль" />
                    <label for="Input.Password">Ключ доступа (Пароль)</label>
                    <ValidationMessage For="() => Input.Password" style="color: var(--danger-color); font-size: 0.8rem; margin-top: 5px;" />
                </div>

                <div class="checkbox mb-4 d-flex align-items-center gap-2">
                    <InputCheckbox @bind-Value="Input.RememberMe" id="Input.RememberMe" class="form-check-input cyber-checkbox m-0" />
                    <label class="checkbox-label m-0" for="Input.RememberMe">
                        Сохранить сессию
                    </label>
                </div>

                <div class="mt-2">
                    <button type="submit" class="btn-primary-gradient">Инициализировать соединение</button>
                </div>

            </EditForm>
        </RadzenColumn>

    </RadzenRow>
</div>

@code {
    private string? errorMessage;
    private EditContext editContext = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        editContext = new EditContext(Input);

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        // Очищаем предыдущую ошибку при новой попытке
        errorMessage = null;

        if (!string.IsNullOrEmpty(Input.Passkey?.Error))
        {
            errorMessage = $"Ошибка: {Input.Passkey.Error}";
            return;
        }

        SignInResult result;
        if (!string.IsNullOrEmpty(Input.Passkey?.CredentialJson))
        {
            result = await SignInManager.PasskeySignInAsync(Input.Passkey.CredentialJson);
        }
        else
        {
            if (!editContext.Validate())
            {
                return;
            }

            // Добавляем домен @polygon.do автоматически
            var fullEmail = Input.UserName.Contains("@")
                ? Input.UserName
                : $"{Input.UserName}@polygon.do";

            result = await SignInManager.PasswordSignInAsync(
                fullEmail,
                Input.Password,
                Input.RememberMe,
                lockoutOnFailure: false);
        }

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            // Здесь устанавливаем текст ошибки для пользователя
            errorMessage = "Неверный логин или пароль. Доступ запрещен.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Поле Логин обязательно для заполнения.")]
        [Display(Name = "Логин")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Поле Пароль обязательно для заполнения.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Remember me?")]
        public bool RememberMe { get; set; }

        public PasskeyInputModel? Passkey { get; set; }
    }
}