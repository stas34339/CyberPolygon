@using System.ComponentModel;
@using Radzen
@using Radzen.Blazor
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">КиберПолигон</a>
    </div>
</div>

<RadzenStack AlignItems="AlignItems.Center" class="rz-p-12, main" >
    <RadzenPanelMenu Click="OnParentClicked"  Multiple="false" class="list">
        <RadzenPanelMenuItem Text="Главная" Icon="home" class="list-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All"></NavLink>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Сценарии" Icon="payment" class="list-item" Style="background-color:#424040;">
            <RadzenPanelMenuItem Text="CheckBox" Path="checkbox" Icon="check_circle" class="item" Style="background-color:#424040;"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="TextBox" Path="textbox" Icon="input" class="item"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="TextArea" Path="textarea" Icon="description" class="item"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Password" Path="password" Icon="payment" class="item"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Numeric" Path="numeric" Icon="aspect_ratio" class="item"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="DatePicker" Path="datepicker" Icon="date_range" class="item"></RadzenPanelMenuItem>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Инструкция" Icon="save">
            <RadzenPanelMenuItem Text="DataGrid" Path="datagrid" Icon="grid_on"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="DataList" Path="datalist" Icon="list"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="DropDown" Path="dropdown" Icon="dns"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="DropDownDataGrid" Path="dropdown-datagrid" Icon="receipt"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="ListBox" Path="listbox" Icon="view_list"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="TemplateForm" Path="templateform" Icon="line_style"></RadzenPanelMenuItem>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Пользователь" Icon="account_box">
            <RadzenPanelMenuItem Text="Tabs" Path="tabs" Icon="tab"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Panel" Path="panel" Icon="content_paste"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Fieldset" Path="fieldset" Icon="account_balance_wallet"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Card" Path="card" Icon="line_style"></RadzenPanelMenuItem>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Выход">
            
        </RadzenPanelMenuItem>
    </RadzenPanelMenu>

</RadzenStack>
<EventConsole @ref=@console />
@code {
    bool multiple = true;
    EventConsole console;

    void OnParentClicked(MenuItemEventArgs args)
    {
        
    }

    void OnChildClicked(MenuItemEventArgs args)
    {
        
    }
}
