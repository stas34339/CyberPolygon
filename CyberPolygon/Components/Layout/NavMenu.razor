@using CyberPolygon.Data
@using Microsoft.AspNetCore.Identity
@using Radzen
@using Radzen.Blazor
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<style>
    /* === Скрытая форма логаута === */
    #logoutForm {
        display: none;
    }

    /* === Верхняя панель === */
    .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: var(--bg-card);
        border-bottom: 1px solid var(--border-color);
        padding: 0 1.5rem;
        min-height: 64px;
        flex-wrap: wrap;
        z-index: 100;
    }

    /* === Логотип === */
    .cyber-logo-container {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        background: transparent;
        position: relative;
    }

    .shield-icon {
        font-size: 28px;
        filter: drop-shadow(0 0 10px rgba(78, 195, 209, 0.7));
        animation: shieldPulse 3s ease-in-out infinite;
    }

    .logo-title {
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 18px;
        margin: 0;
        line-height: 1;
        letter-spacing: 1px;
    }

    .text-cyan {
        color: var(--accent-cyan);
        font-weight: 800;
    }

    .text-gray {
        color: var(--text-light);
        font-weight: 300;
        margin-left: 2px;
    }

    .accent-line {
        height: 1px;
        background: linear-gradient(90deg, var(--accent-cyan) 0%, rgba(78, 195, 209, 0) 100%);
        margin: 4px 0;
    }

    .logo-subtitle {
        color: var(--text-muted);
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin: 0;
        white-space: nowrap;
    }

    @@keyframes shieldPulse {
        0%, 100% {
            transform: scale(1);
            filter: drop-shadow(0 0 10px rgba(78, 195, 209, 0.7));
        }

        50% {
            transform: scale(1.05);
            filter: drop-shadow(0 0 14px rgba(78, 195, 209, 1));
        }
    }

    /* === Кастомизация RadzenMenu === */
    .rz-menu {
        background-color: transparent !important;
        border: none !important;
        box-shadow: none !important;
    }

        .rz-menu .rz-navigation-item {
            color: var(--text-light) !important;
            font-weight: 500;
            transition: all 0.2s;
        }

            .rz-menu .rz-navigation-item:hover {
                background-color: var(--bg-card-hover) !important;
                color: var(--accent-cyan) !important;
                border-radius: 4px;
            }

        /* Активный пункт (совпадающий путь) */
        .rz-menu .rz-navigation-item-active {
            background-color: rgba(91, 163, 227, 0.15) !important;
            border-bottom: 2px solid var(--accent-blue) !important;
        }

        /* Выпадающие подпункты */
        .rz-menu .rz-sub-menu .rz-navigation-item {
            background-color: var(--bg-card) !important;
            color: var(--text-muted) !important;
        }

            .rz-menu .rz-sub-menu .rz-navigation-item:hover {
                background-color: var(--bg-card-hover) !important;
                color: var(--accent-cyan) !important;
            }

        /* Иконки */
        .rz-menu .rz-navigation-item-icon {
            color: var(--accent-cyan) !important;
        }

        /* Мобильная кнопка (гамбургер) */
        .rz-menu .rz-navigation-menu-toggle {
            color: var(--text-light) !important;
        }
</style>

<form id="logoutForm" action="Account/Logout" method="post">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
</form>

<div class="nav-bar">
    <!-- Логотип -->
    <div class="cyber-logo-container">
        <span class="shield-icon">🛡️</span>
        <div>
            <h1 class="logo-title">
                <span class="text-cyan">КИБЕР</span><span class="text-gray">ПОЛИГОН</span>
            </h1>
            <div class="accent-line"></div>
            <p class="logo-subtitle">Информационная безопасность</p>
        </div>
    </div>

    <!-- Горизонтальное меню -->
    <RadzenMenu Responsive="true" Style="background: transparent; border: none;">
        <RadzenMenuItem Text="Главная" Path="" Icon="home" />
        <RadzenMenuItem Text="Сценарии" Path="scenario" Icon="list" />
        <RadzenMenuItem Text="Инструкция" Path="instruction" Icon="menu_book">
        </RadzenMenuItem>
        <RadzenMenuItem Text="@UserDisplayName" Path="profile" Icon="account_box" />
        <RadzenMenuItem Text="Выход" Icon="door_open" Click="HandleLogoutClick" />
    </RadzenMenu>
</div>

@code {
    private string UserDisplayName => user?.UserName ?? "Гость";
    private ApplicationUser? user;
    private string? currentUrl;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId != null)
        {
            user = await UserManager.FindByIdAsync(userId);
        }
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private async Task HandleLogoutClick(MenuItemEventArgs args)
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('logoutForm').submit()");
    }

    // Эти методы оставлены для совместимости (могут пригодиться)
    void OnParentClicked(MenuItemEventArgs args) { }
    void OnChildClicked(MenuItemEventArgs args) { }
}