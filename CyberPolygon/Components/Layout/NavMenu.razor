@using CyberPolygon.Data
@using Microsoft.AspNetCore.Identity
@using Radzen
@using Radzen.Blazor
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<style>
    .cyber-logo-container {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px 20px;
        background: #1a1d21;
        border-radius: 4px;
        width: fit-content;
        position: relative;
        overflow: hidden;
        /* Фон с мерцанием */
        background-image: linear-gradient(-45deg, transparent 40%, rgba(0, 238, 255, 0.1) 50%, transparent 60%);
        background-size: 200% 100%;
        animation: shimmerEffect 4s infinite linear;
    }

    .logo-shield-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 4px;
    }

    .shield-icon {
        font-size: 28px;
        z-index: 2;
        /* Светло-синее свечение */
        filter: drop-shadow(0 0 10px rgba(0, 238, 255, 0.7));
        animation: shieldPulse 3s ease-in-out infinite;
    }

    .logo-title {
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 18px;
        margin: 0;
        line-height: 1;
        letter-spacing: 1px;
    }

    .text-cyan {
        color: #00eeff; /* Светло-синий (cyan) */
        font-weight: 800;
    }

    .text-gray {
        color: #e1e4e8; /* Светло-серый/белый */
        font-weight: 300;
        margin-left: 2px;
    }

    .accent-line {
        height: 1px;
        /* Светло-синяя линия */
        background: linear-gradient(90deg, #00eeff 0%, rgba(0, 238, 255, 0) 100%);
        margin: 4px 0;
    }

    .logo-subtitle {
        color: #8b949e;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin: 0;
        white-space: nowrap;
    }

    /* Анимация мерцания фона */
    @@keyframes shimmerEffect {
        0% {
            background-position: -100% 0;
        }

        100% {
            background-position: 100% 0;
        }
    }

    /* Анимация пульсации щита */
    @@keyframes shieldPulse {
        0%, 100% {
            transform: scale(1);
            filter: drop-shadow(0 0 10px rgba(0, 238, 255, 0.7));
        }

        50% {
            transform: scale(1.05);
            filter: drop-shadow(0 0 14px rgba(0, 238, 255, 1));
        }
    }

</style>

<form id="logoutForm" action="Account/Logout" method="post" style="display: none;">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
    <link rel="stylesheet" href="@Assets["_content/Radzen.Blazor/css/Material-dark.css"]" />
</form>


<div class="cyber-logo-container">
    <div class="logo-shield-wrapper">
        <div class="shield-icon">🛡️</div>
        <div class="shield-glow"></div>
    </div>
    <div class="logo-text-block">
        <h1 class="logo-title">
            <span class="text-green">КИБЕР</span><span class="text-gray">ПОЛИГОН</span>
        </h1>
        <div class="accent-line"></div>
        <p class="logo-subtitle">Информационная безопасность</p>
    </div>
</div>
<RadzenStack AlignItems="AlignItems.Center" class="rz-p-12" Style="width: 300px;
                                                                   margin-top: 100px;
                                                                   margin-left:0px;
                                                                   text-alight: center;
">
    <RadzenPanelMenu Click="OnParentClicked"  Multiple="false" style="font-size:18px;
                                                                      width:300px;">
        <RadzenPanelMenuItem Text="Главная" Path="" Icon="home" style="padding: 10px;">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All"></NavLink>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Сценарии" Path="scenario" Icon="list" Style="margin-top:20px
                                                                   padding: 10px;">
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Инструкция" Icon="menu_book" Style="
                                                                   margin-top:20px
                                                                   padding: 10px;">
            <RadzenPanelMenuItem Text="Инструкция по проекту" Path="instruction" Icon="counter_1"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Инструкция по Vmware" Path="" Icon="counter_2"></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Инстукцию по ..." Path="" Icon="counter_3"></RadzenPanelMenuItem>
        </RadzenPanelMenuItem>

        <RadzenPanelMenuItem Text="@UserDisplayName"
                             Path="profile"
                             Icon="account_box" 
                             Style="word-wrap: break-word; 
                                    word-break: break-word; 
                                    white-space: normal; 
                                    max-width: 300px;
                                    margin-top:20px
                                    padding: 10px;">
        </RadzenPanelMenuItem>

        <RadzenPanelMenuItem Text="Выход" Path="exit" Icon="door_open" Click="HandleLogoutClick">
                
            </RadzenPanelMenuItem>
    </RadzenPanelMenu>

</RadzenStack>
<EventConsole @ref=@console />
@code {
    
     private string UserDisplayName => user?.UserName ?? "Гость";
     private ApplicationUser? user;

     protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (userId != null)
        {
            user = await UserManager.FindByIdAsync(userId);
        }
    }
    private string? currentUrl;

     protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }



    
    EventConsole console;

    void OnParentClicked(MenuItemEventArgs args)
    {
        
    }

    void OnChildClicked(MenuItemEventArgs args)
    {
        
    }

    private async Task HandleLogoutClick(MenuItemEventArgs args)
    {
        // Отправляем скрытую форму
        await JS.InvokeVoidAsync("eval", "document.getElementById('logoutForm').submit()");
    }
}
