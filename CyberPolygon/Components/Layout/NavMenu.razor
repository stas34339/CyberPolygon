@using CyberPolygon.Data
@using CyberPolygon.Services
@using Microsoft.AspNetCore.Identity
@using Radzen
@using Radzen.Blazor
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject UserManagementService UserManagementService
@inject IJSRuntime JS
@rendermode InteractiveServer

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
    }

    #logoutForm {
        display: none;
    }

    .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border-bottom: 2px solid var(--border-color);
        padding: 0 1.5rem;
        min-height: 64px;
        flex-wrap: wrap;
        z-index: 100;
        position: relative;
    }

        .nav-bar::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--accent-cyan) 0%, rgba(78, 195, 209, 0) 80%);
        }

    .cyber-logo-container {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
    }

    .shield-icon {
        font-size: 28px;
        filter: drop-shadow(0 0 10px rgba(78, 195, 209, 0.7));
        animation: shieldPulse 3s ease-in-out infinite;
    }

    .logo-title {
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 18px;
        margin: 0;
        line-height: 1;
        letter-spacing: 1px;
    }

    .text-cyan {
        color: var(--accent-cyan);
        font-weight: 800;
    }

    .text-gray {
        color: var(--text-light);
        font-weight: 300;
        margin-left: 2px;
    }

    .accent-line {
        height: 1px;
        background: linear-gradient(90deg, var(--accent-cyan) 0%, rgba(78, 195, 209, 0) 100%);
        margin: 4px 0;
    }

    .logo-subtitle {
        color: var(--text-muted);
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin: 0;
        white-space: nowrap;
    }

    @@keyframes shieldPulse {
        0%, 100% {
            transform: scale(1);
            filter: drop-shadow(0 0 10px rgba(78, 195, 209, 0.7));
        }

        50% {
            transform: scale(1.05);
            filter: drop-shadow(0 0 14px rgba(78, 195, 209, 1));
        }
    }

    /* === Кастомизация RadzenMenu === */
    .rz-menu {
        background-color: transparent !important;
        border: none !important;
        box-shadow: none !important;
    }

    .rz-navigation {
        background-color: transparent !important;
    }

    .rz-navigation-menu {
        background-color: transparent !important;
    }

    .rz-navigation-item {
        color: var(--text-light) !important;
        font-weight: 500;
        transition: all 0.2s ease;
        border-radius: 6px !important;
        margin: 0 2px;
    }

        .rz-navigation-item:hover {
            background-color: rgba(78, 195, 209, 0.1) !important;
            color: var(--accent-cyan) !important;
        }

    .rz-navigation-item-active {
        background-color: rgba(78, 195, 209, 0.12) !important;
        color: var(--accent-cyan) !important;
        border-bottom: 2px solid var(--accent-cyan) !important;
        border-radius: 6px 6px 0 0 !important;
    }

    .rz-navigation-item-icon {
        color: var(--accent-light-blue) !important;
    }

    .rz-navigation-item-active .rz-navigation-item-icon {
        color: var(--accent-cyan) !important;
    }

    /* Выпадающие подпункты */
    .rz-navigation-item-wrapper .rz-navigation-item {
        background-color: var(--bg-card) !important;
        color: var(--text-muted) !important;
        border: 1px solid var(--border-color) !important;
    }

        .rz-navigation-item-wrapper .rz-navigation-item:hover {
            background-color: var(--bg-card-hover) !important;
            color: var(--accent-cyan) !important;
            border-color: rgba(78, 195, 209, 0.3) !important;
        }

    /* Мобильная кнопка (гамбургер) */
    .rz-navigation-menu-toggle {
        color: var(--accent-cyan) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 6px !important;
    }

        .rz-navigation-menu-toggle:hover {
            background-color: rgba(78, 195, 209, 0.1) !important;
            border-color: var(--accent-cyan) !important;
        }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .nav-bar {
            padding: 0 1rem;
            flex-direction: column;
            align-items: flex-start;
        }

        .rz-navigation {
            width: 100%;
        }
    }
</style>

<form id="logoutForm" action="Account/Logout" method="post">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
</form>

<div class="nav-bar">
    <div class="cyber-logo-container">
        <span class="shield-icon">🛡️</span>
        <div>
            <h1 class="logo-title">
                <span class="text-cyan">КИБЕР</span><span class="text-gray">ПОЛИГОН</span>
            </h1>
            <div class="accent-line"></div>
            <p class="logo-subtitle">Информационная безопасность</p>
        </div>
    </div>

    <RadzenMenu Responsive="true" Style="background: transparent; border: none;">
        <RadzenMenuItem Text="Главная" Path="" Icon="home" />
        <RadzenMenuItem Text="Сценарии" Path="scenario" Icon="crisis_alert" />
        <RadzenMenuItem Text="Тесты" Path="tests" Icon="quiz" />
        <RadzenMenuItem Text="Инструкция" Path="instruction" Icon="menu_book" />
        <RadzenMenuItem Text="@Nm" Path="profile" Icon="account_box" />
        <RadzenMenuItem Text="Панель администратора" Path="admin" Icon="lock" />
        <RadzenMenuItem Text="Выход" Icon="door_open" Click="HandleLogoutClick" />
    </RadzenMenu>
</div>

@code {
    private ApplicationUser? user;
    private string? currentUrl;

    private string UserDisplayFName => user?.FirstName ?? "";
    private string UserDisplayLName => user?.LastName ?? "";

    private string Nm => string.Join(" ", new[] { UserDisplayLName, UserDisplayFName }
        .Where(s => !string.IsNullOrWhiteSpace(s)))
        .Trim();

    // Если оба пустые — показать "Гость"
    private string UserDisplayName => string.IsNullOrWhiteSpace(Nm) ? "Гость" : Nm;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId != null)
        {
            user = await UserManager.FindByIdAsync(userId);
        }
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private async Task HandleLogoutClick(MenuItemEventArgs args)
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('logoutForm').submit()");
    }

    void OnParentClicked(MenuItemEventArgs args) { }
    void OnChildClicked(MenuItemEventArgs args) { }
}