@page "/tests"
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Services
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject TestService TestService
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<CyberPolygon.Data.ApplicationDbContext> ContextFactory
@inject CatalogUpdateService CatalogUpdateService

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .tests-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-muted);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 30px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 15px;
    }

    .difficulty-section {
        margin-bottom: 50px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 30px;
        padding-bottom: 18px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 80px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

        .section-title h3 {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

    .tests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 25px;
    }

    .test-card {
        background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-card-hover) 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        position: relative;
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

        .test-card:hover {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 15px rgba(78, 195, 209, 0.2);
            transform: translateY(-5px);
        }

    .card-title {
        color: var(--text-light);
        margin-bottom: 15px;
        font-weight: bold;
        font-size: 1.25rem;
        word-break: break-word;
        overflow-wrap: break-word;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-right: 70px;
    }

    .card-desc {
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 20px;
        color: var(--text-muted);
        flex-grow: 1;
        word-break: break-word;
        overflow-wrap: break-word;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .admin-actions {
        position: absolute;
        top: 22px;
        right: 20px;
        display: flex;
        gap: 8px;
        z-index: 10;
    }

    .btn-icon {
        background: transparent;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        color: var(--text-muted);
        cursor: pointer;
        padding: 6px;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-icon:hover {
            color: var(--accent-cyan);
            border-color: var(--accent-cyan);
        }

        .btn-icon.delete:hover {
            color: var(--danger-color);
            border-color: var(--danger-color);
        }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-gradient:hover {
            box-shadow: 0 5px 15px rgba(78, 195, 209, 0.4);
            transform: translateY(-2px);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-outline-light:hover {
            background: rgba(255,255,255,0.05);
            border-color: var(--accent-light-blue);
            color: var(--accent-light-blue);
        }

    .cyber-badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        white-space: nowrap;
    }

        .cyber-badge.section-badge {
            padding: 6px 14px;
            font-size: 0.85rem;
            margin: 0;
        }

    .diff-easy {
        background: rgba(152, 195, 121, 0.15);
        border: 1px solid rgba(152, 195, 121, 0.5);
        color: var(--success-color);
    }

    .diff-medium {
        background: rgba(229, 192, 123, 0.15);
        border: 1px solid rgba(229, 192, 123, 0.5);
        color: var(--warning-color);
    }

    .diff-hard {
        background: rgba(224, 108, 117, 0.15);
        border: 1px solid rgba(224, 108, 117, 0.5);
        color: var(--danger-color);
    }

    .cyber-tag {
        background: rgba(78, 195, 209, 0.1);
        border: 1px solid rgba(78, 195, 209, 0.3);
        color: var(--accent-light-blue);
    }

    .status-badge-mini {
        font-size: 0.7rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 4px 8px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: 1px solid transparent;
        flex-shrink: 0;
    }

    .status-in-progress {
        background: rgba(78, 195, 209, 0.1);
        color: var(--accent-cyan);
        border-color: rgba(78, 195, 209, 0.3);
    }

    .status-completed {
        background: rgba(152, 195, 121, 0.1);
        color: var(--success-color);
        border-color: rgba(152, 195, 121, 0.3);
    }

    .status-failed {
        background: rgba(224, 108, 117, 0.1);
        color: var(--danger-color);
        border-color: rgba(224, 108, 117, 0.3);
    }

    .status-available {
        background: rgba(143, 160, 181, 0.1);
        color: var(--text-muted);
        border-color: var(--border-color);
    }
</style>

<div class="tests-container">
    <div class="page-header">
        <h2 style="color: var(--accent-light-blue); margin: 0; text-transform: uppercase; font-weight: 700;">Каталог тестирования</h2>
        <AuthorizeView Roles="Admin">
            <button class="btn-primary-gradient" @onclick="@(() => NavigationManager.NavigateTo("/admin/test/edit"))">
                <RadzenIcon Icon="add" Style="vertical-align: middle;" /> Новый тест
            </button>
        </AuthorizeView>
    </div>

    @if (tests == null)
    {
        <div class="text-center mt-5"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" /></div>
    }
    else if (!tests.Any())
    {
        <div class="text-center mt-5">
            <RadzenIcon Icon="assignment_late" Style="font-size: 4rem; color: var(--border-color);" />
            <h4 class="mt-3" style="color: var(--text-light);">Нет доступных тестов</h4>
            <p>В данный момент вам не назначено ни одного тестирования.</p>
        </div>
    }
    else
    {
        var groupedTests = tests.GroupBy(t => t.Difficulty).OrderBy(g => (int)g.Key);

        @foreach (var group in groupedTests)
        {
            <div class="difficulty-section" @key="group.Key">
                <div class="section-title">
                    <span class="cyber-badge section-badge @GetDifficultyClass(group.Key)">
                        <RadzenIcon Icon="speed" Style="font-size: 1.1rem; margin-top: -2px;" /> Уровень: @GetDifficultyText(group.Key)
                    </span>
                    <h3 style="color: @GetDifficultyColor(group.Key);">Тесты</h3>
                </div>

                <div class="tests-grid">
                    @foreach (var item in group)
                    {
                        var currentStatus = userProgresses.ContainsKey(item.Id) ? userProgresses[item.Id] : AttemptStatus.NotStarted;

                        <div class="test-card" @key="item.Id">
                            <AuthorizeView Roles="SuperAdmin">
                                <div class="admin-actions">
                                    <button class="btn-icon edit" @onclick="@(() => NavigationManager.NavigateTo($"/admin/test/edit/{item.Id}"))" title="Редактировать"><RadzenIcon Icon="edit" /></button>
                                    <button class="btn-icon delete" @onclick="@(() => DeleteItem(item.Id))" title="Удалить"><RadzenIcon Icon="delete" /></button>
                                </div>
                            </AuthorizeView>

                            <h3 class="card-title" title="@item.Title">@item.Title</h3>

                            <div class="d-flex gap-2 mb-3 flex-wrap">
                                @if (currentStatus == AttemptStatus.InProgress)
                                {
                                    <span class="status-badge-mini status-in-progress"><RadzenIcon Icon="clock_loader_40" Style="font-size: 0.9rem;" /> В процессе</span>
                                }
                                else if (currentStatus == AttemptStatus.Completed)
                                {

                                    <span class="status-badge-mini status-completed"><RadzenIcon Icon="check" Style="font-size: 0.9rem;" /> Выполнено</span>
                                }
                                else if (currentStatus == AttemptStatus.Failed)
                                {

                                    <span class="status-badge-mini status-failed"><RadzenIcon Icon="error_outline" Style="font-size: 0.9rem;" /> Провалено</span>
                                }
                                else
                                {

                                    <span class="status-badge-mini status-available"><RadzenIcon Icon="domain_verification" Style="font-size: 0.9rem;" /> Доступно</span>
                                }

                                <span class="cyber-badge" style="background: rgba(91,163,227,0.1); border: 1px solid var(--accent-blue); color: var(--accent-blue);">
                                    <RadzenIcon Icon="person" Style="font-size: 0.9rem; margin-top: -2px;" /> Индивидуальный
                                </span>

                                @if (!string.IsNullOrEmpty(item.Tags))
                                {
                                    @foreach (var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="cyber-badge cyber-tag"><RadzenIcon Icon="sell" Style="font-size: 0.9rem; margin-top: -2px;" /> @tag.Trim()</span>
                                    }
                                }
                            </div>

                            <p class="card-desc" title="@item.ShortDescription">@(string.IsNullOrWhiteSpace(item.ShortDescription) ? "Описание отсутствует." : item.ShortDescription)</p>

                            <div class="mt-auto pt-3" style="border-top: 1px solid var(--border-color);">
                                <button class="btn-outline-light" @onclick="@(() => NavigationManager.NavigateTo($"/test/{item.Id}/workspace"))">
                                    @if (currentStatus == AttemptStatus.InProgress)
                                    {
                                        <span><RadzenIcon Icon="play_arrow" Style="font-size: 1.2rem; margin-top: -2px;" /> Продолжить</span>
                                    }
                                    else if (currentStatus == AttemptStatus.Completed || currentStatus == AttemptStatus.Failed)
                                    {

                                        <span><RadzenIcon Icon="visibility" Style="font-size: 1.2rem; margin-top: -2px;" /> Результаты</span>
                                    }
                                    else
                                    {

                                        <span><RadzenIcon Icon="play_arrow" Style="font-size: 1.2rem; margin-top: -2px;" /> Начать тестирование</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (isDeleteVisualDialogVisible)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(5px); z-index: 1050; position: fixed; top: 0; left: 0; right: 0; bottom: 0;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color);">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-color);"><h5 class="modal-title" style="color: var(--text-light);">Подтверждение удаления</h5><button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteDialog"></button></div>
                <div class="modal-body"><p style="color: var(--text-muted);">Вы действительно хотите удалить этот тест?</p></div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-color);"><button type="button" class="btn btn-secondary" style="background: transparent; border: 1px solid var(--border-color); color: var(--text-light);" @onclick="CloseDeleteDialog">Отмена</button><button type="button" class="btn btn-danger" style="background: var(--danger-color); border: none;" @onclick="ConfirmDelete">Удалить</button></div>
            </div>
        </div>
    </div>
}

