@page "/tests"
@using CyberPolygon.Components.Components
@using CyberPolygon.Data
@rendermode InteractiveServer

@inject TestService TestService
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --border-glow: #4ec3d1;
    }

    .tests-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-muted);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1300px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 50px;
        gap: 30px;
    }

    .header-text {
        flex: 1;
    }

        .header-text h1 {
            color: var(--accent-light-blue);
            font-weight: 700;
            text-transform: uppercase;
            margin: 0 0 12px 0;
            font-size: 2.4rem;
            letter-spacing: 2px;
            text-shadow: 0 0 20px rgba(126, 200, 248, 0.3);
        }

        .header-text p {
            color: var(--text-muted);
            font-size: 1.1rem;
            margin: 0;
            line-height: 1.6;
            max-width: 600px;
        }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .create-btn {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 12px 28px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 15px rgba(78, 195, 209, 0.2);
        white-space: nowrap;
    }

        .create-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
            background: linear-gradient(135deg, #5fd4e0 0%, #6fb3f0 100%);
        }

    .difficulty-section {
        margin-bottom: 55px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 30px;
        padding-bottom: 18px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 80px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

        .section-title h2 {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

    .cards-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .cyber-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px 30px;
        transition: all 0.3s ease;
        position: relative;
        display: flex;
        align-items: center;
        gap: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

        .cyber-card:hover {
            border-color: var(--accent-cyan);
            transform: translateX(5px);
            box-shadow: 0 8px 30px rgba(78, 195, 209, 0.15), 0 0 20px rgba(78, 195, 209, 0.05);
            background: linear-gradient(135deg, #1e2d3d 0%, #223548 100%);
        }

    .card-main {
        flex: 1;
        min-width: 0;
    }

    .card-header {
        position: relative;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .status-badge {
        font-size: 0.7rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 6px;
        letter-spacing: 0.5px;
        backdrop-filter: blur(10px);
        order: -1;
    }

    .status-published {
        background: rgba(78, 195, 209, 0.2);
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.4);
    }

    .status-draft {
        background: rgba(143, 160, 181, 0.15);
        color: var(--text-muted);
        border: 1px solid var(--border-color);
    }

    .difficulty-badge {
        font-size: 0.7rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 6px;
        letter-spacing: 1.5px;
        display: inline-block;
    }

    .diff-easy {
        background: rgba(126, 200, 248, 0.15);
        color: #7ec8f8;
        border: 1px solid rgba(126, 200, 248, 0.4);
    }

    .diff-medium {
        background: rgba(91, 163, 227, 0.15);
        color: #5ba3e3;
        border: 1px solid rgba(91, 163, 227, 0.4);
    }

    .diff-hard {
        background: rgba(78, 195, 209, 0.15);
        color: #4ec3d1;
        border: 1px solid rgba(78, 195, 209, 0.4);
    }

    .card-title {
        color: var(--accent-light-blue);
        margin: 0;
        font-size: 1.2rem;
        font-weight: bold;
        letter-spacing: 0.3px;
    }

    .card-description {
        color: var(--text-muted);
        font-size: 0.92rem;
        line-height: 1.6;
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .card-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }

    .btn-details {
        background: none;
        border: 1px solid rgba(78, 195, 209, 0.3);
        color: var(--accent-cyan);
        cursor: pointer;
        padding: 8px 18px;
        border-radius: 6px;
        font-size: 0.85rem;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

        .btn-details:hover {
            background: rgba(78, 195, 209, 0.1);
            border-color: var(--accent-cyan);
        }

    .admin-actions {
        display: flex;
        gap: 8px;
    }

    .btn-icon {
        background: transparent;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-icon.edit {
            color: var(--accent-light-blue);
            border-color: rgba(126, 200, 248, 0.3);
        }

            .btn-icon.edit:hover {
                background: rgba(126, 200, 248, 0.1);
                border-color: var(--accent-light-blue);
            }

        .btn-icon.delete {
            color: #e06c75;
            border-color: rgba(224, 108, 117, 0.3);
        }

            .btn-icon.delete:hover {
                background: rgba(224, 108, 117, 0.1);
                border-color: #e06c75;
            }

    .card-details {
        margin-top: 20px;
        padding: 20px;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--border-color);
        color: var(--text-light);
        width: 100%;
    }

        .card-details .description {
            font-size: 0.85rem;
            margin-bottom: 15px;
            line-height: 1.6;
        }

    .card-stats {
        display: flex;
        gap: 25px;
        margin-bottom: 18px;
        font-family: monospace;
        font-size: 0.85rem;
        color: var(--accent-cyan);
    }

        .card-stats span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

    .btn-start {
        width: 100%;
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        letter-spacing: 1.5px;
        padding: 12px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.9rem;
        text-transform: uppercase;
        box-shadow: 0 4px 15px rgba(78, 195, 209, 0.2);
    }

        .btn-start:hover {
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
            background: linear-gradient(135deg, #5fd4e0 0%, #6fb3f0 100%);
            transform: translateY(-1px);
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        border: 2px dashed var(--border-color);
        border-radius: 12px;
        color: var(--text-muted);
        background: rgba(26, 35, 50, 0.5);
    }

    .loading-container {
        text-align: center;
        padding: 60px;
    }

    /* Модальное окно удаления */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(6px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .modal-box {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        box-shadow: 0 0 40px rgba(91, 163, 227, 0.2);
        border-radius: 12px;
        width: 450px;
        max-width: 90%;
        padding: 30px;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .modal-header h3 {
            color: var(--accent-light-blue);
            margin: 0;
            font-size: 1.2rem;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

    .modal-close {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        cursor: pointer;
        font-size: 1.2rem;
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

        .modal-close:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }

    .modal-body {
        text-align: center;
        margin-bottom: 30px;
        color: #e06c75;
        font-size: 1.05rem;
        line-height: 1.5;
        padding: 10px 0;
    }

    .modal-footer {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    .btn-ok {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        border: none;
        padding: 10px 35px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        letter-spacing: 0.5px;
        transition: all 0.2s;
    }

        .btn-ok:hover {
            box-shadow: 0 4px 15px rgba(78, 195, 209, 0.4);
        }

    .btn-cancel {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 35px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        letter-spacing: 0.5px;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            border-color: var(--text-muted);
            background: rgba(143, 160, 181, 0.1);
        }

    /* Кастомизация Radzen */
    .rz-dialog {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
    }

    .rz-dialog-titlebar {
        background-color: var(--bg-main) !important;
        color: var(--text-light) !important;
        border-bottom: 1px solid var(--border-color) !important;
    }

    .rz-dialog-content {
        color: var(--text-light) !important;
    }
</style>

<RadzenComponents />
<PageTitle>Обучение на киберполигоне</PageTitle>

<div class="tests-container">
    <div class="page-header">
        <div class="header-text">
            <h1>Обучение на киберполигоне</h1>
            <p>Тестовые задания для обучения и повышения навыков в сфере кибербезопасности.</p>
        </div>

        <AuthorizeView Roles="Admin">
            <div class="header-actions">
                <button class="create-btn" @onclick="@(() => OpenEditDialog(new CyberTest()))">
                    <RadzenIcon Icon="add" Style="vertical-align: middle; margin-right: 6px;" /> Создать тест
                </button>
            </div>
        </AuthorizeView>
    </div>

    @if (tests == null)
    {
        <div class="loading-container">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color);" />
        </div>
    }
    else if (!tests.Any())
    {
        <div class="empty-state">
            <RadzenIcon Icon="school" Style="font-size: 3rem; color: var(--border-color); margin-bottom: 20px;" />
            <p style="font-size: 1.1rem; margin: 0;">База данных тестов пуста.</p>
        </div>
    }
    else
    {
        var difficulties = new[] { TestDifficulty.Easy, TestDifficulty.Medium, TestDifficulty.Hard };
        var difficultyNames = new Dictionary<TestDifficulty, string>
        {
            { TestDifficulty.Easy, "Начальный уровень" },
            { TestDifficulty.Medium, "Средний уровень" },
            { TestDifficulty.Hard, "Продвинутый уровень" }
        };
        foreach (var diff in difficulties)
        {
            var filteredTests = tests.Where(t => t.Difficulty == diff).ToList();
            if (!filteredTests.Any()) continue;

            <div class="difficulty-section">
                <div class="section-title">
                    <span class="difficulty-badge @GetDifficultyClass(diff)" style="margin-bottom:0;">@GetDifficultyText(diff)</span>
                    <h2 style="color: @GetDifficultyColor(diff);">@difficultyNames[diff]</h2>
                </div>

                <div class="cards-list">
                    @foreach (var test in filteredTests)
                    {
                        bool isExpanded = expandedCards.ContainsKey(test.Id) && expandedCards[test.Id];

                        // Логика проверки статуса
                        bool hasProgress = userProgresses.TryGetValue(test.Id, out var status);
                        bool isCompleted = hasProgress && status == AttemptStatus.Completed;
                        bool isStarted = hasProgress && status != AttemptStatus.Completed && status != AttemptStatus.NotStarted;

                        <div>
                            <div class="cyber-card">
                                <div class="card-main">
                                    <div class="card-header">
                                        <span class="difficulty-badge @GetDifficultyClass(test.Difficulty)">@GetDifficultyText(test.Difficulty)</span>
                                        <h3 class="card-title">@test.Title</h3>

                                        @if (isStarted)
                                        {
                                            <span class="status-badge" style="background: rgba(229, 192, 123, 0.15); color: #e5c07b; border: 1px solid rgba(229, 192, 123, 0.4);">В процессе</span>
                                        }
                                        else if (isCompleted)
                                        {
                                            <span class="status-badge" style="background: rgba(152, 195, 121, 0.15); color: #98c379; border: 1px solid rgba(152, 195, 121, 0.4);">Завершен</span>
                                        }

                                        <AuthorizeView Roles="Admin">
                                            <span class="status-badge @(test.IsVisible ? "status-published" : "status-draft")">
                                                @(test.IsVisible ? "Открыт" : "Черновик")
                                            </span>
                                        </AuthorizeView>
                                    </div>
                                    <p class="card-description">@test.ShortDescription</p>
                                </div>

                                <div class="card-actions">
                                    <button class="btn-details" @onclick="@(() => ToggleCard(test.Id))">
                                        <RadzenIcon Icon="@(isExpanded ? "expand_less" : "expand_more")" />
                                        @(isExpanded ? "Скрыть" : "Подробнее")
                                    </button>

                                    <AuthorizeView Roles="Admin">
                                        <div class="admin-actions">
                                            <button class="btn-icon edit" @onclick="@(() => OpenEditDialog(test))">
                                                <RadzenIcon Icon="edit" />
                                            </button>
                                            <button class="btn-icon delete" @onclick="@(() => DeleteItem(test.Id))">
                                                <RadzenIcon Icon="delete" />
                                            </button>
                                        </div>
                                    </AuthorizeView>
                                </div>
                            </div>

                            @if (isExpanded)
                            {
                                <div class="card-details">
                                    <div class="description">@((MarkupString)test.FullDescription)</div>

                                    <div class="card-stats">
                                        <span><RadzenIcon Icon="schedule" /> @test.DurationInMinutes мин.</span>
                                        <span><RadzenIcon Icon="quiz" /> @test.Questions.Count вопр.</span>
                                    </div>

                                    <button class="btn-start" @onclick="@(() => NavigationManager.NavigateTo($"/test/{test.Id}/workspace"))">
                                        @(isCompleted ? "ПРОСМОТРЕТЬ РЕЗУЛЬТАТ" : (isStarted ? "ПРОДОЛЖИТЬ" : "НАЧАТЬ ТЕСТИРОВАНИЕ"))
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (isDeleteVisualDialogVisible)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Предупреждение системы</h3>
                <button class="modal-close" @onclick="CloseDeleteDialog">✕</button>
            </div>
            <div class="modal-body">
                Вы уверены, что хотите навсегда удалить этот тест из базы данных?
            </div>
            <div class="modal-footer">
                <button class="btn-ok" @onclick="ConfirmDelete">ОК</button>
                <button class="btn-cancel" @onclick="CloseDeleteDialog">ОТМЕНА</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CyberTest>? tests;
    private Dictionary<int, bool> expandedCards = new();

    private string currentUserId = string.Empty;
    private Dictionary<int, AttemptStatus> userProgresses = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        await Refresh();
    }

    private async Task Refresh()
    {
        tests = await TestService.GetAllAsync();

        if (!string.IsNullOrEmpty(currentUserId))
        {
            userProgresses = await TestService.GetAllUserProgressesAsync(currentUserId);
        }
    }

    private void ToggleCard(int id)
    {
        if (expandedCards.ContainsKey(id)) expandedCards[id] = !expandedCards[id];
        else expandedCards[id] = true;
    }

    private async Task OpenEditDialog(CyberTest test)
    {
        var res = await DialogService.OpenAsync<TestEditor>(
            test.Id == 0 ? "Создание нового теста" : "Редактирование теста",
            new Dictionary<string, object> { { "Item", test } },
            new DialogOptions { Width = "850px", Height = "700px", Resizable = false, Draggable = true }
        );
        if (res == true) await Refresh();
    }

    bool isDeleteVisualDialogVisible = false;
    int testIdToDelete = 0;

    void DeleteItem(int id)
    {
        testIdToDelete = id;
        isDeleteVisualDialogVisible = true;
    }

    async Task ConfirmDelete()
    {
        isDeleteVisualDialogVisible = false;
        if (testIdToDelete != 0)
        {
            await TestService.DeleteAsync(testIdToDelete);
            await Refresh();
            NotificationService.Notify(NotificationSeverity.Success, "Система", "Тест успешно удален.");
        }
        testIdToDelete = 0;
    }

    void CloseDeleteDialog()
    {
        isDeleteVisualDialogVisible = false;
        testIdToDelete = 0;
    }

    private string GetDifficultyClass(TestDifficulty diff) => diff switch
    {
        TestDifficulty.Easy => "diff-easy",
        TestDifficulty.Medium => "diff-medium",
        _ => "diff-hard"
    };

    private string GetDifficultyText(TestDifficulty diff) => diff switch
    {
        TestDifficulty.Easy => "Легкий",
        TestDifficulty.Medium => "Средний",
        _ => "Сложный"
    };

    private string GetDifficultyColor(TestDifficulty diff) => diff switch
    {
        TestDifficulty.Easy => "#7ec8f8",
        TestDifficulty.Medium => "#5ba3e3",
        _ => "#4ec3d1"
    };
}