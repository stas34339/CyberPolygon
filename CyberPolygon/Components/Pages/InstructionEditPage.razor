@page "/instruction/edit"
@page "/instruction/edit/{Id:int}"
@using CyberPolygon.Data.Models
@using CyberPolygon.Services
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@rendermode InteractiveServer

@inject InstructionService InstructionService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>@(Id.HasValue ? "Редактирование инструкции" : "Новая инструкция") | Киберполигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-input: #131924;
        --border-color: #2a3a4a;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .page-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-light);
        max-width: 1300px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: sticky;
        top: 0;
        background-color: var(--bg-main);
        z-index: 50;
    }

    .cyber-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
        display: block;
        font-weight: 600;
    }

    .dark-input, .rz-textbox, .rz-textarea, .rz-dropdown {
        background-color: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
    }

    /* Исправление выпадающих списков Radzen */
    .rz-dropdown-panel, .rz-popup {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
    }

        .rz-dropdown-item:hover {
            background-color: rgba(78, 195, 209, 0.15) !important;
            color: var(--accent-cyan) !important;
        }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-delete-icon {
        background: transparent;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.3);
        border-radius: 6px;
        padding: 5px 10px;
        cursor: pointer;
    }

    .upload-zone {
        position: relative;
        border: 2px dashed var(--accent-cyan);
        border-radius: 10px;
        padding: 30px 20px;
        text-align: center;
        background: rgba(78, 195, 209, 0.05);
        transition: all 0.3s;
        cursor: pointer;
    }

        .upload-zone:hover {
            background: rgba(78, 195, 209, 0.15);
            border-color: var(--accent-light-blue);
        }

        .upload-zone input[type=file] {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            opacity: 0;
            cursor: pointer;
        }

    .added-item-row {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        padding: 10px 15px;
        border-radius: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
    }
</style>

<div class="page-container">
    <div class="page-header">
        <h2 style="color: var(--accent-light-blue); margin: 0; font-weight: 700; text-transform: uppercase;">
            @(Id.HasValue ? "Редактирование инструкции" : "Создание инструкции")
        </h2>
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn-primary-gradient" style="background: linear-gradient(135deg, #98c379 0%, #5ba3e3 100%);" @onclick="OnSave">
                <RadzenIcon Icon="save" Style="font-size: 1.2rem;" /> Сохранить в БД
            </button>
            <button class="btn-outline-light" @onclick="Cancel">Отмена</button>
        </div>
    </div>

    <RadzenTemplateForm TItem="InstructionModel" Data="@Item" Submit="@OnSave">
        <div class="row">
            <div class="col-md-8">
                <div class="cyber-card">
                    <div class="mb-4">
                        <label class="cyber-label">Название инструкции</label>
                        <RadzenTextBox @bind-Value="@Item.Title" class="w-100 rz-textbox" Placeholder="Введите название регламента или руководства..." />
                    </div>
                    <div class="mb-2">
                        <label class="cyber-label">Содержание / Текст инструкции</label>
                        <RadzenTextArea @bind-Value="@Item.Description" class="w-100 rz-textarea" Rows="14" Placeholder="Подробное описание..." />
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="cyber-card mb-4">
                    <label class="cyber-label">Системная иконка</label>
                    <RadzenDropDown @bind-Value="@Item.IconName" Data="@availableIcons" class="w-100 rz-dropdown" />
                    <div class="mt-4 text-center">
                        <RadzenIcon Icon="@Item.IconName" Style="font-size: 4rem; color: var(--accent-cyan);" />
                    </div>
                </div>

                <div class="cyber-card">
                    <label class="cyber-label">Вложения (Связанные файлы)</label>

                    @* Зона загрузки только для новых файлов *@
                    @if (!Id.HasValue)
                    {
                        <div class="upload-zone">
                            <InputFile OnChange="LoadFiles" multiple />
                            <RadzenIcon Icon="cloud_upload" Style="font-size: 3rem; color: var(--accent-cyan); display: block; margin: 0 auto 10px;" />
                            <span style="color: var(--text-light); font-weight: 500;">Нажмите сюда или перетащите файлы</span>
                        </div>

                        @if (uploadedFiles.Any())
                        {
                            <div class="mt-3">
                                <label class="cyber-label">Подготовлено к загрузке:</label>
                                @foreach (var file in uploadedFiles)
                                {
                                    <div class="added-item-row">
                                        <span style="color: var(--text-light); font-size: 0.85rem;">
                                            <RadzenIcon Icon="attach_file" Style="vertical-align: middle; margin-right: 5px; color: var(--accent-blue);" />
                                            @file.Name
                                        </span>
                                        <button type="button" class="btn-delete-icon" style="padding: 2px 5px;" @onclick="() => RemoveFile(file)">
                                            <RadzenIcon Icon="close" Style="font-size: 0.9rem;" />
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        @* Отображение уже прикрепленных файлов (добавление новых в режиме редактирования зависит от твоего бекенда) *@
                        @if (Item.Attachments != null && Item.Attachments.Any())
                        {
                            <div class="mt-2">
                                @foreach (var file in Item.Attachments)
                                {
                                    <div class="added-item-row">
                                        <span style="color: var(--text-light); font-size: 0.85rem;">
                                            <RadzenIcon Icon="description" Style="vertical-align: middle; margin-right: 5px; color: var(--success-color);" />
                                            @file.FileName
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center mt-3">Файлы отсутствуют.</p>
                        }
                    }
                </div>
            </div>
        </div>
    </RadzenTemplateForm>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private InstructionModel Item { get; set; } = new();

    private List<IBrowserFile> uploadedFiles = new();
    private int maxAllowedFiles = 10;

    private readonly List<string> availableIcons = new()
    {
        "assignment", "terminal", "security", "shield", "bug_report",
        "lock", "visibility", "help_center", "description", "code", "lan"
    };

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            // Получаем список и находим нужную инструкцию
            var all = await InstructionService.GetAllAsync();
            Item = all.FirstOrDefault(i => i.Id == Id.Value) ?? new InstructionModel { IconName = "assignment" };
        }
        else
        {
            Item = new InstructionModel { IconName = "assignment" };
        }
    }

    private void LoadFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(maxAllowedFiles))
        {
            if (!uploadedFiles.Any(f => f.Name == file.Name))
            {
                uploadedFiles.Add(file);
            }
        }
    }

    private void RemoveFile(IBrowserFile file)
    {
        uploadedFiles.Remove(file);
    }

    private async Task OnSave()
    {
        if (string.IsNullOrWhiteSpace(Item.Title) || string.IsNullOrWhiteSpace(Item.Description))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Ошибка", "Заполните название и содержание инструкции.");
            return;
        }

        try
        {
            if (Item.Id == 0)
            {
                // Высчитываем порядок для новой инструкции
                var all = await InstructionService.GetAllAsync();
                Item.Order = all.Any() ? all.Max(i => i.Order) + 1 : 1;

                await InstructionService.AddAsync(Item, uploadedFiles);
                NotificationService.Notify(NotificationSeverity.Success, "Успех", "Новая инструкция добавлена.");
            }
            else
            {
                await InstructionService.UpdateAsync(Item);
                NotificationService.Notify(NotificationSeverity.Success, "Успех", "Инструкция обновлена.");
            }

            NavigationManager.NavigateTo("instruction");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка сохранения", ex.Message);
        }
    }

    private void Cancel() => NavigationManager.NavigateTo("instruction");
}