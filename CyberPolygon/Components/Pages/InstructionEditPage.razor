@page "/instruction/edit"
@page "/instruction/edit/{Id:int}"
@using CyberPolygon.Data.Models
@using CyberPolygon.Services
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@rendermode InteractiveServer
@attribute [Authorize]
@inject InstructionService InstructionService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>@(Id.HasValue ? "Редактирование инструкции" : "Новая инструкция") | Киберполигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-input: #131924;
        --border-color: #2a3a4a;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .page-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-light);
        max-width: 1300px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: sticky;
        top: 0;
        background-color: var(--bg-main);
        z-index: 50;
    }

    .cyber-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
        display: block;
        font-weight: 600;
    }

    .dark-input, .rz-textbox, .rz-textarea, .rz-dropdown {
        background-color: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
    }

        /* СВЕТЛЫЕ ПЛЕЙСХОЛДЕРЫ ДЛЯ ВСЕХ ПОЛЕЙ */
        .dark-input::placeholder, .rz-textbox::placeholder, .rz-textarea::placeholder {
            color: #8fa0b5 !important;
            opacity: 0.9 !important;
            font-style: italic;
        }

    ::-webkit-input-placeholder {
        color: #8fa0b5 !important;
        opacity: 0.9 !important;
        font-style: italic;
    }

    ::-moz-placeholder {
        color: #8fa0b5 !important;
        opacity: 0.9 !important;
        font-style: italic;
    }

    /* Исправление выпадающих списков Radzen */
    .rz-dropdown-panel, .rz-popup {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
        padding: 8px 12px !important;
    }

        .rz-dropdown-item:hover {
            background-color: rgba(78, 195, 209, 0.15) !important;
            color: var(--accent-cyan) !important;
        }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-delete-icon {
        background: transparent;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.3);
        border-radius: 6px;
        padding: 5px 10px;
        cursor: pointer;
    }

    /* ОБНОВЛЕННАЯ ЗОНА ЗАГРУЗКИ */
    .upload-zone {
        position: relative;
        border: 2px dashed var(--accent-cyan);
        border-radius: 10px;
        padding: 30px 20px;
        text-align: center;
        background: rgba(78, 195, 209, 0.05);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        overflow: hidden;
    }

        .upload-zone:hover {
            background: rgba(78, 195, 209, 0.15);
            border-color: var(--accent-light-blue);
            box-shadow: 0 4px 15px rgba(78, 195, 209, 0.2);
        }

        .upload-zone input[type=file] {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            opacity: 0;
            cursor: pointer;
            z-index: 2;
        }

    .upload-icon {
        font-size: 2.5rem;
        color: var(--accent-cyan);
        transition: transform 0.3s ease, color 0.3s ease;
    }

    .upload-zone:hover .upload-icon {
        transform: translateY(-4px);
        color: var(--accent-light-blue);
    }

    .added-item-row {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        padding: 10px 15px;
        border-radius: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
    }

    .upload-zone small, .upload-zone span {
        color: var(--text-light) !important;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    }

        /* Оставляем саму техническую подсказку чуть мягче основного текста, но контрастной */
        .upload-zone span:last-child {
            color: var(--text-muted) !important;
        }
</style>

<div class="page-container">
    <div class="page-header">
        <h2 style="color: var(--accent-light-blue); margin: 0; font-weight: 700; text-transform: uppercase;">
            @(Id.HasValue ? "Редактирование инструкции" : "Создание инструкции")
        </h2>
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn-primary-gradient" style="background: linear-gradient(135deg, #98c379 0%, #5ba3e3 100%);" @onclick="OnSave">
                <RadzenIcon Icon="save" Style="font-size: 1.2rem;" /> Сохранить в БД
            </button>
            <button class="btn-outline-light" @onclick="Cancel">Отмена</button>
        </div>
    </div>

    <RadzenTemplateForm TItem="InstructionModel" Data="@Item" Submit="@OnSave">
        <div class="row">
            <div class="col-md-8">
                <div class="cyber-card">
                    <div class="mb-4">
                        <label class="cyber-label">Название руководства</label>
                        <RadzenTextBox @bind-Value="@Item.Title" class="w-100 rz-textbox" Placeholder="Например: Памятка по настройке VPN подключения..." />
                    </div>
                    <div class="mb-2">
                        <label class="cyber-label">Текст инструкции</label>
                        <RadzenTextArea @bind-Value="@Item.Description" class="w-100 rz-textarea" Rows="14" Placeholder="Подробное описание шагов, команд или регламентов..." />
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="cyber-card mb-4">
                    <label class="cyber-label">Системная иконка</label>

                    <RadzenDropDown @bind-Value="@Item.IconName" Data="@availableIcons" class="w-100 rz-dropdown">
                        <Template Context="icon">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="@icon" Style="font-size: 1.2rem; color: var(--accent-cyan);" />
                                <span style="color: var(--text-light);">@GetIconDescription(icon)</span>
                            </div>
                        </Template>
                        <ValueTemplate Context="icon">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="@icon" Style="font-size: 1.2rem; color: var(--accent-cyan);" />
                                <span style="color: var(--text-light);">@GetIconDescription(icon)</span>
                            </div>
                        </ValueTemplate>
                    </RadzenDropDown>

                    <div class="mt-4 text-center">
                        <RadzenIcon Icon="@Item.IconName" Style="font-size: 4.5rem; color: var(--accent-cyan); text-shadow: 0 0 15px rgba(78, 195, 209, 0.4);" />
                    </div>
                </div>

                <div class="cyber-card">
                    <label class="cyber-label">Вложения (Связанные файлы)</label>

                    @* Зона загрузки только для новых файлов *@
                    @if (!Id.HasValue)
                    {
                        <div class="upload-zone">
                            <InputFile OnChange="LoadFiles" multiple />
                            <RadzenIcon Icon="cloud_upload" class="upload-icon" />
                            <span style="color: var(--text-light); font-weight: 500; display: block;">Нажмите сюда или перетащите файлы</span>
                            <span style="color: var(--text-muted); font-size: 0.8rem; display: block; margin-top: 2px;">Поддерживаются форматы PDF, DOCX, ZIP (Макс. 10 файлов)</span>
                        </div>

                        @if (uploadedFiles.Any())
                        {
                            <div class="mt-3">
                                <label class="cyber-label" style="font-size: 0.75rem; opacity: 0.8;">Подготовлено к загрузке:</label>
                                @foreach (var file in uploadedFiles)
                                {
                                    <div class="added-item-row">
                                        <span style="color: var(--text-light); font-size: 0.85rem;">
                                            <RadzenIcon Icon="attach_file" Style="vertical-align: middle; margin-right: 5px; color: var(--accent-blue);" />
                                            @file.Name
                                        </span>
                                        <button type="button" class="btn-delete-icon" style="padding: 2px 5px;" @onclick="() => RemoveFile(file)">
                                            <RadzenIcon Icon="close" Style="font-size: 0.9rem;" />
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        @* Отображение уже прикрепленных файлов *@
                        @if (Item.Attachments != null && Item.Attachments.Any())
                        {
                            <div class="mt-2">
                                @foreach (var file in Item.Attachments)
                                {
                                    <div class="added-item-row">
                                        <span style="color: var(--text-light); font-size: 0.85rem;">
                                            <RadzenIcon Icon="description" Style="vertical-align: middle; margin-right: 5px; color: var(--success-color);" />
                                            @file.FileName
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-center mt-3" style="color: var(--text-light); font-weight: 500;">Файлы отсутствуют.</p>
                        }
                    }
                </div>
            </div>
        </div>
    </RadzenTemplateForm>
</div>
