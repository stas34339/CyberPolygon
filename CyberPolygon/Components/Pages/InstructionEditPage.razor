@page "/instruction/edit"
@page "/instruction/edit/{Id:int}"
@using CyberPolygon.Data.Models
@using CyberPolygon.Services
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@rendermode InteractiveServer
@attribute [Authorize]
@inject InstructionService InstructionService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>@(Id.HasValue ? "Редактирование инструкции" : "Новая инструкция") | Киберполигон</PageTitle>

<style>
    /* Строгая киберпанк-тема */
    :root {
        --bg-main: #0b0f17;
        --bg-card: #131924;
        --bg-card-hover: #1a2435;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    /* Обертка на всю ширину для однородного фона */
    .full-page-wrapper {
        background-color: var(--bg-main) !important;
        min-height: calc(100vh - 60px);
        width: 100%;
        padding: 30px 20px;
        box-sizing: border-box;
    }

    /* Внутренний контейнер с ограничением ширины по центру */
    .page-container {
        color: var(--text-light);
        max-width: 1300px;
        margin: 0 auto;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 35px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
        gap: 20px;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

    .header-text h1 {
        color: var(--accent-cyan);
        font-weight: 800;
        text-transform: uppercase;
        margin: 0 0 8px 0;
        font-size: 1.8rem;
        letter-spacing: 2px;
        text-shadow: 0 0 15px rgba(78, 195, 209, 0.3);
    }

    .header-text p {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* === ОБОЛОЧКА (CYBER-SHELL) === */
    .cyber-shell {
        background-color: rgba(19, 25, 36, 0.6);
        border: 1px solid rgba(78, 195, 209, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(78, 195, 209, 0.05);
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .cyber-shell-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 25px;
        background: linear-gradient(90deg, rgba(78,195,209,0.1) 0%, transparent 100%);
        border-bottom: 1px solid rgba(78, 195, 209, 0.3);
        font-family: 'Courier New', Courier, monospace;
    }

    .shell-title {
        color: var(--accent-cyan);
        font-size: 0.95rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .shell-status {
        color: var(--text-muted);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    .status-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background-color: var(--accent-light-blue);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--accent-light-blue);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(126, 200, 248, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0);
        }
    }

    .cyber-shell-body {
        padding: 30px;
    }

    /* Внутренние карточки-секции */
    .cyber-section {
        background-color: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 25px;
        /* УБРАНО height: 100%; ТЕПЕРЬ БЛОКИ ВЫСТРАИВАЮТСЯ КОРРЕКТНО */
    }

    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
        font-weight: 700;
    }

    /* Инпуты Radzen */
    .rz-textbox, .rz-textarea, .rz-dropdown {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
        transition: all 0.3s ease;
    }

        .rz-textbox:focus, .rz-textarea:focus, .rz-dropdown:focus {
            border-color: var(--accent-cyan) !important;
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.2) !important;
        }

        .rz-textbox::placeholder, .rz-textarea::placeholder {
            color: #5b6b7a !important;
            font-style: normal;
        }

    .rz-dropdown-panel, .rz-popup {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--accent-cyan) !important;
        box-shadow: 0 10px 25px rgba(0,0,0,0.8) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
        padding: 10px 15px !important;
    }

        .rz-dropdown-item:hover {
            background-color: rgba(78, 195, 209, 0.15) !important;
            color: var(--accent-cyan) !important;
        }

    /* Кнопки */
    .btn-main {
        background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
        color: var(--bg-main);
        font-weight: 800;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-main:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(78, 195, 209, 0.4);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 12px 30px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

        .btn-outline-light:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-light);
            border-color: var(--text-muted);
        }

    .btn-delete-icon {
        background: transparent;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.3);
        border-radius: 6px;
        padding: 5px 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-delete-icon:hover {
            background: rgba(224, 108, 117, 0.1);
            border-color: var(--danger-color);
        }

    /* Зона загрузки файлов */
    .upload-zone {
        position: relative;
        border: 1px dashed var(--accent-cyan);
        border-radius: 8px;
        padding: 30px 20px;
        text-align: center;
        background: rgba(78, 195, 209, 0.03);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        overflow: hidden;
    }

        .upload-zone:hover {
            background: rgba(78, 195, 209, 0.1);
            box-shadow: inset 0 0 20px rgba(78, 195, 209, 0.1);
        }

    .upload-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 10;
    }

    .upload-icon {
        font-size: 3rem;
        color: var(--accent-cyan);
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    .upload-zone:hover .upload-icon {
        transform: translateY(-4px);
        filter: drop-shadow(0 0 10px rgba(78, 195, 209, 0.6));
    }

    .upload-title {
        color: var(--accent-light-blue);
        font-weight: 700;
        display: block;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .upload-subtitle {
        color: var(--text-muted);
        font-size: 0.75rem;
        display: block;
        margin-top: 2px;
    }

    .added-item-row {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--border-color);
        padding: 10px 15px;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
        transition: border-color 0.2s;
    }

        .added-item-row:hover {
            border-color: rgba(78, 195, 209, 0.4);
        }
</style>

<div class="full-page-wrapper">
    <div class="page-container">
        <div class="page-header">
            <div class="header-text">
                <h1>@(Id.HasValue ? "Редактирование инструкции" : "Создание инструкции")</h1>
                <p>Информационно-аналитический департамент // Конфигурация записи</p>
            </div>

            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn-main" @onclick="OnSave">
                    <RadzenIcon Icon="save" Style="font-size: 1.2rem;" /> Сохранить в БД
                </button>
                <button class="btn-outline-light" @onclick="Cancel">Отмена</button>
            </div>
        </div>

        <RadzenTemplateForm TItem="InstructionModel" Data="@Item" Submit="@OnSave">
            <div class="cyber-shell">
                <div class="cyber-shell-header">
                    <div class="shell-title">
                        <RadzenIcon Icon="edit_document" Style="font-size: 1.2rem;" />
                        SYS.ADMIN_TERMINAL // DOC_EDITOR
                    </div>
                    <div class="shell-status">
                        <span class="status-dot"></span>
                        ONLINE
                    </div>
                </div>

                <div class="cyber-shell-body">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="cyber-section" style="height: 100%;">
                                <div class="mb-4">
                                    <label class="cyber-label">Название блока</label>
                                    <RadzenTextBox @bind-Value="@Item.Title" class="w-100 rz-textbox" Placeholder="Например: Памятка по настройке VPN подключения..." />
                                </div>
                                <div class="mb-2">
                                    <label class="cyber-label">Содержание инструкции</label>
                                    <RadzenTextArea @bind-Value="@Item.Description" class="w-100 rz-textarea" Rows="14" Placeholder="Подробное описание шагов, команд или регламентов..." />
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 d-flex flex-column">
                            <div class="cyber-section mb-4">
                                <label class="cyber-label">Системная иконка</label>

                                <RadzenDropDown @bind-Value="@Item.IconName" Data="@availableIcons" class="w-100 rz-dropdown">
                                    <Template Context="icon">
                                        <div class="d-flex align-items-center gap-2">
                                            <RadzenIcon Icon="@icon" Style="font-size: 1.2rem; color: var(--accent-cyan);" />
                                            <span style="color: var(--text-light);">@GetIconDescription(icon)</span>
                                        </div>
                                    </Template>
                                    <ValueTemplate Context="icon">
                                        <div class="d-flex align-items-center gap-2">
                                            <RadzenIcon Icon="@icon" Style="font-size: 1.2rem; color: var(--accent-cyan);" />
                                            <span style="color: var(--text-light);">@GetIconDescription(icon)</span>
                                        </div>
                                    </ValueTemplate>
                                </RadzenDropDown>

                                <div class="mt-4 text-center">
                                    <RadzenIcon Icon="@Item.IconName" Style="font-size: 5rem; color: var(--accent-cyan); filter: drop-shadow(0 0 15px rgba(78, 195, 209, 0.4));" />
                                </div>
                            </div>

                            <div class="cyber-section flex-grow-1 mb-0">
                                <label class="cyber-label">Вложения (Связанные файлы)</label>

                                <!-- Зона загрузки файлов -->
                                <div class="upload-zone">
                                    <InputFile OnChange="LoadFiles" multiple class="upload-input" />
                                    <RadzenIcon Icon="cloud_upload" class="upload-icon" />
                                    <span class="upload-title">Выбрать файлы</span>
                                    <span class="upload-subtitle">Нажмите или перетащите сюда (PDF, DOCX, ZIP)</span>
                                </div>

                                <!-- Файлы, выбранные для добавления и уже загруженные -->
                                @if (Item.Attachments != null && Item.Attachments.Any())
                                {
                                    <div class="mt-4 pt-3" style="border-top: 1px dashed var(--border-color);">
                                        <label class="cyber-label" style="font-size: 0.75rem;">Загруженные файлы:</label>
                                        @foreach (var file in Item.Attachments.ToList())
                                        {
                                            <div class="added-item-row">
                                                <span style="color: var(--text-light); font-size: 0.85rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    <RadzenIcon Icon="description" Style="vertical-align: middle; margin-right: 5px; color: var(--success-color);" />
                                                    @file.FileName
                                                </span>
                                                <button type="button" class="btn-delete-icon" style="padding: 2px 5px; flex-shrink: 0;" @onclick="() => RemoveFile(file)">
                                                    <RadzenIcon Icon="close" Style="font-size: 0.9rem;" />
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Существующие файлы (только если мы редактируем) -->
                                @if (Id.HasValue && Item.Attachments != null && Item.Attachments.Any())
                                {
                                    <div class="mt-4 pt-3" style="border-top: 1px dashed var(--border-color);">
                                        <label class="cyber-label" style="font-size: 0.75rem;">Уже загружены в систему:</label>
                                        @foreach (var file in Item.Attachments)
                                        {
                                            <div class="added-item-row">
                                                <span style="color: var(--text-light); font-size: 0.85rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    <RadzenIcon Icon="description" Style="vertical-align: middle; margin-right: 5px; color: var(--success-color);" />
                                                    @file.FileName
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </RadzenTemplateForm>
    </div>
</div>