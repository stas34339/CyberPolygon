@page "/admin/test-attempt/{ProgressId:int}"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Детали попытки теста | Киберполигон</PageTitle>

<style>
    /* Строгая киберпанк-тема */
    :root {
        --bg-main: #0b0f17;
        --bg-card: #131924;
        --bg-card-hover: #1a2435;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    html, body {
        background-color: var(--bg-main) !important;
    }

    /* Обертка на всю ширину для однородного фона */
    .full-page-wrapper {
        background-color: var(--bg-main) !important;
        min-height: calc(100vh - 60px);
        width: 100%;
        padding: 30px 20px;
        box-sizing: border-box;
    }

    .page-container {
        color: var(--text-light);
        max-width: 1400px;
        margin: 0 auto;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 35px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
        gap: 20px;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

    .header-text h1 {
        color: var(--accent-cyan);
        font-weight: 800;
        text-transform: uppercase;
        margin: 0 0 8px 0;
        font-size: 1.8rem;
        letter-spacing: 2px;
        text-shadow: 0 0 15px rgba(78, 195, 209, 0.3);
    }

    .header-text p {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* === ОБОЛОЧКА (CYBER-SHELL) === */
    .cyber-shell {
        background-color: rgba(19, 25, 36, 0.6);
        border: 1px solid rgba(78, 195, 209, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(78, 195, 209, 0.05);
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .cyber-shell-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 25px;
        background: linear-gradient(90deg, rgba(78,195,209,0.1) 0%, transparent 100%);
        border-bottom: 1px solid rgba(78, 195, 209, 0.3);
        font-family: 'Courier New', Courier, monospace;
    }

    .shell-title {
        color: var(--accent-cyan);
        font-size: 0.95rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .shell-status {
        color: var(--text-muted);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    .status-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background-color: var(--accent-light-blue);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--accent-light-blue);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(126, 200, 248, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0);
        }
    }

    .cyber-shell-body {
        padding: 30px;
    }

    /* Внутренние секции */
    .cyber-section {
        background-color: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 25px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .info-item {
        background: rgba(0, 0, 0, 0.3);
        border: 1px dashed var(--border-color);
        border-radius: 8px;
        padding: 15px;
        text-align: center;
    }

        .info-item label {
            color: var(--accent-cyan);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: block;
            margin-bottom: 5px;
            font-weight: 700;
        }

        .info-item span {
            color: var(--text-light);
            font-size: 1.1rem;
            font-weight: 600;
            font-family: monospace;
        }

    .question-card {
        background: rgba(0,0,0,0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

        .question-card.correct {
            border-color: var(--success-color);
            background: rgba(152,195,121,0.05);
        }

            .question-card.correct::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background-color: var(--success-color);
                box-shadow: 0 0 10px var(--success-color);
            }

        .question-card.wrong {
            border-color: var(--danger-color);
            background: rgba(224,108,117,0.05);
        }

            .question-card.wrong::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background-color: var(--danger-color);
                box-shadow: 0 0 10px var(--danger-color);
            }

        .question-card.unanswered {
            border-color: var(--warning-color);
        }

    .option-item {
        padding: 12px 15px;
        margin: 8px 0;
        border-radius: 6px;
        background: #0d1117;
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

        .option-item.correct-option {
            background: rgba(152,195,121,0.1);
            border-color: var(--success-color);
            color: var(--success-color);
        }

        .option-item.selected-wrong {
            background: rgba(224,108,117,0.1);
            border-color: var(--danger-color);
            color: var(--danger-color);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-outline-light:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-light);
            border-color: var(--text-muted);
        }

    .badge-status {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 4px;
        display: inline-block;
        letter-spacing: 1px;
    }

    .badge-success {
        background: rgba(152,195,121,0.15);
        color: var(--success-color);
        border: 1px solid rgba(152,195,121,0.4);
    }

    .badge-danger {
        background: rgba(224,108,117,0.15);
        color: var(--danger-color);
        border: 1px solid rgba(224,108,117,0.4);
    }

    .badge-warning {
        background: rgba(229,192,123,0.15);
        color: var(--warning-color);
        border: 1px solid rgba(229,192,123,0.4);
    }
</style>

<div class="full-page-wrapper">
    <div class="page-container">
        <div class="page-header">
            <div class="header-text">
                <h1>ДЕТАЛИ ТЕСТИРОВАНИЯ</h1>
                <p>Информационно-аналитический департамент // Отчет системы</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <!-- Кнопка скачивания теперь в стиле btn-outline-light -->
                <button class="btn-outline-light" @onclick="DownloadWordReport">
                    <RadzenIcon Icon="file_download" Style="margin-right: 5px;" /> СКАЧАТЬ ОТЧЕТ В WORD
                </button>
                <button class="btn-outline-light" @onclick="GoBack">
                    <RadzenIcon Icon="arrow_back" Style="margin-right: 5px;" /> НАЗАД К УПРАВЛЕНИЮ
                </button>
            </div>
        </div>

        @if (progress == null)
        {
            <div class="text-center" style="padding: 80px 20px;">
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color); height: 6px;" />
                <p style="color: var(--accent-cyan); margin-top: 15px; font-size: 0.9rem; font-weight: bold; letter-spacing: 2px;">ЗАГРУЗКА ДАННЫХ...</p>
            </div>
        }
        else
        {
            <div class="cyber-shell">
                <div class="cyber-shell-header">
                    <div class="shell-title">
                        <RadzenIcon Icon="quiz" Style="font-size: 1.2rem;" />
                        SYS.ADMIN_TERMINAL // TEST_REPORT
                    </div>
                    <div class="shell-status">
                        <span class="status-dot"></span>
                        ONLINE
                    </div>
                </div>

                <div class="cyber-shell-body">
                    <h3 style="color: var(--accent-light-blue); margin-bottom: 25px; font-weight: 800; text-transform: uppercase;">
                        Попытка: @(test?.Title ?? "Тест")
                    </h3>

                    <div class="cyber-section">
                        <div class="info-grid">
                            <div class="info-item"><label>Пользователь</label><span>@userName</span></div>
                            <div class="info-item"><label>Сложность</label><span>@(test != null ? GetDifficultyText(test.Difficulty) : "—")</span></div>
                            <div class="info-item"><label>Статус</label><span>@(progress != null ? GetStatusText(progress.Status) : "—")</span></div>
                            <div class="info-item"><label>Начало</label><span>@(progress?.StartedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</span></div>
                            <div class="info-item"><label>Завершение</label><span>@(progress?.CompletedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</span></div>
                            <div class="info-item"><label>Результат</label><span style="color: var(--accent-cyan); font-size: 1.3rem;">@(progress?.Score ?? 0) / @(test?.Questions?.Count ?? 0) (@percentage%)</span></div>
                        </div>
                    </div>

                    <h4 style="color: var(--accent-cyan); margin-bottom: 20px; font-weight: 800; text-transform: uppercase;">
                        Вопросы и ответы (@userAnswers.Count(a => a.IsCorrect) из @questions.Count верно)
                    </h4>

                    @foreach (var q in questions)
                    {
                        var userAnswer = userAnswers.FirstOrDefault(a => a.QuestionId == q.Id);
                        var selectedIds = GetSelectedOptionIds(userAnswer);
                        var correctOptionIds = q.Options.Where(o => o.IsCorrect).Select(o => o.Id).ToList();
                        bool isCorrect = userAnswer?.IsCorrect ?? false;

                        <div class="question-card @(userAnswer == null ? "unanswered" : isCorrect ? "correct" : "wrong")">
                            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                                <h5 style="color: var(--text-light); margin: 0; font-weight: 700; line-height: 1.4;">Вопрос @(questions.IndexOf(q) + 1): @q.Text</h5>
                                @if (userAnswer != null)
                                {
                                    <span class="badge-status @(isCorrect ? "badge-success" : "badge-danger")">@(isCorrect ? "ВЕРНО" : "НЕВЕРНО")</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-warning">НЕ ОТВЕЧЕНО</span>
                                }
                            </div>

                            <div style="margin-top: 15px;">
                                @if (q.Type == QuestionType.ManualText)
                                {
                                    <div style="display: flex; flex-direction: column; gap: 15px;">
                                        <div>
                                            <span style="color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; font-weight: bold;">Ответ пользователя:</span>
                                            <div style="margin-top: 5px; padding: 12px 15px; border-radius: 6px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: @(isCorrect ? "var(--success-color)" : "var(--danger-color)"); font-family: monospace; font-size: 1.05rem;">
                                                @(string.IsNullOrWhiteSpace(userAnswer?.SelectedAnswer) ? "— [Пустой ответ] —" : userAnswer.SelectedAnswer)
                                            </div>
                                        </div>
                                        <div>
                                            <span style="color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; font-weight: bold;">Правильный ответ:</span>
                                            <div style="margin-top: 5px; padding: 12px 15px; border-radius: 6px; background: rgba(152,195,121,0.05); border: 1px solid var(--success-color); color: var(--success-color); font-family: monospace; font-size: 1.05rem;">
                                                @(string.IsNullOrWhiteSpace(q.CorrectTextAnswer) ? "— [Не задан] —" : q.CorrectTextAnswer)
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var opt in q.Options)
                                    {
                                        string cssClass = "option-item";
                                        string indicator = "";

                                        if (correctOptionIds.Contains(opt.Id))
                                        {
                                            cssClass += " correct-option";
                                            indicator = " ✓ (правильный ответ)";
                                        }
                                        if (selectedIds.Contains(opt.Id) && !correctOptionIds.Contains(opt.Id))
                                        {
                                            cssClass += " selected-wrong";
                                            indicator = " ✗ (выбран ошибочно)";
                                        }
                                        else if (selectedIds.Contains(opt.Id) && correctOptionIds.Contains(opt.Id))
                                        {
                                            indicator = " ✓ (выбран верно)";
                                        }

                                        <div class="@cssClass">
                                            <span style="flex-grow: 1;">@opt.Text</span>
                                            <span style="font-weight: bold; font-size: 0.85rem;">@indicator</span>
                                        </div>
                                    }
                                }
                            </div>

                            @if (userAnswer != null)
                            {
                                <div style="margin-top: 15px; font-size: 0.85rem; color: var(--text-muted); font-family: monospace; border-top: 1px dashed var(--border-color); padding-top: 10px;">
                                    Время ответа: @userAnswer.AnsweredAt.ToString("dd.MM.yyyy HH:mm:ss")
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int ProgressId { get; set; }

    private UserTestProgress? progress;
    private CyberTest? test;
    private List<TestQuestion> questions = new();
    private List<UserTestAnswer> userAnswers = new();
    private string userName = "—";
    private int percentage = 0;

    protected override async Task OnInitializedAsync()
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        progress = await context.Set<UserTestProgress>()
            .Include(p => p.Test)
            .ThenInclude(t => t.Questions)
            .ThenInclude(q => q.Options)
            .FirstOrDefaultAsync(p => p.Id == ProgressId);

        if (progress != null)
        {
            test = progress.Test;
            questions = test?.Questions ?? new();
            userAnswers = await context.Set<UserTestAnswer>()
                .Where(a => a.UserTestProgressId == ProgressId)
                .ToListAsync();
            percentage = questions.Count > 0 ? (int)Math.Round((double)progress.Score / questions.Count * 100) : 0;

            if (!string.IsNullOrEmpty(progress.UserId))
            {
                var user = await context.Users.FindAsync(progress.UserId);
                if (user != null)
                {
                    // Собираем полное ФИО
                    string fullName = $"{user.LastName} {user.FirstName} {user.MiddleName}".Trim();
                    // Если ФИО не заполнено, откатываемся к логину
                    userName = string.IsNullOrWhiteSpace(fullName) ? user.UserName ?? "Неизвестно" : fullName;
                }
            }
        }
    }

    // Метод для чистого парсинга вариантов выбора из БД
    private List<int> GetSelectedOptionIds(UserTestAnswer? answer)
    {
        if (answer == null || string.IsNullOrWhiteSpace(answer.SelectedAnswer))
            return new List<int>();

        // SelectedAnswer хранит ID вариантов через запятую, парсим их:
        return answer.SelectedAnswer
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(id => int.TryParse(id.Trim(), out int parsed) ? parsed : -1)
            .Where(id => id > 0)
            .ToList();
    }
    private async Task DownloadWordReport()
    {
        // 1. Генерируем HTML-разметку под стандарты Word
        var htmlContent = BuildWordReportHtml();

        // 2. Формируем имя файла (убираем пробелы из ФИО)
        var safeUserName = userName.Replace(" ", "_");
        var fileName = $"Отчет_{safeUserName}_{DateTime.Now:ddMMyyyy}.doc";

        // 3. Отправляем в наш JS-скрипт на скачивание
        await JS.InvokeVoidAsync("downloadFileFromBlob", fileName, htmlContent);
    }

    private string BuildWordReportHtml()
    {
        var sb = new System.Text.StringBuilder();

        // Специфичные теги, которые говорят Ворду "открой меня красиво"
        sb.AppendLine("<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>");
        sb.AppendLine("<head><meta charset='utf-8'><title>Отчет по тестированию</title></head>");
        sb.AppendLine("<body style='font-family: \"Times New Roman\", Times, serif; font-size: 14pt;'>");

        // Шапка отчета
        sb.AppendLine($"<h2 style='text-align:center;'>Отчет о результатах тестирования</h2>");
        sb.AppendLine($"<h3 style='text-align:center;'>{test?.Title}</h3>");
        sb.AppendLine("<hr/>");

        // Основная статистика
        sb.AppendLine($"<p><b>ФИО (Пользователь):</b> {userName}</p>");
        sb.AppendLine($"<p><b>Время начала:</b> {(progress?.StartedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")}</p>");
        sb.AppendLine($"<p><b>Время завершения:</b> {(progress?.CompletedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")}</p>");
        sb.AppendLine($"<p><b>Количество верных ответов:</b> {userAnswers.Count(a => a.IsCorrect)} из {questions.Count}</p>");
        sb.AppendLine($"<p><b>Точность выполнения:</b> {percentage}%</p>");
        sb.AppendLine("<hr/><br/>");

        // Вывод всех вопросов
        for (int i = 0; i < questions.Count; i++)
        {
            var q = questions[i];
            var userAnswer = userAnswers.FirstOrDefault(a => a.QuestionId == q.Id);
            var selectedIds = GetSelectedOptionIds(userAnswer);
            var correctOptionIds = q.Options.Where(o => o.IsCorrect).Select(o => o.Id).ToList();
            bool isCorrect = userAnswer?.IsCorrect ?? false;

            string statusColor = isCorrect ? "green" : "red";
            string statusText = isCorrect ? "ВЕРНО" : "НЕВЕРНО";

            sb.AppendLine($"<p style='margin-bottom: 5px;'><b>Вопрос {i + 1}:</b> {q.Text}</p>");
            sb.AppendLine($"<p style='margin-top: 0;'><b>Статус:</b> <span style='color:{statusColor}; font-weight:bold;'>{statusText}</span></p>");

            if (q.Type == QuestionType.ManualText)
            {
                string userText = string.IsNullOrWhiteSpace(userAnswer?.SelectedAnswer) ? "— [Ответ не предоставлен] —" : userAnswer.SelectedAnswer;
                string correctText = string.IsNullOrWhiteSpace(q.CorrectTextAnswer) ? "— [Эталон не задан] —" : q.CorrectTextAnswer;

                sb.AppendLine($"<p>Ответ пользователя: <span style='color:blue;'>{userText}</span></p>");
                sb.AppendLine($"<p>Правильный ответ: <span style='color:green;'>{correctText}</span></p>");
            }
            else
            {
                sb.AppendLine("<ul style='list-style-type: none; padding-left: 0;'>");
                foreach (var opt in q.Options)
                {
                    string mark = "";
                    if (correctOptionIds.Contains(opt.Id))
                        mark += " &nbsp;&nbsp;<b><span style='color:green;'>[ПРАВИЛЬНЫЙ ОТВЕТ]</span></b>";
                    if (selectedIds.Contains(opt.Id))
                        mark += " &nbsp;&nbsp;<b><span style='color:blue;'>[ВЫБРАНО ПОЛЬЗОВАТЕЛЕМ]</span></b>";

                    // Добавляем чекбоксы для красоты
                    string checkbox = selectedIds.Contains(opt.Id) ? "☑" : "☐";

                    sb.AppendLine($"<li style='margin-bottom: 5px;'>{checkbox} {opt.Text} {mark}</li>");
                }
                sb.AppendLine("</ul>");
            }
            sb.AppendLine("<br/>"); // Отступ между вопросами
        }

        sb.AppendLine("</body></html>");
        return sb.ToString();
    }
    // Перевод уровней сложности на русский
    private string GetDifficultyText(TestDifficulty diff) => diff switch
    {
        TestDifficulty.Easy => "Легкий",
        TestDifficulty.Medium => "Средний",
        TestDifficulty.Hard => "Сложный",
        _ => "Неизвестно"
    };

    // Перевод статуса попытки на русский
    private string GetStatusText(AttemptStatus status) => status switch
    {
        AttemptStatus.NotStarted => "Не начато",
        AttemptStatus.InProgress => "В процессе",
        AttemptStatus.Completed => "Выполнено",
        AttemptStatus.Failed => "Провалено",
        _ => "Неизвестно"
    };
    private void GoBack()
    {
        NavigationManager.NavigateTo("/admin");
    }
}