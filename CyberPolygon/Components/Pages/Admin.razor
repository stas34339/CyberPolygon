@page "/admin"
@using CyberPolygon.Data
@using CyberPolygon.Services
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

@* ЗАЩИТА: На эту страницу зайдет только Администратор *@
@attribute [Authorize(Roles = "Admin")]

@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject UserManagementService UserManagementService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@rendermode InteractiveServer

<RadzenDialog />
<PageTitle>Панель управления | Киберполигон</PageTitle>

<style>
    /* ГЛОБАЛЬНЫЕ ЦВЕТА И СТИЛИ */
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --bg-input: #131924;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .cyber-card {
        background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-card-hover) 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .admin-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-muted);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--warning-color);
            box-shadow: 0 0 10px rgba(229, 192, 123, 0.5);
        }

    .tabs-navigation {
        display: flex;
        border-bottom: 2px solid var(--border-color);
        margin-bottom: 25px;
        gap: 5px;
        flex-wrap: wrap;
    }

    .tab-trigger {
        background: transparent;
        border: none;
        padding: 12px 24px;
        color: var(--text-muted);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .tab-trigger:hover {
            color: var(--text-light);
        }

        .tab-trigger.active {
            color: var(--warning-color);
            border-bottom: 2px solid var(--warning-color);
        }

    .section-title {
        color: var(--warning-color);
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 0.5px;
    }

    .cyber-label {
        color: var(--accent-cyan);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
        display: block;
        font-weight: 600;
    }

    /* Кнопки */
    .btn-primary-gradient {
        background: linear-gradient(135deg, var(--warning-color) 0%, #d4a373 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 25px rgba(229, 192, 123, 0.4);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-outline-light:hover {
            background: rgba(255,255,255,0.05);
        }

    .btn-icon-danger {
        background: transparent;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.3);
        padding: 4px 6px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
    }

        .btn-icon-danger:hover {
            background: rgba(224, 108, 117, 0.1);
            border-color: var(--danger-color);
        }

    .btn-detail {
        background: transparent;
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.3);
        padding: 5px 10px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .btn-detail:hover {
            background: rgba(78, 195, 209, 0.1);
            border-color: var(--accent-cyan);
        }

    /* Таблицы */
    ::deep .rz-datagrid {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 8px !important;
    }

    ::deep .rz-grid-table thead th {
        background-color: #1a1d21 !important;
        color: var(--warning-color) !important;
        border-bottom: 1px solid var(--border-color) !important;
        border-right: 1px solid var(--border-color) !important;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    ::deep .rz-grid-table tbody tr {
        background-color: transparent !important;
        color: var(--text-muted) !important;
    }

        ::deep .rz-grid-table tbody tr:hover {
            background-color: var(--bg-card-hover) !important;
        }

    ::deep .rz-grid-table td {
        border-bottom: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-right: 1px solid var(--border-color) !important;
        padding: 10px !important;
    }

    ::deep .rz-pager {
        background-color: #1a1d21 !important;
        border-top: 1px solid var(--border-color) !important;
        color: var(--text-muted) !important;
    }

    /* Поля ввода и выпадающие списки */
    .dark-input, .rz-dropdown {
        background-color: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
    }

    .rz-dropdown-panel {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 6px !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
    }

        .rz-dropdown-item:hover {
            background-color: var(--bg-card-hover) !important;
            color: var(--warning-color) !important;
        }

    .status-badge-mini {
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .status-in-progress {
        background: rgba(78, 195, 209, 0.15);
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.4);
    }

    .status-completed {
        background: rgba(152, 195, 121, 0.15);
        color: var(--success-color);
        border: 1px solid rgba(152, 195, 121, 0.4);
    }

    .status-failed {
        background: rgba(224, 108, 117, 0.15);
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.4);
    }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 25px;
        margin-bottom: 25px;
    }

    .admin-row {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .admin-row-input {
        flex: 1;
        min-width: 0;
    }

    .admin-row-btn {
        flex-shrink: 0;
    }

    .loading-container {
        text-align: center;
        padding: 80px 20px;
    }
</style>

<div class="admin-container">
    @if (!isLoaded)
    {
        <div class="loading-container">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color); width: 300px; margin: 0 auto;" />
        </div>
    }
    else
    {
        <div class="page-header">
            <RadzenIcon Icon="admin_panel_settings" Style="color: var(--warning-color); font-size: 2.5rem;" />
            <h2 style="color: var(--warning-color); margin: 0; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Панель администратора</h2>
        </div>

        <div class="tabs-navigation">
            <button class="tab-trigger @(activeTabIndex == 0 ? "active" : "")" @onclick="() => activeTabIndex = 0"><RadzenIcon Icon="history" /> УПРАВЛЕНИЕ АКАДЕМИЕЙ</button>
            <button class="tab-trigger @(activeTabIndex == 1 ? "active" : "")" @onclick="() => activeTabIndex = 1"><RadzenIcon Icon="people" /> ПОЛЬЗОВАТЕЛИ</button>
        </div>

        @if (activeTabIndex == 0)
        {
            <div class="cyber-card" style="margin-bottom: 25px;">
                <h4 class="section-title"><RadzenIcon Icon="history" /> Активность в сценариях (Все)</h4>
                @if (!allScenarioProgressList.Any())
                {
                    <div class="text-center py-4 text-muted"><RadzenIcon Icon="cloud_off" Style="font-size: 2rem; color: var(--border-color);" /><br />Нет попыток</div>
                }
                else
                {
                    <RadzenDataGrid Data="@allScenarioProgressList" TItem="UserScenarioProgress" AllowPaging="true" PageSize="10">
                        <Columns>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="АГЕНТ/КОМАНДА" Width="180px">
                                <Template Context="data">
                                    @if (data.IsTeamAttempt)
                                    {
                                        <span style="color: var(--accent-blue);">👥 @(teamsList.FirstOrDefault(t => t.Id == data.TeamId)?.Name ?? "Команда")</span>
                                    }
                                    else
                                    {
                                        var usr = usersList.FirstOrDefault(u => u.Id == data.UserId);
                                        <span style="color: var(--text-light);">👤 @GetUserDisplayName(usr)</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="СЦЕНАРИЙ" Width="200px">
                                <Template Context="data"><span style="color: var(--text-light); font-weight: 500;">@(data.Scenario?.Title ?? "—")</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="СТАТУС" Width="120px" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    @switch (data.Status)
                                    {
                                        case AttemptStatus.InProgress:
                                            <span class="status-badge-mini status-in-progress">В процессе</span>
                                            break;
                                        case AttemptStatus.Completed:

                                            <span class="status-badge-mini status-completed">Завершен</span>
                                            break;
                                        case AttemptStatus.Failed:

                                            <span class="status-badge-mini status-failed">Неудача</span>
                                            break;
                                        default:

                                            <span class="status-badge-mini" style="background: rgba(143,160,181,0.15); color: var(--text-muted); border: 1px solid var(--border-color);">@data.Status</span>
                                            break;
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="XP" Width="80px" TextAlign="TextAlign.Center">
                                <Template Context="data"><span style="color: var(--accent-cyan); font-weight: bold;">@data.Score</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="ДАТА" Width="140px" TextAlign="TextAlign.Center">
                                <Template Context="data"><span style="font-size: 0.85rem;">@(data.StartedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="" Width="120px" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    <button class="btn-detail" @onclick="@(() => NavigationManager.NavigateTo($"/admin/scenario-attempt/{data.Id}"))"><RadzenIcon Icon="visibility" style="font-size: 0.9rem;" /> Детали</button>
                                    <button class="btn-primary-gradient" style="background: #e06c75; font-size: 0.7rem; padding: 4px 8px; margin-left: 4px;" @onclick="@(() => ResetScenarioProgress(data.Id))" title="Сбросить попытку"><RadzenIcon Icon="refresh" style="font-size: 0.8rem;" /></button>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>

            <div class="cyber-card" style="margin-bottom: 25px;">
                <h4 class="section-title"><RadzenIcon Icon="assignment" /> Активность в тестах (Все)</h4>
                @if (!allTestProgressList.Any())
                {
                    <div class="text-center py-4 text-muted"><RadzenIcon Icon="cloud_off" Style="font-size: 2rem; color: var(--border-color);" /><br />Нет попыток</div>
                }
                else
                {
                    <RadzenDataGrid Data="@allTestProgressList" TItem="UserTestProgress" AllowPaging="true" PageSize="10">
                        <Columns>
                            <RadzenDataGridColumn TItem="UserTestProgress" Title="ПОЛЬЗОВАТЕЛЬ" Width="180px">
                                <Template Context="data"><span style="color: var(--text-light);">👤 @GetUserDisplayName(usersList.FirstOrDefault(u => u.Id == data.UserId))</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserTestProgress" Title="ТЕСТ" Width="200px">
                                <Template Context="data"><span style="color: var(--text-light); font-weight: 500;">@(data.Test?.Title ?? "—")</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserTestProgress" Title="СЛОЖНОСТЬ" Width="100px" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    @{
                                        var d = data.Test?.Difficulty;
                                        var dt = d switch { TestDifficulty.Easy => "Лёгкий", TestDifficulty.Medium => "Средний", TestDifficulty.Hard => "Сложный", _ => "—" };
                                        var dc = d switch { TestDifficulty.Easy => "var(--success-color)", TestDifficulty.Medium => "var(--warning-color)", TestDifficulty.Hard => "var(--danger-color)", _ => "var(--text-muted)" };
                                    }
                                    <span style="color: @dc;">@dt</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserTestProgress" Title="СТАТУС" Width="120px" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    @switch (data.Status)
                                    {
                                        case AttemptStatus.InProgress:
                                            <span class="status-badge-mini status-in-progress">В процессе</span>
                                            break;
                                        case AttemptStatus.Completed:

                                            <span class="status-badge-mini status-completed">Завершен</span>
                                            break;
                                        case AttemptStatus.Failed:

                                            <span class="status-badge-mini status-failed">Неудача</span>
                                            break;
                                        default:

                                            <span class="status-badge-mini" style="background: rgba(143,160,181,0.15); color: var(--text-muted); border: 1px solid var(--border-color);">@data.Status</span>
                                            break;
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserTestProgress" Title="РЕЗУЛЬТАТ" Width="100px" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    @{
                                        var tq = data.Test?.Questions?.Count ?? 0;
                                    }
                                    <span style="color: var(--accent-cyan); font-weight: bold;">@data.Score/@tq</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserTestProgress" Title="" Width="120px" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    <button class="btn-detail" @onclick="@(() => NavigationManager.NavigateTo($"/admin/test-attempt/{data.Id}"))"><RadzenIcon Icon="visibility" style="font-size: 0.9rem;" /> Детали</button>
                                    <button class="btn-primary-gradient" style="background: #e06c75; font-size: 0.7rem; padding: 4px 8px; margin-left: 4px;" @onclick="@(() => ResetTestProgress(data.Id))" title="Сбросить попытку"><RadzenIcon Icon="refresh" style="font-size: 0.8rem;" /></button>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>

            <div class="admin-grid">
                <div class="cyber-card">
                    <h4 class="section-title"><RadzenIcon Icon="lan" /> Управление подразделениями</h4>
                    <div class="admin-row mb-3">
                        <div class="admin-row-input"><RadzenTextBox @bind-Value="@newGroupName" Placeholder="Название подразделения" class="w-100 dark-input" /></div>
                        <div class="admin-row-btn"><button class="btn-primary-gradient" @onclick="CreateGroup"><RadzenIcon Icon="add" /> Добавить</button></div>
                    </div>
                    <RadzenDataGrid Data="@groupsList" TItem="UserGroup" Height="200px">
                        <Columns>
                            <RadzenDataGridColumn TItem="UserGroup" Property="Name" Title="ПОДРАЗДЕЛЕНИЕ" />
                            <RadzenDataGridColumn TItem="UserGroup" Title="" Width="60px" TextAlign="TextAlign.Center">
                                <Template Context="grp"><button class="btn-icon-danger" @onclick="@(async () => await DeleteGroup(grp.Id))"><RadzenIcon Icon="delete" style="font-size: 1rem;" /></button></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
                <div class="cyber-card">
                    <h4 class="section-title"><RadzenIcon Icon="groups" /> Управление командами</h4>
                    <div class="mb-2"><RadzenDropDown TValue="int" Data="@groupsList" TextProperty="Name" ValueProperty="Id" @bind-Value="@selectedGroupIdForTeam" Placeholder="Выберите подразделение" style="width: 100%;" class="dark-input" /></div>
                    <div class="admin-row mb-3">
                        <div class="admin-row-input"><RadzenTextBox @bind-Value="@newTeamName" Placeholder="Название команды" class="w-100 dark-input" /></div>
                        <div class="admin-row-btn"><button class="btn-primary-gradient" style="background: linear-gradient(135deg, #98c379 0%, #7ec8f8 100%);" @onclick="CreateTeam"><RadzenIcon Icon="group_add" /> Создать</button></div>
                    </div>
                    <RadzenDataGrid Data="@teamsList" TItem="UserTeam" Height="150px">
                        <Columns>
                            <RadzenDataGridColumn TItem="UserTeam" Title="КОМАНДА">
                                <Template Context="t"><span style="color: var(--text-light); font-weight: 500;">@t.Name</span><br /><span style="font-size:0.75rem;color:var(--text-muted);">@t.Group.Name</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserTeam" Title="" Width="60px" TextAlign="TextAlign.Center">
                                <Template Context="tm"><button class="btn-icon-danger" @onclick="@(async () => await DeleteTeam(tm.Id))"><RadzenIcon Icon="delete" style="font-size: 1rem;" /></button></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </div>

            <div class="cyber-card">
                <h4 class="section-title"><RadzenIcon Icon="assignment_ind" /> Распределение агентов по командам</h4>
                <RadzenDataGrid Data="@usersList" TItem="ApplicationUser" AllowPaging="true" PageSize="10">
                    <Columns>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="АГЕНТ" Width="180px">
                            <Template Context="u"><span style="color: var(--text-light);">@GetUserDisplayName(u)</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="ПОДРАЗДЕЛЕНИЕ" Width="220px">
                            <Template Context="usr">
                                <RadzenDropDown TValue="int?" Data="@groupsList" TextProperty="Name" ValueProperty="Id" Value="@usr.GroupId" Change="@(async (args) => await UpdateUserGroup(usr.Id, args != null ? (int?)Convert.ToInt32(args) : null))" Placeholder="Нет подразделения" AllowClear="true" style="width: 100%;" class="dark-input" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="КОМАНДЫ" Width="120px" TextAlign="TextAlign.Center">
                            <Template Context="usr">
                                <button class="btn-primary-gradient" style="font-size: 0.78rem; padding: 5px 10px; background: rgba(78, 195, 209, 0.2); border: 1px solid var(--accent-cyan); color: var(--text-light);" @onclick="@(() => OpenTeamAssignmentModal(usr))"><RadzenIcon Icon="settings" style="font-size: 0.9rem;" /> Состав</button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
        else if (activeTabIndex == 1)
        {
            <div class="cyber-card" style="margin-bottom: 25px;">
                <h4 class="section-title"><RadzenIcon Icon="person_add" /> Создание нового пользователя</h4>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="cyber-label">Логин (Email)</label>
                        <RadzenTextBox @bind-Value="@newUserModel.Login" class="w-100 dark-input" Placeholder="user@polygon.do" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="cyber-label">Пароль</label>
                        <RadzenTextBox @bind-Value="@newUserModel.Password" type="password" class="w-100 dark-input" Placeholder="Минимум 6 символов" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="cyber-label">Фамилия</label>
                        <RadzenTextBox @bind-Value="@newUserModel.LastName" class="w-100 dark-input" Placeholder="Иванов" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="cyber-label">Имя</label>
                        <RadzenTextBox @bind-Value="@newUserModel.FirstName" class="w-100 dark-input" Placeholder="Иван" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="cyber-label">Отчество</label>
                        <RadzenTextBox @bind-Value="@newUserModel.MiddleName" class="w-100 dark-input" Placeholder="Иванович" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="d-flex align-items-center gap-3" style="height: 37px;">
                            <RadzenCheckBox @bind-Value="@newUserModel.IsAdmin" />
                            <span style="color: var(--text-light);">Выдать права Администратора</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3 text-end">
                        <button class="btn-primary-gradient" @onclick="CreateUser">
                            <RadzenIcon Icon="person_add" /> Создать пользователя
                        </button>
                    </div>
                </div>
            </div>

            <div class="cyber-card">
                <h4 class="section-title"><RadzenIcon Icon="people" /> База данных пользователей (@usersList.Count)</h4>
                <RadzenDataGrid Data="@usersList" TItem="ApplicationUser" AllowPaging="true" PageSize="15">
                    <Columns>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="ЛОГИН" Width="200px">
                            <Template Context="u"><span style="color: var(--accent-light-blue);">@u.UserName</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="ФИО" Width="220px">
                            <Template Context="u"><span style="color: var(--text-light);">@GetUserDisplayName(u)</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="РОЛЬ" Width="120px" TextAlign="TextAlign.Center">
                            <Template Context="u">
                                @if (adminUserIds.Contains(u.Id))
                                {
                                    <span class="status-badge-mini status-completed">Админ</span>
                                }
                                else
                                {

                                    <span style="color: var(--text-muted);">Оперативник</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="ПОДРАЗДЕЛЕНИЕ" Width="150px">
                            <Template Context="u"><span style="color: var(--text-muted);">@(u.Group?.Name ?? "—")</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="" Width="120px" TextAlign="TextAlign.Center">
                            <Template Context="u">
                                <button class="btn-detail" style="margin-right: 6px;" @onclick="@(() => ToggleAdminRole(u.Id))" title="Сменить роль"><RadzenIcon Icon="swap_horiz" style="font-size: 0.9rem;" /> Роль</button>
                                <button class="btn-icon-danger" @onclick="@(() => DeleteUser(u.Id))" title="Удалить"><RadzenIcon Icon="delete" style="font-size: 0.9rem;" /></button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    }
</div>

@if (showTeamModal && selectedUserForTeams != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); backdrop-filter: blur(6px); display: flex; justify-content: center; align-items: center; z-index: 9999;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; width: 500px; padding: 25px; box-shadow: 0 0 40px rgba(91, 163, 227, 0.2);">
            <h4 style="color: var(--accent-light-blue); margin: 0 0 10px 0;">Команды агента</h4>
            <p style="color: var(--text-light); font-weight: bold; margin-bottom: 5px;">@GetUserDisplayName(selectedUserForTeams)</p>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 20px;">Отметьте команды, в которых состоит этот оперативник (в рамках его подразделения).</p>
            @{
                var availableTeams = selectedUserForTeams.GroupId != null ? teamsList.Where(t => t.GroupId == selectedUserForTeams.GroupId).ToList() : teamsList;
            }
            <div style="max-height: 250px; overflow-y: auto; background: var(--bg-main); border: 1px solid var(--border-color); padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                @if (!availableTeams.Any())
                {
                    <div class="text-danger">В подразделении этого агента пока нет команд.</div>
                }
                @foreach (var team in availableTeams)
                {
                    var isChecked = selectedUserForTeams.Teams != null && selectedUserForTeams.Teams.Any(t => t.Id == team.Id);
                    <div style="display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border-color);">
                        <RadzenCheckBox TValue="bool" Value="@isChecked" Change="@(async (val) => await ToggleTeamAssignment(selectedUserForTeams.Id, team.Id, val))" />
                        <span style="color: var(--text-light);">@team.Name</span>
                    </div>
                }
            </div>
            <div class="text-right"><button class="btn-outline-light" @onclick="CloseTeamAssignmentModal">Закрыть</button></div>
        </div>
    </div>
}

@code {
    private int activeTabIndex = 0; private bool isLoaded = false;

    // Списки данных
    private List<UserGroup> groupsList = new();
    private List<UserTeam> teamsList = new();
    private List<ApplicationUser> usersList = new();
    private List<UserScenarioProgress> allScenarioProgressList = new();
    private List<UserTestProgress> allTestProgressList = new();

    // Переменные состояния
    private HashSet<string> adminUserIds = new();
    private bool showTeamModal = false;
    private ApplicationUser? selectedUserForTeams;
    private string newGroupName = "";
    private string newTeamName = "";
    private int selectedGroupIdForTeam;
    private UserCreationModel newUserModel = new();

    public class UserCreationModel { public string Login { get; set; } = string.Empty; public string Password { get; set; } = string.Empty; public string FirstName { get; set; } = string.Empty; public string LastName { get; set; } = string.Empty; public string MiddleName { get; set; } = string.Empty; public bool IsAdmin { get; set; } }

    private string GetUserDisplayName(ApplicationUser? u)
    {
        if (u == null) return "Неизвестный агент";
        var name = $"{u.LastName} {u.FirstName} {u.MiddleName}".Trim();
        return string.IsNullOrWhiteSpace(name) ? (u.UserName ?? "Агент") : name;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAdminData();
        isLoaded = true;
    }

    private async Task LoadAdminData()
    {
        using var c = await ContextFactory.CreateDbContextAsync();

        groupsList = await c.UserGroups.ToListAsync();
        teamsList = await c.UserTeams.Include(t => t.Group).ToListAsync();
        usersList = await c.Set<ApplicationUser>().Include(u => u.Group).Include(u => u.Teams).ToListAsync();

        allScenarioProgressList = await c.UserProgresses.Include(p => p.Scenario).OrderByDescending(p => p.StartedAt).ToListAsync();
        allTestProgressList = await c.Set<UserTestProgress>().Include(tp => tp.Test).OrderByDescending(tp => tp.StartedAt).ToListAsync();

        adminUserIds.Clear();
        foreach (var u in usersList)
        {
            if (await UserManagementService.IsUserAdminAsync(u.Id))
                adminUserIds.Add(u.Id);
        }
    }

    private void OpenTeamAssignmentModal(ApplicationUser u) { selectedUserForTeams = u; showTeamModal = true; }
    private void CloseTeamAssignmentModal() { showTeamModal = false; selectedUserForTeams = null; }

    private async Task ToggleTeamAssignment(string uid, int tid, bool assign)
    {
        using var c = await ContextFactory.CreateDbContextAsync();
        var u = await c.Set<ApplicationUser>().Include(usr => usr.Teams).FirstOrDefaultAsync(usr => usr.Id == uid);
        var t = await c.UserTeams.FindAsync(tid);

        if (u != null && t != null)
        {
            if (assign && !u.Teams.Any(x => x.Id == tid)) u.Teams.Add(t);
            else if (!assign) { var tr = u.Teams.FirstOrDefault(x => x.Id == tid); if (tr != null) u.Teams.Remove(tr); }
            await c.SaveChangesAsync();
            await LoadAdminData();
            if (selectedUserForTeams?.Id == uid) selectedUserForTeams = usersList.FirstOrDefault(x => x.Id == uid);
        }
    }

    private async Task UpdateUserGroup(string uid, int? gid)
    {
        using var c = await ContextFactory.CreateDbContextAsync();
        var u = await c.Set<ApplicationUser>().FindAsync(uid);
        if (u != null) { u.GroupId = gid; await c.SaveChangesAsync(); }
        await LoadAdminData();
    }

    private async Task CreateGroup()
    {
        if (string.IsNullOrWhiteSpace(newGroupName)) return;
        using var c = await ContextFactory.CreateDbContextAsync();
        c.UserGroups.Add(new UserGroup { Name = newGroupName });
        await c.SaveChangesAsync(); newGroupName = ""; await LoadAdminData();
    }

    private async Task DeleteGroup(int id)
    {
        var ok = await DialogService.Confirm("Удалить подразделение?", "Удаление", new ConfirmOptions { OkButtonText = "Удалить", CancelButtonText = "Отмена" });
        if (ok == true)
        {
            using var c = await ContextFactory.CreateDbContextAsync(); var g = await c.UserGroups.FindAsync(id);
            if (g != null) { c.UserGroups.Remove(g); await c.SaveChangesAsync(); await LoadAdminData(); }
        }
    }

    private async Task CreateTeam()
    {
        if (string.IsNullOrWhiteSpace(newTeamName) || selectedGroupIdForTeam <= 0) return;
        using var c = await ContextFactory.CreateDbContextAsync();
        c.UserTeams.Add(new UserTeam { Name = newTeamName, GroupId = selectedGroupIdForTeam });
        await c.SaveChangesAsync(); newTeamName = ""; await LoadAdminData();
    }

    private async Task DeleteTeam(int id)
    {
        var ok = await DialogService.Confirm("Удалить команду?", "Удаление", new ConfirmOptions { OkButtonText = "Удалить", CancelButtonText = "Отмена" });
        if (ok == true)
        {
            using var c = await ContextFactory.CreateDbContextAsync(); var t = await c.UserTeams.FindAsync(id);
            if (t != null) { c.UserTeams.Remove(t); await c.SaveChangesAsync(); await LoadAdminData(); }
        }
    }

    private async Task ResetScenarioProgress(int id)
    {
        var ok = await DialogService.Confirm("Сбросить сессию сценария?", "Сброс", new ConfirmOptions { OkButtonText = "Сбросить", CancelButtonText = "Отмена" });
        if (ok == true)
        {
            using var c = await ContextFactory.CreateDbContextAsync(); var p = await c.UserProgresses.FindAsync(id);
            if (p != null) { c.UserProgresses.Remove(p); await c.SaveChangesAsync(); await LoadAdminData(); }
        }
    }

    private async Task ResetTestProgress(int id)
    {
        var ok = await DialogService.Confirm("Сбросить сессию теста?", "Сброс", new ConfirmOptions { OkButtonText = "Сбросить", CancelButtonText = "Отмена" });
        if (ok == true)
        {
            using var c = await ContextFactory.CreateDbContextAsync(); var p = await c.Set<UserTestProgress>().FindAsync(id);
            if (p != null) { c.Set<UserTestProgress>().Remove(p); await c.SaveChangesAsync(); await LoadAdminData(); }
        }
    }

    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(newUserModel.Login) || string.IsNullOrWhiteSpace(newUserModel.Password))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Ошибка", "Логин и пароль обязательны"); return;
        }
        if (newUserModel.Password.Length < 6)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Ошибка", "Пароль должен содержать минимум 6 символов"); return;
        }
        var (success, error) = await UserManagementService.CreateUserAsync(
            newUserModel.Login, newUserModel.Password, newUserModel.FirstName, newUserModel.LastName, newUserModel.MiddleName, newUserModel.IsAdmin
        );
        if (success)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Успех", $"Пользователь {newUserModel.Login} создан");
            newUserModel = new UserCreationModel(); await LoadAdminData();
        }
        else { NotificationService.Notify(NotificationSeverity.Error, "Ошибка", error); }
    }

    private async Task DeleteUser(string userId)
    {
        var ok = await DialogService.Confirm("Удалить пользователя навсегда? Это действие необратимо.", "Удаление", new ConfirmOptions { OkButtonText = "Удалить", CancelButtonText = "Отмена" });
        if (ok == true)
        {
            var result = await UserManagementService.DeleteUserAsync(userId);
            if (result) { NotificationService.Notify(NotificationSeverity.Success, "Успех", "Пользователь удален"); await LoadAdminData(); }
            else { NotificationService.Notify(NotificationSeverity.Error, "Ошибка", "Не удалось удалить пользователя"); }
        }
    }

    private async Task ToggleAdminRole(string userId)
    {
        await UserManagementService.ToggleAdminRoleAsync(userId);
        await LoadAdminData();
        NotificationService.Notify(NotificationSeverity.Success, "Успех", "Роль пользователя изменена");
    }
}