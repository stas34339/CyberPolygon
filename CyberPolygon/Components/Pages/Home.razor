@page "/"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@using System.Security.Claims
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@rendermode InteractiveServer

<PageTitle>Главный терминал | Киберполигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .home-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-muted);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 20px 40px 20px;
    }

    .hero-section {
        text-align: center;
        padding: 60px 20px 70px 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
        margin-bottom: 50px;
    }

        .hero-section::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 15px rgba(78, 195, 209, 0.5);
        }

    .hero-title {
        color: var(--accent-light-blue);
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: 2px;
        margin: 20px 0 15px 0;
        text-transform: uppercase;
        text-shadow: 0 0 20px rgba(126, 200, 248, 0.3);
    }

    .hero-subtitle {
        color: var(--text-muted);
        font-size: 1.1rem;
        max-width: 800px;
        margin: 0 auto;
        line-height: 1.7;
    }

    .user-panel {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-left: 4px solid var(--accent-cyan);
        border-radius: 10px;
        padding: 25px 30px;
        margin-bottom: 50px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .user-info-title {
        color: var(--accent-light-blue);
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0;
    }

    .user-meta-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--accent-cyan);
        font-weight: 600;
        margin-bottom: 4px;
    }

    .user-meta-value {
        font-size: 1rem;
        color: var(--text-light);
        font-weight: 500;
    }

    .btn-outline {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-light);
        padding: 10px 22px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-outline:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 22px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(78, 195, 209, 0.2);
    }

        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
        }

    .btn-tests-gradient {
        background: linear-gradient(135deg, #7ec8f8 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 22px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(126, 200, 248, 0.2);
    }

        .btn-tests-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(126, 200, 248, 0.4);
        }

    .section-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
    }

        .section-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

        .section-header h2 {
            color: var(--accent-light-blue);
            font-size: 1.5rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin: 0;
        }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 25px;
        margin-bottom: 50px;
    }

    .cyber-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

        .cyber-card:hover {
            border-color: var(--accent-cyan);
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(78, 195, 209, 0.1);
        }

    .card-icon {
        font-size: 2.2rem;
        margin-bottom: 15px;
    }

    .card-title {
        color: var(--accent-light-blue);
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .card-text {
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0;
    }

    .interactive-card {
        cursor: pointer;
    }

        .interactive-card.active {
            border-color: var(--accent-cyan) !important;
            box-shadow: 0 0 20px rgba(78, 195, 209, 0.15) !important;
        }

    .interactive-detail {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px dashed var(--border-color);
        color: var(--accent-cyan);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .promo-section {
        background: linear-gradient(135deg, rgba(78, 195, 209, 0.03) 0%, rgba(91, 163, 227, 0.03) 100%);
        border: 1px solid rgba(78, 195, 209, 0.2);
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 50px;
        text-align: center;
    }

    .promo-section-icon {
        font-size: 3rem;
        color: var(--accent-cyan);
        margin-bottom: 15px;
    }

    .promo-section-title {
        color: var(--accent-light-blue);
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .promo-section-text {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        max-width: 700px;
        margin: 0 auto 20px auto;
    }

    .promo-features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .promo-feature-item {
        text-align: center;
    }

    .promo-feature-icon {
        font-size: 1.5rem;
        color: var(--accent-cyan);
        margin-bottom: 8px;
    }

    .promo-feature-title {
        color: var(--text-light);
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .promo-feature-text {
        color: var(--text-muted);
        font-size: 0.8rem;
        line-height: 1.4;
    }

    .threat-card {
        text-align: center;
        border-top: 3px solid var(--border-color);
    }

        .threat-card.network {
            border-top-color: var(--danger-color);
        }

        .threat-card.web {
            border-top-color: var(--warning-color);
        }

        .threat-card.forensics {
            border-top-color: var(--success-color);
        }

    .step-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(78, 195, 209, 0.1);
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.3);
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 15px;
    }

    .step-title {
        color: var(--accent-light-blue);
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .step-text {
        color: var(--text-muted);
        font-size: 0.85rem;
        line-height: 1.6;
        margin: 0;
    }

    .loading-container {
        text-align: center;
        padding: 80px 20px;
    }
</style>

<RadzenComponents />

<div class="home-container">
    <div class="hero-section">
        <RadzenIcon Icon="shield_lock" Style="font-size: 4rem; color: var(--accent-cyan);" />
        <h1 class="hero-title">ПЛАТФОРМА "КИБЕРПОЛИГОН"</h1>
        <p class="hero-subtitle">
            Практическое обучение сотрудников отдела обеспечения информационной безопасности на реалистичных симуляциях кибератак, рассмотрение и разбор инцидентов информационной безопасности.
        </p>
    </div>

    @if (isLoaded)
    {
        <div class="user-panel">
            <div class="row">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3">
                        <RadzenIcon Icon="admin_panel_settings" Style="font-size: 3rem; color: var(--accent-cyan);" />
                        <div>
                            <h3 class="user-info-title">@UserDisplayName</h3>
                            <div class="mt-3 d-flex flex-wrap gap-4">
                                <div>
                                    <div class="user-meta-label">Подразделение</div>
                                    <div class="user-meta-value">@(dbUser?.Group?.Name ?? "Не назначено")</div>
                                </div>
                                <div>
                                    <div class="user-meta-label">Боевая команда</div>
                                    <div class="user-meta-value">
                                        @if (dbUser?.Teams != null && dbUser.Teams.Any())
                                        {
                                            @string.Join(", ", dbUser.Teams.Select(t => t.Name))
                                        }
                                        else
                                        {
                                            <span>Личное участие</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end d-flex flex-column gap-2 justify-content-center">
                    <button class="btn-outline" @onclick="@(() => NavigationManager.NavigateTo("/scenario/28/workspace"))">
                        <RadzenIcon Icon="help_outline" /> Ознакомительный сценарий
                    </button>
                    <button class="btn-primary-gradient" @onclick="@(() => NavigationManager.NavigateTo("/scenario"))">
                        <RadzenIcon Icon="launch" /> Все сценарии
                    </button>
                    <button class="btn-tests-gradient" @onclick="@(() => NavigationManager.NavigateTo("/tests"))">
                        <RadzenIcon Icon="quiz" /> Тестовые задания
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="loading-container">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color);" />
        </div>
    }

    <div class="section-header">
        <h2>Боевые сценарии</h2>
    </div>

    <div class="promo-section">
        <div class="promo-section-icon">
            <RadzenIcon Icon="crisis_alert" />
        </div>
        <h3 class="promo-section-title">Практические симуляции кибератак</h3>
        <p class="promo-section-text">
            Отработка навыков защиты в условиях, максимально приближенных к реальным инцидентам. Проходите сценарии индивидуально или в составе команды.
        </p>

        <div class="promo-features">
            <div class="promo-feature-item">
                <div class="promo-feature-icon">
                    <RadzenIcon Icon="lan" />
                </div>
                <div class="promo-feature-title">Реалистичная инфраструктура</div>
                <div class="promo-feature-text">Виртуальные сети, серверы, рабочие станции и средства защиты</div>
            </div>
            <div class="promo-feature-item">
                <div class="promo-feature-icon">
                    <RadzenIcon Icon="groups" />
                </div>
                <div class="promo-feature-title">Командные и одиночные режимы</div>
                <div class="promo-feature-text">Синхронная работа подразделения или индивидуальная тренировка</div>
            </div>
            <div class="promo-feature-item">
                <div class="promo-feature-icon">
                    <RadzenIcon Icon="schedule" />
                </div>
                <div class="promo-feature-title">Контроль времени</div>
                <div class="promo-feature-text">Ограниченные по времени миссии с автоматическим завершением</div>
            </div>
            <div class="promo-feature-item">
                <div class="promo-feature-icon">
                    <RadzenIcon Icon="military_tech" />
                </div>
                <div class="promo-feature-title">Система XP и рейтинг</div>
                <div class="promo-feature-text">Начисление баллов за флаги, штрафы за ошибки, таблица лидеров</div>
            </div>
        </div>

        <button class="btn-primary-gradient" style="margin: 0 auto; padding: 14px 35px; font-size: 1rem;" @onclick="@(() => NavigationManager.NavigateTo("/scenario"))">
            <RadzenIcon Icon="launch" /> Перейти к сценариям
        </button>
    </div>

    <div class="section-header">
        <h2>Тестовые задания</h2>
    </div>

    <div class="promo-section">
        <div class="promo-section-icon">
            <RadzenIcon Icon="quiz" />
        </div>
        <h3 class="promo-section-title">Проверка теоретических знаний</h3>
        <p class="promo-section-text">
            Закрепите теоретическую базу перед практическими сценариями. Тестовые задания охватывают ключевые темы кибербезопасности и помогают систематизировать знания.
        </p>

        <div class="promo-features">
            <div class="promo-feature-item">
                <div class="promo-feature-icon">
                    <RadzenIcon Icon="school" />
                </div>
                <div class="promo-feature-title">Три уровня сложности</div>
                <div class="promo-feature-text">Начальный, средний и продвинутый — выбирайте под свой уровень подготовки</div>
            </div>
            <div class="promo-feature-item">
                <div class="promo-feature-icon">
                    <RadzenIcon Icon="timer" />
                </div>
                <div class="promo-feature-title">Ограничение по времени</div>
                <div class="promo-feature-text">Тренируйте скорость принятия решений в условиях ограниченного времени</div>
            </div>
            <div class="promo-feature-item">
                <div class="promo-feature-icon">
                    <RadzenIcon Icon="fact_check" />
                </div>
                <div class="promo-feature-title">Разные типы вопросов</div>
                <div class="promo-feature-text">Ручной ввод, одиночный и множественный выбор ответов</div>
            </div>
            <div class="promo-feature-item">
                <div class="promo-feature-icon">
                    <RadzenIcon Icon="trending_up" />
                </div>
                <div class="promo-feature-title">Отслеживание прогресса</div>
                <div class="promo-feature-text">Система запоминает начатые тесты и позволяет продолжить с места остановки</div>
            </div>
        </div>

        <button class="btn-primary-gradient" style="margin: 0 auto; padding: 14px 35px; font-size: 1rem;" @onclick="@(() => NavigationManager.NavigateTo("/tests"))">
            <RadzenIcon Icon="school" /> Перейти к тестовым заданиям
        </button>
    </div>

    <div class="section-header">
        <h2>Ключевые возможности</h2>
    </div>

    <div class="cards-grid" style="grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));">
        <div class="cyber-card interactive-card @(activeCard == 1 ? "active" : "")" @onclick="() => ToggleCard(1)">
            <div class="card-icon">
                <RadzenIcon Icon="layers" style="color: var(--accent-cyan);" />
            </div>
            <h4 class="card-title">Проработанные сценарии кибератак</h4>
            <p class="card-text">Инфраструктурные модели различной сложности для верификации навыков защиты.</p>
            @if (activeCard == 1)
            {
                <div class="interactive-detail">
                    <RadzenIcon Icon="done" /> Доступно: 12 актуальных векторов APT и симуляций.
                </div>
            }
        </div>

        <div class="cyber-card interactive-card @(activeCard == 2 ? "active" : "")" @onclick="() => ToggleCard(2)">
            <div class="card-icon">
                <RadzenIcon Icon="groups" style="color: var(--accent-cyan);" />
            </div>
            <h4 class="card-title">Командные и одиночные режимы</h4>
            <p class="card-text">Синхронное прохождение симуляций подразделением или точечная личная тренировка.</p>
            @if (activeCard == 2)
            {
                <div class="interactive-detail">
                    <RadzenIcon Icon="sync" /> Механизм реального времени: общий таймер и баланс очков сессии.
                </div>
            }
        </div>

        <div class="cyber-card interactive-card @(activeCard == 3 ? "active" : "")" @onclick="() => ToggleCard(3)">
            <div class="card-icon">
                <RadzenIcon Icon="insights" style="color: var(--accent-cyan);" />
            </div>
            <h4 class="card-title">Система рейтинга и XP</h4>
            <p class="card-text">Прозрачная оценка эффективности специалистов с учетом штрафов за ложные срабатывания.</p>
            @if (activeCard == 3)
            {
                <div class="interactive-detail">
                    <RadzenIcon Icon="military_tech" /> Обновление таблицы лидеров происходит автоматически при фиксации флага.
                </div>
            }
        </div>
    </div>

    <div class="section-header">
        <h2>Какие угрозы отрабатываем</h2>
    </div>

    <div class="cards-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
        <div class="cyber-card threat-card network">
            <RadzenIcon Icon="lan" style="font-size: 2.2rem; color: var(--danger-color); margin-bottom: 15px;" />
            <h4 class="card-title">Сетевые атаки</h4>
            <p class="card-text">Защита периметра, обнаружение вторжений, противодействие сканированию и эксплуатации сетевых уязвимостей.</p>
        </div>

        <div class="cyber-card threat-card web">
            <RadzenIcon Icon="code" style="font-size: 2.2rem; color: var(--warning-color); margin-bottom: 15px;" />
            <h4 class="card-title">Веб-уязвимости</h4>
            <p class="card-text">OAuth-атаки, XSS/CSRF, SQL-инъекции, SSRF — практическая отработка защиты веб-приложений.</p>
        </div>

        <div class="cyber-card threat-card forensics">
            <RadzenIcon Icon="find_in_page" style="font-size: 2.2rem; color: var(--success-color); margin-bottom: 15px;" />
            <h4 class="card-title">Расследования инцидентов</h4>
            <p class="card-text">Цифровая криминалистика, анализ логов, восстановление цепочки атаки и подготовка отчётов.</p>
        </div>
    </div>

    <div class="section-header">
        <h2>Первые шаги в Киберполигоне</h2>
    </div>

    <div class="cards-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
        <div class="cyber-card">
            <span class="step-badge">
                <RadzenIcon Icon="looks_one" /> Шаг 1
            </span>
            <h4 class="step-title">
                <RadzenIcon Icon="badge" style="color: var(--accent-cyan);" /> Перейдите в профиль
            </h4>
            <p class="step-text">Откройте личный кабинет и проверьте свою учётную запись. Узнайте, к какому подразделению вы прикреплены и входите ли в боевую команду. Это определит, какие сценарии вам доступны — одиночные или командные.</p>
        </div>

        <div class="cyber-card">
            <span class="step-badge">
                <RadzenIcon Icon="looks_two" /> Шаг 2
            </span>
            <h4 class="step-title">
                <RadzenIcon Icon="menu_book" style="color: var(--accent-cyan);" /> Перейдите в инструкции
            </h4>
            <p class="step-text">Ознакомьтесь с документацией платформы: как устроены симуляции, какие инструменты защиты интегрированы, как начисляются XP и формируется рейтинг. Понимание механики — залог успешного прохождения сценариев.</p>
        </div>

        <div class="cyber-card">
            <span class="step-badge">
                <RadzenIcon Icon="looks_3" /> Шаг 3
            </span>
            <h4 class="step-title">
                <RadzenIcon Icon="crisis_alert" style="color: var(--accent-cyan);" /> Выберите сценарий
            </h4>
            <p class="step-text">Перейдите в каталог симуляций. Доступны одиночные миссии для отработки личных навыков и командные операции для совместного отражения атак. Выбирайте сценарий под свою специализацию и начинайте тренировку.</p>
        </div>
    </div>
</div>

@code {
    private bool isLoaded = false;
    private string UserDisplayName = string.Empty;
    private ApplicationUser? dbUser;
    private int activeCard = 1;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userClaims = authState.User;

        if (userClaims.Identity?.IsAuthenticated == true)
        {
            var userId = userClaims.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                using var context = await ContextFactory.CreateDbContextAsync();
                dbUser = await context.Set<ApplicationUser>()
                    .Include(u => u.Group)
                    .Include(u => u.Teams)
                    .FirstOrDefaultAsync(u => u.Id == userId);

                UserDisplayName = dbUser?.Email ?? userClaims.Identity.Name ?? "Оперативник";
            }
        }
        else
        {
            UserDisplayName = "Гость полигона";
        }

        isLoaded = true;
    }

    private void ToggleCard(int cardId)
    {
        activeCard = cardId;
    }
}