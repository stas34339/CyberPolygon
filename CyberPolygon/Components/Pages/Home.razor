@page "/"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@using System.Security.Claims
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>КИБЕРПОЛИГОН - Главная</PageTitle>

<style>
    /* Строгая киберпанк-тема */
    :root {
        --bg-main: #0b0f17;
        --bg-card: #131924;
        --bg-card-hover: #1a2435;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
    }

    html, body {
        background-color: var(--bg-main) !important;
        margin: 0;
        padding: 0;
        color: var(--text-light);
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .home-container {
        background-color: var(--bg-main) !important;
        min-height: calc(100vh - 60px);
        width: 100%;
        padding: 50px 20px 70px;
        box-sizing: border-box;
    }

    .home-inner {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Логотип */
    .brand-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        margin-bottom: 40px;
        text-align: center;
    }

    .brand-logo-text {
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: 10px;
        color: var(--accent-cyan);
        text-transform: uppercase;
        margin: 0;
        text-shadow: 0 0 25px rgba(78, 195, 209, 0.4);
    }

    /* ===== ОБОЛОЧКА (CYBER-SHELL) ===== */
    .cyber-shell {
        background-color: transparent; /* Убрана заливка, чтобы фон под планетой был чистым */
        border: 1px solid rgba(78, 195, 209, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(78, 195, 209, 0.05);
        position: relative;
        overflow: hidden;
    }

    .cyber-shell-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 25px;
        background: linear-gradient(90deg, rgba(78,195,209,0.1) 0%, transparent 100%);
        border-bottom: 1px solid rgba(78, 195, 209, 0.3);
        font-family: 'Courier New', Courier, monospace;
    }

    /* Левая часть - Уровень */
    .shell-level {
        color: var(--accent-cyan);
        font-size: 0.95rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    /* Центральная часть - Данные пользователя */
    .shell-user {
        color: var(--text-light);
        display: flex;
        align-items: center;
        gap: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.85rem;
        border-left: 1px solid rgba(78, 195, 209, 0.2);
        border-right: 1px solid rgba(78, 195, 209, 0.2);
        padding: 0 25px;
    }

    .user-highlight {
        color: var(--accent-light-blue);
        font-weight: bold;
    }

    /* Правая часть - Статус */
    .shell-status {
        color: var(--text-muted);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    .status-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background-color: var(--accent-light-blue);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--accent-light-blue);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(126, 200, 248, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0);
        }
    }

    .cyber-shell-body {
        padding: 40px 20px;
    }

    /* Контейнер для планеты Three.js */
    #cyber-globe {
        width: 100%;
        max-width: 740px;
        height: 420px;
        margin: 0 auto 40px;
    }

    /* Описание платформы */
    .platform-desc {
        text-align: center;
        color: var(--text-muted);
        font-size: 1.1rem;
        max-width: 700px;
        margin: 0 auto 50px;
        line-height: 1.6;
        padding: 20px;
        background: rgba(19, 25, 36, 0.5);
        border-radius: 8px;
        border-left: 3px solid var(--accent-blue);
    }

    /* Стили для блоков "Учебные модули" */
    .modules-section {
        padding: 20px;
    }

    .gradient-header {
        font-size: 2.2rem;
        font-weight: 800;
        text-align: center;
        background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue), var(--accent-light-blue));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 30px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    /* Вкладки переключения режимов */
    .mode-tabs {
        display: flex;
        background: var(--bg-card);
        border-radius: 8px;
        padding: 6px;
        margin: 0 auto 40px auto;
        max-width: 450px;
        border: 1px solid var(--border-color);
    }

    .mode-tab {
        flex: 1;
        text-align: center;
        padding: 12px 15px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .mode-tab:hover:not(.active) {
            color: var(--accent-cyan);
        }

        .mode-tab.active {
            background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
            color: var(--bg-main);
            box-shadow: 0 4px 15px rgba(78, 195, 209, 0.3);
        }

    /* Сетка модулей */
    .modules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 30px;
        margin-bottom: 50px;
    }

    /* Карточки с визуальной частью сверху и плавным hover */
    .module-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        overflow: hidden;
        transition: all 0.3s ease-in-out;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .module-card::before, .module-card::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            border: 2px solid transparent;
            transition: all 0.4s ease-in-out;
            z-index: 10;
            pointer-events: none;
        }

        .module-card::before {
            top: 0;
            left: 0;
            border-top-color: var(--border-color);
            border-left-color: var(--border-color);
            border-top-left-radius: 10px;
        }

        .module-card::after {
            bottom: 0;
            right: 0;
            border-bottom-color: var(--border-color);
            border-right-color: var(--border-color);
            border-bottom-right-radius: 10px;
        }

        .module-card:hover {
            background-color: var(--bg-card-hover);
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(78, 195, 209, 0.2);
            border-color: var(--accent-cyan);
        }

            .module-card:hover::before, .module-card:hover::after {
                width: 100%;
                height: 100%;
                border-color: rgba(78, 195, 209, 0.3);
                border-radius: 10px;
            }

    /* Визуальная часть */
    .module-visual {
        height: 160px;
        background: linear-gradient(180deg, var(--bg-main) 0%, var(--bg-card) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid var(--border-color);
        position: relative;
        overflow: hidden;
    }

        .module-visual::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(78, 195, 209, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(78, 195, 209, 0.05) 1px, transparent 1px);
            background-size: 20px 20px;
            opacity: 0.8;
        }

    .scanline {
        position: absolute;
        top: -10px;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--accent-cyan);
        box-shadow: 0 0 10px var(--accent-cyan), 0 0 20px var(--accent-cyan);
        opacity: 0;
        transition: opacity 0.3s;
        z-index: 2;
    }

    .module-card:hover .scanline {
        opacity: 0.6;
        animation: scan 2s linear infinite;
    }

    @@keyframes scan {
        0% {
            top: -10px;
        }

        100% {
            top: 100%;
        }
    }

    .cyber-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(11, 15, 23, 0.9);
        border: 1px solid var(--border-color);
        color: var(--accent-blue);
        font-size: 0.7rem;
        font-weight: 800;
        padding: 4px 8px;
        border-radius: 4px;
        letter-spacing: 1px;
        z-index: 3;
        transition: all 0.3s ease;
    }

    .module-card:hover .cyber-badge {
        border-color: var(--accent-cyan);
        color: var(--accent-cyan);
        box-shadow: 0 0 10px rgba(78, 195, 209, 0.2);
    }

    .module-icon {
        font-size: 4.5rem !important;
        color: var(--text-muted);
        transition: color 0.3s ease, filter 0.3s ease, transform 0.3s ease;
        z-index: 1;
    }

    .module-card:hover .module-icon {
        color: var(--accent-cyan);
        filter: drop-shadow(0 0 20px rgba(78, 195, 209, 0.8));
        transform: scale(1.15);
    }

    .module-content {
        padding: 25px 20px;
        flex-grow: 1;
        text-align: center;
        position: relative;
        z-index: 2;
    }

    .module-title {
        color: var(--accent-light-blue);
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 12px;
        transition: color 0.3s ease;
    }

    .module-card:hover .module-title {
        color: var(--text-light);
        text-shadow: 0 0 8px rgba(203, 224, 245, 0.3);
    }

    .module-desc {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0;
    }

    /* Кнопка перехода */
    .modules-btn-wrap {
        text-align: center;
    }

    .btn-main {
        background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
        color: var(--bg-main);
        font-weight: 800;
        border: none;
        padding: 15px 50px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1.1rem;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-main:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(78, 195, 209, 0.5);
        }

    /* ДОБАВЛЕННЫЕ КЛАССЫ ДЛЯ НОВОГО БЛОКА */
    .content-section {
        padding: 20px;
    }

    .features-divider {
        border-bottom: 1px dashed rgba(78, 195, 209, 0.2);
        margin: 40px 20px;
    }

    .gradient-header-sm {
        font-size: 1.8rem;
    }

    .feature-visual {
        height: 130px;
    }

    .feature-icon {
        font-size: 3.5rem !important;
    }

    @@media (max-width: 900px) {
        .cyber-shell-header {
            flex-direction: column;
            gap: 15px;
        }

        .shell-user {
            border: none;
            border-top: 1px solid rgba(78,195,209,0.2);
            border-bottom: 1px solid rgba(78,195,209,0.2);
            padding: 10px 0;
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 768px) {
        .brand-logo-text {
            font-size: 2.2rem;
            letter-spacing: 5px;
        }

        .gradient-header {
            font-size: 1.8rem;
        }

        #cyber-globe {
            height: 300px;
        }
    }
</style>

<RadzenComponents />

<div class="home-container">
    <div class="home-inner">

        <!-- ЛОГО + НАЗВАНИЕ -->
        <div class="brand-container">
            <RadzenIcon Icon="shield_lock" Style="font-size: 6.5rem; color: var(--accent-cyan); filter: drop-shadow(0 0 30px rgba(78, 195, 209, 0.6));" />
            <h1 class="brand-logo-text">КИБЕРПОЛИГОН</h1>
        </div>

        <!-- ОБОЛОЧКА (CYBER-SHELL) ДЛЯ ИНТЕРАКТИВНОЙ ЧАСТИ -->
        <div class="cyber-shell">
            <div class="cyber-shell-header">

                <!-- УРОВЕНЬ ПОЛЬЗОВАТЕЛЯ -->
                <div class="shell-level">
                    <RadzenIcon Icon="military_tech" Style="font-size: 1.2rem;" />
                    LVL // <span class="user-highlight">@UserLevel</span>
                </div>

                <!-- БЛОК С ДАННЫМИ ПОЛЬЗОВАТЕЛЯ -->
                <div class="shell-user">
                    <RadzenIcon Icon="fingerprint" Style="font-size: 1.2rem; color: var(--accent-cyan);" />
                    <span>AUTH: <span class="user-highlight">@UserDisplayName</span></span>
                    @if (dbUser?.Group != null)
                    {
                        <span style="color: var(--border-color);">//</span>
                        <span>GRP: <span class="user-highlight">@dbUser.Group.Name</span></span>
                    }
                </div>

                <!-- СТАТУС -->
                <div class="shell-status">
                    <span class="status-dot"></span>
                    ONLINE
                </div>
            </div>

            <div class="cyber-shell-body">
                <!-- ПЛАНЕТА -->
                <div id="cyber-globe"></div>

                <p class="platform-desc">
                    Интерактивная среда Департамента охраны для практической отработки навыков выявления, анализа и нейтрализации инцидентов.
                </p>
                <!-- УЧЕБНЫЕ МОДУЛИ -->
                <div class="modules-section">
                    <h2 class="gradient-header">Учебные модули</h2>

                    <div class="mode-tabs">
                        <div class="mode-tab @(selectedMode == 1 ? "active" : "")" @onclick="() => SelectMode(1)">
                            Сценарии
                        </div>
                        <div class="mode-tab @(selectedMode == 2 ? "active" : "")" @onclick="() => SelectMode(2)">
                            Задания
                        </div>
                    </div>

                    <div class="modules-grid">
                        @if (selectedMode == 1)
                        {
                            <div class="module-card">
                                <div class="module-visual">
                                    <div class="scanline"></div>
                                    <span class="cyber-badge">ЦИФРОВОЙ ДВОЙНИК</span>
                                    <RadzenIcon Icon="dns" class="module-icon" />
                                </div>
                                <div class="module-content">
                                    <div class="module-title">Эмуляция ведомственной инфраструктуры</div>
                                    <p class="module-desc">
                                        Платформа полностью воссоздает действующую доменную иерархию, корпоративную топологию сети и стек специализированного программного обеспечения для полного погружения.
                                    </p>
                                </div>
                            </div>

                            <div class="module-card">
                                <div class="module-visual">
                                    <div class="scanline"></div>
                                    <span class="cyber-badge">КООРДИНАЦИЯ И СИНЕРГИЯ</span>
                                    <RadzenIcon Icon="hub" class="module-icon" />
                                </div>
                                <div class="module-content">
                                    <div class="module-title">Синхронизация оперативных действий</div>
                                    <p class="module-desc">
                                        Тренировочная среда позволяет профильным подразделениям отрабатывать совместное и индивидуальное реагирование на инциденты информационной безопасности.
                                    </p>
                                </div>
                            </div>

                            <div class="module-card">
                                <div class="module-visual">
                                    <div class="scanline"></div>
                                    <span class="cyber-badge">ЭКСПЕРТНАЯ БАЗА ЗНАНИЙ</span>
                                    <RadzenIcon Icon="security" class="module-icon" />
                                </div>
                                <div class="module-content">
                                    <div class="module-title">Практико-ориентированные миссии</div>
                                    <p class="module-desc">
                                        Тренировочные сценарии и векторы атак проектируются наиболее опытными специалистами и аналитиками Департамента охраны.
                                    </p>
                                </div>
                            </div>
                        }
                        else if (selectedMode == 2)
                        {
                            <div class="module-card">
                                <div class="module-visual">
                                    <div class="scanline"></div>
                                    <span class="cyber-badge">БАЗА ЗНАНИЙ</span>
                                    <RadzenIcon Icon="gavel" class="module-icon" />
                                </div>
                                <div class="module-content">
                                    <div class="module-title">Теоретическая подготовка</div>
                                    <p class="module-desc">
                                        Программа обеспечивает глубокое освоение отраслевых стандартов, нормативно-правовых актов и строгих внутренних регламентов Департамента охраны.
                                    </p>
                                </div>
                            </div>

                            <div class="module-card">
                                <div class="module-visual">
                                    <div class="scanline"></div>
                                    <span class="cyber-badge">АВТОРСКАЯ ЭКСПЕРТИЗА</span>
                                    <RadzenIcon Icon="verified_user" class="module-icon" />
                                </div>
                                <div class="module-content">
                                    <div class="module-title">Ведомственный стандарт качества</div>
                                    <p class="module-desc">
                                        Методология и контрольные вопросы формируются исключительно действующими, высококвалифицированными офицерами информационной безопасности Департамента охраны.
                                    </p>
                                </div>
                            </div>

                            <div class="module-card">
                                <div class="module-visual">
                                    <div class="scanline"></div>
                                    <span class="cyber-badge">ОЦЕНКА КОМПЕТЕНЦИЙ</span>
                                    <RadzenIcon Icon="assessment" class="module-icon" />
                                </div>
                                <div class="module-content">
                                    <div class="module-title">Объективный аудит знаний</div>
                                    <p class="module-desc">
                                        Интеллектуальная система тестирования служит инструментом непрерывного мониторинга профессионального уровня сотрудников.
                                    </p>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="modules-btn-wrap">
                        <button class="btn-main" @onclick="GoToSelected">
                            <RadzenIcon Icon="power_settings_new" Style="font-size: 1.4rem;" />
                            @(selectedMode == 1 ? "Приступить к сценариям" : "Перейти к заданиям")
                        </button>
                    </div>
                </div>
                <!-- НОВЫЙ БЛОК: КЛЮЧЕВЫЕ ПРЕИМУЩЕСТВА -->
                <div class="content-section">
                    <h2 class="gradient-header gradient-header-sm">Ключевые особенности</h2>

                    <div class="modules-grid">
                        <div class="module-card">
                            <div class="module-visual feature-visual">
                                <div class="scanline"></div>
                                <RadzenIcon Icon="lan" class="module-icon feature-icon" />
                            </div>
                            <div class="module-content">
                                <div class="module-title">Реалистичная инфраструктура</div>
                                <p class="module-desc">
                                    Виртуальные сети, серверы, рабочие станции, используемое ПО и средства защиты повторяют структура Департамента охраны.
                                </p>
                            </div>
                        </div>

                        <div class="module-card">
                            <div class="module-visual feature-visual">
                                <div class="scanline"></div>
                                <RadzenIcon Icon="diversity_3" class="module-icon feature-icon" />
                            </div>
                            <div class="module-content">
                                <div class="module-title">Командные и одиночные режимы</div>
                                <p class="module-desc">
                                    Синхронная работа подразделения или индивидуальная тренировка.
                                </p>
                            </div>
                        </div>

                        <div class="module-card">
                            <div class="module-visual feature-visual">
                                <div class="scanline"></div>
                                <RadzenIcon Icon="timer" class="module-icon feature-icon" />
                            </div>
                            <div class="module-content">
                                <div class="module-title">Контроль времени</div>
                                <p class="module-desc">
                                    Ограниченные по времени миссии с автоматическим завершением. Тренируйте скорость принятия решений в условиях ограниченного времени.
                                </p>
                            </div>
                        </div>

                        <div class="module-card">
                            <div class="module-visual feature-visual">
                                <div class="scanline"></div>
                                <RadzenIcon Icon="military_tech" class="module-icon feature-icon" />
                            </div>
                            <div class="module-content">
                                <div class="module-title">Система рейтингов</div>
                                <p class="module-desc">
                                    Начисление баллов за флаги, штрафы за ошибки, таблица лидеров.
                                </p>
                            </div>
                        </div>
                        <div class="module-card">
                            <div class="module-visual feature-visual">
                                <div class="scanline"></div>
                                <RadzenIcon Icon="award_star" class="module-icon feature-icon" />
                            </div>
                            <div class="module-content">
                                <div class="module-title">Три уровня сложности</div>
                                <p class="module-desc">
                                    Начальный, средний и продвинутый — выбирайте под свой уровень подготовки.
                                </p>
                            </div>
