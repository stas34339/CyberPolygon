@page "/"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@using System.Security.Claims
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@rendermode InteractiveServer

<PageTitle>Главный терминал | Киберполигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #24272c;
        --bg-card-hover: #2a2e36;
        --text-muted: #8fa0b5; /* Мягкий серо-голубой тон для обычного текста */
        --text-light: #cbe0f5; /* Светло-голубой оттенок для заголовков */
        --accent-blue: #5ba3e3; /* Ненавязчивый синий акцент */
        --accent-cyan: #4ec3d1; /* Спокойный циан для иконок и ключевых элементов */
        --border-color: #343a42;
    }

    .home-wrapper {
        background-color: var(--bg-main);
        color: var(--text-muted);
        min-height: 100vh;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* БЛОК 1: Приветственный блок */
    .hero-section {
        text-align: center;
        padding: 5rem 1rem 6rem 1rem;
        border-bottom: 1px solid var(--border-color);
        background: linear-gradient(180deg, #181a1e 0%, var(--bg-main) 100%);
    }

    .hero-title {
        color: var(--text-light);
        font-size: 2.6rem;
        font-weight: 800;
        letter-spacing: 2px;
        margin: 1.5rem 0 1rem 0;
        text-transform: uppercase;
    }

    .hero-subtitle {
        color: var(--text-muted);
        font-size: 1.15rem;
        max-width: 850px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* Общие стили кибер-карточек */
    .cyber-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 1.75rem;
        height: 100%;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
    }

        .cyber-card:hover {
            background-color: var(--bg-card-hover);
            border-color: var(--accent-blue);
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(91, 163, 227, 0.08);
        }

    /* БЛОК 2: Информация по сотруднику */
    .user-panel {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-left: 4px solid var(--accent-cyan);
        border-radius: 6px;
        padding: 2rem;
        margin-top: -3.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .user-info-title {
        color: var(--text-light);
        font-size: 1.4rem;
        font-weight: 600;
        margin: 0;
    }

    .user-meta-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
        opacity: 0.7;
    }

    .user-meta-value {
        font-size: 1.05rem;
        color: var(--text-light);
        font-weight: 500;
    }

    /* БЛОК 3: Интерактивные блоки */
    .interactive-card {
        cursor: pointer;
        border: 1px solid var(--border-color);
    }

        .interactive-card.active {
            border-color: var(--accent-cyan);
            background-color: var(--bg-card-hover);
            box-shadow: inset 0 0 10px rgba(78, 195, 209, 0.05), 0 4px 15px rgba(78, 195, 209, 0.1);
        }

    .interactive-detail {
        font-size: 0.9rem;
        color: var(--accent-cyan);
        border-top: 1px dashed var(--border-color);
        padding-top: 0.75rem;
        margin-top: 0.75rem;
        animation: fadeIn 0.3s ease;
    }

    /* Заголовки секций */
    .section-header {
        color: var(--text-light);
        font-size: 1.75rem;
        font-weight: 700;
        text-align: center;
        margin: 5rem 0 2.5rem 0;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    /* БЛОК 6: Шаги выполнения */
    .step-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(91, 163, 227, 0.15);
        color: var(--accent-blue);
        border: 1px solid var(--accent-blue);
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="home-wrapper">

    <div class="hero-section">
        <RadzenIcon Icon="shield_lock" Style="font-size: 4.5rem; color: var(--accent-cyan);" />
        <h1 class="hero-title">ПЛАТФОРМА "КИБЕРПОЛИГОН"</h1>
        <p class="hero-subtitle">
            Практическое обучение сотрудников отдела обеспечения информационной безопасности на реалистичных симуляциях кибератак, рассмотрение и разбор инцидентов информационной безопасности.
        </p>
    </div>

    <div class="container pb-5">

        @if (isLoaded)
        {
            <div class="user-panel mb-5">
                <RadzenRow AlignItems="AlignItems.Center" Gap="1.5rem">
                    <RadzenColumn Size="12" SizeMD="8">
                        <div class="d-flex align-items-center gap-3">
                            <RadzenIcon Icon="admin_panel_settings" Style="font-size: 3.5rem; color: var(--accent-cyan);" />
                            <div>
                                <h3 class="user-info-title">@UserDisplayName</h3>
                                <div class="mt-3 d-flex flex-wrap gap-4">
                                    <div>
                                        <div class="user-meta-label">Подразделение</div>
                                        <div class="user-meta-value">@(dbUser?.Group?.Name ?? "Не назначено")</div>
                                    </div>
                                    <div>
                                        <div class="user-meta-label">Боевая команда</div>
                                        <div class="user-meta-value">
                                            @if (dbUser?.Teams != null && dbUser.Teams.Any())
                                            {
                                                @string.Join(", ", dbUser.Teams.Select(t => t.Name))
                                            }
                                            else
                                            {
                                                <span>Личное участие</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4" class="text-md-end d-flex flex-column gap-2">
                        <RadzenButton Text="Ознакомительный сценарий" Icon="help_outline" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Style="border-color: var(--border-color); color: var(--text-light);" Click="@(() => NavigationManager.NavigateTo("/scenario/28/workspace"))" />
                        <RadzenButton Text="Все сценарии" Icon="launch" ButtonStyle="ButtonStyle.Info" Style="background-color: var(--accent-blue); color: #1e1e1e;" Click="@(() => NavigationManager.NavigateTo("/scenario"))" />
                    </RadzenColumn>
                </RadzenRow>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color);" />
            </div>
        }

        <RadzenRow Gap="1.25rem" class="mb-5">
            <RadzenColumn Size="12" SizeMD="4">
                <div class="cyber-card interactive-card @(activeCard == 1 ? "active" : "")" @onclick="() => ToggleCard(1)">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <RadzenIcon Icon="layers" Style="font-size: 2rem; color: var(--accent-cyan);" />
                        <h4 class="m-0" style="color: var(--text-light); font-size: 1.1rem; font-weight: 600;">Проработанные сценарии кибератак</h4>
                    </div>
                    <p class="m-0" style="font-size: 0.9rem; cubic-bezier(0.4, 0, 0.2, 1)">Инфраструктурные модели различной сложности для верификации навыков защиты.</p>
                    @if (activeCard == 1)
                    {
                        <div class="interactive-detail">
                            <RadzenIcon Icon="done" Style="font-size: 1rem;" /> Доступно: 12 актуальных векторов APT и симуляций.
                        </div>
                    }
                </div>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <div class="cyber-card interactive-card @(activeCard == 2 ? "active" : "")" @onclick="() => ToggleCard(2)">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <RadzenIcon Icon="groups" Style="font-size: 2rem; color: var(--accent-cyan);" />
                        <h4 class="m-0" style="color: var(--text-light); font-size: 1.1rem; font-weight: 600;">Командные и одиночные режимы</h4>
                    </div>
                    <p class="m-0" style="font-size: 0.9rem;">Синхронное прохождение симуляций подразделением или точечная личная тренировка.</p>
                    @if (activeCard == 2)
                    {
                        <div class="interactive-detail">
                            <RadzenIcon Icon="sync" Style="font-size: 1rem;" /> Механизм реального времени: общий таймер и баланс очков сессии.
                        </div>
                    }
                </div>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <div class="cyber-card interactive-card @(activeCard == 3 ? "active" : "")" @onclick="() => ToggleCard(3)">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <RadzenIcon Icon="insights" Style="font-size: 2rem; color: var(--accent-cyan);" />
                        <h4 class="m-0" style="color: var(--text-light); font-size: 1.1rem; font-weight: 600;">Система рейтинга и XP</h4>
                    </div>
                    <p class="m-0" style="font-size: 0.9rem;">Прозрачная оценка эффективности специалистов с учетом штрафов за ложные срабатывания.</p>
                    @if (activeCard == 3)
                    {
                        <div class="interactive-detail">
                            <RadzenIcon Icon="military_tech" Style="font-size: 1rem;" /> Обновление таблицы лидеров происходит автоматически при фиксации флага.
                        </div>
                    }
                </div>
            </RadzenColumn>
        </RadzenRow>

        <h2 class="section-header">Возможности платформы</h2>
        <RadzenRow Gap="1.5rem" class="mb-5">
            <RadzenColumn Size="12" SizeMD="6">
                <div class="cyber-card">
                    <h4 style="color: var(--text-light); font-weight: 600;" class="mb-2">Реалистичные симуляции</h4>
                    <p class="m-0" style="font-size: 0.95rem; line-height: 1.5;">Сетевые атаки, веб-уязвимости, APT-сценарии и цифровая криминалистика - сотрудники работают в условиях, максимально приближенных к реальным инцидентам.</p>
                </div>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <div class="cyber-card">
                    <h4 style="color: var(--text-light); font-weight: 600;" class="mb-2">Командная работа</h4>
                    <p class="m-0" style="font-size: 0.95rem; line-height: 1.5;">Гибкая структура: пользователь - подразделение - команда. Одиночные тренировки для отработки личных навыков и командные учения для синхронизации действий отдела.</p>
                </div>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <div class="cyber-card">
                    <h4 style="color: var(--text-light); font-weight: 600;" class="mb-2">Интеграция с инфраструктурой</h4>
                    <p class="m-0" style="font-size: 0.95rem; line-height: 1.5;">SIEM, KES, DLP, Active Directory, VMware и другие средства защиты — обучение проходит на тех же инструментах, с которыми сотрудники работают ежедневно.</p>
                </div>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <div class="cyber-card">
                    <h4 style="color: var(--text-light); font-weight: 600;" class="mb-2">Оценка эффективности</h4>
                    <p class="m-0" style="font-size: 0.95rem; line-height: 1.5;">Система XP, рейтинг сотрудников, архив завершённых симуляций и детальная аналитика для руководителей подразделений.</p>
                </div>
            </RadzenColumn>
        </RadzenRow>

        <h2 class="section-header">Какие угрозы отрабатываем</h2>
        <RadzenRow Gap="1.5rem" class="mb-5">
            <RadzenColumn Size="12" SizeMD="4">
                <div class="cyber-card text-center" style="border-top: 3px solid #e06c75;">
                    <RadzenIcon Icon="lan" Style="font-size: 2.2rem; color: #e06c75;" class="mb-2" />
                    <h4 style="color: var(--text-light); font-weight: 600;" class="mb-2">Сетевые атаки</h4>
                    <p class="m-0" style="font-size: 0.9rem; line-height: 1.5;">Защита периметра, обнаружение вторжений, противодействие сканированию и эксплуатации сетевых уязвимостей.</p>
                </div>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <div class="cyber-card text-center" style="border-top: 3px solid #e5c07b;">
                    <RadzenIcon Icon="code" Style="font-size: 2.2rem; color: #e5c07b;" class="mb-2" />
                    <h4 style="color: var(--text-light); font-weight: 600;" class="mb-2">Веб-уязвимости</h4>
                    <p class="m-0" style="font-size: 0.9rem; line-height: 1.5;">OAuth-атаки, XSS/CSRF, SQL-инъекции, SSRF — практическая отработка защиты веб-приложений.</p>
                </div>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <div class="cyber-card text-center" style="border-top: 3px solid #98c379;">
                    <RadzenIcon Icon="find_in_page" Style="font-size: 2.2rem; color: #98c379;" class="mb-2" />
                    <h4 style="color: var(--text-light); font-weight: 600;" class="mb-2">Расследования инцидентов</h4>
                    <p class="m-0" style="font-size: 0.9rem; line-height: 1.5;">Цифровая криминалистика, анализ логов, восстановление цепочки атаки и подготовка отчётов.</p>
                </div>
            </RadzenColumn>
        </RadzenRow>

        <h2 class="section-header mb-1">Первые шаги в Киберполигоне</h2>
        <p class="text-center mb-5" style="color: var(--accent-blue); font-size: 1rem;">Три простых действия — и вы на пути к кибериммунитету</p>

        <RadzenRow Gap="1.5rem">
            <RadzenColumn Size="12" SizeMD="4">
                <div class="cyber-card">
                    <div>
                        <span class="step-badge">Шаг 1</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <RadzenIcon Icon="badge" Style="color: var(--accent-cyan); font-size: 1.5rem;" />
                        <h4 style="color: var(--text-light); font-weight: 600; margin: 0;">Перейдите в профиль</h4>
                    </div>
                    <p class="m-0" style="font-size: 0.9rem; line-height: 1.5;">Откройте личный кабинет и проверьте свою учётную запись. Узнайте, к какому подразделению вы прикреплены и входите ли в боевую команду. Это определит, какие сценарии вам доступны — одиночные или командные.</p>
                </div>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <div class="cyber-card">
                    <div>
                        <span class="step-badge">Шаг 2</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <RadzenIcon Icon="menu_book" Style="color: var(--accent-cyan); font-size: 1.5rem;" />
                        <h4 style="color: var(--text-light); font-weight: 600; margin: 0;">Перейдите в инструкции</h4>
                    </div>
                    <p class="m-0" style="font-size: 0.9rem; line-height: 1.5;">Ознакомьтесь с документацией платформы: как устроены симуляции, какие инструменты защиты интегрированы, как начисляются XP и формируется рейтинг. Понимание механики — залог успешного прохождения сценариев.</p>
                </div>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <div class="cyber-card">
                    <div>
                        <span class="step-badge">Шаг 3</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <RadzenIcon Icon="crisis_alert" Style="color: var(--accent-cyan); font-size: 1.5rem;" />
                        <h4 style="color: var(--text-light); font-weight: 600; margin: 0;">Выберите сценарий</h4>
                    </div>
                    <p class="m-0" style="font-size: 0.9rem; line-height: 1.5;">Перейдите в каталог симуляций. Доступны одиночные миссии для отработки личных навыков и командные операции для совместного отражения атак. Выбирайте сценарий под свою специализацию и начинайте тренировку.</p>
                </div>
            </RadzenColumn>
        </RadzenRow>

    </div>
</div>

@code {
    private bool isLoaded = false;
    private string UserDisplayName = string.Empty;
    private ApplicationUser? dbUser;

    // Переменная для хранения состояния интерактивных карточек (Блок 3)
    private int activeCard = 1;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userClaims = authState.User;

        if (userClaims.Identity?.IsAuthenticated == true)
        {
            var userId = userClaims.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                using var context = await ContextFactory.CreateDbContextAsync();
                dbUser = await context.Set<ApplicationUser>()
                    .Include(u => u.Group)
                    .Include(u => u.Teams)
                    .FirstOrDefaultAsync(u => u.Id == userId);

                UserDisplayName = dbUser?.Email ?? userClaims.Identity.Name ?? "Оперативник";
            }
        }
        else
        {
            UserDisplayName = "Гость полигона";
        }

        isLoaded = true;
    }

    private void ToggleCard(int cardId)
    {
        activeCard = cardId;
    }
}