@page "/admin/scenario-attempt/{ProgressId:int}"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@using static CyberPolygon.Data.ApplicationDbContext
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Детали попытки сценария | Киберполигон</PageTitle>

<style>
    /* Строгая киберпанк-тема */
    :root {
        --bg-main: #0b0f17;
        --bg-card: #131924;
        --bg-card-hover: #1a2435;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    html, body {
        background-color: var(--bg-main) !important;
    }

    /* Обертка на всю ширину для однородного фона */
    .full-page-wrapper {
        background-color: var(--bg-main) !important;
        min-height: calc(100vh - 60px);
        width: 100%;
        padding: 30px 20px;
        box-sizing: border-box;
    }

    .page-container {
        color: var(--text-light);
        max-width: 1400px;
        margin: 0 auto;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 35px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
        gap: 20px;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

    .header-text h1 {
        color: var(--accent-cyan);
        font-weight: 800;
        text-transform: uppercase;
        margin: 0 0 8px 0;
        font-size: 1.8rem;
        letter-spacing: 2px;
        text-shadow: 0 0 15px rgba(78, 195, 209, 0.3);
    }

    .header-text p {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* === ОБОЛОЧКА (CYBER-SHELL) === */
    .cyber-shell {
        background-color: rgba(19, 25, 36, 0.6);
        border: 1px solid rgba(78, 195, 209, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(78, 195, 209, 0.05);
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .cyber-shell-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 25px;
        background: linear-gradient(90deg, rgba(78,195,209,0.1) 0%, transparent 100%);
        border-bottom: 1px solid rgba(78, 195, 209, 0.3);
        font-family: 'Courier New', Courier, monospace;
    }

    .shell-title {
        color: var(--accent-cyan);
        font-size: 0.95rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .shell-status {
        color: var(--text-muted);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    .status-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background-color: var(--accent-light-blue);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--accent-light-blue);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(126, 200, 248, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0);
        }
    }

    .cyber-shell-body {
        padding: 30px;
    }

    /* Внутренние секции */
    .cyber-section {
        background-color: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 25px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .info-item {
        background: rgba(0, 0, 0, 0.3);
        border: 1px dashed var(--border-color);
        border-radius: 8px;
        padding: 15px;
        text-align: center;
    }

        .info-item label {
            color: var(--accent-cyan);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: block;
            margin-bottom: 5px;
            font-weight: 700;
        }

        .info-item span {
            color: var(--text-light);
            font-size: 1.1rem;
            font-weight: 600;
            font-family: monospace;
        }

    .question-card {
        background: rgba(0,0,0,0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

        .question-card.correct {
            border-color: var(--success-color);
            background: rgba(152,195,121,0.05);
        }

            .question-card.correct::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background-color: var(--success-color);
                box-shadow: 0 0 10px var(--success-color);
            }

        .question-card.wrong {
            border-color: var(--danger-color);
            background: rgba(224,108,117,0.05);
        }

            .question-card.wrong::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background-color: var(--danger-color);
                box-shadow: 0 0 10px var(--danger-color);
            }

        .question-card.unanswered {
            border-color: var(--warning-color);
        }

    .answer-box {
        background: #0d1117;
        border-radius: 6px;
        padding: 12px 15px;
        margin-top: 8px;
        font-family: monospace;
        font-size: 1.05rem;
        border: 1px solid var(--border-color);
        box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
    }

    .btn-outline-light {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-outline-light:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-light);
            border-color: var(--text-muted);
        }

    .badge-status {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 4px;
        display: inline-block;
        letter-spacing: 1px;
    }

    .badge-success {
        background: rgba(152,195,121,0.15);
        color: var(--success-color);
        border: 1px solid rgba(152,195,121,0.4);
    }

    .badge-danger {
        background: rgba(224,108,117,0.15);
        color: var(--danger-color);
        border: 1px solid rgba(224,108,117,0.4);
    }

    .badge-warning {
        background: rgba(229,192,123,0.15);
        color: var(--warning-color);
        border: 1px solid rgba(229,192,123,0.4);
    }
</style>

<div class="full-page-wrapper">
    <div class="page-container">
        <div class="page-header">
            <div class="header-text">
                <h1>ДЕТАЛИ СИМУЛЯЦИИ</h1>
                <p>Информационно-аналитический департамент // Отчет системы</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button class="btn-outline-light" @onclick="DownloadWordReport">
                    <RadzenIcon Icon="file_download" Style="margin-right: 5px;" /> СКАЧАТЬ ОТЧЕТ В WORD
                </button>
                <button class="btn-outline-light" @onclick="GoBack">
                    <RadzenIcon Icon="arrow_back" Style="margin-right: 5px;" /> НАЗАД К УПРАВЛЕНИЮ
                </button>
            </div>
        </div>

        @if (progress == null)
        {
            <div class="text-center" style="padding: 80px 20px;">
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color); height: 6px;" />
                <p style="color: var(--accent-cyan); margin-top: 15px; font-size: 0.9rem; font-weight: bold; letter-spacing: 2px;">ЗАГРУЗКА ДАННЫХ...</p>
            </div>
        }
        else
        {
            <div class="cyber-shell">
                <div class="cyber-shell-header">
                    <div class="shell-title">
                        <RadzenIcon Icon="crisis_alert" Style="font-size: 1.2rem;" />
                        SYS.ADMIN_TERMINAL // SCENARIO_REPORT
                    </div>
                    <div class="shell-status">
                        <span class="status-dot"></span>
                        ONLINE
                    </div>
                </div>

                <div class="cyber-shell-body">
                    <h3 style="color: var(--accent-light-blue); margin-bottom: 25px; font-weight: 800; text-transform: uppercase;">
                        Попытка: @(scenario?.Title ?? "Сценарий")
                    </h3>

                    <div class="cyber-section">
                        <div class="info-grid">
                            <div class="info-item"><label>Пользователь / Команда</label><span>@userName</span></div>
                            <div class="info-item"><label>Сложность</label><span>@(string.IsNullOrWhiteSpace(scenario?.Difficulty) ? "—" : scenario.Difficulty)</span></div>
                            <div class="info-item"><label>Тип симуляции</label><span>@(progress.IsTeamAttempt ? $"Командный (ID: {progress.TeamId})" : "Одиночный")</span></div>
                            <div class="info-item"><label>Статус</label><span>@GetStatusText(progress.Status)</span></div>
                            <div class="info-item"><label>Начало</label><span>@(progress.StartedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</span></div>
                            <div class="info-item"><label>Завершение</label><span>@(progress.CompletedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</span></div>
                            <div class="info-item"><label>Опыт (XP)</label><span style="color: var(--accent-cyan); font-size: 1.3rem;">@progress.Score</span></div>
                            @if (progress.TimeSpent.HasValue)
                            {
                                <div class="info-item"><label>Затрачено времени</label><span>@($"{progress.TimeSpent.Value.Hours}ч {progress.TimeSpent.Value.Minutes}м {progress.TimeSpent.Value.Seconds}с")</span></div>
                            }
                        </div>
                    </div>

                    <h4 style="color: var(--accent-cyan); margin-bottom: 20px; font-weight: 800; text-transform: uppercase;">
                        Ответы на задания (Флаги) (@answers.Count(a => a.IsCorrect) из @questions.Count верно)
                    </h4>

                    @foreach (var q in questions)
                    {
                        var answer = answers.FirstOrDefault(a => a.QuestionId == q.Id);
                        bool isCorrect = answer?.IsCorrect ?? false;

                        <div class="question-card @(answer == null ? "unanswered" : isCorrect ? "correct" : "wrong")">
                            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                                <h5 style="color: var(--text-light); margin: 0; font-weight: 700; line-height: 1.4;">Задание: @q.Text</h5>
                                @if (answer != null)
                                {
                                    <span class="badge-status @(isCorrect ? "badge-success" : "badge-danger")">@(isCorrect ? "ВЕРНО" : "НЕВЕРНО")</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-warning">НЕ ОТВЕЧЕНО</span>
                                }
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 15px;">
                                <div>
                                    <label style="color: var(--accent-cyan); font-size: 0.75rem; text-transform: uppercase; font-weight: bold;">Эталонный ответ (Флаг):</label>
                                    <div class="answer-box" style="color: var(--success-color);">@q.CorrectAnswer</div>
                                </div>
                                <div>
                                    <label style="color: var(--accent-cyan); font-size: 0.75rem; text-transform: uppercase; font-weight: bold;">Ответ пользователя:</label>
                                    <div class="answer-box" style="color: @(isCorrect ? "var(--success-color)" : "var(--danger-color)");">
                                        @(answer?.LastSubmittedAnswer ?? "—")
                                    </div>
                                </div>
                            </div>

                            @if (answer != null)
                            {
                                <div style="margin-top: 15px; font-size: 0.85rem; color: var(--text-muted); font-family: monospace; border-top: 1px dashed var(--border-color); padding-top: 10px;">
                                    Попыток: @answer.FailedAttempts | Награда: +@q.AwardPoints XP | Штраф: -@q.PenaltyPoints XP | Обновлено: @answer.UpdatedAt.ToString("dd.MM.yyyy HH:mm:ss")
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int ProgressId { get; set; }

    private UserScenarioProgress? progress;
    private CyberScenario? scenario;
    private List<ScenarioQuestion> questions = new();
    private List<ApplicationDbContext.UserAnswerProgress> answers = new();
    private string userName = "—";

    protected override async Task OnInitializedAsync()
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        progress = await context.UserProgresses.Include(p => p.Scenario).FirstOrDefaultAsync(p => p.Id == ProgressId);

        if (progress != null)
        {
            scenario = progress.Scenario;
            questions = await context.ScenarioQuestions.Where(q => q.CyberScenarioId == progress.CyberScenarioId).ToListAsync();

            answers = await context.Set<ApplicationDbContext.UserAnswerProgress>()
                .Where(a => a.UserScenarioProgressId == ProgressId)
                .ToListAsync();

            // Сборка ФИО или названия команды
            if (!string.IsNullOrEmpty(progress.UserId))
            {
                var user = await context.Users.FindAsync(progress.UserId);
                if (user != null)
                {
                    string fullName = $"{user.LastName} {user.FirstName} {user.MiddleName}".Trim();
                    userName = string.IsNullOrWhiteSpace(fullName) ? (user.UserName ?? "Неизвестно") : fullName;
                }
            }
            else if (progress.TeamId.HasValue)
            {
                var team = await context.UserTeams.FindAsync(progress.TeamId.Value);
                userName = team?.Name != null ? $"[Команда] {team.Name}" : $"Команда #{progress.TeamId}";
            }
        }
    }

    private string GetStatusText(AttemptStatus status) => status switch
    {
        AttemptStatus.NotStarted => "Не начато",
        AttemptStatus.InProgress => "В процессе",
        AttemptStatus.Completed => "Выполнено",
        AttemptStatus.Failed => "Провалено",
        _ => "Неизвестно"
    };

    private async Task DownloadWordReport()
    {
        var htmlContent = BuildWordReportHtml();

        // Очищаем имя от спецсимволов для названия файла
        var safeUserName = userName.Replace(" ", "_").Replace("[", "").Replace("]", "");
        var fileName = $"Отчет_Сценарий_{safeUserName}_{DateTime.Now:ddMMyyyy}.doc";

        // Используем тот же скрипт, который мы ранее добавили в App.razor
        await JS.InvokeVoidAsync("downloadFileFromBlob", fileName, htmlContent);
    }

    private string BuildWordReportHtml()
    {
        var sb = new System.Text.StringBuilder();

        sb.AppendLine("<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>");
        sb.AppendLine("<head><meta charset='utf-8'><title>Отчет по симуляции</title></head>");
        sb.AppendLine("<body style='font-family: \"Times New Roman\", Times, serif; font-size: 14pt;'>");

        sb.AppendLine($"<h2 style='text-align:center;'>Отчет о прохождении симуляции</h2>");
        sb.AppendLine($"<h3 style='text-align:center;'>{scenario?.Title}</h3>");
        sb.AppendLine("<hr/>");

        sb.AppendLine($"<p><b>Участник / Команда:</b> {userName}</p>");
        sb.AppendLine($"<p><b>Сложность:</b> {(string.IsNullOrWhiteSpace(scenario?.Difficulty) ? "—" : scenario.Difficulty)}</p>");
        sb.AppendLine($"<p><b>Тип симуляции:</b> {(progress!.IsTeamAttempt ? "Командный" : "Одиночный")}</p>");
        sb.AppendLine($"<p><b>Статус:</b> <span style='font-weight:bold;'>{GetStatusText(progress.Status)}</span></p>");
        sb.AppendLine($"<p><b>Время начала:</b> {(progress?.StartedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")}</p>");
        sb.AppendLine($"<p><b>Время завершения:</b> {(progress?.CompletedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")}</p>");

        if (progress.TimeSpent.HasValue)
        {
            sb.AppendLine($"<p><b>Затрачено времени:</b> {progress.TimeSpent.Value.Hours}ч {progress.TimeSpent.Value.Minutes}м {progress.TimeSpent.Value.Seconds}с</p>");
        }

        sb.AppendLine($"<p><b>Получено опыта (XP):</b> {progress.Score}</p>");
        sb.AppendLine($"<p><b>Сдано флагов:</b> {answers.Count(a => a.IsCorrect)} из {questions.Count}</p>");
        sb.AppendLine("<hr/><br/>");

        for (int i = 0; i < questions.Count; i++)
        {
            var q = questions[i];
            var answer = answers.FirstOrDefault(a => a.QuestionId == q.Id);
            bool isCorrect = answer?.IsCorrect ?? false;

            string statusColor = isCorrect ? "green" : "red";
            string statusText = isCorrect ? "ВЕРНО" : "НЕВЕРНО";

            sb.AppendLine($"<p style='margin-bottom: 5px;'><b>Задание {i + 1}:</b> {q.Text}</p>");
            sb.AppendLine($"<p style='margin-top: 0;'><b>Статус:</b> <span style='color:{statusColor}; font-weight:bold;'>{statusText}</span></p>");

            string userText = string.IsNullOrWhiteSpace(answer?.LastSubmittedAnswer) ? "— [Нет ответа] —" : answer.LastSubmittedAnswer;
            string correctText = string.IsNullOrWhiteSpace(q.CorrectAnswer) ? "— [Эталон не задан] —" : q.CorrectAnswer;

            sb.AppendLine($"<p>Ответ пользователя: <span style='color:blue;'>{userText}</span></p>");
            sb.AppendLine($"<p>Эталонный ответ (Флаг): <span style='color:green;'>{correctText}</span></p>");

            if (answer != null)
            {
                sb.AppendLine($"<p style='font-size: 12pt; color: gray;'>Попыток: {answer.FailedAttempts} | Награда: +{q.AwardPoints} XP | Штраф: -{q.PenaltyPoints} XP</p>");
            }

            sb.AppendLine("<br/>");
        }

        sb.AppendLine("</body></html>");
        return sb.ToString();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/profile"); // Или куда требуется
    }
}