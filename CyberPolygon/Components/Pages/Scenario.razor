@page "/scenario"
@using CyberPolygon.Components.Components
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@rendermode InteractiveServer

@inject ScenarioService ScenarioService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<CyberPolygon.Data.ApplicationDbContext> ContextFactory

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
    }

    .scenarios-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-muted);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1300px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 50px;
        gap: 30px;
    }

    .header-text h1 {
        color: var(--accent-light-blue);
        font-weight: 700;
        text-transform: uppercase;
        margin: 0 0 12px 0;
        font-size: 2.4rem;
        letter-spacing: 2px;
        text-shadow: 0 0 20px rgba(126, 200, 248, 0.3);
    }

    .header-text p {
        color: var(--text-muted);
        font-size: 1.1rem;
        margin: 0;
        line-height: 1.6;
        max-width: 600px;
    }

    .create-btn {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 12px 28px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
    }

        .create-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
        }

    .cards-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .cyber-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px 30px;
        transition: all 0.3s ease;
        position: relative;
    }

        .cyber-card:hover {
            border-color: var(--accent-cyan);
            box-shadow: 0 8px 30px rgba(78, 195, 209, 0.15);
        }

    .card-header-clickable {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
    }

    .card-title-group {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .card-title {
        color: var(--accent-light-blue);
        margin: 0;
        font-size: 1.2rem;
        font-weight: bold;
    }

    .status-badge {
        font-size: 0.7rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 6px;
    }

    .status-published {
        background: rgba(78, 195, 209, 0.2);
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.4);
    }

    .status-draft {
        background: rgba(143, 160, 181, 0.15);
        color: var(--text-muted);
        border: 1px solid var(--border-color);
    }

    .card-details {
        margin-top: 20px;
        padding: 20px;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--border-color);
        color: var(--text-light);
    }

    .card-stats {
        display: flex;
        gap: 25px;
        margin-bottom: 18px;
        font-family: monospace;
        color: var(--accent-cyan);
        font-size: 0.9rem;
    }

    .btn-start {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-start:hover {
            box-shadow: 0 4px 15px rgba(78, 195, 209, 0.4);
        }

    .btn-icon {
        background: transparent;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 8px 12px;
        cursor: pointer;
        transition: all 0.2s;
        color: var(--text-light);
    }

        .btn-icon.edit:hover {
            border-color: var(--accent-light-blue);
            color: var(--accent-light-blue);
        }

        .btn-icon.delete:hover {
            border-color: var(--danger-color);
            color: var(--danger-color);
        }

    .loading-container, .empty-state {
        text-align: center;
        padding: 60px;
        color: var(--text-muted);
        border: 2px dashed var(--border-color);
        border-radius: 12px;
        background: rgba(26, 35, 50, 0.5);
    }

    /* Модальное окно */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(6px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal-box {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        width: 450px;
        padding: 30px;
    }

    .btn-ok {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        border: none;
        padding: 10px 35px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn-cancel {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 35px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
    }
</style>

<RadzenComponents />
<PageTitle>Сценарии | Киберполигон</PageTitle>

<div class="scenarios-container">
    <div class="page-header">
        <div class="header-text">
            <h1>Боевые сценарии</h1>
            <p>Практические симуляции кибератак для отработки навыков защиты в условиях, приближенных к реальным.</p>
        </div>
        <AuthorizeView Roles="Admin">
            <button class="create-btn" @onclick="@(() => OpenEditDialog(new CyberScenario()))">
                <RadzenIcon Icon="add" Style="vertical-align: middle;" /> Новый сценарий
            </button>
        </AuthorizeView>
    </div>

    @if (scenarios == null)
    {
        <div class="loading-container"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" /></div>
    }
    else if (!scenarios.Any())
    {
        <div class="empty-state">
            <RadzenIcon Icon="school" Style="font-size: 3rem; margin-bottom: 20px;" />
            <p>База данных пуста. Сценарии не обнаружены.</p>
        </div>
    }
    else
    {
        <div class="cards-list">
            @foreach (var item in scenarios)
            {
                bool isExpanded = expandedCards.ContainsKey(item.Id) && expandedCards[item.Id];
                bool hasProgress = userProgresses.TryGetValue(item.Id, out var status);
                bool isCompleted = hasProgress && status == AttemptStatus.Completed;
                bool isStarted = hasProgress && status != AttemptStatus.Completed && status != AttemptStatus.NotStarted;

                <div class="cyber-card">
                    <div class="card-header-clickable" @onclick="@(() => ToggleCard(item.Id))">
                        <div class="card-title-group">
                            <h3 class="card-title">@item.Title</h3>

                            @if (isStarted)
                            {
                                <span class="status-badge" style="background: rgba(229, 192, 123, 0.15); color: #e5c07b; border: 1px solid #e5c07b;">В процессе</span>
                            }
                            else if (isCompleted)
                            {

                                <span class="status-badge" style="background: rgba(152, 195, 121, 0.15); color: #98c379; border: 1px solid #98c379;">Завершен</span>
                            }

                            <AuthorizeView Roles="Admin">
                                <span class="status-badge @(item.IsVisible ? "status-published" : "status-draft")">@(item.IsVisible ? "Открыт" : "Черновик")</span>
                            </AuthorizeView>
                        </div>

                        <RadzenIcon Icon="@(isExpanded ? "expand_less" : "expand_more")" Style="color: var(--accent-cyan); font-size: 1.8rem;" />
                    </div>

                    @if (!isExpanded)
                    {
                        <p style="margin: 10px 0 0 0; color: var(--text-muted); font-size: 0.95rem;">@item.Description</p>
                    }

                    @if (isExpanded)
                    {
                        <div class="card-details" @onclick:stopPropagation="true">
                            <div style="margin-bottom: 15px; line-height: 1.6;">@((MarkupString)item.Legend)</div>

                            <div class="card-stats">
                                <span><RadzenIcon Icon="schedule" Style="vertical-align: middle; margin-right: 5px;" /> @(item.DurationInMinutes > 0 ? $"{item.DurationInMinutes} мин." : "Без ограничений")</span>
                                <span><RadzenIcon Icon="flag" Style="vertical-align: middle; margin-right: 5px;" /> Заданий: @(item.Questions?.Count ?? 0)</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top: 1px solid var(--border-color);">
                                <AuthorizeView Roles="Admin">
                                    <div class="d-flex gap-2">
                                        <button class="btn-icon edit" @onclick="@(() => OpenEditDialog(item))"><RadzenIcon Icon="edit" /></button>
                                        <button class="btn-icon delete" @onclick="@(() => DeleteItem(item.Id))"><RadzenIcon Icon="delete" /></button>
                                    </div>
                                </AuthorizeView>

                                @{
                                    string btnText = isCompleted ? "ПРОСМОТРЕТЬ РЕЗУЛЬТАТ" : (isStarted ? "ПРОДОЛЖИТЬ" : "НАЧАТЬ СЦЕНАРИЙ");
                                    string btnColor = isCompleted ? "#98c379" : (isStarted ? "#e5c07b" : "");
                                }
                                <button class="btn-start ms-auto" style="@(string.IsNullOrEmpty(btnColor) ? "" : $"background: {btnColor}; box-shadow: none;")"
                                        @onclick="@(() => NavigationManager.NavigateTo($"/scenario/{item.Id}/workspace"))">
                                    @btnText
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@if (isDeleteVisualDialogVisible)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <div class="modal-header d-flex justify-content-between mb-3">
                <h3 style="color: var(--accent-light-blue); margin: 0; font-size: 1.2rem; font-weight: bold;">Предупреждение</h3>
                <button style="background: none; border: none; color: var(--text-muted); cursor: pointer;" @onclick="CloseDeleteDialog">✕</button>
            </div>
            <div class="modal-body text-center mb-4" style="color: var(--danger-color); font-size: 1.05rem;">
                Удалить сценарий из базы навсегда?
            </div>
            <div class="modal-footer d-flex justify-content-center gap-2">
                <button class="btn-ok" @onclick="ConfirmDelete">ОК</button>
                <button class="btn-cancel" @onclick="CloseDeleteDialog">ОТМЕНА</button>
            </div>
        </div>
    </div>
}

@code {
    List<CyberScenario>? scenarios;
    private Dictionary<int, bool> expandedCards = new();
    private Dictionary<int, AttemptStatus> userProgresses = new();
    private string currentUserId = string.Empty;

    protected override async Task OnInitializedAsync() => await Refresh();

    async Task Refresh()
    {
        var allScenarios = await ScenarioService.GetAllAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;
        currentUserId = userPrincipal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        // Загрузка прогресса пользователя для динамической кнопки старта
        if (!string.IsNullOrEmpty(currentUserId))
        {
            try
            {
                using var context = await ContextFactory.CreateDbContextAsync();
                var progresses = await context.Set<UserScenarioProgress>().Where(p => p.UserId == currentUserId).ToListAsync();
                foreach (var p in progresses)
                {
                    // Адаптируй под точное имя поля в БД, если оно называется иначе (например, ScenarioId)
                    var prop = p.GetType().GetProperty("CyberScenarioId") ?? p.GetType().GetProperty("ScenarioId");
                    if (prop != null)
                    {
                        userProgresses[(int)prop.GetValue(p)!] = p.Status;
                    }
                }
            }
            catch { }
        }

        if (userPrincipal.IsInRole("Admin"))
        {
            scenarios = allScenarios;
        }
        else
        {
            using var context = await ContextFactory.CreateDbContextAsync();
            var dbUser = await context.Set<ApplicationUser>().Include(u => u.Teams).FirstOrDefaultAsync(u => u.Id == currentUserId);
            if (dbUser == null)
            {
                scenarios = new List<CyberScenario>();
                return;
            }

            int userGroupId = dbUser.GroupId ?? 0;
            var userTeamIds = dbUser.Teams.Select(t => t.Id).ToList();

            scenarios = allScenarios.Where(s => s.IsVisible && (
                s.Scope == VisibilityScope.Public ||
                (s.Scope == VisibilityScope.GroupOnly && s.TargetGroupId == userGroupId) ||
                (s.Scope == VisibilityScope.TeamOnly && s.TargetTeamId.HasValue && userTeamIds.Contains(s.TargetTeamId.Value))
            )).ToList();
        }
    }

    private void ToggleCard(int id)
    {
        if (expandedCards.ContainsKey(id)) expandedCards[id] = !expandedCards[id];
        else expandedCards[id] = true;
    }

    async Task OpenEditDialog(CyberScenario scenario)
    {
        var res = await DialogService.OpenAsync<ScenarioEditor>("Управление сценарием",
                  new Dictionary<string, object> { { "Item", scenario } },
                  new DialogOptions { Width = "900px", Height = "700px" });
        if (res == true) await Refresh();
    }

    bool isDeleteVisualDialogVisible = false;
    int scenarioIdToDelete = 0;

    void DeleteItem(int id)
    {
        scenarioIdToDelete = id;
        isDeleteVisualDialogVisible = true;
    }

    async Task ConfirmDelete()
    {
        isDeleteVisualDialogVisible = false;
        if (scenarioIdToDelete != 0)
        {
            await ScenarioService.DeleteAsync(scenarioIdToDelete);
            await Refresh();
            NotificationService.Notify(NotificationSeverity.Success, "Система", "Данные удалены");
        }
        scenarioIdToDelete = 0;
    }

    void CloseDeleteDialog()
    {
        isDeleteVisualDialogVisible = false;
        scenarioIdToDelete = 0;
    }
}