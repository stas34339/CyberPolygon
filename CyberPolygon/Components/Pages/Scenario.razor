@page "/scenario"
@using CyberPolygon.Components.Components
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@rendermode InteractiveServer

@inject ScenarioService ScenarioService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<CyberPolygon.Data.ApplicationDbContext> ContextFactory

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --border-glow: #4ec3d1;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .scenarios-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-muted);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1300px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 50px;
        gap: 30px;
    }

    .header-text {
        flex: 1;
    }

        .header-text h1 {
            color: var(--accent-light-blue);
            font-weight: 700;
            text-transform: uppercase;
            margin: 0 0 12px 0;
            font-size: 2.4rem;
            letter-spacing: 2px;
            text-shadow: 0 0 20px rgba(126, 200, 248, 0.3);
        }

        .header-text p {
            color: var(--text-muted);
            font-size: 1.1rem;
            margin: 0;
            line-height: 1.6;
            max-width: 600px;
        }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .create-btn {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 12px 28px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 15px rgba(78, 195, 209, 0.2);
        white-space: nowrap;
    }

        .create-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
            background: linear-gradient(135deg, #5fd4e0 0%, #6fb3f0 100%);
        }

    .cards-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .cyber-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px 30px;
        transition: all 0.3s ease;
        position: relative;
        display: flex;
        align-items: center;
        gap: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

        .cyber-card:hover {
            border-color: var(--accent-cyan);
            transform: translateX(5px);
            box-shadow: 0 8px 30px rgba(78, 195, 209, 0.15), 0 0 20px rgba(78, 195, 209, 0.05);
            background: linear-gradient(135deg, #1e2d3d 0%, #223548 100%);
        }

    .card-main {
        flex: 1;
        min-width: 0;
    }

    .card-header {
        position: relative;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .status-badge {
        font-size: 0.7rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 6px;
        letter-spacing: 0.5px;
        backdrop-filter: blur(10px);
    }

    .status-published {
        background: rgba(78, 195, 209, 0.2);
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.4);
    }

    .status-draft {
        background: rgba(143, 160, 181, 0.15);
        color: var(--text-muted);
        border: 1px solid var(--border-color);
    }

    .card-title {
        color: var(--accent-light-blue);
        margin: 0;
        font-size: 1.2rem;
        font-weight: bold;
        letter-spacing: 0.3px;
    }

    .card-description {
        color: var(--text-muted);
        font-size: 0.92rem;
        line-height: 1.6;
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .card-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }

    .btn-details {
        background: none;
        border: 1px solid rgba(78, 195, 209, 0.3);
        color: var(--accent-cyan);
        cursor: pointer;
        padding: 8px 18px;
        border-radius: 6px;
        font-size: 0.85rem;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

        .btn-details:hover {
            background: rgba(78, 195, 209, 0.1);
            border-color: var(--accent-cyan);
        }

    .admin-actions {
        display: flex;
        gap: 8px;
    }

    .btn-icon {
        background: transparent;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-icon.edit {
            color: var(--accent-light-blue);
            border-color: rgba(126, 200, 248, 0.3);
        }

            .btn-icon.edit:hover {
                background: rgba(126, 200, 248, 0.1);
                border-color: var(--accent-light-blue);
            }

        .btn-icon.delete {
            color: #e06c75;
            border-color: rgba(224, 108, 117, 0.3);
        }

            .btn-icon.delete:hover {
                background: rgba(224, 108, 117, 0.1);
                border-color: #e06c75;
            }

    .card-details {
        margin-top: 0;
        padding: 20px;
        border-radius: 0 0 10px 10px;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--border-color);
        border-top: none;
        color: var(--text-light);
        width: 100%;
    }

        .card-details .legend {
            font-size: 0.85rem;
            margin-bottom: 15px;
            line-height: 1.6;
        }

    .card-stats {
        display: flex;
        gap: 25px;
        margin-bottom: 18px;
        font-family: monospace;
        font-size: 0.85rem;
        color: var(--accent-cyan);
    }

        .card-stats span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

    .btn-start {
        width: 100%;
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        letter-spacing: 1.5px;
        padding: 12px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.9rem;
        text-transform: uppercase;
        box-shadow: 0 4px 15px rgba(78, 195, 209, 0.2);
    }

        .btn-start:hover {
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
            background: linear-gradient(135deg, #5fd4e0 0%, #6fb3f0 100%);
            transform: translateY(-1px);
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        border: 2px dashed var(--border-color);
        border-radius: 12px;
        color: var(--text-muted);
        background: rgba(26, 35, 50, 0.5);
    }

    .loading-container {
        text-align: center;
        padding: 60px;
    }

    /* Модальное окно удаления */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(6px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .modal-box {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        box-shadow: 0 0 40px rgba(91, 163, 227, 0.2);
        border-radius: 12px;
        width: 450px;
        max-width: 90%;
        padding: 30px;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .modal-header h3 {
            color: var(--accent-light-blue);
            margin: 0;
            font-size: 1.2rem;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

    .modal-close {
        background: none;
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        cursor: pointer;
        font-size: 1.2rem;
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

        .modal-close:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }

    .modal-body {
        text-align: center;
        margin-bottom: 30px;
        color: #e06c75;
        font-size: 1.05rem;
        line-height: 1.5;
        padding: 10px 0;
    }

    .modal-footer {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    .btn-ok {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        border: none;
        padding: 10px 35px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        letter-spacing: 0.5px;
        transition: all 0.2s;
    }

        .btn-ok:hover {
            box-shadow: 0 4px 15px rgba(78, 195, 209, 0.4);
        }

    .btn-cancel {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 35px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        letter-spacing: 0.5px;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            border-color: var(--text-muted);
            background: rgba(143, 160, 181, 0.1);
        }
</style>

<RadzenComponents />
<PageTitle>Сценарии | Киберполигон</PageTitle>

<div class="scenarios-container">
    <div class="page-header">
        <div class="header-text">
            <h1>Боевые сценарии</h1>
            <p>Практические симуляции кибератак для отработки навыков защиты в условиях, приближенных к реальным.</p>
        </div>

        <AuthorizeView Roles="Admin">
            <div class="header-actions">
                <button class="create-btn" @onclick="@(() => OpenEditDialog(new CyberScenario()))">
                    <RadzenIcon Icon="add" Style="vertical-align: middle; margin-right: 6px;" /> Новый сценарий
                </button>
            </div>
        </AuthorizeView>
    </div>

    @if (scenarios == null)
    {
        <div class="loading-container">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color);" />
        </div>
    }
    else if (!scenarios.Any())
    {
        <div class="empty-state">
            <RadzenIcon Icon="school" Style="font-size: 3rem; color: var(--border-color); margin-bottom: 20px;" />
            <p style="font-size: 1.1rem; margin: 0;">База данных пуста. Сценарии не обнаружены.</p>
        </div>
    }
    else
    {
        <div class="cards-list">
            @foreach (var item in scenarios)
            {
                bool isExpanded = expandedCards.ContainsKey(item.Id) && expandedCards[item.Id];
                bool hasProgress = userProgresses.TryGetValue(item.Id, out var status);
                bool isCompleted = hasProgress && status == AttemptStatus.Completed;
                bool isFailed = hasProgress && status == AttemptStatus.Failed;
                bool isStarted = hasProgress && status == AttemptStatus.InProgress;

                <div>
                    <div class="cyber-card">
                        <div class="card-main">
                            <div class="card-header">
                                <h3 class="card-title">@item.Title</h3>

                                @if (isStarted)
                                {
                                    <span class="status-badge" style="background: rgba(229, 192, 123, 0.15); color: #e5c07b; border: 1px solid rgba(229, 192, 123, 0.4);">В процессе</span>
                                }
                                else if (isCompleted)
                                {
                                    <span class="status-badge" style="background: rgba(152, 195, 121, 0.15); color: #98c379; border: 1px solid rgba(152, 195, 121, 0.4);">Завершен</span>
                                }
                                else if (isFailed)
                                {
                                    <span class="status-badge" style="background: rgba(224, 108, 117, 0.15); color: #e06c75; border: 1px solid rgba(224, 108, 117, 0.4);">Неудача</span>
                                }

                                <AuthorizeView Roles="Admin">
                                    <span class="status-badge @(item.IsVisible ? "status-published" : "status-draft")">
                                        @(item.IsVisible ? "Открыт" : "Черновик")
                                    </span>
                                </AuthorizeView>
                            </div>
                            <p class="card-description">@item.Description</p>
                        </div>

                        <div class="card-actions">
                            <button class="btn-details" @onclick="@(() => ToggleCard(item.Id))">
                                <RadzenIcon Icon="@(isExpanded ? "expand_less" : "expand_more")" />
                                @(isExpanded ? "Скрыть" : "Подробнее")
                            </button>

                            <AuthorizeView Roles="Admin">
                                <div class="admin-actions">
                                    <button class="btn-icon edit" @onclick="@(() => OpenEditDialog(item))">
                                        <RadzenIcon Icon="edit" />
                                    </button>
                                    <button class="btn-icon delete" @onclick="@(() => DeleteItem(item.Id))">
                                        <RadzenIcon Icon="delete" />
                                    </button>
                                </div>
                            </AuthorizeView>
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="card-details">
                            <div class="legend">@((MarkupString)item.Legend)</div>

                            <div class="card-stats">
                                <span><RadzenIcon Icon="schedule" /> @(item.DurationInMinutes > 0 ? $"{item.DurationInMinutes} мин." : "Без ограничений")</span>
                                <span><RadzenIcon Icon="flag" /> Заданий: @(item.Questions?.Count ?? 0)</span>
                            </div>

                            @{
                                string btnText;
                                string btnColor = "";

                                if (isCompleted)
                                {
                                    btnText = "ПРОСМОТРЕТЬ РЕЗУЛЬТАТ";
                                    btnColor = "#98c379";
                                }
                                else if (isFailed)
                                {
                                    btnText = "ПРОЙТИ ПОВТОРНО";
                                    btnColor = "#e06c75";
                                }
                                else if (isStarted)
                                {
                                    btnText = "ПРОДОЛЖИТЬ";
                                    btnColor = "#e5c07b";
                                }
                                else
                                {
                                    btnText = "НАЧАТЬ СЦЕНАРИЙ";
                                }
                            }
                            <button class="btn-start" style="@(string.IsNullOrEmpty(btnColor) ? "" : $"background: {btnColor}; box-shadow: none;")"
                                    @onclick="@(() => NavigationManager.NavigateTo($"/scenario/{item.Id}/workspace"))">
                                @btnText
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@if (isDeleteVisualDialogVisible)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Предупреждение системы</h3>
                <button class="modal-close" @onclick="CloseDeleteDialog">✕</button>
            </div>
            <div class="modal-body">
                Вы уверены, что хотите навсегда удалить этот сценарий из базы данных?
            </div>
            <div class="modal-footer">
                <button class="btn-ok" @onclick="ConfirmDelete">ОК</button>
                <button class="btn-cancel" @onclick="CloseDeleteDialog">ОТМЕНА</button>
            </div>
        </div>
    </div>
}

@code {
    List<CyberScenario>? scenarios;
    private Dictionary<int, bool> expandedCards = new();
    private Dictionary<int, AttemptStatus> userProgresses = new();
    private string currentUserId = string.Empty;

    protected override async Task OnInitializedAsync() => await Refresh();

    async Task Refresh()
    {
        var allScenarios = await ScenarioService.GetAllAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;
        currentUserId = userPrincipal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        if (!string.IsNullOrEmpty(currentUserId))
        {
            try
            {
                using var context = await ContextFactory.CreateDbContextAsync();
                var progresses = await context.Set<UserScenarioProgress>()
                    .Where(p => p.UserId == currentUserId)
                    .ToListAsync();

                foreach (var p in progresses)
                {
                    var prop = p.GetType().GetProperty("CyberScenarioId") ?? p.GetType().GetProperty("ScenarioId");
                    if (prop != null)
                    {
                        int scenarioId = (int)prop.GetValue(p)!;

                        if (p.Status == AttemptStatus.InProgress && p.TargetEndTime.HasValue)
                        {
                            if (DateTime.UtcNow >= p.TargetEndTime.Value)
                            {
                                p.Status = AttemptStatus.Failed;
                                p.CompletedAt = DateTime.UtcNow;
                                if (p.StartedAt.HasValue)
                                    p.TimeSpent = p.CompletedAt.Value - p.StartedAt.Value;

                                context.UserProgresses.Update(p);
                                await context.SaveChangesAsync();
                            }
                        }

                        userProgresses[scenarioId] = p.Status;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка загрузки прогресса: {ex.Message}");
            }
        }

        if (userPrincipal.IsInRole("Admin"))
        {
            scenarios = allScenarios;
        }
        else
        {
            using var context = await ContextFactory.CreateDbContextAsync();
            var dbUser = await context.Set<ApplicationUser>()
                .Include(u => u.Teams)
                .FirstOrDefaultAsync(u => u.Id == currentUserId);

            if (dbUser == null)
            {
                scenarios = new List<CyberScenario>();
                return;
            }

            int userGroupId = dbUser.GroupId ?? 0;
            var userTeamIds = dbUser.Teams.Select(t => t.Id).ToList();

            scenarios = allScenarios.Where(s => s.IsVisible && (
                s.Scope == VisibilityScope.Public ||
                (s.Scope == VisibilityScope.GroupOnly && s.TargetGroupId == userGroupId) ||
                (s.Scope == VisibilityScope.TeamOnly && s.TargetTeamId.HasValue && userTeamIds.Contains(s.TargetTeamId.Value))
            )).ToList();
        }
    }

    private void ToggleCard(int id)
    {
        if (expandedCards.ContainsKey(id)) expandedCards[id] = !expandedCards[id];
        else expandedCards[id] = true;
    }

    async Task OpenEditDialog(CyberScenario scenario)
    {
        var res = await DialogService.OpenAsync<ScenarioEditor>("Управление сценарием",
                  new Dictionary<string, object> { { "Item", scenario } },
                  new DialogOptions { Width = "900px", Height = "700px" });
        if (res == true) await Refresh();
    }

    bool isDeleteVisualDialogVisible = false;
    int scenarioIdToDelete = 0;

    void DeleteItem(int id)
    {
        scenarioIdToDelete = id;
        isDeleteVisualDialogVisible = true;
    }

    async Task ConfirmDelete()
    {
        isDeleteVisualDialogVisible = false;
        if (scenarioIdToDelete != 0)
        {
            await ScenarioService.DeleteAsync(scenarioIdToDelete);
            await Refresh();
            NotificationService.Notify(NotificationSeverity.Success, "Система", "Данные удалены");
        }
        scenarioIdToDelete = 0;
    }

    void CloseDeleteDialog()
    {
        isDeleteVisualDialogVisible = false;
        scenarioIdToDelete = 0;
    }
}