@page "/scenario"
@using CyberPolygon.Components.Components
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@rendermode InteractiveServer

@inject ScenarioService ScenarioService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<CyberPolygon.Data.ApplicationDbContext> ContextFactory

<style>
    /* ---------- ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ПЛАТФОРМЫ ---------- */
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #24272c;
        --bg-card-hover: #2a2e36;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --border-color: #343a42;
    }

    .scenarios-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-muted);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* ---------- Карточки ---------- */
    .cyber-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 6px;
        padding: 1.75rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .cyber-card:hover {
            background-color: var(--bg-card-hover) !important;
            border-color: var(--accent-cyan) !important;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(78, 195, 209, 0.08);
        }

    .item-title {
        font-size: 1.4rem;
        font-weight: bold;
        color: var(--text-light) !important;
        margin-bottom: 12px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .item-desc {
        color: var(--text-muted) !important;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 20px;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ---------- Шапка ---------- */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 3rem;
    }

    .page-title {
        color: var(--text-light);
        font-size: 2.2rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin: 0;
    }

    /* ---------- Кнопки ---------- */
    .scenarios-container .rz-button {
        transition: all 0.3s ease;
        border-radius: 4px;
        position: relative;
        overflow: hidden;
        transform: scale(1);
    }

        .scenarios-container .rz-button:hover {
            filter: brightness(1.1);
            box-shadow: 0 0 12px rgba(91, 163, 227, 0.4);
            transform: scale(1.02);
        }

        .scenarios-container .rz-button:active {
            transform: scale(0.98);
        }

    .empty-db {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px;
        border: 1px dashed var(--border-color);
        border-radius: 8px;
        background: rgba(0,0,0,0.2);
        color: var(--text-muted) !important;
        font-size: 1.1rem;
        margin-top: 20px;
    }

    /* ---------- Модальное окно ---------- */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(4px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal-box {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        box-shadow: 0 0 30px rgba(91, 163, 227, 0.15);
        border-radius: 6px;
        width: 420px;
        max-width: 90%;
        padding: 24px;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 1.2rem;
        color: var(--text-light);
        font-weight: 600;
    }

    .modal-close-btn {
        background: none;
        border: none;
        color: var(--text-muted);
        font-size: 1.5rem;
        cursor: pointer;
    }

    .modal-body {
        text-align: center;
        margin: 20px 0;
        color: #e06c75;
        font-size: 1.1rem;
        font-weight: 500;
    }

    .btn-ok {
        background-color: var(--accent-blue);
        color: #1e1e1e;
        border: none;
        padding: 8px 30px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn-cancel {
        background-color: #3a3a3a;
        color: #fff;
        border: none;
        padding: 8px 30px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
    }
</style>

<RadzenComponents />
<PageTitle>Сценарии | Киберполигон</PageTitle>

<div class="scenarios-container" style="padding: 30px 20px;">
    <div class="page-header">
        <h1 class="page-title">Боевые сценарии</h1>
        <AuthorizeView Roles="Admin">
            <RadzenButton Text="Новый сценарий" Icon="add" ButtonStyle="ButtonStyle.Info"
                          Style="background-color: var(--accent-blue); color: #1e1e1e; border: none;"
                          Click="@(() => OpenEditDialog(new CyberScenario()))" />
        </AuthorizeView>
    </div>

    @if (scenarios == null)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color);" />
    }
    else if (!scenarios.Any())
    {
        <div class="empty-db">
            <RadzenIcon Icon="warning" Style="font-size: 2.5rem; color: var(--accent-cyan); margin-bottom: 1rem;" />
            База данных пуста. Сценарии не обнаружены.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in scenarios)
            {
                <div class="col-md-4 mb-4">
                    <RadzenCard class="cyber-card">
                        <AuthorizeView Roles="Admin">
                            <div style="position: absolute; top: 12px; right: 12px; z-index: 10;">
                                @if (item.IsVisible)
                                {
                                    <span class="badge" style="background-color: rgba(78,195,209,0.15); color: var(--accent-cyan); border:1px solid var(--accent-cyan);">Открыт</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: rgba(143,160,181,0.1); color: var(--text-muted); border:1px solid var(--border-color);">Черновик</span>
                                }
                            </div>
                        </AuthorizeView>

                        <h3 class="item-title">@item.Title</h3>
                        <p class="item-desc">@item.Description</p>

                        <div class="card-actions mt-auto pt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <RadzenButton Text="Подробнее"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Variant="Variant.Outlined"
                                              Style="border-color: var(--accent-blue); color: var(--accent-blue);"
                                              Click="@(() => OpenDetails(item))" />
                                <RadzenButton Text="Открыть"
                                              Icon="play_arrow"
                                              ButtonStyle="ButtonStyle.Success"
                                              Style="background-color: var(--accent-cyan); color: #1e1e1e; border: none;"
                                              Click="@(() => NavigationManager.NavigateTo($"/scenario/{item.Id}/workspace"))" />
                            </div>

                            <AuthorizeView Roles="Admin">
                                <div class="admin-tools d-flex justify-content-end gap-2 border-top pt-2 mt-2" style="border-color: var(--border-color) !important;">
                                    <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Style="background: transparent; color: var(--text-light); border: 1px solid var(--border-color);"
                                                  Click="@(() => OpenEditDialog(item))" />
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Style="background: rgba(224,108,117,0.1); color: #e06c75; border: 1px solid #e06c75;"
                                                  Click="@(() => DeleteItem(item.Id))" />
                                </div>
                            </AuthorizeView>
                        </div>
                    </RadzenCard>
                </div>
            }
        </div>
    }
</div>

@if (isDeleteVisualDialogVisible)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Предупреждение</h3>
                <button class="modal-close-btn" @onclick="CloseDeleteDialog">✕</button>
            </div>
            <div class="modal-body">
                Удалить сценарий из базы навсегда?
            </div>
            <div class="modal-footer">
                <button class="btn-ok" @onclick="ConfirmDelete">OK</button>
                <button class="btn-cancel" @onclick="CloseDeleteDialog">CANCEL</button>
            </div>
        </div>
    </div>
}

@code {
    List<CyberScenario>? scenarios;

    protected override async Task OnInitializedAsync() => await Refresh();

    async Task Refresh()
    {
        var allScenarios = await ScenarioService.GetAllAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.IsInRole("Admin"))
        {
            scenarios = allScenarios;
        }
        else
        {
            var userId = userPrincipal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            using var context = await ContextFactory.CreateDbContextAsync();
            var dbUser = await context.Set<ApplicationUser>()
                .Include(u => u.Teams)
                .FirstOrDefaultAsync(u => u.Id == userId);
            if (dbUser == null)
            {
                scenarios = new List<CyberScenario>();
                return;
            }

            int userGroupId = dbUser.GroupId ?? 0;
            var userTeamIds = dbUser.Teams.Select(t => t.Id).ToList();

            scenarios = allScenarios.Where(s => s.IsVisible && (
                s.Scope == VisibilityScope.Public ||
                (s.Scope == VisibilityScope.GroupOnly && s.TargetGroupId == userGroupId) ||
                (s.Scope == VisibilityScope.TeamOnly && s.TargetTeamId.HasValue && userTeamIds.Contains(s.TargetTeamId.Value))
            )).ToList();
        }
    }

    async Task OpenEditDialog(CyberScenario scenario)
    {
        var res = await DialogService.OpenAsync<ScenarioEditor>("Управление сценарием",
                  new Dictionary<string, object> { { "Item", scenario } },
                  new DialogOptions { Width = "900px", Height = "700px" });
        if (res == true) await Refresh();
    }

    async Task OpenDetails(CyberScenario scenario)
    {
        await DialogService.OpenAsync<ScenarioDetails>(scenario.Title,
              new Dictionary<string, object> { { "Item", scenario } },
              new DialogOptions { Width = "900px", Height = "600px" });
    }

    bool isDeleteVisualDialogVisible = false;
    int scenarioIdToDelete = 0;
    void DeleteItem(int id)
    {
        scenarioIdToDelete = id;
        isDeleteVisualDialogVisible = true;
    }

    async Task ConfirmDelete()
    {
        isDeleteVisualDialogVisible = false;
        if (scenarioIdToDelete != 0)
        {
            await ScenarioService.DeleteAsync(scenarioIdToDelete);
            await Refresh();
            NotificationService.Notify(NotificationSeverity.Success, "Система", "Данные удалены");
        }
        scenarioIdToDelete = 0;
    }

    void CloseDeleteDialog()
    {
        isDeleteVisualDialogVisible = false;
        scenarioIdToDelete = 0;
    }
}