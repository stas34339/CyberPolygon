@page "/scenario"
@using CyberPolygon.Components.Components
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@using CyberPolygon.Services
@rendermode InteractiveServer

@implements IDisposable
@inject ScenarioService ScenarioService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<CyberPolygon.Data.ApplicationDbContext> ContextFactory
@inject CatalogUpdateService CatalogUpdateService
@inject ScenarioSessionManager SessionManager

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .scenarios-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-muted);
        padding: 30px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 15px;
    }

    .difficulty-section {
        margin-bottom: 50px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 30px;
        padding-bottom: 18px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 80px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

        .section-title h3 {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

    .scenarios-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 25px;
    }

    .scenario-card {
        background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-card-hover) 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        position: relative;
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

        .scenario-card:hover {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 15px rgba(78, 195, 209, 0.2);
            transform: translateY(-5px);
        }

    .card-title {
        color: var(--text-light);
        margin-bottom: 15px;
        font-weight: bold;
        font-size: 1.25rem;
        word-break: break-word;
        overflow-wrap: break-word;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-right: 70px;
    }

    .card-desc {
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 20px;
        color: var(--text-muted);
        flex-grow: 1;
        word-break: break-word;
        overflow-wrap: break-word;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .admin-actions {
        position: absolute;
        top: 15px;
        right: 15px;
        display: flex;
        gap: 8px;
        z-index: 10;
    }

    .btn-icon {
        background: transparent;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        color: var(--text-muted);
        cursor: pointer;
        padding: 5px;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-icon:hover {
            color: var(--accent-cyan);
            border-color: var(--accent-cyan);
        }

        .btn-icon.delete:hover {
            color: var(--danger-color);
            border-color: var(--danger-color);
        }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-gradient:hover {
            box-shadow: 0 5px 15px rgba(78, 195, 209, 0.4);
            transform: translateY(-2px);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-outline-light:hover {
            background: rgba(255,255,255,0.05);
            border-color: var(--accent-light-blue);
            color: var(--accent-light-blue);
        }

    .cyber-badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        white-space: nowrap;
    }

        .cyber-badge.section-badge {
            padding: 6px 14px;
            font-size: 0.85rem;
            margin: 0;
        }

    .diff-easy {
        background: rgba(152, 195, 121, 0.15);
        border: 1px solid rgba(152, 195, 121, 0.5);
        color: var(--success-color);
    }

    .diff-medium {
        background: rgba(229, 192, 123, 0.15);
        border: 1px solid rgba(229, 192, 123, 0.5);
        color: var(--warning-color);
    }

    .diff-hard {
        background: rgba(224, 108, 117, 0.15);
        border: 1px solid rgba(224, 108, 117, 0.5);
        color: var(--danger-color);
    }

    .cyber-tag {
        background: rgba(78, 195, 209, 0.1);
        border: 1px solid rgba(78, 195, 209, 0.3);
        color: var(--accent-light-blue);
    }

    .status-badge-mini {
        font-size: 0.7rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 4px 8px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: 1px solid transparent;
        flex-shrink: 0;
    }

    .status-in-progress {
        background: rgba(78, 195, 209, 0.1);
        color: var(--accent-cyan);
        border-color: rgba(78, 195, 209, 0.3);
    }

    .status-completed {
        background: rgba(152, 195, 121, 0.1);
        color: var(--success-color);
        border-color: rgba(152, 195, 121, 0.3);
    }

    .status-failed {
        background: rgba(224, 108, 117, 0.1);
        color: var(--danger-color);
        border-color: rgba(224, 108, 117, 0.3);
    }

    .status-available {
        background: rgba(143, 160, 181, 0.1);
        color: var(--text-muted);
        border-color: var(--border-color);
    }
</style>

<div class="scenarios-container">
    <div class="page-header">
        <h2 style="color: var(--accent-light-blue); margin: 0; text-transform: uppercase; font-weight: 700;">Каталог сценариев</h2>
        <AuthorizeView Roles="Admin">
            <button class="btn-primary-gradient" @onclick="@(() => NavigationManager.NavigateTo("/scenario/edit"))">
                <RadzenIcon Icon="add" Style="vertical-align: middle;" /> Новый сценарий
            </button>
        </AuthorizeView>
    </div>

    @if (scenarios == null)
    {
        <div class="text-center mt-5"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" /></div>
    }
    else if (!scenarios.Any())
    {
        <div class="text-center mt-5">
            <RadzenIcon Icon="search_off" Style="font-size: 4rem; color: var(--border-color);" />
            <h4 class="mt-3">Нет доступных сценариев</h4>
            <p>В данный момент вам не назначено ни одного сценария или они находятся в черновиках.</p>
        </div>
    }
    else
    {
        var queuedGroups = scenarios.GroupBy(s => string.IsNullOrWhiteSpace(s.Difficulty) ? "Без категории" : s.Difficulty).OrderBy(g => GetDifficultyOrder(g.Key));

        @foreach (var group in queuedGroups)
        {
            <div class="difficulty-section" @key="group.Key">
                <div class="section-title">
                    <span class="cyber-badge section-badge @GetDifficultyClass(group.Key)"><RadzenIcon Icon="speed" Style="font-size: 1.1rem; margin-top: -2px;" /> Уровень: @group.Key</span>
                    <h3 style="color: @GetDifficultyColor(group.Key);">Сценарии</h3>
                </div>

                <div class="scenarios-grid">
                    @foreach (var item in group)
                    {
                        var currentStatus = userProgresses.ContainsKey(item.Id) ? userProgresses[item.Id] : AttemptStatus.NotStarted;

                        <div class="scenario-card" @key="item.Id">
                            <AuthorizeView Roles="Admin">
                                <div class="admin-actions">
                                    <button class="btn-icon edit" @onclick="@(() => OpenEditDialog(item))" title="Редактировать"><RadzenIcon Icon="edit" /></button>
                                    <button class="btn-icon delete" @onclick="@(() => DeleteItem(item.Id))" title="Удалить"><RadzenIcon Icon="delete" /></button>
                                </div>
                            </AuthorizeView>

                            <h3 class="card-title" title="@item.Title">@item.Title</h3>

                            <div class="d-flex gap-2 mb-3 flex-wrap">
                                @switch (currentStatus)
                                {
                                    case AttemptStatus.InProgress:
                                        <span class="status-badge-mini status-in-progress"><RadzenIcon Icon="clock_loader_40" Style="font-size: 0.9rem;" /> В процессе</span>
                                        break;
                                    case AttemptStatus.Completed:

                                        <span class="status-badge-mini status-completed"><RadzenIcon Icon="check" Style="font-size: 0.9rem;" /> Выполнено</span>
                                        break;
                                    case AttemptStatus.Failed:

                                        <span class="status-badge-mini status-failed"><RadzenIcon Icon="error_outline" Style="font-size: 0.9rem;" /> Провалено</span>
                                        break;
                                    default:

                                        <span class="status-badge-mini status-available"><RadzenIcon Icon="domain_verification" Style="font-size: 0.9rem;" /> Доступно</span>
                                        break;
                                }

                                @if (item.Scope == VisibilityScope.TeamOnly)
                                {
                                    <span class="cyber-badge" style="background: rgba(229,192,123,0.1); border: 1px solid var(--warning-color); color: var(--warning-color);"><RadzenIcon Icon="groups" Style="font-size: 0.9rem; margin-top: -2px;" /> Командный</span>
                                }
                                else
                                {
                                    <span class="cyber-badge" style="background: rgba(91,163,227,0.1); border: 1px solid var(--accent-blue); color: var(--accent-blue);"><RadzenIcon Icon="person" Style="font-size: 0.9rem; margin-top: -2px;" /> Индивидуальный</span>
                                }

                                @if (!string.IsNullOrEmpty(item.Tags))
                                {
                                    @foreach (var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="cyber-badge cyber-tag"><RadzenIcon Icon="sell" Style="font-size: 0.9rem; margin-top: -2px;" /> @tag.Trim()</span>
                                    }
                                }
                            </div>

                            <p class="card-desc" title="@item.Description">@(string.IsNullOrWhiteSpace(item.Description) ? "Описание отсутствует." : item.Description)</p>

                            <div class="mt-auto pt-3" style="border-top: 1px solid var(--border-color);">
                                <button class="btn-outline-light" @onclick="@(() => NavigationManager.NavigateTo($"/scenario/{item.Id}/workspace"))">
                                    @if (currentStatus == AttemptStatus.InProgress)
                                    {
                                        <span><RadzenIcon Icon="play_arrow" Style="font-size: 1.2rem; margin-top: -2px;" /> Продолжить</span>
                                    }
                                    else if (currentStatus == AttemptStatus.Completed || currentStatus == AttemptStatus.Failed)
                                    {

                                        <span><RadzenIcon Icon="visibility" Style="font-size: 1.2rem; margin-top: -2px;" /> Результаты</span>
                                    }
                                    else
                                    {

                                        <span><RadzenIcon Icon="terminal" Style="font-size: 1.2rem; margin-top: -2px;" /> Запустить терминал</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (isDeleteVisualDialogVisible)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(5px); z-index: 1050; position: fixed; top: 0; left: 0; right: 0; bottom: 0;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color);">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-color);"><h5 class="modal-title" style="color: var(--text-light);">Подтверждение удаления</h5><button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteDialog"></button></div>
                <div class="modal-body"><p style="color: var(--text-muted);">Вы действительно хотите навсегда удалить этот сценарий?</p></div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-color);"><button type="button" class="btn btn-secondary" style="background: transparent; border: 1px solid var(--border-color); color: var(--text-light);" @onclick="CloseDeleteDialog">Отмена</button><button type="button" class="btn btn-danger" style="background: var(--danger-color); border: none;" @onclick="ConfirmDelete">Удалить</button></div>
            </div>
        </div>
    </div>
}

@code {
    List<CyberScenario>? scenarios;
    private Dictionary<int, AttemptStatus> userProgresses = new();
    private string currentUserId = string.Empty;
    private int? currentTeamId = null;
    private bool isAdmin = false;
    private readonly SemaphoreSlim _lock = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        CatalogUpdateService.OnCatalogChanged += HandleExternalUpdate;
        SessionManager.TeamProgressChanged += OnTeamProgressChanged;

        await Refresh();
    }

    private async void HandleExternalUpdate()
    {
        await InvokeAsync(async () =>
        {
            await Refresh();
            StateHasChanged();
        });
    }

    private async void OnTeamProgressChanged(int teamId)
    {
        if (currentTeamId == teamId)
        {
            await InvokeAsync(async () =>
            {
                await Refresh();
                StateHasChanged();
            });
        }
    }

    async Task Refresh()
    {
        // Предотвращаем одновременные конкурентные запросы к контексту данных
        if (!await _lock.WaitAsync(0)) return;

        try
        {
            var allScenarios = await ScenarioService.GetAllAsync();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState.User;
            currentUserId = userPrincipal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            isAdmin = userPrincipal.IsInRole("Admin");

            userProgresses.Clear();

            if (!string.IsNullOrEmpty(currentUserId))
            {
                using var context = await ContextFactory.CreateDbContextAsync();
                var dbUser = await context.Set<ApplicationUser>().Include(u => u.Teams).AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUserId);
                currentTeamId = dbUser?.Teams?.FirstOrDefault()?.Id;

                // ОПТИМИЗАЦИЯ: Извлекаем из БД строго записи текущего пользователя или его команды
                var progresses = await context.Set<UserScenarioProgress>()
                    .Where(p => p.UserId == currentUserId || (currentTeamId.HasValue && p.TeamId == currentTeamId.Value))
                    .AsNoTracking()
                    .ToListAsync();

                foreach (var item in allScenarios)
                {
                    UserScenarioProgress? p = null;
                    if (item.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
                        p = progresses.FirstOrDefault(x => x.CyberScenarioId == item.Id && x.TeamId == currentTeamId.Value && x.IsTeamAttempt);
                    else
                        p = progresses.FirstOrDefault(x => x.CyberScenarioId == item.Id && x.UserId == currentUserId && !x.IsTeamAttempt);

                    if (p != null) userProgresses[item.Id] = p.Status;
                }
            }

            if (isAdmin)
            {
                scenarios = allScenarios;
            }
            else
            {
                using var context = await ContextFactory.CreateDbContextAsync();
                var dbUser = await context.Set<ApplicationUser>().Include(u => u.Teams).AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUserId);
                if (dbUser == null) { scenarios = new List<CyberScenario>(); return; }

                var userTeamIds = dbUser.Teams?.Select(t => t.Id).ToList() ?? new List<int>();
                scenarios = allScenarios.Where(s => s.IsVisible && (s.Scope == VisibilityScope.Public || (s.Scope == VisibilityScope.GroupOnly && !string.IsNullOrEmpty(s.AllowedUserIds) && s.AllowedUserIds.Contains(currentUserId)) || (s.Scope == VisibilityScope.TeamOnly && !string.IsNullOrEmpty(s.AllowedTeamIds) && userTeamIds.Any(t => s.AllowedTeamIds.Contains(t.ToString()))))).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки каталога сценариев: {ex.Message}");
            scenarios ??= new List<CyberScenario>();
        }
        finally
        {
            _lock.Release();
        }
    }

    void OpenEditDialog(CyberScenario scenario) => NavigationManager.NavigateTo($"/scenario/edit/{scenario.Id}");

    bool isDeleteVisualDialogVisible = false; int scenarioIdToDelete = 0;
    void DeleteItem(int id) { scenarioIdToDelete = id; isDeleteVisualDialogVisible = true; }

    async Task ConfirmDelete()
    {
        isDeleteVisualDialogVisible = false;
        if (scenarioIdToDelete != 0)
        {
            await ScenarioService.DeleteAsync(scenarioIdToDelete);
            CatalogUpdateService.NotifyCatalogChanged();
            NotificationService.Notify(NotificationSeverity.Success, "Система", "Данные удалены");
        }
        scenarioIdToDelete = 0;
    }

    void CloseDeleteDialog() { isDeleteVisualDialogVisible = false; scenarioIdToDelete = 0; }

    private int GetDifficultyOrder(string difficulty) => difficulty switch { "Легкий" => 1, "Средний" => 2, "Сложный" => 3, _ => 4 };
    private string GetDifficultyClass(string difficulty) => difficulty switch { "Легкий" => "diff-easy", "Средний" => "diff-medium", "Сложный" => "diff-hard", _ => "diff-easy" };
    private string GetDifficultyColor(string difficulty) => difficulty switch { "Легкий" => "var(--success-color)", "Средний" => "var(--warning-color)", "Сложный" => "var(--danger-color)", _ => "var(--text-light)" };

    public void Dispose()
    {
        CatalogUpdateService.OnCatalogChanged -= HandleExternalUpdate;
        SessionManager.TeamProgressChanged -= OnTeamProgressChanged;
    }
}