@page "/"
@using CyberPolygon.Components.Components
@rendermode InteractiveServer

@inject ScenarioService ScenarioService
@inject DialogService DialogService
@inject NotificationService NotificationService
<RadzenComponents />
<PageTitle>Сценарии | Киберполигон</PageTitle>

<div class="scenarios-grid">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="cyber-header">Боевые сценарии</h1>
        <AuthorizeView Roles="Admin">
            <RadzenButton Text="Новый сценарий" Icon="add" ButtonStyle="ButtonStyle.Info"
                          Click="@(() => OpenEditDialog(new CyberScenario()))" />
        </AuthorizeView>
    </div>

    @if (scenarios == null)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (!scenarios.Any())
    {
        <div class="empty-db">База данных пуста. Сценарии не обнаружены.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in scenarios)
            {
                @* --- ЗАМЕНИТЕ ЭТУ СТРОКУ --- *@
                @* <div class="col-md-4 mb-4 d-flex align-items-stretch"> *@

                @* --- НА ЭТУ --- *@
                <div class="col-md-4 mb-4">
                    @* Просто стандартная колонка, без d-flex *@

                    @* Класс h-100 на карточке мы оставляем! Он по-прежнему растягивает её по высоте соседних *@
                    <RadzenCard class="cyber-card h-100">
                        <div class="card-glow"></div>
                        <h3 class="item-title">@item.Title</h3>
                        <p class="item-desc">@item.Description</p>

                        <div class="d-flex justify-content-between mt-4">
                            <RadzenButton Text="Подробнее"
                                          ButtonStyle="ButtonStyle.Info"
                                          Variant="Variant.Outlined"
                                          class="cyan-border"
                                          Click="@(() => OpenDetails(item))" />

                            <AuthorizeView Roles="Admin">
                                <div class="admin-tools">
                                    <RadzenButton Icon="edit" Size="ButtonSize.Small"
                                                  Click="@(() => OpenEditDialog(item))" />
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                  Click="@(() => DeleteItem(item.Id))" />
                                </div>
                            </AuthorizeView>
                        </div>
                    </RadzenCard>
                </div>
            }
        </div>
    }
</div>
@if (isDeleteVisualDialogVisible)
{
    <div class="cyber-modal-overlay">
        <div class="cyber-modal-box">
            <div class="cyber-modal-header">
                <h3>Предупреждение</h3>
                <button class="cyber-modal-close-btn" @onclick="CloseDeleteDialog">×</button>
            </div>
            <div class="cyber-modal-body">
                <p>Удалить сценарий из базы навсегда?</p>
            </div>
            <div class="cyber-modal-footer">
                <button class="cyber-btn-ok" @onclick="ConfirmDelete">OK</button>
                <button class="cyber-btn-cancel" @onclick="CloseDeleteDialog">CANCEL</button>
            </div>
        </div>
    </div>
}
@code {
    List<CyberScenario>? scenarios;


    protected override async Task OnInitializedAsync() => await Refresh();

    async Task Refresh() => scenarios = await ScenarioService.GetAllAsync();

    async Task OpenEditDialog(CyberScenario scenario)
    {
        var res = await DialogService.OpenAsync<ScenarioEditor>("Управление сценарием",
                  new Dictionary<string, object> { { "Item", scenario } },
                  new DialogOptions { Width = "900px", Height = "700px" });
        if (res == true) await Refresh();
    }

    async Task OpenDetails(CyberScenario scenario)
    {
        await DialogService.OpenAsync<ScenarioDetails>(scenario.Title,
              new Dictionary<string, object> { { "Item", scenario } },
              new DialogOptions { Width = "900px", Height = "700px" });
    }

    bool isDeleteVisualDialogVisible = false;
    int scenarioIdToDelete = 0;

    // 1. Метод, который срабатывает при клике на иконку урны в карточке
    void DeleteItem(int id)
    {
        scenarioIdToDelete = id;
        isDeleteVisualDialogVisible = true; // Просто показываем наше окно
    }

    // 2. Метод, если пользователь нажал OK
    async Task ConfirmDelete()
    {
        isDeleteVisualDialogVisible = false; // Прячем окно

        if (scenarioIdToDelete != 0)
        {
            await ScenarioService.DeleteAsync(scenarioIdToDelete);
            await Refresh();
            NotificationService.Notify(NotificationSeverity.Success, "Система", "Данные удалены");
        }
        scenarioIdToDelete = 0;
    }

    // 3. Метод, если пользователь закрыл окно или нажал CANCEL
    void CloseDeleteDialog()
    {
        isDeleteVisualDialogVisible = false;
        scenarioIdToDelete = 0;
    }
}