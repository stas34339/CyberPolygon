@page "/scenario/{Id:int}/workspace"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Threading
@implements IDisposable
@rendermode InteractiveServer

@inject ScenarioSessionManager SessionManager
@inject ScenarioService ScenarioService
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env

<PageTitle>Терминал: @(scenario?.Title ?? "Загрузка...")</PageTitle>
<RadzenComponents />

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --border-color: #2a3a4a;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --success-color: #98c379;
        --danger-color: #e06c75;
    }

    .workspace-container {
        background-color: var(--bg-main);
        min-height: 100vh;
        color: var(--text-light);
    }

    .panel-box {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
    }

    .schema-box {
        background: #0d1117;
        border: 1px dashed var(--accent-cyan);
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        margin-bottom: 30px;
        position: relative;
    }

    .flag-block {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .f-correct {
        border-color: var(--success-color) !important;
        background: rgba(152, 195, 121, 0.05);
    }

    .dark-input {
        background: #131924 !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        width: 100%;
        border-radius: 6px;
    }

        .dark-input:focus {
            border-color: var(--accent-cyan) !important;
        }

    /* Блюр зона */
    .blur-zone-wrapper {
        position: relative;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
        background: #131924;
        min-height: 600px;
    }

    .blur-overlay-content {
        filter: blur(8px);
        opacity: 0.3;
        user-select: none;
        pointer-events: none;
        padding: 30px;
    }

    .lock-center-panel {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 5;
        background: rgba(26, 35, 50, 0.6);
        text-align: center;
    }

    .btn-action {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 12px 20px;
        border-radius: 6px;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-action:hover {
            box-shadow: 0 4px 15px rgba(78, 195, 209, 0.4);
        }

    .btn-zoom {
        background: transparent;
        border: 1px solid var(--border-color);
        color: #8fa0b5;
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-zoom:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }

    /* Таблица админа */
    .rz-datagrid {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 8px !important;
    }

    .rz-grid-table thead th {
        background-color: #1a1d21 !important;
        color: var(--accent-cyan) !important;
        border-bottom: 1px solid var(--border-color) !important;
        border-right: 1px solid var(--border-color) !important;
    }

    .rz-grid-table tbody tr {
        background-color: var(--bg-card) !important;
        color: #8fa0b5 !important;
    }

        .rz-grid-table tbody tr:hover {
            background-color: #1e2d3d !important;
        }

    .rz-grid-table td {
        border-bottom: 1px solid var(--border-color) !important;
        border-right: 1px solid var(--border-color) !important;
    }

    .rz-pager {
        background-color: #1a1d21 !important;
        border-top: 1px solid var(--border-color) !important;
        color: #8fa0b5 !important;
    }

    .rz-pager-button {
        background: transparent !important;
        color: #8fa0b5 !important;
    }

        .rz-pager-button.rz-state-active {
            background-color: var(--accent-cyan) !important;
            color: #1e1e1e !important;
        }
</style>

<div class="workspace-container p-4">
    @if (scenario == null || currentUserProgress == null)
    {
        <div class="text-center p-5"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color);" /></div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="panel-box" style="position: sticky; top: 20px;">
                    <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" class="mb-4" Click="@(() => NavigationManager.NavigateTo("scenario"))" Style="color: #8fa0b5; border-color: var(--border-color);" />

                    <h3 style="color: var(--accent-cyan); font-weight: bold; margin-bottom: 15px;">@scenario.Title</h3>

                    @if (currentUserProgress.Status == AttemptStatus.InProgress && scenario.DurationInMinutes > 0)
                    {
                        <div class="p-3 mb-4 text-center rounded" style="border: 1px solid var(--accent-cyan); color: var(--accent-cyan); font-family: monospace; font-size: 1.5rem; background: rgba(78,195,209,0.05);">
                            <RadzenIcon Icon="timer" Style="vertical-align: middle; margin-right: 5px;" /> @timeLeft.ToString(@"hh\:mm\:ss")
                        </div>
                    }

                    <div style="font-size: 0.95rem; color: #8fa0b5; margin-bottom: 25px; line-height: 1.6;">@((MarkupString)scenario.Legend)</div>

                    @if (scenario.Documents != null && scenario.Documents.Any())
                    {
                        <div style="font-size: 0.85rem; text-transform: uppercase; color: var(--accent-cyan); font-weight: bold; margin-bottom: 10px;">Материалы:</div>
                        <ul class="mb-4" style="padding-left: 20px; color: #5ba3e3;">
                            @foreach (var doc in scenario.Documents)
                            {
                                <li class="mb-2"><a href="@doc.FilePath" target="_blank" style="color: inherit; text-decoration: none;"><RadzenIcon Icon="description" Style="font-size:1rem; vertical-align:middle;" /> @doc.Title</a></li>
                            }
                        </ul>
                    }

                    @if (currentUserProgress.Status == AttemptStatus.NotStarted)
                    {
                        <button class="btn-action w-100 py-3" @onclick="StartScenario">НАЧАТЬ СИМУЛЯЦИЮ</button>
                    }
                    else if (currentUserProgress.Status == AttemptStatus.InProgress)
                    {
                        <div class="p-3 mb-3 rounded text-center" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color);">Текущий счет: <b style="color: var(--accent-cyan); font-size: 1.2rem;">@totalScore XP</b></div>
                        <RadzenButton Text="ЗАВЕРШИТЬ И ОТПРАВИТЬ ОТЧЕТ" class="w-100 py-2" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="CompleteScenario" />
                    }
                    else if (currentUserProgress.Status == AttemptStatus.Completed)
                    {
                        <div class="p-4 text-center rounded" style="border: 1px solid var(--success-color); background: rgba(152,195,121,0.1);">
                            <h4 style="color: var(--success-color); font-weight: bold; margin-bottom: 5px;">СЦЕНАРИЙ УСПЕШНО ЗАВЕРШЕН</h4>
                            <p style="margin: 0; color: #cbe0f5;">Итоговый счет: <b style="font-size: 1.2rem;">@currentUserProgress.Score XP</b></p>
                        </div>
                    }
                    else if (currentUserProgress.Status == AttemptStatus.Failed)
                    {
                        <div class="p-4 text-center rounded" style="border: 1px solid var(--danger-color); background: rgba(224,108,117,0.1);">
                            <h4 style="color: var(--danger-color); font-weight: bold; margin-bottom: 5px;">МИССИЯ ПРОВАЛЕНА</h4>
                            <p style="margin: 0; color: #cbe0f5; margin-bottom: 15px;">Время истекло.</p>
                            <button class="btn-action w-100" style="background: var(--danger-color); color: white;" @onclick="RestartScenario">ПОПРОБОВАТЬ СНОВА</button>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-8">
                @if (currentUserProgress.Status == AttemptStatus.NotStarted)
                {
                    <div class="blur-zone-wrapper shadow-lg">
                        <div class="lock-center-panel">
                            <RadzenIcon Icon="lock" Style="font-size: 4rem; color: var(--accent-cyan); margin-bottom: 15px;" />
                            <h5 style="color: white; font-weight: bold; text-transform: uppercase;">Система заблокирована</h5>
                            <p style="color: #8fa0b5; font-size: 0.95rem; max-width: 70%;">Запустите сценарий на левой панели управления для получения доступа к сетевой инфраструктуре и полям ввода.</p>
                        </div>
                        <div class="blur-overlay-content">
                            <div class="schema-box" style="height: 250px;"></div>
                            <div class="flag-block"><div style="width: 60%; height: 20px; background: #343a42; margin-bottom:15px;"></div><div style="width: 100%; height: 40px; background: #131924;"></div></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="panel-box" style="min-height: 600px;">
                        @if (!string.IsNullOrEmpty(scenario.SchemaPath))
                        {
                            <div class="schema-box" style="height: 400px; display: flex; flex-direction: column;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 style="color: #cbe0f5; font-weight: bold; margin: 0;">Архитектура сети</h5>
                                    @if (!isXmlSchema)
                                    {
                                        <div style="display: flex; gap: 8px;">
                                            <button class="btn-zoom" @onclick="ZoomIn"><RadzenIcon Icon="zoom_in" /></button>
                                            <button class="btn-zoom" @onclick="ZoomOut"><RadzenIcon Icon="zoom_out" /></button>
                                            <button class="btn-zoom" @onclick="ResetZoom"><RadzenIcon Icon="restart_alt" /></button>
                                        </div>
                                    }
                                </div>

                                <div style="flex-grow: 1; border-radius: 4px; overflow: hidden; background: #0d1117;">
                                    @if (isXmlSchema)
                                    {
                                        <iframe id="drawio-workspace-iframe" style="width: 100%; height: 100%; border: none; background: #0d1117;"></iframe>
                                    }
                                    else
                                    {
                                        <div style="overflow: auto; width: 100%; height: 100%; padding: 10px;">
                                            <img src="@scenario.SchemaPath" style="transform: scale(@schemaZoomLevel); transform-origin: top left; transition: transform 0.2s ease; max-width: none;" />
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                            <h5 style="color: var(--accent-light-blue); font-weight: bold; margin: 0;">Терминал проверки</h5>
                            <span class="badge" style="background: rgba(78,195,209,0.1); border: 1px solid var(--accent-cyan); color: var(--accent-cyan); padding: 5px 12px;">Режим: @(scenario.GameMode == ScenarioGameMode.AllAtOnce ? "Свободный" : "Последовательный")</span>
                        </div>

                        @foreach (var qState in questionStates)
                        {
                            var index = questionStates.IndexOf(qState);
                            @if (scenario.GameMode == ScenarioGameMode.AllAtOnce || index == 0 || questionStates[index - 1].IsCorrect)
                            {
                                <div class="flag-block @(qState.IsCorrect ? "f-correct" : "")">
                                    <div class="d-flex justify-content-between mb-3">
                                        <span style="color: var(--accent-blue); font-weight: bold;">ЗАДАНИЕ №@(index + 1)</span>
                                        <div style="font-family: monospace; font-size: 0.85rem;">
                                            <span style="color: var(--success-color);">+@qState.CurrentAward XP</span> | <span style="color: var(--danger-color);">-@qState.Question.PenaltyPoints XP</span>
                                        </div>
                                    </div>

                                    <p style="font-size: 1rem; margin-bottom: 15px; color: #cbe0f5;">@qState.Question.Text</p>

                                    <div class="d-flex gap-2 align-items-center">
                                        <RadzenTextBox @bind-Value="@qState.UserAnswer" Disabled="@qState.IsCorrect" Placeholder="@(qState.IsCorrect ? "Ответ принят" : "Введите ваш ответ или флаг...")" class="w-100 dark-input" @onkeypress="@(async (e) => await HandleKeyPress(e, qState))" />
                                        @if (!qState.IsCorrect)
                                        {
                                            <button class="btn-action" style="padding: 8px 16px; font-size: 0.85rem;" @onclick="@(async () => await CheckAnswer(qState))">ПРОВЕРИТЬ</button>
                                        }
                                        else
                                        {
                                            <RadzenIcon Icon="check_circle" Style="color: var(--success-color); font-size: 2rem;" />
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(qState.FeedbackMessage))
                                    {
                                        <div style="margin-top: 10px; font-size: 0.9rem; font-family: monospace; color: @(qState.IsCorrect ? "var(--success-color)" : "var(--danger-color)");">@qState.FeedbackMessage</div>
                                    }
                                </div>
                            }
                        }

                        @* БЛОК АДМИНА НИЖЕ ЗАДАНИЙ *@
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <div class="mt-5 p-4" style="background: rgba(224, 108, 117, 0.02); border: 1px solid rgba(224, 108, 117, 0.2); border-radius: 8px;">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <h5 style="color: var(--danger-color); font-weight: bold; margin: 0;"><RadzenIcon Icon="monitor_heart" Style="vertical-align: middle; margin-right: 8px;" /> Мониторинг прохождений</h5>
                                        <button class="btn-action" style="background: var(--danger-color); color: white; padding: 6px 16px; font-size: 0.8rem;" @onclick="ResetAllProgress">Сбросить ВСЕ</button>
                                    </div>

                                    @if (completedUsers == null || !completedUsers.Any())
                                    {
                                        <div class="text-center py-4" style="color: #8fa0b5;"><RadzenIcon Icon="cloud_off" Style="font-size: 2rem; color: var(--border-color);" /><br />Активных прохождений не обнаружено</div>
                                    }
                                    else
                                    {
                                        <RadzenDataGrid Data="@completedUsers" TItem="UserScenarioProgressDto" AllowPaging="true" PageSize="10" Density="Density.Compact">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="UserScenarioProgressDto" Title="Агент / Команда">
                                                    <Template Context="data">
                                                        <div class="d-flex flex-column">
                                                            @if (data.IsTeamAttempt)
                                                            {
                                                                <span style="color: #cbe0f5; font-weight: bold;">Команда: @data.TeamName</span>
                                                            }
                                                            else
                                                            {

                                                                <span style="color: #cbe0f5; font-weight: bold;">@data.UserName</span> <span style="color: #8fa0b5; font-size: 0.75rem;">@data.Email</span>
                                                            }
                                                        </div>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="UserScenarioProgressDto" Title="Статус" Width="140px" TextAlign="TextAlign.Center">
                                                    <Template Context="data">
                                                        @if (data.Status == AttemptStatus.InProgress)
                                                        {
                                                            <span style="color: var(--accent-cyan); font-weight: bold;">В ПРОЦЕССЕ</span>
                                                        }
                                                        else if (data.Status == AttemptStatus.Completed)
                                                        {

                                                            <span style="color: var(--success-color); font-weight: bold;">УСПЕХ</span>
                                                        }
                                                        else if (data.Status == AttemptStatus.Failed)
                                                        {

                                                            <span style="color: var(--danger-color); font-weight: bold;">ПРОВАЛ</span>
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="UserScenarioProgressDto" Property="Score" Title="Баллы" Width="110px" TextAlign="TextAlign.Center">
                                                    <Template Context="data"><span style="color: var(--accent-cyan); font-weight: bold;">@data.Score XP</span></Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="UserScenarioProgressDto" Title="Действия" Width="80px" TextAlign="TextAlign.Center">
                                                    <Template Context="data">
                                                        <button class="btn-zoom" style="color: #e5c07b; border-color: rgba(229, 192, 123, 0.3);" @onclick="@(async () => await ResetSessionById(data.Id))"><RadzenIcon Icon="restart_alt" /></button>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>
                                        </RadzenDataGrid>
                                    }
                                </div>
                            </Authorized>
                        </AuthorizeView>

                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private CyberScenario? scenario;
    private UserScenarioProgress? currentUserProgress;
    private List<UserScenarioProgressDto> completedUsers = new();
    private bool isAdmin = false;
    private string currentUserId = string.Empty;
    private Timer? _timer;
    private TimeSpan timeLeft = TimeSpan.Zero;
    private int totalScore = 0;
    private bool isXmlSchema = false;
    private string schemaXmlContent = string.Empty;
    private bool isViewerLoaded = false;
    private double schemaZoomLevel = 1.0;

    public class UserQuestionState
    {
        public ScenarioQuestion Question { get; set; } = new();
        public string UserAnswer { get; set; } = string.Empty;
        public bool IsCorrect { get; set; } = false;
        public string FeedbackMessage { get; set; } = string.Empty;
        public int FailedAttempts { get; set; } = 0;
        public int CurrentAward => Math.Max(0, Question.AwardPoints - (FailedAttempts * Question.PenaltyPoints));
    }

    private List<UserQuestionState> questionStates = new();

    private void ZoomIn() => schemaZoomLevel += 0.2;
    private void ZoomOut() { if (schemaZoomLevel > 0.4) schemaZoomLevel -= 0.2; }
    private void ResetZoom() => schemaZoomLevel = 1.0;

    protected override async Task OnInitializedAsync()
    {
        scenario = await ScenarioService.GetByIdAsync(Id);
        if (scenario == null) { NavigationManager.NavigateTo("/scenario"); return; }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            isAdmin = user.IsInRole("Admin");
            await LoadUserState();
            if (isAdmin) await LoadAdminData();
        }
        SessionManager.TeamProgressChanged += OnTeamProgressChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isXmlSchema && !string.IsNullOrEmpty(schemaXmlContent) && !isViewerLoaded)
        {
            try { await JSRuntime.InvokeVoidAsync("setupDrawIoViewer", "drawio-workspace-iframe", schemaXmlContent); isViewerLoaded = true; }
            catch (Exception ex) { Console.WriteLine($"Ошибка инициализации Draw.io: {ex.Message}"); }
        }
    }

    private async Task LoadUserState()
    {
        currentUserProgress = await ScenarioService.GetUserProgressAsync(currentUserId, scenario!.Id) ?? new UserScenarioProgress { Status = AttemptStatus.NotStarted };
        totalScore = currentUserProgress.Score;

        if (!string.IsNullOrEmpty(scenario.SchemaPath) && (scenario.SchemaPath.EndsWith(".xml", StringComparison.OrdinalIgnoreCase) || scenario.SchemaPath.EndsWith(".drawio", StringComparison.OrdinalIgnoreCase) || scenario.SchemaPath.EndsWith(".drawioa", StringComparison.OrdinalIgnoreCase)))
        {
            isXmlSchema = true;
            try { var filePath = Path.Combine(Env.WebRootPath, scenario.SchemaPath.TrimStart('/')); if (System.IO.File.Exists(filePath)) schemaXmlContent = await System.IO.File.ReadAllTextAsync(filePath); }
            catch { }
        }
        if (scenario.Questions != null && questionStates.Count == 0) questionStates = scenario.Questions.Select(q => new UserQuestionState { Question = q }).ToList();

        if (currentUserProgress.Id != 0)
        {
            var statesDb = await ScenarioService.GetUserQuestionStatesAsync(currentUserProgress.Id);
            foreach (var qState in questionStates) { if (statesDb.TryGetValue(qState.Question.Id, out var dbInfo)) { qState.IsCorrect = dbInfo.IsCorrect; qState.FailedAttempts = dbInfo.FailedAttempts; } }
        }
        if (currentUserProgress.Status == AttemptStatus.InProgress) { CheckTime(); StartTimer(); }
    }

    private async void OnTeamProgressChanged(int teamId) { if (scenario?.Scope == VisibilityScope.TeamOnly && scenario.TargetTeamId == teamId) { await InvokeAsync(async () => { await LoadUserState(); StateHasChanged(); }); } }

    private async Task StartScenario() { await ScenarioService.StartScenarioAsync(currentUserId, scenario!.Id, scenario.DurationInMinutes); await LoadUserState(); if (scenario!.Scope == VisibilityScope.TeamOnly && scenario.TargetTeamId.HasValue) SessionManager.NotifyTeamUpdate(scenario.TargetTeamId.Value); }

    private async Task CheckAnswer(UserQuestionState state)
    {
        if (string.IsNullOrWhiteSpace(state.UserAnswer) || currentUserProgress?.Status != AttemptStatus.InProgress) return;
        bool isRight = string.Equals(state.UserAnswer.Trim(), state.Question.CorrectAnswer.Trim(), StringComparison.OrdinalIgnoreCase);
        var result = await ScenarioService.ProcessTeamAnswerAsync(currentUserProgress.Id, state.Question.Id, isRight, state.Question.AwardPoints, state.Question.PenaltyPoints);

        if (!result.Success) { if (result.AlreadySolved) { state.FeedbackMessage = "Задание уже было решено!"; state.IsCorrect = true; } return; }
        totalScore = result.NewTotalScore;
        if (isRight) { state.IsCorrect = true; state.FeedbackMessage = $"✓ Ответ принят! Начислено: +{result.EarnedPoints} XP."; }
        else { state.FailedAttempts++; state.FeedbackMessage = $"❌ Отказ системы. Потенциальная награда за вопрос снижена."; }

        if (scenario!.Scope == VisibilityScope.TeamOnly && scenario.TargetTeamId.HasValue) SessionManager.NotifyTeamUpdate(scenario.TargetTeamId.Value);
    }

    private async Task CompleteScenario() { StopTimer(); if (currentUserProgress != null) await ScenarioService.CompleteProgressByIdAsync(currentUserProgress.Id); await LoadUserState(); NotificationService.Notify(NotificationSeverity.Success, "Успех", $"Сценарий завершен. Итоговый счет: {totalScore}"); if (scenario!.Scope == VisibilityScope.TeamOnly && scenario.TargetTeamId.HasValue) SessionManager.NotifyTeamUpdate(scenario.TargetTeamId.Value); }

    private async Task HandleKeyPress(KeyboardEventArgs e, UserQuestionState state) { if (e.Key == "Enter") await CheckAnswer(state); }

    private async void TimerTick(object? state)
    {
        if (currentUserProgress?.TargetEndTime != null)
        {
            timeLeft = currentUserProgress.TargetEndTime.Value - DateTime.UtcNow;
            if (timeLeft.TotalSeconds <= 0) { StopTimer(); await ScenarioService.FailUserProgressAsync(currentUserId, scenario!.Id); await InvokeAsync(LoadUserState); await InvokeAsync(StateHasChanged); if (scenario!.Scope == VisibilityScope.TeamOnly && scenario.TargetTeamId.HasValue) SessionManager.NotifyTeamUpdate(scenario.TargetTeamId.Value); }
            else await InvokeAsync(StateHasChanged);
        }
    }

    private void StartTimer() { if (scenario!.DurationInMinutes > 0 && currentUserProgress?.TargetEndTime != null) { _timer?.Dispose(); _timer = new Timer(TimerTick, null, 0, 1000); } }
    private void StopTimer() => _timer?.Dispose();

    private void CheckTime() { if (currentUserProgress?.TargetEndTime != null && DateTime.UtcNow >= currentUserProgress.TargetEndTime.Value) { _ = ScenarioService.FailUserProgressAsync(currentUserId, scenario!.Id); currentUserProgress.Status = AttemptStatus.Failed; } }

    private async Task RestartScenario() { await ScenarioService.ResetUserProgressAsync(currentUserId, scenario!.Id); questionStates.ForEach(q => { q.IsCorrect = false; q.UserAnswer = ""; q.FeedbackMessage = ""; q.FailedAttempts = 0; }); await LoadUserState(); if (scenario!.Scope == VisibilityScope.TeamOnly && scenario.TargetTeamId.HasValue) SessionManager.NotifyTeamUpdate(scenario.TargetTeamId.Value); }

    private async Task LoadAdminData() => completedUsers = await ScenarioService.GetAllProgressForScenarioAsync(scenario!.Id);

    private async Task ResetAllProgress() { await ScenarioService.ResetAllProgressForScenarioAsync(scenario!.Id); await LoadAdminData(); if (!isAdmin) await LoadUserState(); }

    private async Task ResetSessionById(int progressId) { await ScenarioService.ResetProgressByIdAsync(progressId); await LoadAdminData(); if (currentUserProgress != null && currentUserProgress.Id == progressId) { StopTimer(); await LoadUserState(); } }

    public void Dispose() { StopTimer(); SessionManager.TeamProgressChanged -= OnTeamProgressChanged; }
}