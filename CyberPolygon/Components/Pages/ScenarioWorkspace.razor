@page "/scenario/{Id:int}/workspace"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Claims
@using System.Threading
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@using CyberPolygon.Models
@implements IDisposable
@rendermode InteractiveServer
@attribute [Authorize]
@inject ScenarioSessionManager SessionManager
@inject DialogService DialogService
@inject ScenarioService ScenarioService
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env
@inject IDbContextFactory<CyberPolygon.Data.ApplicationDbContext> ContextFactory

<PageTitle>Терминал: @(scenario?.Title ?? "Загрузка...") | Киберполигон</PageTitle>
<RadzenComponents />

<style>
    /* Строгая киберпанк-тема */
    :root {
        --bg-main: #0b0f17;
        --bg-card: #131924;
        --bg-card-hover: #1a2435;
        --bg-input: #131924;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --warning-color: #e5c07b;
        --danger-color: #e06c75;
    }

    html, body {
        background-color: var(--bg-main) !important;
    }

    /* Обертка на всю ширину для однородного фона */
    .full-page-wrapper {
        background-color: var(--bg-main) !important;
        min-height: calc(100vh - 60px);
        width: 100%;
        padding: 30px 20px;
        box-sizing: border-box;
    }

    .page-container {
        color: var(--text-light);
        max-width: 1600px;
        margin: 0 auto;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 35px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
        gap: 20px;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

    .header-text h1 {
        color: var(--accent-cyan);
        font-weight: 800;
        text-transform: uppercase;
        margin: 0 0 8px 0;
        font-size: 1.8rem;
        letter-spacing: 2px;
        text-shadow: 0 0 15px rgba(78, 195, 209, 0.3);
    }

    .header-text p {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* === ОБОЛОЧКА (CYBER-SHELL) === */
    .cyber-shell {
        background-color: rgba(19, 25, 36, 0.6);
        border: 1px solid rgba(78, 195, 209, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(78, 195, 209, 0.05);
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .cyber-shell-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 25px;
        background: linear-gradient(90deg, rgba(78,195,209,0.1) 0%, transparent 100%);
        border-bottom: 1px solid rgba(78, 195, 209, 0.3);
        font-family: 'Courier New', Courier, monospace;
    }

    .shell-title {
        color: var(--accent-cyan);
        font-size: 0.95rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .shell-status {
        color: var(--text-muted);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    .status-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background-color: var(--accent-light-blue);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--accent-light-blue);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(126, 200, 248, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0);
        }
    }

    .cyber-shell-body {
        padding: 30px;
    }

    /* Внутренние карточки-секции */
    .cyber-section {
        background-color: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 25px;
    }

    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
        font-weight: 700;
    }

    /* Кнопки */
    .btn-main {
        background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
        color: var(--bg-main);
        font-weight: 800;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-main:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(78, 195, 209, 0.4);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-outline-light:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-light);
            border-color: var(--text-muted);
        }

    /* Инпуты */
    .dark-input {
        background: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        width: 100%;
        border-radius: 6px;
        padding: 10px 15px;
        transition: all 0.3s ease;
    }

        .dark-input:focus {
            border-color: var(--accent-cyan) !important;
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.2) !important;
            outline: none;
        }

        .dark-input::placeholder {
            color: #5b6b7a !important;
            font-style: italic;
        }

    /* Блоки с флагами (задания) */
    .flag-block {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 25px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .f-correct {
        border-color: var(--success-color) !important;
        background: rgba(152, 195, 121, 0.05);
    }

        .f-correct::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background-color: var(--success-color);
            box-shadow: 0 0 10px var(--success-color);
        }

    .f-failed {
        border-color: var(--danger-color) !important;
        background: rgba(224, 108, 117, 0.05);
    }

        .f-failed::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background-color: var(--danger-color);
            box-shadow: 0 0 10px var(--danger-color);
        }

    /* Блокировка (Blur) */
    .blur-zone-wrapper {
        position: relative;
        border: 1px dashed var(--accent-cyan);
        border-radius: 12px;
        overflow: hidden;
        background: rgba(78, 195, 209, 0.03);
        min-height: 600px;
    }

    .lock-center-panel {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 5;
        background: rgba(11, 15, 23, 0.7);
        backdrop-filter: blur(8px);
        text-align: center;
        border-radius: 12px;
    }

        .lock-center-panel h5 {
            color: var(--accent-cyan);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 15px;
            margin-bottom: 10px;
            font-size: 1.5rem;
        }

        .lock-center-panel p {
            color: var(--text-muted);
            font-size: 0.95rem;
            max-width: 60%;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    /* Топология сети (Canvas) */
    .schema-box {
        background-color: var(--bg-main) !important;
        border: 1px dashed var(--accent-cyan);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 30px;
        position: relative;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
    }

    #topology-move-layer {
        position: absolute;
        left: 0;
        top: 0;
        background-color: var(--bg-main);
        background-image: radial-gradient(rgba(78, 195, 209, 0.2) 1px, transparent 1px);
        background-size: 30px 30px;
        box-shadow: inset 0 0 50px rgba(0,0,0,0.8);
        border: 1px solid rgba(78, 195, 209, 0.3);
        border-radius: 8px;
    }

    .btn-zoom {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        border-radius: 6px;
        padding: 6px 12px;
        cursor: pointer;
        transition: all 0.2s;
        backdrop-filter: blur(5px);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-zoom:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            background: rgba(78, 195, 209, 0.1);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.2);
        }

    /* Маркеры сети (Hotspots) */
    .network-hotspot {
        width: 48px;
        height: 48px;
        margin-left: -24px;
        margin-top: -24px;
        z-index: 100;
    }

    .hotspot-trigger {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 0 10px rgba(0,0,0,0.8);
        transition: all 0.2s ease-in-out;
    }

        .hotspot-trigger i {
            font-size: 1.6rem;
            color: #1a1d21;
        }

        .hotspot-trigger.secure {
            background: var(--success-color);
            box-shadow: 0 0 15px rgba(152, 195, 121, 0.6);
        }

        .hotspot-trigger.compromised {
            background: var(--danger-color);
            box-shadow: 0 0 15px rgba(224, 108, 117, 0.8);
            animation: cyberPulse 2s infinite;
        }

        .hotspot-trigger:hover {
            transform: scale(1.15);
            z-index: 110;
        }

    /* Тултипы карты */
    .hotspot-tooltip {
        position: absolute;
        top: 58px;
        left: 50%;
        transform: translateX(-50%) translateY(-10px);
        width: 280px;
        background: rgba(19, 25, 36, 0.95);
        border: 1px solid var(--accent-cyan);
        border-radius: 8px;
        padding: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.9);
        backdrop-filter: blur(5px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 500;
    }

        .hotspot-tooltip::before {
            content: '';
            position: absolute;
            top: -20px;
            left: 0;
            width: 100%;
            height: 20px;
            background: transparent;
        }

        .hotspot-tooltip::after {
            content: '';
            position: absolute;
            top: -6px;
            left: 50%;
            transform: translateX(-50%) rotate(45deg);
            width: 10px;
            height: 10px;
            background: var(--bg-card);
            border-left: 1px solid var(--accent-cyan);
            border-top: 1px solid var(--accent-cyan);
        }

    .network-hotspot:hover .hotspot-tooltip {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
    }

    .tooltip-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px dashed rgba(78, 195, 209, 0.4);
        padding-bottom: 8px;
        margin-bottom: 12px;
    }

    .node-name {
        font-weight: 800;
        color: var(--accent-light-blue);
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .node-status-badge {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 3px 6px;
        border-radius: 4px;
        letter-spacing: 1px;
    }

        .node-status-badge.secure {
            background: rgba(152,195,121,0.15);
            color: var(--success-color);
            border: 1px solid var(--success-color);
        }

        .node-status-badge.compromised {
            background: rgba(224,108,117,0.15);
            color: var(--danger-color);
            border: 1px solid var(--danger-color);
        }

    .info-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        margin-bottom: 6px;
        font-family: monospace;
    }

        .info-row span {
            color: var(--text-muted);
        }

        .info-row strong {
            color: var(--accent-cyan);
        }

        .info-row .val {
            color: var(--text-light);
        }

    .val-ports {
        color: var(--warning-color);
        font-weight: bold;
    }

    .tooltip-note {
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px dashed var(--border-color);
        font-size: 0.8rem;
        color: var(--text-muted);
        font-style: italic;
    }

    @@keyframes cyberPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(224, 108, 117, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(224, 108, 117, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(224, 108, 117, 0);
        }
    }

    .cyber-badge {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
</style>

<div class="full-page-wrapper">
    <div class="page-container">
        <div class="page-header">
            <div class="header-text">
                <h1>ТЕРМИНАЛ: @(scenario?.Title ?? "Загрузка...")</h1>
                <p>Информационно-аналитический департамент // Рабочая область</p>
            </div>

            <div class="d-flex align-items-center gap-3">
                <button class="btn-outline-light" @onclick="@(() => NavigationManager.NavigateTo("scenario"))">
                    <RadzenIcon Icon="arrow_back" Style="margin-right: 5px;" /> КАТАЛОГ СЦЕНАРИЕВ
                </button>
            </div>
        </div>

        @if (scenario == null || currentUserProgress == null)
        {
            <div class="text-center" style="padding: 80px 20px;">
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color); height: 6px;" />
                <p style="color: var(--accent-cyan); margin-top: 15px; font-size: 0.9rem; font-weight: bold; letter-spacing: 2px;">ПОДКЛЮЧЕНИЕ К СЕССИИ...</p>
            </div>
        }
        else
        {
            <div class="cyber-shell">
                <div class="cyber-shell-header">
                    <div class="shell-title">
                        <RadzenIcon Icon="terminal" Style="font-size: 1.2rem;" />
                        SYS.WORKSPACE // ACTIVE_SESSION
                    </div>
                    <div class="shell-status">
                        <span class="status-dot"></span>
                        ONLINE
                    </div>
                </div>

                <div class="cyber-shell-body">
                    <div class="row">
                        <!-- ЛЕВАЯ ПАНЕЛЬ: ИНФОРМАЦИЯ И УПРАВЛЕНИЕ -->
                        <div class="col-lg-4 mb-4">
                            <div class="cyber-section" style="position: sticky; top: 20px; height: auto;">

                                <h3 style="color: var(--accent-cyan); font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px;">@scenario.Title</h3>

                                @if (scenario.Scope == VisibilityScope.TeamOnly)
                                {
                                    <div class="mb-4">
                                        <span class="cyber-badge" style="background: rgba(229,192,123,0.15); border: 1px solid var(--warning-color); color: var(--warning-color);">
                                            <RadzenIcon Icon="groups" Style="font-size: 1.1rem; margin-top: -2px;" /> КОМАНДНЫЙ РЕЖИМ
                                        </span>
                                    </div>
                                }

                                @if (currentUserProgress.Status == AttemptStatus.InProgress && scenario.DurationInMinutes > 0)
                                {
                                    <div class="p-3 mb-4 text-center rounded" style="border: 1px solid var(--accent-cyan); color: var(--accent-cyan); font-family: monospace; font-size: 1.8rem; font-weight: bold; background: rgba(78,195,209,0.05); box-shadow: inset 0 0 15px rgba(78,195,209,0.1);">
                                        <RadzenIcon Icon="timer" Style="vertical-align: middle; margin-right: 8px; font-size: 2rem;" /> @timeLeft.ToString(@"hh\:mm\:ss")
                                    </div>
                                }

                                <div style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 30px; line-height: 1.7;">
                                    @((MarkupString)scenario.Legend)
                                </div>

                                @if (scenario.Documents != null && scenario.Documents.Any())
                                {
                                    <div style="font-size: 0.85rem; text-transform: uppercase; color: var(--accent-cyan); font-weight: 800; margin-bottom: 12px; letter-spacing: 1px;">
                                        <RadzenIcon Icon="folder_open" Style="margin-right: 5px;" /> Материалы:
                                    </div>
                                    <ul class="mb-4 list-unstyled" style="padding-left: 5px;">
                                        @foreach (var doc in scenario.Documents)
                                        {
                                            <li class="mb-2">
                                                <a href="/files/scenario/@doc.Id" target="_blank" style="color: var(--accent-blue); text-decoration: none; display: flex; align-items: center; gap: 8px; font-weight: 600; padding: 6px 10px; background: rgba(91,163,227,0.05); border-radius: 6px; border: 1px solid rgba(91,163,227,0.2); transition: all 0.2s;">
                                                    <RadzenIcon Icon="file_download" Style="font-size:1.1rem;" /> @doc.Title
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (currentUserProgress.Status == AttemptStatus.NotStarted)
                                {
                                    @if (isGloballyOccupied)
                                    {
                                        <div class="p-3 mb-3 rounded text-center" style="background: rgba(229,192,123,0.05); border: 1px solid var(--warning-color); box-shadow: inset 0 0 15px rgba(229,192,123,0.1);">
                                            <RadzenIcon Icon="lock_clock" Style="font-size: 2rem; color: var(--warning-color); margin-bottom: 5px;" /><br />
                                            <strong style="color: var(--warning-color); letter-spacing: 1px;">ПОЛИГОН ЗАНЯТ</strong>
                                            <p style="font-size: 0.85rem; margin: 5px 0 0 0; color: var(--text-light); line-height: 1.4;">Инфраструктуру прямо сейчас использует другой участник.<br />Дождитесь своей очереди.</p>
                                        </div>
                                        <button class="btn-outline-light w-100 py-3" disabled style="opacity: 0.5; cursor: not-allowed; border-color: var(--warning-color); color: var(--warning-color);">
                                            <RadzenIcon Icon="block" Style="font-size: 1.2rem;" /> ОЖИДАНИЕ...
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-main w-100 py-3" style="font-size: 1rem;" @onclick="StartScenario">
                                            <RadzenIcon Icon="play_arrow" Style="font-size: 1.4rem;" /> НАЧАТЬ СИМУЛЯЦИЮ
                                        </button>
                                    }
                                }
                                else if (currentUserProgress.Status == AttemptStatus.InProgress)
                                {
                                    <div class="p-3 mb-4 rounded text-center" style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color);">
                                        <span style="color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Текущий счет</span><br />
                                        <b style="color: var(--accent-cyan); font-size: 1.8rem; font-family: monospace;">@totalScore XP</b>
                                    </div>
                                    <button class="btn-outline-light w-100 py-3" style="border-color: var(--danger-color); color: var(--danger-color);" @onclick="CompleteScenario">
                                        <RadzenIcon Icon="stop_circle" Style="font-size: 1.2rem;" /> ЗАВЕРШИТЬ МИССИЮ
                                    </button>
                                }
                                else if (currentUserProgress.Status == AttemptStatus.Completed || currentUserProgress.Status == AttemptStatus.Failed)
                                {
                                    <div class="p-4 text-center rounded mb-3" style="border: 1px solid @(currentUserProgress.Status == AttemptStatus.Completed ? "var(--success-color)" : "var(--danger-color)"); background: @(currentUserProgress.Status == AttemptStatus.Completed ? "rgba(152,195,121,0.1)" : "rgba(224,108,117,0.1)");">
                                        <h4 style="color: @(currentUserProgress.Status == AttemptStatus.Completed ? "var(--success-color)" : "var(--danger-color)"); font-weight: 800; text-transform: uppercase;">
                                            @(currentUserProgress.Status == AttemptStatus.Completed ? "Сценарий завершен" : "Миссия провалена")
                                        </h4>
                                        <p style="margin: 0; color: var(--text-light);">Итоговый счет:<br /><b style="font-size: 2rem; font-family: monospace; color: @(currentUserProgress.Status == AttemptStatus.Completed ? "var(--success-color)" : "var(--danger-color)");">@currentUserProgress.Score XP</b></p>
                                    </div>

                                    @if (currentUserProgress.IsRetakeGranted)
                                    {
                                        <button class="btn-main w-100 py-2" style="background: linear-gradient(90deg, var(--success-color), #5ba3e3);" @onclick="StartScenario">
                                            <RadzenIcon Icon="play_arrow" /> НАЧАТЬ ПОВТОРНУЮ ПОПЫТКУ
                                        </button>
                                    }
                                    else if (currentUserProgress.IsRetakeRequested)
                                    {
                                        <button class="btn-outline-light w-100 py-2" disabled style="opacity: 0.5; cursor: not-allowed;">
                                            <RadzenIcon Icon="pending_actions" /> ЗАПРОС ОТПРАВЛЕН
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-main w-100 py-2" style="background: linear-gradient(90deg, var(--warning-color), #c29d59);" @onclick="RequestRetake">
                                            <RadzenIcon Icon="restart_alt" /> ЗАПРОСИТЬ ПОВТОР
                                        </button>
                                    }

                                }
                                else if (currentUserProgress.Status == AttemptStatus.Failed)
                                {
                                    <div class="p-4 text-center rounded" style="border: 1px solid var(--danger-color); background: rgba(224,108,117,0.1); box-shadow: inset 0 0 20px rgba(224,108,117,0.1); margin-bottom: 15px;">
                                        <h4 style="color: var(--danger-color); font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px;">Миссия провалена</h4>
                                        <p style="margin: 0; color: var(--text-light); margin-bottom: 20px;">Отведенное время истекло.</p>
                                    </div>
                                    @if (currentUserProgress.IsRetakeRequested)
                                    {
                                        <button class="btn-outline-light w-100 py-2" disabled style="opacity: 0.5; cursor: not-allowed;">
                                            <RadzenIcon Icon="pending_actions" /> ЗАПРОС НА ПОВТОР ОТПРАВЛЕН
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-main w-100 py-2" style="background: linear-gradient(90deg, var(--warning-color), #c29d59);" @onclick="RequestRetake">
                                            <RadzenIcon Icon="restart_alt" /> ЗАПРОСИТЬ ПОВТОР
                                        </button>
                                    }
                                }
                            </div>
                        </div>

                        <!-- ПРАВАЯ ПАНЕЛЬ: КАРТА И ЗАДАНИЯ -->
                        <div class="col-lg-8">
                            @if (currentUserProgress.Status == AttemptStatus.NotStarted)
                            {
                                <div class="blur-zone-wrapper">
                                    <div class="lock-center-panel">
                                        <RadzenIcon Icon="lock" Style="font-size: 5rem; color: var(--accent-cyan); margin-bottom: 20px; filter: drop-shadow(0 0 15px rgba(78,195,209,0.5));" />
                                        <h5>СИСТЕМА ЗАБЛОКИРОВАНА</h5>
                                        <p>Запустите симуляцию в панели слева, чтобы получить доступ к терминалу и инфраструктуре.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="cyber-section" style="padding: 0; border: none; background: transparent;">

                                    @if (scenario.Devices != null && scenario.Devices.Any())
                                    {
                                        <div class="schema-box" style="height: 520px; display: flex; flex-direction: column;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h5 style="color: var(--accent-light-blue); font-weight: 800; margin: 0; text-transform: uppercase; letter-spacing: 1px;">
                                                    <RadzenIcon Icon="account_tree" Style="margin-top: -3px; margin-right: 5px;" /> Карта инфраструктуры
                                                </h5>
                                                <div class="d-flex gap-2 flex-wrap justify-content-end">
                                                    @foreach (var device in scenario.Devices)
                                                    {
                                                        <button type="button" class="btn-zoom" @onclick="() => FocusOnDevice(device.MapX, device.MapY)">
                                                            <RadzenIcon Icon="my_location" Style="font-size:1rem; margin-right:4px; margin-top:-2px;" /> @device.Name
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <div style="flex-grow: 1; border-radius: 8px; position: relative; border: 1px solid var(--border-color); overflow: hidden; background: var(--bg-main);">
                                                <div id="schema-drag-container" style="width: 100%; height: 100%; margin: 0; padding: 0; user-select: none; position: relative; cursor: grab;">

                                                    <div id="topology-move-layer" style="width: @(canvasWidth)px; height: @(canvasHeight)px;">

                                                        @if (scenario.Connections != null && scenario.Connections.Any())
                                                        {
                                                            <svg style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; overflow: visible;">
                                                                <defs>
                                                                    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                                                                        <feGaussianBlur stdDeviation="3" result="blur" />
                                                                        <feComposite in="SourceGraphic" in2="blur" operator="over" />
                                                                    </filter>
                                                                </defs>

                                                                @foreach (var conn in scenario.Connections)
                                                                {
                                                                    var fromNode = scenario.Devices?.FirstOrDefault(d => d.Id == conn.FromDeviceId);
                                                                    var toNode = scenario.Devices?.FirstOrDefault(d => d.Id == conn.ToDeviceId);

                                                                    if (fromNode != null && toNode != null)
                                                                    {
                                                                        bool isDangerLink = fromNode.IsCompromised || toNode.IsCompromised;
                                                                        string linkColor = isDangerLink ? "var(--danger-color)" : "rgba(78, 195, 209, 0.6)";
                                                                        string dashArray = conn.LinkType == "VPN" ? "6,6" : "0";

                                                                        <line x1="@fromNode.MapX" y1="@fromNode.MapY"
                                                                              x2="@toNode.MapX" y2="@toNode.MapY"
                                                                              stroke="@linkColor" stroke-width="2" stroke-dasharray="@dashArray"
                                                                              style="@(isDangerLink ? "filter: url(#glow);" : "")" />
                                                                    }
                                                                }
                                                            </svg>
                                                        }

                                                        @if (scenario.Devices != null)
                                                        {
                                                            @foreach (var device in scenario.Devices)
                                                            {
                                                                <div class="network-hotspot" @key="device.Id" style="position: absolute; left: @(device.MapX)px; top: @(device.MapY)px;">
                                                                    <div class="hotspot-trigger @(device.IsCompromised ? "compromised" : "secure")" @onclick="() => FocusOnDevice(device.MapX, device.MapY)">
                                                                        <RadzenIcon Icon="@(string.IsNullOrEmpty(device.Type) ? "dns" : device.Type)" />
                                                                    </div>
                                                                    <div class="hotspot-tooltip">
                                                                        <div class="tooltip-header">
                                                                            <span class="node-name">@device.Name</span>
                                                                            <span class="node-status-badge @(device.IsCompromised ? "compromised" : "secure")">
                                                                                @(device.IsCompromised ? "COMPROMISED" : "ONLINE")
                                                                            </span>
                                                                        </div>
                                                                        <div class="tooltip-body">
                                                                            <div class="info-row"><span>IP-адрес:</span> <strong>@device.IpAddress</strong></div>
                                                                            <div class="info-row"><span>Система:</span> <span class="val">@device.Os</span></div>
                                                                            <div class="info-row"><span>Порты:</span> <span class="val-ports">@device.OpenPorts</span></div>

                                                                            @if (device.Applications != null && device.Applications.Any())
                                                                            {
                                                                                <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--border-color);">
                                                                                    <div style="font-size: 0.75rem; color: var(--accent-cyan); text-transform: uppercase; margin-bottom: 8px; font-weight: 800; letter-spacing: 0.5px;">
                                                                                        Установленное ПО:
                                                                                    </div>
                                                                                    @foreach (var app in device.Applications)
                                                                                    {
                                                                                        <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 4px; align-items: center;" @key="app.Id">
                                                                                            <span style="color: var(--text-light); display: flex; align-items: center; gap: 6px;">
                                                                                                <RadzenIcon Icon="layers" Style="font-size: 0.9rem; color: var(--text-muted);" />
                                                                                                @app.Name
                                                                                            </span>
                                                                                            <span style="color: var(--warning-color); font-family: monospace; font-size: 0.8rem;">v.@app.Version</span>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            }

                                                                            @if (!string.IsNullOrEmpty(device.Description))
                                                                            {
                                                                                <div class="tooltip-note">@device.Description</div>
                                                                            }
                                                                        </div>
                                                                        <!-- КНОПКА ПОДКЛЮЧЕНИЯ К VMWARE -->
                                                                        @if (!string.IsNullOrEmpty(device.VmName))
                                                                        {
                                                                            <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--border-color); text-align: center;">
                                                                                <div class="d-flex justify-content-between mb-2" style="font-size: 0.8rem; text-align: left;">
                                                                                    <span style="color: var(--text-muted);">Логин: <strong style="color: var(--text-light);">@(string.IsNullOrEmpty(device.DomainLogin) ? "-" : device.DomainLogin)</strong></span>
                                                                                    <span style="color: var(--text-muted);">Пароль: <strong style="color: var(--warning-color);">@(string.IsNullOrEmpty(device.DomainPassword) ? "-" : device.DomainPassword)</strong></span>
                                                                                </div>
                                                                                <a href="/vm-console/@device.Id" target="_blank" class="btn-main w-100" style="padding: 6px; font-size: 0.8rem; text-decoration: none; border-radius: 4px;">
                                                                                    <RadzenIcon Icon="desktop_windows" Style="font-size: 1rem; margin-top: -2px;" /> ПОДКЛЮЧИТЬСЯ К ВМ
                                                                                </a>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                    
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                                        <h4 style="color: var(--accent-blue); font-weight: 800; margin: 0; text-transform: uppercase; letter-spacing: 1px;">Терминал проверки</h4>
                                        <span class="cyber-badge" style="background: rgba(78,195,209,0.1); border: 1px solid var(--accent-cyan); color: var(--accent-cyan);">
                                            РЕЖИМ: @(scenario.GameMode == ScenarioGameMode.AllAtOnce ? "СВОБОДНЫЙ" : "ПОСЛЕДОВАТЕЛЬНЫЙ")
                                        </span>
                                    </div>

                                    @for (int k = 0; k < questionStates.Count; k++)
                                    {
                                        var qState = questionStates[k];
                                        var index = k;
                                        bool isLocked = !qState.IsCorrect && qState.Question.PenaltyPoints > 0 && qState.CurrentAward <= 0;

                                        @if (scenario.GameMode == ScenarioGameMode.AllAtOnce || index == 0 || questionStates[index - 1].IsCorrect)
                                        {
                                            <div class="flag-block @(qState.IsCorrect ? "f-correct" : (isLocked ? "f-failed" : ""))" @key="qState.Question.Id">
                                                <div class="d-flex justify-content-between mb-3 align-items-center">
                                                    <span style="color: @(qState.IsCorrect ? "var(--success-color)" : "var(--accent-blue)"); font-weight: 800; font-size: 1.1rem; letter-spacing: 1px;">ЗАДАНИЕ №@(index + 1)</span>
                                                    <div style="font-family: monospace; font-size: 0.95rem; background: rgba(0,0,0,0.3); padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border-color);">
                                                        @if (isLocked)
                                                        {
                                                            <span style="color: var(--danger-color); font-weight: bold;">0 XP</span>
                                                        }
                                                        else
                                                        {
                                                            <span style="color: var(--success-color); font-weight: bold;">+@qState.CurrentAward XP</span>
                                                            @if (qState.Question.PenaltyPoints > 0)
                                                            {
                                                                <span style="color: var(--text-muted); margin: 0 4px;">|</span> <span style="color: var(--danger-color);">-@qState.Question.PenaltyPoints XP / ошибку</span>
                                                            }
                                                        }
                                                    </div>
                                                </div>

                                                <p style="font-size: 1.05rem; margin-bottom: 20px; color: var(--text-light); line-height: 1.6;">@qState.Question.Text</p>

                                                <div class="d-flex gap-3 align-items-center">
                                                    <RadzenTextBox @bind-Value="@qState.UserAnswer"
                                                                   Disabled="@(qState.IsCorrect || isLocked)"
                                                                   Placeholder="@(qState.IsCorrect ? "ФЛАГ ПРИНЯТ" : (isLocked ? "ДОСТУП ЗАБЛОКИРОВАН" : "Введите найденный флаг..."))"
                                                                   class="flex-grow-1 dark-input"
                                                                   style="padding: 12px 15px; font-family: monospace; font-size: 1.1rem;"
                                                                   @onkeypress="@(async (e) => await HandleKeyPress(e, qState))" />

                                                    @if (!qState.IsCorrect && !isLocked)
                                                    {
                                                        <button class="btn-main" style="padding: 12px 25px;" @onclick="@(async () => await CheckAnswer(qState))">
                                                            <RadzenIcon Icon="send" Style="margin-right: 5px;" /> ПРОВЕРИТЬ
                                                        </button>
                                                    }
                                                </div>

                                                @if (!qState.IsCorrect && !isLocked && !string.IsNullOrEmpty(qState.Question.ExampleAnswer))
                                                {
                                                    <div style="margin-top: 12px; font-size: 0.85rem; color: var(--text-muted); font-family: monospace;">
                                                        <RadzenIcon Icon="help_outline" Style="font-size: 1rem; vertical-align: middle; margin-right: 4px; color: var(--accent-cyan);" />
                                                        Формат ответа: <span style="color: var(--accent-light-blue); background: rgba(126,200,248,0.1); padding: 2px 6px; border-radius: 4px;">@qState.Question.ExampleAnswer</span>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrEmpty(qState.FeedbackMessage))
                                                {
                                                    <div style="margin-top: 15px; padding: 10px 15px; border-radius: 6px; font-size: 0.95rem; font-family: monospace; font-weight: bold; background: @(qState.IsCorrect ? "rgba(152,195,121,0.1)" : "rgba(224,108,117,0.1)"); border: 1px solid @(qState.IsCorrect ? "var(--success-color)" : "var(--danger-color)"); color: @(qState.IsCorrect ? "var(--success-color)" : "var(--danger-color)");">
                                                        @qState.FeedbackMessage
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>