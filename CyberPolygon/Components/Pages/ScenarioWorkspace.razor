@page "/scenario/{Id:int}/workspace"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@rendermode InteractiveServer

@inject ScenarioService ScenarioService
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<RadzenComponents />
<PageTitle>Терминал: @(scenario?.Title ?? "Загрузка...")</PageTitle>

<div class="workspace-wrapper rz-p-4" style="background-color: #1e1e1e; min-height: 100vh; color: #e1e1e1;">
    @if (scenario == null)
    {
        <div class="text-center p-5">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">Синхронизация с виртуальным полигоном...</p>
        </div>
    }
    else
    {
        @* ВЕРХНЯЯ НАВИГАЦИОННАЯ ПАНЕЛЬ С КНОПКОЙ НАЗАД *@
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid rgba(0, 238, 255, 0.2);">
            <div class="d-flex align-items-center gap-3">
                <RadzenButton Text="НАЗАД К КАТАЛОГУ" Icon="arrow_back" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                              Click="@(() => NavigationManager.NavigateTo("scenario"))" />
                <h2 style="color: #00eeff; margin: 0; font-weight: bold; font-family: monospace;">[АРЕНА]: @scenario.Title</h2>
            </div>
            <div class="score-badge" style="color: #e1e4e8; font-size: 1.1rem; background: #161b22; padding: 8px 15px; border-radius: 4px; border: 1px solid #30363d;">
                Текущий счет: <span style="color: #28a745; text-shadow: 0 0 5px rgba(40,167,69,0.5); font-weight: bold;">@totalScore</span> XP
            </div>
        </div>

        @* ОСНОВНЫЕ ВКЛАДКИ РАБОЧЕГО ПРОСТРАНСТВА *@
        <RadzenTabs RenderMode="TabRenderMode.Client" class="custom-tabs">
            <Tabs>
                @* Вкладка 1: Легенда *@
                <RadzenTabsItem Text="Легенда" Icon="history_edu">
                    <div class="details-content-box p-4" style="background: rgba(255, 255, 255, 0.02); border-radius: 4px; min-height: 450px;">
                        <h4 style="color: #00eeff;" class="mb-3">Оперативная сводка</h4>
                        <div style="color: white; line-height: 1.6;">
                            @((MarkupString)scenario.Legend)
                        </div>
                    </div>
                </RadzenTabsItem>

                @* Вкладка 2: Схема *@
                <RadzenTabsItem Text="Схема сети" Icon="hub">
                    <div class="details-content-box p-4 text-center" style="background: rgba(255, 255, 255, 0.02); border-radius: 4px; min-height: 450px;">
                        <h4 style="color: #00eeff;" class="text-start mb-3">Топология инфраструктуры</h4>
                        @if (!string.IsNullOrEmpty(scenario.SchemaPath))
                        {
                            <div class="schema-container p-2" style="background: #111; border: 1px solid #333; display: inline-block; border-radius: 4px;">
                                <img src="@scenario.SchemaPath" alt="Схема сети" class="img-fluid" style="max-height: 500px; border: 1px solid rgba(0,238,255,0.3);" />
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary bg-dark text-muted border-secondary">Инфраструктурная схема отсутствует.</div>
                        }
                    </div>
                </RadzenTabsItem>

                @* Вкладка 3: Документация (СКАЧИВАНИЕ ФАЙЛОВ) *@
                <RadzenTabsItem Text="Документация" Icon="description">
                    <div class="details-content-box p-4" style="background: rgba(255, 255, 255, 0.02); border-radius: 4px; min-height: 450px;">
                        <h4 style="color: #00eeff;" class="mb-3">Сопутствующие материалы и руководства</h4>
                        <p class="text-muted">Перед выполнением заданий ознакомьтесь с прикрепленными методическими файлами.</p>

                        @if (scenario.Documents != null && scenario.Documents.Any())
                        {
                            @foreach (var doc in scenario.Documents)
                            {
                                <div class="p-3 mb-3 d-flex align-items-center justify-content-between" style="background: #161b22; border: 1px solid #30363d; border-radius: 4px;">
                                    <div class="d-flex align-items-center gap-3">
                                        <RadzenIcon Icon="picture_as_pdf" Style="font-size: 2.5rem; color: #ff4444;" />
                                        <div>
                                            <b style="color: white;">@(string.IsNullOrWhiteSpace(doc.Title) ? "Прикрепленный документ" : doc.Title)</b>
                                            <div class="text-muted" style="font-size: 0.85rem;">Файл хранится на защищенном сервере платформы</div>
                                        </div>
                                    </div>
                                    @* Прямая ссылка на скачивание файла из коллекции *@
                                    <a href="@doc.FilePath" download target="_blank" class="btn btn-outline-info" style="border-radius: 4px; text-decoration: none; padding: 8px 16px; border: 1px solid #00bfff; color: #00bfff;">
                                        <RadzenIcon Icon="download" class="rz-mr-1" Style="vertical-align: middle;" /> СКАЧАТЬ ФАЙЛ
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning bg-dark text-warning border-warning mt-3">
                                <RadzenIcon Icon="warning" class="rz-mr-2" /> Документация для этого сценария не добавлена администратором.
                            </div>
                        }
                    </div>
                </RadzenTabsItem>

                @* Вкладка 4: Задание (ИНТЕРАКТИВНЫЙ ТЕСТ) *@
                <RadzenTabsItem Text="Задания" Icon="terminal">
                    <div class="details-content-box p-4" style="background: rgba(255, 255, 255, 0.02); border-radius: 4px; min-height: 450px;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 style="color: #00eeff; margin:0;">Интерактивный терминал проверки флагов</h4>
                            <span class="badge bg-secondary p-2 border border-info text-info" style="border-radius: 4px;">
                                Режим контроля: @(scenario.GameMode == ScenarioGameMode.AllAtOnce ? "Свободный" : "Последовательный")
                            </span>
                        </div>

                        @if (isAlreadyCompleted)
                        {
                            <div class="p-5 text-center border border-success rounded mt-4" style="background: rgba(40, 167, 69, 0.05);">
                                <RadzenIcon Icon="workspace_premium" Style="font-size: 4rem; color: #28a745;" />
                                <h3 style="color: #28a745;" class="mt-3">Сценарий успешно завершен!</h3>
                                <p class="text-white mb-0" style="font-size: 1.1rem;">Ваш зафиксированный результат: <b>@savedScore XP</b></p>
                                <p class="text-muted mt-2">Дата фиксации: @completedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                            </div>
                        }
                        else if (scenario.Questions == null || !scenario.Questions.Any())
                        {
                            <div class="alert alert-warning bg-dark text-warning border-warning">
                                Контрольные вопросы еще не сконфигурированы. Обратитесь к администратору.
                            </div>
                        }
                        else
                        {
                            <div class="interactive-test-zone">
                                @foreach (var qState in questionStates)
                                {
                                    var index = questionStates.IndexOf(qState);

                                    @if (scenario.GameMode == ScenarioGameMode.AllAtOnce || index == 0 || questionStates[index - 1].IsCorrect)
                                    {
                                        <div class="mb-4 p-3" style="background: #161b22; border: 1px solid @(qState.IsCorrect ? "#28a745" : "#30363d"); border-radius: 4px;">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span style="color: #00eeff; font-weight: bold; font-size: 0.85rem;">ВОПРОС №@(index + 1)</span>
                                                <div class="points-info" style="font-size: 0.85rem;">
                                                    <span class="text-success">+@qState.Question.AwardPoints XP</span> |
                                                    <span class="text-danger">-@qState.Question.PenaltyPoints XP</span>
                                                </div>
                                            </div>

                                            <p class="text-white font-weight-bold">@qState.Question.Text</p>

                                            <div class="d-flex gap-2">
                                                <RadzenTextBox @bind-Value="@qState.UserAnswer"
                                                               Disabled="@qState.IsCorrect"
                                                               Placeholder="@(qState.IsCorrect ? "Ответ принят и заблокирован" : "Введите ваш ответ или полученный флаг...")"
                                                               Style="background: #0d1117 !important; border: 1px solid #30363d !important; color: #00ff00 !important; font-family: monospace;"
                                                               class="w-100"
                                                               @onkeypress="@(async (e) => await HandleKeyPress(e, qState))" />

                                                @if (!qState.IsCorrect)
                                                {
                                                    <RadzenButton Text="Проверить" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                                                                  Click="@(async () => await CheckAnswer(qState))" />
                                                }
                                                else
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="color: #28a745; font-size: 2rem;" />
                                                }
                                            </div>

                                            @if (!string.IsNullOrEmpty(qState.FeedbackMessage))
                                            {
                                                <div class="mt-2 @(qState.IsCorrect ? "text-success" : "text-danger")" style="font-size: 0.9rem; font-family: monospace;">
                                                    @qState.FeedbackMessage
                                                </div>
                                            }
                                        </div>
                                    }
                                }

                                @if (questionStates.All(q => q.IsCorrect))
                                {
                                    <div class="p-4 text-center border border-success rounded mt-4" style="background: rgba(40, 167, 69, 0.05);">
                                        <RadzenIcon Icon="workspace_premium" Style="font-size: 3rem; color: #ffd700;" />
                                        <h3 style="color: #28a745;" class="mt-2">Миссия выполнена!</h3>
                                        <p class="text-white mb-0">Все уязвимости устранены. Итоговый счет: <b>@totalScore XP</b></p>
                                        <p class="text-muted mt-2">Ваш прогресс сохранен в личном профиле.</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </RadzenTabsItem>

                @* Вкладка 5: Управление (Админ) *@
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <RadzenTabsItem Text="Управление (Админ)" Icon="admin_panel_settings">
                            <div class="details-content-box p-4 border border-danger" style="background: rgba(255, 255, 255, 0.02); border-radius: 4px; min-height: 450px;">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h4 class="text-danger mb-0">Мониторинг прохождений пользователей</h4>
                                    <RadzenButton Text="Сбросить ВСЕ результаты" Icon="delete_forever"
                                                  ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                  Click="@ResetProgress" />
                                </div>

                                @if (completedUsers == null || !completedUsers.Any())
                                {
                                    <div class="text-muted">Ни один агент еще не завершил данный сценарий.</div>
                                }
                                else
                                {
                                    <RadzenDataGrid Data="@completedUsers" TItem="UserScenarioProgressDto" AllowPaging="true" PageSize="5" Style="border: none;">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="UserScenarioProgressDto" Title="Агент">
                                                <Template Context="data">
                                                    <div class="d-flex flex-column">
                                                        <span class="text-white" style="font-weight: bold;">@data.UserName</span>
                                                        <span class="text-muted" style="font-size: 0.8rem;">@data.Email</span>
                                                    </div>
                                                </Template>
                                            </RadzenDataGridColumn>

                                            <RadzenDataGridColumn TItem="UserScenarioProgressDto" Property="Score" Title="Баллы" Width="120px" TextAlign="TextAlign.Center">
                                                <Template Context="data">
                                                    <b style="color: #28a745;">@data.Score XP</b>
                                                </Template>
                                            </RadzenDataGridColumn>

                                            <RadzenDataGridColumn TItem="UserScenarioProgressDto" Property="CompletedAt" Title="Дата завершения" Width="180px">
                                                <Template Context="data">
                                                    @data.CompletedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                </Template>
                                            </RadzenDataGridColumn>

                                            <RadzenDataGridColumn TItem="UserScenarioProgressDto" Title="Действия" Width="100px" TextAlign="TextAlign.Center">
                                                <Template Context="data">
                                                    <RadzenButton Icon="restart_alt" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.ExtraSmall"
                                                                  Click="@(async () => await ResetSingleUser(data.UserId))" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                            </div>
                        </RadzenTabsItem>
                    </Authorized>
                </AuthorizeView>
            </Tabs>
        </RadzenTabs>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private CyberScenario? scenario;
    private List<UserScenarioProgressDto> completedUsers = new();
    private bool isAdmin = false;

    public class UserQuestionState
    {
        public ScenarioQuestion Question { get; set; } = new();
        public string UserAnswer { get; set; } = string.Empty;
        public bool IsCorrect { get; set; } = false;
        public string FeedbackMessage { get; set; } = string.Empty;
    }

    private List<UserQuestionState> questionStates = new();
    private int totalScore = 0;

    private string currentUserId = string.Empty;
    private bool isAlreadyCompleted = false;
    private int savedScore = 0;
    private DateTime completedDate;

    protected override async Task OnInitializedAsync()
    {
        // 1. Получаем сценарий по переданному ID из URL роута
        scenario = await ScenarioService.GetByIdAsync(Id); // Предполагаем наличие GetByIdAsync в твоем сервисе

        if (scenario == null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка", "Сценарий не найден.");
            NavigationManager.NavigateTo("scenario");
            return;
        }

        // 2. Аутентификация
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            isAdmin = user.IsInRole("Admin");

            if (isAdmin)
            {
                await LoadAdminData();
            }

            // Проверяем прохождение
            var progress = await ScenarioService.GetUserProgressAsync(currentUserId, scenario.Id);
            if (progress != null && progress.IsCompleted)
            {
                isAlreadyCompleted = true;
                savedScore = progress.Score;
                completedDate = progress.CompletedAt;
                totalScore = savedScore;
                return;
            }
        }

        if (scenario.Questions != null)
        {
            questionStates = scenario.Questions.Select(q => new UserQuestionState { Question = q }).ToList();
        }
    }

    private async Task CheckAnswer(UserQuestionState state)
    {
        if (string.IsNullOrWhiteSpace(state.UserAnswer)) return;

        bool isRight = string.Equals(state.UserAnswer.Trim(), state.Question.CorrectAnswer.Trim(), StringComparison.OrdinalIgnoreCase);

        if (isRight)
        {
            state.IsCorrect = true;
            state.FeedbackMessage = $"✓ Успешно! Добавлено +{state.Question.AwardPoints} XP.";
            totalScore += state.Question.AwardPoints;
        }
        else
        {
            state.FeedbackMessage = $"❌ Неверный флаг. Штраф: -{state.Question.PenaltyPoints} XP.";
            totalScore -= state.Question.PenaltyPoints;
        }

        if (questionStates.All(q => q.IsCorrect) && !string.IsNullOrEmpty(currentUserId) && scenario != null)
        {
            await ScenarioService.SaveUserProgressAsync(currentUserId, scenario.Id, totalScore);
            isAlreadyCompleted = true;
            savedScore = totalScore;
            completedDate = DateTime.UtcNow;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e, UserQuestionState state)
    {
        if (e.Key == "Enter") await CheckAnswer(state);
    }

    private async Task ResetProgress()
    {
        if (scenario == null) return;
        await ScenarioService.ResetAllProgressForScenarioAsync(scenario.Id);

        isAlreadyCompleted = false;
        totalScore = 0;
        foreach (var q in questionStates)
        {
            q.IsCorrect = false;
            q.UserAnswer = string.Empty;
            q.FeedbackMessage = string.Empty;
        }

        if (isAdmin) await LoadAdminData();
        NotificationService.Notify(NotificationSeverity.Success, "Система", "Прогресс всех пользователей обнулен.");
    }

    private async Task LoadAdminData()
    {
        if (scenario != null)
            completedUsers = await ScenarioService.GetAllProgressForScenarioAsync(scenario.Id);
    }

    private async Task ResetSingleUser(string targetUserId)
    {
        if (scenario == null) return;
        await ScenarioService.ResetUserProgressAsync(targetUserId, scenario.Id);
        await LoadAdminData();

        if (targetUserId == currentUserId)
        {
            isAlreadyCompleted = false;
            totalScore = 0;
            foreach (var q in questionStates)
            {
                q.IsCorrect = false;
                q.UserAnswer = string.Empty;
                q.FeedbackMessage = string.Empty;
            }
        }
        NotificationService.Notify(NotificationSeverity.Info, "Система", "Прогресс пользователя обнулен.");
    }
}