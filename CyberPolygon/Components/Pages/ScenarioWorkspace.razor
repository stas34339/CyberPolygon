@page "/scenario/{Id:int}/workspace"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Claims
@using System.Threading
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@using CyberPolygon.Models
@implements IDisposable
@rendermode InteractiveServer

@inject ScenarioSessionManager SessionManager
@inject ScenarioService ScenarioService
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env
@inject IDbContextFactory<CyberPolygon.Data.ApplicationDbContext> ContextFactory

<PageTitle>Терминал: @(scenario?.Title ?? "Загрузка...")</PageTitle>
<RadzenComponents />

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --border-color: #2a3a4a;
        --text-light: #cbe0f5;
        --text-muted: #8fa0b5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .workspace-container {
        background-color: var(--bg-main);
        min-height: 100vh;
        color: var(--text-light);
        font-family: 'Segoe UI', sans-serif;
    }

    .panel-box {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
    }

    .flag-block {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .f-correct {
        border-color: var(--success-color) !important;
        background: rgba(152, 195, 121, 0.05);
    }

    .f-failed {
        border-color: var(--danger-color) !important;
        background: rgba(224, 108, 117, 0.05);
    }

    .dark-input {
        background: #131924 !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        width: 100%;
        border-radius: 6px;
    }

        .dark-input:focus {
            border-color: var(--accent-cyan) !important;
        }

    .blur-zone-wrapper {
        position: relative;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
        background: #131924;
        min-height: 600px;
    }

    .blur-overlay-content {
        filter: blur(8px);
        opacity: 0.3;
        user-select: none;
        pointer-events: none;
        padding: 30px;
    }

    .lock-center-panel {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 5;
        background: rgba(26, 35, 50, 0.6);
        text-align: center;
    }

    .btn-action {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 12px 20px;
        border-radius: 6px;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-action:hover {
            box-shadow: 0 4px 15px rgba(78, 195, 209, 0.4);
        }

    .btn-zoom {
        background: rgba(13, 17, 23, 0.7);
        border: 1px solid var(--border-color);
        color: #8fa0b5;
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        transition: all 0.2s;
        backdrop-filter: blur(5px);
    }

        .btn-zoom:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            background: rgba(78, 195, 209, 0.1);
        }

    .schema-box {
        background-color: #131924 !important;
        border: 1px dashed var(--accent-cyan);
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 30px;
        position: relative;
    }

    #topology-move-layer {
        position: absolute;
        left: 0;
        top: 0;
        background-color: #1a2332;
        background-image: radial-gradient(rgba(78, 195, 209, 0.2) 1px, transparent 1px);
        background-size: 30px 30px;
        box-shadow: inset 0 0 50px rgba(0,0,0,0.8);
        border: 1px solid rgba(78, 195, 209, 0.3);
        border-radius: 12px;
    }

    .network-hotspot {
        width: 32px;
        height: 32px;
        margin-left: -16px;
        margin-top: -16px;
        z-index: 100;
    }

    .hotspot-trigger {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 0 10px rgba(0,0,0,0.8);
        transition: all 0.2s ease-in-out;
    }

        .hotspot-trigger i {
            font-size: 1.1rem;
            color: #1a1d21;
        }

        .hotspot-trigger.secure {
            background: #98c379;
            box-shadow: 0 0 12px rgba(152, 195, 121, 0.6);
        }

        .hotspot-trigger.compromised {
            background: #e06c75;
            box-shadow: 0 0 12px rgba(224, 108, 117, 0.8);
            animation: cyberPulse 2s infinite;
        }

        .hotspot-trigger:hover {
            transform: scale(1.25);
            z-index: 110;
        }

    .hotspot-tooltip {
        position: absolute;
        top: 42px;
        left: 50%;
        transform: translateX(-50%) translateY(-10px);
        width: 260px;
        background: #131924;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.8);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 500;
    }

        .hotspot-tooltip::before {
            content: '';
            position: absolute;
            top: -20px;
            left: 0;
            width: 100%;
            height: 20px;
            background: transparent;
        }

        .hotspot-tooltip::after {
            content: '';
            position: absolute;
            top: -6px;
            left: 50%;
            transform: translateX(-50%) rotate(45deg);
            width: 10px;
            height: 10px;
            background: #131924;
            border-left: 1px solid var(--border-color);
            border-top: 1px solid var(--border-color);
        }

    .network-hotspot:hover .hotspot-tooltip {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
    }

    .tooltip-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 6px;
        margin-bottom: 8px;
    }

    .node-name {
        font-weight: bold;
        color: var(--text-light);
        font-size: 0.9rem;
    }

    .node-status-badge {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 4px;
    }

        .node-status-badge.secure {
            background: rgba(152,195,121,0.15);
            color: #98c379;
        }

        .node-status-badge.compromised {
            background: rgba(224,108,117,0.15);
            color: #e06c75;
        }

    .info-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        margin-bottom: 4px;
        font-family: monospace;
    }

        .info-row span {
            color: var(--text-muted);
        }

        .info-row strong {
            color: var(--accent-cyan);
        }

        .info-row .val {
            color: var(--text-light);
        }

    .val-ports {
        color: #e5c07b;
    }

    .tooltip-note {
        margin-top: 6px;
        padding-top: 6px;
        border-top: 1px dashed var(--border-color);
        font-size: 0.75rem;
        color: #8fa0b5;
        font-style: italic;
    }

    @@keyframes cyberPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(224, 108, 117, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(224, 108, 117, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(224, 108, 117, 0);
        }
    }
</style>

<div class="workspace-container p-4">
    @if (scenario == null || currentUserProgress == null)
    {
        <div class="text-center p-5"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color);" /></div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="panel-box" style="position: sticky; top: 20px;">
                    <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" class="mb-4" Click="@(() => NavigationManager.NavigateTo("scenario"))" Style="color: #8fa0b5; border-color: var(--border-color);" />

                    <h3 style="color: var(--accent-cyan); font-weight: bold; margin-bottom: 15px;">@scenario.Title</h3>

                    @if (scenario.Scope == VisibilityScope.TeamOnly)
                    {
                        <div class="mb-3"><span class="badge" style="background: rgba(229,192,123,0.1); border: 1px solid var(--warning-color); color: var(--warning-color); padding: 6px 12px;"><RadzenIcon Icon="groups" Style="font-size: 1rem; margin-top: -2px; margin-right: 5px;" /> КОМАНДНЫЙ РЕЖИМ</span></div>
                    }

                    @if (currentUserProgress.Status == AttemptStatus.InProgress && scenario.DurationInMinutes > 0)
                    {
                        <div class="p-3 mb-4 text-center rounded" style="border: 1px solid var(--accent-cyan); color: var(--accent-cyan); font-family: monospace; font-size: 1.5rem; background: rgba(78,195,209,0.05);">
                            <RadzenIcon Icon="timer" Style="vertical-align: middle; margin-right: 5px;" /> @timeLeft.ToString(@"hh\:mm\:ss")
                        </div>
                    }

                    <div style="font-size: 0.95rem; color: #8fa0b5; margin-bottom: 25px; line-height: 1.6;">@((MarkupString)scenario.Legend)</div>

                    @if (scenario.Documents != null && scenario.Documents.Any())
                    {
                        <div style="font-size: 0.85rem; text-transform: uppercase; color: var(--accent-cyan); font-weight: bold; margin-bottom: 10px;">Материалы:</div>
                        <ul class="mb-4" style="padding-left: 20px; color: #5ba3e3;">
                            @foreach (var doc in scenario.Documents)
                            {
                                <li class="mb-2"><a href="@doc.FilePath" target="_blank" style="color: inherit; text-decoration: none;"><RadzenIcon Icon="description" Style="font-size:1rem; vertical-align:middle;" /> @doc.Title</a></li>
                            }
                        </ul>
                    }

                    @if (currentUserProgress.Status == AttemptStatus.NotStarted)
                    {
                        <button class="btn-action w-100 py-3" @onclick="StartScenario">НАЧАТЬ СИМУЛЯЦИЮ</button>
                    }
                    else if (currentUserProgress.Status == AttemptStatus.InProgress)
                    {
                        <div class="p-3 mb-3 rounded text-center" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color);">Текущий счет: <b style="color: var(--accent-cyan); font-size: 1.2rem;">@totalScore XP</b></div>
                        <RadzenButton Text="ЗАВЕРШИТЬ МИССИЮ" class="w-100 py-2" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="CompleteScenario" />
                    }
                    else if (currentUserProgress.Status == AttemptStatus.Completed)
                    {
                        <div class="p-4 text-center rounded" style="border: 1px solid var(--success-color); background: rgba(152,195,121,0.1);">
                            <h4 style="color: var(--success-color); font-weight: bold; margin-bottom: 5px;">СЦЕНАРИЙ ЗАВЕРШЕН</h4>
                            <p style="margin: 0; color: #cbe0f5;">Итоговый счет: <b style="font-size: 1.2rem;">@currentUserProgress.Score XP</b></p>
                        </div>
                    }
                    else if (currentUserProgress.Status == AttemptStatus.Failed)
                    {
                        <div class="p-4 text-center rounded" style="border: 1px solid var(--danger-color); background: rgba(224,108,117,0.1);">
                            <h4 style="color: var(--danger-color); font-weight: bold; margin-bottom: 5px;">МИССИЯ ПРОВАЛЕНА</h4>
                            <p style="margin: 0; color: #cbe0f5; margin-bottom: 15px;">Время истекло.</p>
                            <button class="btn-action w-100" style="background: var(--danger-color); color: white;" @onclick="RestartScenario">ПОПРОБОВАТЬ СНОВА</button>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-8">
                @if (currentUserProgress.Status == AttemptStatus.NotStarted)
                {
                    <div class="blur-zone-wrapper shadow-lg">
                        <div class="lock-center-panel">
                            <RadzenIcon Icon="lock" Style="font-size: 4rem; color: var(--accent-cyan); margin-bottom: 15px;" />
                            <h5 style="color: white; font-weight: bold; text-transform: uppercase;">Система заблокирована</h5>
                            <p style="color: #8fa0b5; font-size: 0.95rem; max-width: 70%;">Запустите сценарий для получения доступа.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="panel-box" style="min-height: 600px;">

                        <div class="schema-box" style="height: 520px; display: flex; flex-direction: column;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 style="color: #cbe0f5; font-weight: bold; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Карта инфраструктуры</h5>
                                <div class="d-flex gap-2">
                                    @if (scenario.Devices != null)
                                    {
                                        @foreach (var device in scenario.Devices)
                                        {
                                            <button type="button" class="btn-zoom" style="font-size: 0.8rem; padding: 4px 10px;" @onclick="() => FocusOnDevice(device.MapX, device.MapY)">
                                                <RadzenIcon Icon="center_focus_strong" Style="font-size:0.9rem; vertical-align:middle; margin-right:3px;" /> @device.Name
                                            </button>
                                        }
                                    }
                                </div>
                            </div>

                            <div style="flex-grow: 1; border-radius: 6px; position: relative; border: 1px solid rgba(255,255,255,0.05); overflow: hidden;">
                                <div id="schema-drag-container" style="width: 100%; height: 100%; margin: 0; padding: 0; user-select: none; position: relative;">

                                    <div id="topology-move-layer" style="width: @(canvasWidth)px; height: @(canvasHeight)px;">

                                        @if (scenario.Connections != null && scenario.Connections.Any())
                                        {
                                            <svg style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; overflow: visible;">
                                                <defs>
                                                    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                                                        <feGaussianBlur stdDeviation="2" result="blur" />
                                                        <feComposite in="SourceGraphic" in2="blur" operator="over" />
                                                    </filter>
                                                </defs>

                                                @foreach (var conn in scenario.Connections)
                                                {
                                                    var fromNode = scenario.Devices?.FirstOrDefault(d => d.Id == conn.FromDeviceId);
                                                    var toNode = scenario.Devices?.FirstOrDefault(d => d.Id == conn.ToDeviceId);

                                                    if (fromNode != null && toNode != null)
                                                    {
                                                        bool isDangerLink = fromNode.IsCompromised || toNode.IsCompromised;
                                                        string linkColor = isDangerLink ? "var(--danger-color)" : "rgba(78, 195, 209, 0.6)";
                                                        string dashArray = conn.LinkType == "VPN" ? "6,6" : "0";

                                                        <line x1="@fromNode.MapX" y1="@fromNode.MapY"
                                                              x2="@toNode.MapX" y2="@toNode.MapY"
                                                              stroke="@linkColor" stroke-width="2" stroke-dasharray="@dashArray"
                                                              style="@(isDangerLink ? "filter: url(#glow);" : "")" />
                                                    }
                                                }
                                            </svg>
                                        }

                                        @if (scenario.Devices != null)
                                        {
                                            @foreach (var device in scenario.Devices)
                                            {
                                                <div class="network-hotspot" @key="device.Id" style="position: absolute; left: @(device.MapX)px; top: @(device.MapY)px;">
                                                    <div class="hotspot-trigger @(device.IsCompromised ? "compromised" : "secure")" @onclick="() => FocusOnDevice(device.MapX, device.MapY)">
                                                        <RadzenIcon Icon="@(string.IsNullOrEmpty(device.Type) ? "dns" : device.Type)" />
                                                    </div>
                                                    <div class="hotspot-tooltip">
                                                        <div class="tooltip-header">
                                                            <span class="node-name">@device.Name</span>
                                                            <span class="node-status-badge @(device.IsCompromised ? "compromised" : "secure")">
                                                                @(device.IsCompromised ? "COMPROMISED" : "ONLINE")
                                                            </span>
                                                        </div>
                                                        <div class="tooltip-body">
                                                            <div class="info-row"><span>IP:</span> <strong>@device.IpAddress</strong></div>
                                                            <div class="info-row"><span>OS:</span> <span class="val">@device.Os</span></div>
                                                            <div class="info-row"><span>Порты:</span> <span class="val-ports">@device.OpenPorts</span></div>

                                                            @if (device.Applications != null && device.Applications.Any())
                                                            {
                                                                <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed var(--border-color);">
                                                                    <div style="font-size: 0.7rem; color: var(--accent-cyan); text-transform: uppercase; margin-bottom: 6px; font-weight: bold; letter-spacing: 0.5px;">
                                                                        Установленное ПО:
                                                                    </div>
                                                                    @foreach (var app in device.Applications)
                                                                    {
                                                                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; margin-bottom: 3px; align-items: center;" @key="app.Id">
                                                                            <span style="color: var(--text-light); display: flex; align-items: center; gap: 4px;">
                                                                                <RadzenIcon Icon="layers" Style="font-size: 0.8rem; color: var(--text-muted);" />
                                                                                @app.Name
                                                                            </span>
                                                                            <span style="color: var(--warning-color); font-family: monospace; font-size: 0.75rem;">v.@app.Version</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }

                                                            @if (!string.IsNullOrEmpty(device.Description))
                                                            {
                                                                <div class="tooltip-note">@device.Description</div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                            <h5 style="color: #5ba3e3; font-weight: bold; margin: 0;">Терминал проверки</h5>
                            <span class="badge" style="background: rgba(78,195,209,0.1); border: 1px solid var(--accent-cyan); color: var(--accent-cyan); padding: 5px 12px;">Режим: @(scenario.GameMode == ScenarioGameMode.AllAtOnce ? "Свободный" : "Последовательный")</span>
                        </div>

                        @for (int k = 0; k < questionStates.Count; k++)
                        {
                            var qState = questionStates[k];
                            var index = k;
                            bool isLocked = !qState.IsCorrect && qState.Question.PenaltyPoints > 0 && qState.CurrentAward <= 0;

                            @if (scenario.GameMode == ScenarioGameMode.AllAtOnce || index == 0 || questionStates[index - 1].IsCorrect)
                            {
                                <div class="flag-block @(qState.IsCorrect ? "f-correct" : (isLocked ? "f-failed" : ""))" @key="qState.Question.Id">
                                    <div class="d-flex justify-content-between mb-3">
                                        <span style="color: var(--accent-blue); font-weight: bold;">ЗАДАНИЕ №@(index + 1)</span>
                                        <div style="font-family: monospace; font-size: 0.85rem;">
                                            @if (isLocked)
                                            {
                                                <span style="color: var(--danger-color); font-weight: bold;">0 XP</span>
                                            }
                                            else
                                            {
                                                <span style="color: var(--success-color);">+@qState.CurrentAward XP</span>
                                                @if (qState.Question.PenaltyPoints > 0)
                                                {
                                                    <span style="color: var(--text-muted);"> | </span> <span style="color: var(--danger-color);">-@qState.Question.PenaltyPoints XP</span>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <p style="font-size: 1rem; margin-bottom: 15px; color: #cbe0f5;">@qState.Question.Text</p>

                                    <div class="d-flex gap-2 align-items-center">
                                        <RadzenTextBox @bind-Value="@qState.UserAnswer"
                                                       Disabled="@(qState.IsCorrect || isLocked)"
                                                       Placeholder="@(qState.IsCorrect ? "Ответ принят" : (isLocked ? "Заблокировано" : "Введите ответ..."))"
                                                       class="w-100 dark-input"
                                                       @onkeypress="@(async (e) => await HandleKeyPress(e, qState))" />

                                        @if (!qState.IsCorrect && !isLocked)
                                        {
                                            <button class="btn-action" style="padding: 8px 16px; font-size: 0.85rem;" @onclick="@(async () => await CheckAnswer(qState))">ПРОВЕРИТЬ</button>
                                        }
                                    </div>

                                    @if (!qState.IsCorrect && !isLocked && !string.IsNullOrEmpty(qState.Question.ExampleAnswer))
                                    {
                                        <div style="margin-top: 6px; font-size: 0.8rem; color: var(--text-muted); padding-left: 5px; font-family: monospace;">
                                            <RadzenIcon Icon="help_outline" Style="font-size: 0.9rem; vertical-align: middle; margin-right: 4px; color: var(--accent-cyan);" />
                                            Формат ответа: <span style="color: var(--text-light);">@qState.Question.ExampleAnswer</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(qState.FeedbackMessage))
                                    {
                                        <div style="margin-top: 10px; font-size: 0.9rem; font-family: monospace; color: @(qState.IsCorrect ? "var(--success-color)" : "var(--danger-color)");">@qState.FeedbackMessage</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private CyberScenario? scenario;
    private UserScenarioProgress? currentUserProgress;
    private string currentUserId = string.Empty;
    private int? currentTeamId = null;

    private Timer? _timer;
    private TimeSpan timeLeft = TimeSpan.Zero;
    private int totalScore = 0;
    private bool isMapInitialized = false;
    private bool _isDisposed = false;

    private int canvasWidth = 800;
    private int canvasHeight = 550;

    public class UserQuestionState
    {
        public ScenarioQuestion Question { get; set; } = new();
        public string UserAnswer { get; set; } = string.Empty;
        public bool IsCorrect { get; set; } = false;
        public string FeedbackMessage { get; set; } = string.Empty;
        public int FailedAttempts { get; set; } = 0;
        public int CurrentAward => Question.PenaltyPoints <= 0 ? Question.AwardPoints : Math.Max(0, Question.AwardPoints - (FailedAttempts * Question.PenaltyPoints));
    }

    private List<UserQuestionState> questionStates = new();

    private async Task FocusOnDevice(int x, int y)
    {
        try { await JSRuntime.InvokeVoidAsync("imageViewer.focusOnCoordinates", "schema-drag-container", x, y); } catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            scenario = await ScenarioService.GetByIdAsync(Id);
            if (scenario == null) { NavigationManager.NavigateTo("/scenario"); return; }

            if (scenario.Questions != null)
            {
                questionStates = scenario.Questions.Select(q => new UserQuestionState { Question = q }).ToList();
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
                using var ctx = await ContextFactory.CreateDbContextAsync();
                var dbUser = await ctx.Set<ApplicationUser>().Include(u => u.Teams).AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUserId);
                currentTeamId = dbUser?.Teams?.FirstOrDefault()?.Id;

                await LoadUserState();
            }
            SessionManager.TeamProgressChanged += OnTeamProgressChanged;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Критический сбой инициализации", ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isMapInitialized && currentUserProgress?.Status == AttemptStatus.InProgress)
        {
            isMapInitialized = true;
            try { await JSRuntime.InvokeVoidAsync("imageViewer.init", "schema-drag-container", "topology-move-layer"); } catch { }
        }
    }

    private async Task LoadUserState()
    {
        if (scenario == null) return;

        try
        {
            using var context = await ContextFactory.CreateDbContextAsync();

            if (scenario.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
            {
                currentUserProgress = await context.UserProgresses
                    .FirstOrDefaultAsync(p => p.CyberScenarioId == Id && p.TeamId == currentTeamId && p.Status == AttemptStatus.InProgress);
            }
            else
            {
                currentUserProgress = await context.UserProgresses
                    .FirstOrDefaultAsync(p => p.CyberScenarioId == Id && p.UserId == currentUserId && p.Status == AttemptStatus.InProgress);
            }

            if (currentUserProgress == null)
            {
                if (scenario.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
                {
                    currentUserProgress = await context.UserProgresses
                        .OrderByDescending(p => p.StartedAt)
                        .FirstOrDefaultAsync(p => p.CyberScenarioId == Id && p.TeamId == currentTeamId);
                }
                else
                {
                    currentUserProgress = await context.UserProgresses
                        .OrderByDescending(p => p.StartedAt)
                        .FirstOrDefaultAsync(p => p.CyberScenarioId == Id && p.UserId == currentUserId);
                }
            }

            if (currentUserProgress == null)
            {
                currentUserProgress = new UserScenarioProgress
                {
                    Status = AttemptStatus.NotStarted,
                    CyberScenarioId = Id
                };
            }

            totalScore = currentUserProgress.Score;

            if (scenario.Questions != null && currentUserProgress.Id != 0)
            {
                var solvedAnswers = await context.UserAnswerProgresses
                    .Where(a => a.UserScenarioProgressId == currentUserProgress.Id)
                    .ToListAsync();

                questionStates = scenario.Questions.Select(q =>
                {
                    var solved = solvedAnswers.FirstOrDefault(a => a.QuestionId == q.Id);
                    return new UserQuestionState
                    {
                        Question = q,
                        IsCorrect = solved?.IsCorrect ?? false,
                        FailedAttempts = solved?.FailedAttempts ?? 0,
                        UserAnswer = solved?.LastSubmittedAnswer ?? string.Empty
                    };
                }).ToList();
            }

            var freshDevices = await context.Set<ScenarioDevice>()
                .Include(d => d.Applications)
                .Where(d => d.CyberScenarioId == scenario.Id)
                .ToListAsync();

            if (freshDevices != null)
            {
                scenario.Devices = freshDevices;
                CalculateCanvasBounds();
            }

            if (currentUserProgress.Status == AttemptStatus.InProgress)
            {
                StartTimer();
            }
            else
            {
                StopTimer();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка базы данных", ex.Message);
        }
    }

    private void CalculateCanvasBounds()
    {
        if (scenario?.Devices != null && scenario.Devices.Any())
        {
            int maxX = scenario.Devices.Max(d => d.MapX);
            int maxY = scenario.Devices.Max(d => d.MapY);

            canvasWidth = Math.Max(800, maxX + 150);
            canvasHeight = Math.Max(550, maxY + 150);
        }
        else
        {
            canvasWidth = 800;
            canvasHeight = 550;
        }
    }

    private async void OnTeamProgressChanged(int teamId)
    {
        if (_isDisposed) return;
        if (scenario?.Scope == VisibilityScope.TeamOnly && currentTeamId == teamId)
        {
            await InvokeAsync(async () => { await LoadUserState(); StateHasChanged(); });
        }
    }

    private async Task StartScenario()
    {
        if (scenario == null || string.IsNullOrEmpty(currentUserId)) return;

        var (success, msg) = await SessionManager.CheckConcurrencyAsync(currentUserId, currentTeamId);
        if (!success)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Предупреждение", msg);
            return;
        }

        try
        {
            using var context = await ContextFactory.CreateDbContextAsync();

            var newProgress = new UserScenarioProgress
            {
                UserId = scenario.Scope == VisibilityScope.TeamOnly ? null : currentUserId,
                TeamId = currentTeamId,
                IsTeamAttempt = scenario.Scope == VisibilityScope.TeamOnly,
                CyberScenarioId = scenario.Id,
                Score = 0,
                Status = AttemptStatus.InProgress,
                StartedAt = DateTime.UtcNow,
                TargetEndTime = scenario.DurationInMinutes > 0 ? DateTime.UtcNow.AddMinutes(scenario.DurationInMinutes) : null
            };

            context.UserProgresses.Add(newProgress);
            await context.SaveChangesAsync();

            await LoadUserState();

            if (scenario.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
                SessionManager.NotifyTeamUpdate(currentTeamId.Value);

            NotificationService.Notify(NotificationSeverity.Success, "Система", "Симуляция инфраструктуры успешно запущена!");

            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);

            if (!isMapInitialized)
            {
                isMapInitialized = true;
                try { await JSRuntime.InvokeVoidAsync("imageViewer.init", "schema-drag-container", "topology-move-layer"); } catch { }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Критическая ошибка старта", ex.Message);
        }
    }

    private async Task CheckAnswer(UserQuestionState state)
    {
        if (string.IsNullOrWhiteSpace(state.UserAnswer) || currentUserProgress?.Status != AttemptStatus.InProgress) return;
        try
        {
            var result = await ScenarioService.ProcessTeamAnswerAsync(currentUserProgress.Id, state.Question.Id, state.UserAnswer, currentUserId, currentTeamId);
            if (!result.Success)
            {
                if (result.AlreadySolved) state.IsCorrect = true;
                else { state.FailedAttempts++; state.FeedbackMessage = "❌ Неверный флаг."; }
                if (scenario!.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue) SessionManager.NotifyTeamUpdate(currentTeamId.Value);
                StateHasChanged(); return;
            }

            totalScore = result.NewTotalScore;
            state.IsCorrect = true;
            state.FeedbackMessage = "✅ Флаг принят!";

            if (scenario!.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue) SessionManager.NotifyTeamUpdate(currentTeamId.Value);
            StateHasChanged();

            if (questionStates.All(q => q.IsCorrect)) await CompleteScenario();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка проверки флага", ex.Message);
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e, UserQuestionState state)
    {
        if (e.Key == "Enter") await CheckAnswer(state);
    }

    private async Task CompleteScenario()
    {
        StopTimer();
        if (currentUserProgress != null && currentUserProgress.Id != 0)
        {
            try
            {
                using var context = await ContextFactory.CreateDbContextAsync();
                var p = await context.Set<UserScenarioProgress>().FindAsync(currentUserProgress.Id);
                if (p != null)
                {
                    p.Status = AttemptStatus.Completed;
                    p.CompletedAt = DateTime.UtcNow;
                    context.Set<UserScenarioProgress>().Update(p);
                    await context.SaveChangesAsync();
                }
                await LoadUserState();
                if (scenario!.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue) SessionManager.NotifyTeamUpdate(currentTeamId.Value);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
    }

    private async void TimerTick(object? state)
    {
        if (_isDisposed) return;

        if (currentUserProgress?.TargetEndTime != null)
        {
            timeLeft = currentUserProgress.TargetEndTime.Value - DateTime.UtcNow;

            if (timeLeft.TotalSeconds <= 0)
            {
                StopTimer();
                await InvokeAsync(ForceFailScenario);
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StartTimer()
    {
        if (scenario != null && scenario.DurationInMinutes > 0 && currentUserProgress?.TargetEndTime != null)
        {
            _timer?.Dispose();
            _timer = new Timer(TimerTick, null, 0, 1000);
        }
    }

    private void StopTimer() => _timer?.Dispose();

    private async Task ForceFailScenario()
    {
        if (currentUserProgress != null && currentUserProgress.Id != 0)
        {
            try
            {
                using var context = await ContextFactory.CreateDbContextAsync();
                var progress = await context.Set<UserScenarioProgress>().FindAsync(currentUserProgress.Id);
                if (progress != null && progress.Status == AttemptStatus.InProgress)
                {
                    progress.Status = AttemptStatus.Failed;
                    progress.CompletedAt = DateTime.UtcNow;

                    if (progress.StartedAt.HasValue)
                        progress.TimeSpent = progress.CompletedAt.Value - progress.StartedAt.Value;

                    context.Set<UserScenarioProgress>().Update(progress);
                    await context.SaveChangesAsync();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }

        await InvokeAsync(async () => { await LoadUserState(); StateHasChanged(); });

        if (scenario!.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
            SessionManager.NotifyTeamUpdate(currentTeamId.Value);
    }

    private async Task RestartScenario()
    {
        StopTimer();
        await StartScenario();
    }

    public void Dispose()
    {
        _isDisposed = true;
        StopTimer();
        SessionManager.TeamProgressChanged -= OnTeamProgressChanged;
    }
}