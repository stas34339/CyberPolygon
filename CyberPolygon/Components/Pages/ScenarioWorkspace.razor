@page "/scenario/{Id:int}/workspace"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Threading
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@implements IDisposable
@rendermode InteractiveServer

@inject ScenarioSessionManager SessionManager
@inject ScenarioService ScenarioService
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env
@inject IDbContextFactory<CyberPolygon.Data.ApplicationDbContext> ContextFactory

<PageTitle>Терминал: @(scenario?.Title ?? "Загрузка...")</PageTitle>
<RadzenComponents />

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --border-color: #2a3a4a;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --success-color: #98c379;
        --danger-color: #e06c75;
    }

    .workspace-container {
        background-color: var(--bg-main);
        min-height: 100vh;
        color: var(--text-light);
    }

    .panel-box {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
    }

    .schema-box {
        background: #0d1117;
        border: 1px dashed var(--accent-cyan);
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        margin-bottom: 30px;
        position: relative;
    }

    .flag-block {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .f-correct {
        border-color: var(--success-color) !important;
        background: rgba(152, 195, 121, 0.05);
    }

    .f-failed {
        border-color: var(--danger-color) !important;
        background: rgba(224, 108, 117, 0.05);
    }

    .dark-input {
        background: #131924 !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        width: 100%;
        border-radius: 6px;
    }

        .dark-input:focus {
            border-color: var(--accent-cyan) !important;
        }

    .blur-zone-wrapper {
        position: relative;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
        background: #131924;
        min-height: 600px;
    }

    .blur-overlay-content {
        filter: blur(8px);
        opacity: 0.3;
        user-select: none;
        pointer-events: none;
        padding: 30px;
    }

    .lock-center-panel {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 5;
        background: rgba(26, 35, 50, 0.6);
        text-align: center;
    }

    .btn-action {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 12px 20px;
        border-radius: 6px;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-action:hover {
            box-shadow: 0 4px 15px rgba(78, 195, 209, 0.4);
        }

    .btn-zoom {
        background: transparent;
        border: 1px solid var(--border-color);
        color: #8fa0b5;
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-zoom:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }
</style>

<div class="workspace-container p-4">
    @if (scenario == null || currentUserProgress == null)
    {
        <div class="text-center p-5"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color);" /></div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="panel-box" style="position: sticky; top: 20px;">
                    <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" class="mb-4" Click="@(() => NavigationManager.NavigateTo("scenario"))" Style="color: #8fa0b5; border-color: var(--border-color);" />

                    <h3 style="color: var(--accent-cyan); font-weight: bold; margin-bottom: 15px;">@scenario.Title</h3>

                    @if (scenario.Scope == VisibilityScope.TeamOnly)
                    {
                        <div class="mb-3"><span class="badge" style="background: rgba(229,192,123,0.1); border: 1px solid var(--warning-color); color: var(--warning-color); padding: 6px 12px;"><RadzenIcon Icon="groups" Style="font-size: 1rem; margin-top: -2px; margin-right: 5px;" /> КОМАНДНЫЙ РЕЖИМ</span></div>
                    }

                    @if (currentUserProgress.Status == AttemptStatus.InProgress && scenario.DurationInMinutes > 0)
                    {
                        <div class="p-3 mb-4 text-center rounded" style="border: 1px solid var(--accent-cyan); color: var(--accent-cyan); font-family: monospace; font-size: 1.5rem; background: rgba(78,195,209,0.05);">
                            <RadzenIcon Icon="timer" Style="vertical-align: middle; margin-right: 5px;" /> @timeLeft.ToString(@"hh\:mm\:ss")
                        </div>
                    }

                    <div style="font-size: 0.95rem; color: #8fa0b5; margin-bottom: 25px; line-height: 1.6;">@((MarkupString)scenario.Legend)</div>

                    @if (scenario.Documents != null && scenario.Documents.Any())
                    {
                        <div style="font-size: 0.85rem; text-transform: uppercase; color: var(--accent-cyan); font-weight: bold; margin-bottom: 10px;">Материалы:</div>
                        <ul class="mb-4" style="padding-left: 20px; color: #5ba3e3;">
                            @foreach (var doc in scenario.Documents)
                            {
                                <li class="mb-2"><a href="@doc.FilePath" target="_blank" style="color: inherit; text-decoration: none;"><RadzenIcon Icon="description" Style="font-size:1rem; vertical-align:middle;" /> @doc.Title</a></li>
                            }
                        </ul>
                    }

                    @if (currentUserProgress.Status == AttemptStatus.NotStarted)
                    {
                        <button class="btn-action w-100 py-3" @onclick="StartScenario">НАЧАТЬ СИМУЛЯЦИЮ</button>
                    }
                    else if (currentUserProgress.Status == AttemptStatus.InProgress)
                    {
                        <div class="p-3 mb-3 rounded text-center" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color);">Текущий счет: <b style="color: var(--accent-cyan); font-size: 1.2rem;">@totalScore XP</b></div>
                        <RadzenButton Text="ЗАВЕРШИТЬ МИССИЮ" class="w-100 py-2" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="CompleteScenario" />
                    }
                    else if (currentUserProgress.Status == AttemptStatus.Completed)
                    {
                        <div class="p-4 text-center rounded" style="border: 1px solid var(--success-color); background: rgba(152,195,121,0.1);">
                            <h4 style="color: var(--success-color); font-weight: bold; margin-bottom: 5px;">СЦЕНАРИЙ ЗАВЕРШЕН</h4>
                            <p style="margin: 0; color: #cbe0f5;">Итоговый счет: <b style="font-size: 1.2rem;">@currentUserProgress.Score XP</b></p>
                        </div>
                    }
                    else if (currentUserProgress.Status == AttemptStatus.Failed)
                    {
                        <div class="p-4 text-center rounded" style="border: 1px solid var(--danger-color); background: rgba(224,108,117,0.1);">
                            <h4 style="color: var(--danger-color); font-weight: bold; margin-bottom: 5px;">МИССИЯ ПРОВАЛЕНА</h4>
                            <p style="margin: 0; color: #cbe0f5; margin-bottom: 15px;">Время истекло.</p>
                            <button class="btn-action w-100" style="background: var(--danger-color); color: white;" @onclick="RestartScenario">ПОПРОБОВАТЬ СНОВА</button>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-8">
                @if (currentUserProgress.Status == AttemptStatus.NotStarted)
                {
                    <div class="blur-zone-wrapper shadow-lg">
                        <div class="lock-center-panel">
                            <RadzenIcon Icon="lock" Style="font-size: 4rem; color: var(--accent-cyan); margin-bottom: 15px;" />
                            <h5 style="color: white; font-weight: bold; text-transform: uppercase;">Система заблокирована</h5>
                            <p style="color: #8fa0b5; font-size: 0.95rem; max-width: 70%;">Запустите сценарий на левой панели управления для получения доступа к сетевой инфраструктуре и полям ввода.</p>
                        </div>
                        <div class="blur-overlay-content">
                            <div class="schema-box" style="height: 250px;"></div>
                            <div class="flag-block"><div style="width: 60%; height: 20px; background: #343a42; margin-bottom:15px;"></div><div style="width: 100%; height: 40px; background: #131924;"></div></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="panel-box" style="min-height: 600px;">
                        @if (!string.IsNullOrEmpty(scenario.SchemaPath))
                        {
                            <div class="schema-box" style="height: 400px; display: flex; flex-direction: column;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 style="color: #cbe0f5; font-weight: bold; margin: 0;">Архитектура сети</h5>
                                    @if (!isXmlSchema)
                                    {
                                        <div style="display: flex; gap: 8px;">
                                            <button class="btn-zoom" @onclick="ZoomIn"><RadzenIcon Icon="zoom_in" /></button>
                                            <button class="btn-zoom" @onclick="ZoomOut"><RadzenIcon Icon="zoom_out" /></button>
                                            <button class="btn-zoom" @onclick="ResetZoom"><RadzenIcon Icon="restart_alt" /></button>
                                        </div>
                                    }
                                </div>

                                <div style="flex-grow: 1; border-radius: 4px; overflow: hidden; background: #0d1117;">
                                    @if (isXmlSchema)
                                    {
                                        <iframe id="drawio-workspace-iframe" style="width: 100%; height: 100%; border: none; background: #0d1117;"></iframe>
                                    }
                                    else
                                    {
                                        <div style="overflow: auto; width: 100%; height: 100%; padding: 10px;">
                                            <img src="@scenario.SchemaPath" style="transform: scale(@schemaZoomLevel); transform-origin: top left; transition: transform 0.2s ease; max-width: none;" />
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                            <h5 style="color: var(--accent-light-blue); font-weight: bold; margin: 0;">Терминал проверки</h5>
                            <span class="badge" style="background: rgba(78,195,209,0.1); border: 1px solid var(--accent-cyan); color: var(--accent-cyan); padding: 5px 12px;">Режим: @(scenario.GameMode == ScenarioGameMode.AllAtOnce ? "Свободный" : "Последовательный")</span>
                        </div>

                        @foreach (var qState in questionStates)
                        {
                            var index = questionStates.IndexOf(qState);
                            bool isLocked = !qState.IsCorrect && qState.Question.PenaltyPoints > 0 && qState.CurrentAward <= 0;

                            @if (scenario.GameMode == ScenarioGameMode.AllAtOnce || index == 0 || questionStates[index - 1].IsCorrect)
                            {
                                <div class="flag-block @(qState.IsCorrect ? "f-correct" : (isLocked ? "f-failed" : ""))" @key="qState.Question.Id">
                                    <div class="d-flex justify-content-between mb-3">
                                        <span style="color: var(--accent-blue); font-weight: bold;">ЗАДАНИЕ №@(index + 1)</span>
                                        <div style="font-family: monospace; font-size: 0.85rem;">
                                            @if (isLocked)
                                            {
                                                <span style="color: var(--danger-color); font-weight: bold;">0 XP</span>
                                            }
                                            else
                                            {
                                                <span style="color: var(--success-color);">+@qState.CurrentAward XP</span>
                                                @if (qState.Question.PenaltyPoints > 0)
                                                {
                                                    <span style="color: var(--text-muted);"> | </span> <span style="color: var(--danger-color);">-@qState.Question.PenaltyPoints XP</span>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <p style="font-size: 1rem; margin-bottom: 15px; color: #cbe0f5;">@qState.Question.Text</p>

                                    <div class="d-flex gap-2 align-items-center">
                                        <RadzenTextBox @bind-Value="@qState.UserAnswer"
                                                       Disabled="@(qState.IsCorrect || isLocked)"
                                                       Placeholder="@(qState.IsCorrect ? "Ответ принят" : (isLocked ? "Заблокировано (попытки исчерпаны)" : "Введите ваш ответ или флаг..."))"
                                                       class="w-100 dark-input"
                                                       @onkeypress="@(async (e) => await HandleKeyPress(e, qState))" />

                                        @if (!qState.IsCorrect && !isLocked)
                                        {
                                            <button class="btn-action" style="padding: 8px 16px; font-size: 0.85rem;" @onclick="@(async () => await CheckAnswer(qState))">ПРОВЕРИТЬ</button>
                                        }
                                        else if (qState.IsCorrect)
                                        {
                                            <RadzenIcon Icon="check_circle" Style="color: var(--success-color); font-size: 2rem;" />
                                        }
                                        else if (isLocked)
                                        {
                                            <RadzenIcon Icon="lock" Style="color: var(--danger-color); font-size: 2rem;" title="Попытки исчерпаны" />
                                        }
                                    </div>

                                    @if (!qState.IsCorrect && !isLocked && !string.IsNullOrEmpty(qState.Question.ExampleAnswer))
                                    {
                                        <div style="margin-top: 6px; font-size: 0.8rem; color: var(--text-muted); padding-left: 5px; font-family: monospace;">
                                            <RadzenIcon Icon="help_outline" Style="font-size: 0.9rem; vertical-align: middle; margin-right: 4px; color: var(--accent-cyan);" />
                                            Формат ответа: <span style="color: var(--text-light);">@qState.Question.ExampleAnswer</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(qState.FeedbackMessage))
                                    {
                                        <div style="margin-top: 10px; font-size: 0.9rem; font-family: monospace; color: @(qState.IsCorrect ? "var(--success-color)" : "var(--danger-color)");">@qState.FeedbackMessage</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private CyberScenario? scenario;
    private UserScenarioProgress? currentUserProgress;
    private string currentUserId = string.Empty;
    private int? currentTeamId = null;

    private Timer? _timer;
    private TimeSpan timeLeft = TimeSpan.Zero;
    private int totalScore = 0;
    private bool isXmlSchema = false;
    private string schemaXmlContent = string.Empty;
    private bool isViewerLoaded = false;
    private double schemaZoomLevel = 1.0;

    public class UserQuestionState
    {
        public ScenarioQuestion Question { get; set; } = new();
        public string UserAnswer { get; set; } = string.Empty;
        public bool IsCorrect { get; set; } = false;
        public string FeedbackMessage { get; set; } = string.Empty;
        public int FailedAttempts { get; set; } = 0;
        public int CurrentAward
        {
            get
            {
                if (Question.PenaltyPoints <= 0) return Question.AwardPoints;
                return Math.Max(0, Question.AwardPoints - (FailedAttempts * Question.PenaltyPoints));
            }
        }
    }

    private List<UserQuestionState> questionStates = new();

    private void ZoomIn() => schemaZoomLevel += 0.2;
    private void ZoomOut() { if (schemaZoomLevel > 0.4) schemaZoomLevel -= 0.2; }
    private void ResetZoom() => schemaZoomLevel = 1.0;

    protected override async Task OnInitializedAsync()
    {
        scenario = await ScenarioService.GetByIdAsync(Id);
        if (scenario == null) { NavigationManager.NavigateTo("/scenario"); return; }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

            using var ctx = await ContextFactory.CreateDbContextAsync();
            var dbUser = await ctx.Set<ApplicationUser>().Include(u => u.Teams).AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUserId);
            currentTeamId = dbUser?.Teams?.FirstOrDefault()?.Id;

            await LoadUserState();
        }
        SessionManager.TeamProgressChanged += OnTeamProgressChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isXmlSchema && !string.IsNullOrEmpty(schemaXmlContent) && !isViewerLoaded)
        {
            try { await JSRuntime.InvokeVoidAsync("setupDrawIoViewer", "drawio-workspace-iframe", schemaXmlContent); isViewerLoaded = true; }
            catch (Exception ex) { Console.WriteLine($"Ошибка инициализации Draw.io: {ex.Message}"); }
        }
    }

    private async Task LoadUserState()
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        var query = context.Set<UserScenarioProgress>().Where(p => p.CyberScenarioId == scenario!.Id);

        if (scenario!.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
        {
            // Ищем строго по TeamId (UserId здесь больше не является якорем)
            query = query.Where(p => p.TeamId == currentTeamId.Value && p.IsTeamAttempt);
        }
        else
        {
            query = query.Where(p => p.UserId == currentUserId && !p.IsTeamAttempt);
        }

        currentUserProgress = await query.FirstOrDefaultAsync(p => p.Status == AttemptStatus.InProgress)
                            ?? await query.OrderByDescending(p => p.StartedAt).FirstOrDefaultAsync();

        if (currentUserProgress == null)
            currentUserProgress = new UserScenarioProgress { Status = AttemptStatus.NotStarted };

        totalScore = currentUserProgress.Score;

        if (!string.IsNullOrEmpty(scenario.SchemaPath) && (scenario.SchemaPath.EndsWith(".xml", StringComparison.OrdinalIgnoreCase) || scenario.SchemaPath.EndsWith(".drawio", StringComparison.OrdinalIgnoreCase) || scenario.SchemaPath.EndsWith(".drawioa", StringComparison.OrdinalIgnoreCase)))
        {
            isXmlSchema = true;
            try { var filePath = Path.Combine(Env.WebRootPath, scenario.SchemaPath.TrimStart('/')); if (System.IO.File.Exists(filePath)) schemaXmlContent = await System.IO.File.ReadAllTextAsync(filePath); }
            catch { }
        }

        if (scenario.Questions != null && questionStates.Count == 0)
            questionStates = scenario.Questions.Select(q => new UserQuestionState { Question = q }).ToList();

        if (currentUserProgress.Id != 0)
        {
            var statesDb = await ScenarioService.GetUserQuestionStatesAsync(currentUserProgress.Id);
            foreach (var qState in questionStates)
            {
                if (statesDb.TryGetValue(qState.Question.Id, out var dbInfo))
                {
                    qState.IsCorrect = dbInfo.IsCorrect;
                    qState.FailedAttempts = dbInfo.FailedAttempts;
                }
            }
        }

        if (currentUserProgress.Status == AttemptStatus.InProgress)
        {
            CheckTime();
            StartTimer();
        }
    }

    private async void OnTeamProgressChanged(int teamId)
    {
        if (scenario?.Scope == VisibilityScope.TeamOnly && currentTeamId == teamId)
        {
            await InvokeAsync(async () => { await LoadUserState(); StateHasChanged(); });
        }
    }

    private async Task StartScenario()
    {
        try
        {
            using var context = await ContextFactory.CreateDbContextAsync();

            var newProgress = new UserScenarioProgress
            {
                CyberScenarioId = scenario!.Id,
                UserId = scenario.Scope == VisibilityScope.TeamOnly ? null : currentUserId, // ВАЖНО: В командном режиме UserId сессии равен null, чтобы она принадлежала всей команде!
                TeamId = scenario.Scope == VisibilityScope.TeamOnly ? currentTeamId : null,
                IsTeamAttempt = scenario.Scope == VisibilityScope.TeamOnly,
                Status = AttemptStatus.InProgress,
                StartedAt = DateTime.UtcNow,
                Score = 0
            };

            if (scenario.DurationInMinutes > 0)
                newProgress.TargetEndTime = DateTime.UtcNow.AddMinutes(scenario.DurationInMinutes);

            context.Set<UserScenarioProgress>().Add(newProgress);
            await context.SaveChangesAsync();

            await LoadUserState();

            if (scenario.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
                SessionManager.NotifyTeamUpdate(currentTeamId.Value);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка старта", ex.Message);
        }
    }

    private async Task CheckAnswer(UserQuestionState state)
    {
        if (state.Question.PenaltyPoints > 0 && state.CurrentAward <= 0) return;
        if (string.IsNullOrWhiteSpace(state.UserAnswer) || currentUserProgress?.Status != AttemptStatus.InProgress) return;

        var result = await ScenarioService.ProcessTeamAnswerAsync(currentUserProgress.Id, state.Question.Id, state.UserAnswer, currentUserId, currentTeamId);

        if (!result.Success)
        {
            if (result.AlreadySolved) { state.FeedbackMessage = "Задание уже было решено!"; state.IsCorrect = true; }
            else { state.FailedAttempts++; state.FeedbackMessage = $"❌ Отказ системы. Потенциальная награда за вопрос снижена."; }
            StateHasChanged();
            return;
        }

        totalScore = result.NewTotalScore;
        state.IsCorrect = true;
        state.FeedbackMessage = $"✓ Флаг принят! Начислено: +{result.EarnedPoints} XP.";

        if (scenario!.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
            SessionManager.NotifyTeamUpdate(currentTeamId.Value);

        StateHasChanged();

        if (questionStates.All(q => q.IsCorrect))
        {
            await Task.Delay(1000);
            await CompleteScenario();
        }
    }

    private async Task CompleteScenario()
    {
        StopTimer();
        if (currentUserProgress != null && currentUserProgress.Id != 0)
        {
            using var context = await ContextFactory.CreateDbContextAsync();
            var progressToUpdate = await context.Set<UserScenarioProgress>().FindAsync(currentUserProgress.Id);

            if (progressToUpdate != null)
            {
                progressToUpdate.Status = AttemptStatus.Completed;
                progressToUpdate.CompletedAt = DateTime.UtcNow;
                if (progressToUpdate.StartedAt.HasValue)
                    progressToUpdate.TimeSpent = progressToUpdate.CompletedAt.Value - progressToUpdate.StartedAt.Value;

                context.Set<UserScenarioProgress>().Update(progressToUpdate);
                await context.SaveChangesAsync();
            }

            await LoadUserState();
            NotificationService.Notify(NotificationSeverity.Success, "Успех", $"Сценарий завершен. Итоговый счет: {totalScore}");

            if (scenario!.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
                SessionManager.NotifyTeamUpdate(currentTeamId.Value);

            StateHasChanged();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e, UserQuestionState state)
    {
        if (e.Key == "Enter") await CheckAnswer(state);
    }

    private async void TimerTick(object? state)
    {
        if (currentUserProgress?.TargetEndTime != null)
        {
            timeLeft = currentUserProgress.TargetEndTime.Value - DateTime.UtcNow;
            if (timeLeft.TotalSeconds <= 0)
            {
                StopTimer();
                await ForceFailScenario();
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StartTimer()
    {
        if (scenario!.DurationInMinutes > 0 && currentUserProgress?.TargetEndTime != null)
        {
            _timer?.Dispose();
            _timer = new Timer(TimerTick, null, 0, 1000);
        }
    }

    private void StopTimer() => _timer?.Dispose();

    private async void CheckTime()
    {
        if (currentUserProgress?.TargetEndTime != null && DateTime.UtcNow >= currentUserProgress.TargetEndTime.Value)
            await ForceFailScenario();
    }

    private async Task ForceFailScenario()
    {
        if (currentUserProgress != null && currentUserProgress.Id != 0)
        {
            using var context = await ContextFactory.CreateDbContextAsync();
            var progress = await context.Set<UserScenarioProgress>().FindAsync(currentUserProgress.Id);
            if (progress != null)
            {
                progress.Status = AttemptStatus.Failed;
                progress.CompletedAt = DateTime.UtcNow;
                context.Set<UserScenarioProgress>().Update(progress);
                await context.SaveChangesAsync();
            }
        }
        await InvokeAsync(async () => { await LoadUserState(); StateHasChanged(); });
        if (scenario!.Scope == VisibilityScope.TeamOnly && currentTeamId.HasValue)
            SessionManager.NotifyTeamUpdate(currentTeamId.Value);
    }

    private async Task RestartScenario()
    {
        await StartScenario();
        if (scenario!.Questions != null)
            questionStates = scenario.Questions.Select(q => new UserQuestionState { Question = q }).ToList();
    }

    public void Dispose()
    {
        StopTimer();
        SessionManager.TeamProgressChanged -= OnTeamProgressChanged;
    }
}