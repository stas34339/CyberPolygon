@page "/instruction"
@using CyberPolygon.Data.Models
@using CyberPolygon.Services
@using Radzen
@using Radzen.Blazor
@rendermode InteractiveServer

@inject InstructionService InstructionService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Руководство оператора | Киберполигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-input: #1a2332;
        --border-color: #2a3a4a;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .instruction-container {
        background-color: var(--bg-main);
        min-height: 100vh;
        color: var(--text-light);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 35px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
        gap: 20px;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

    .header-text {
        flex: 1;
    }

        .header-text h1 {
            color: var(--accent-light-blue);
            font-weight: 700;
            text-transform: uppercase;
            margin: 0 0 8px 0;
            font-size: 1.8rem;
            letter-spacing: 1px;
        }

        .header-text p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 0;
            line-height: 1.5;
        }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
            background: linear-gradient(135deg, #5fd4e0 0%, #6fb3f0 100%);
        }

    .btn-icon {
        background: transparent;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 5px 8px;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
    }

        .btn-icon.edit {
            color: var(--accent-light-blue);
            border-color: rgba(126, 200, 248, 0.3);
        }

            .btn-icon.edit:hover {
                background: rgba(126, 200, 248, 0.1);
                border-color: var(--accent-light-blue);
            }

        .btn-icon.delete {
            color: var(--danger-color);
            border-color: rgba(224, 108, 117, 0.3);
        }

            .btn-icon.delete:hover {
                background: rgba(224, 108, 117, 0.1);
                border-color: var(--danger-color);
            }

        .btn-icon.move {
            color: var(--accent-cyan);
            border-color: rgba(78, 195, 209, 0.3);
        }

            .btn-icon.move:hover {
                background: rgba(78, 195, 209, 0.1);
                border-color: var(--accent-cyan);
            }

    .content-layout {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 25px;
        align-items: start;
    }

    .cyber-accordion {
        background-color: transparent !important;
        border: none !important;
    }

    ::deep .rz-accordion-header {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        margin-bottom: 6px;
        border-radius: 8px !important;
        padding: 16px 20px !important;
        transition: all 0.2s;
    }

        ::deep .rz-accordion-header:hover {
            border-color: rgba(78, 195, 209, 0.3) !important;
        }

        ::deep .rz-accordion-header .rz-accordion-header-text {
            color: var(--accent-light-blue) !important;
            font-weight: 600 !important;
            letter-spacing: 0.5px;
        }

        ::deep .rz-accordion-header .rz-accordion-toggle {
            color: var(--accent-cyan) !important;
        }

    ::deep .rz-accordion-content {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%) !important;
        border: 1px solid var(--border-color) !important;
        border-top: none !important;
        color: var(--text-light) !important;
        padding: 20px !important;
        margin-top: -7px;
        margin-bottom: 12px;
        border-bottom-left-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    .instruction-item {
        position: relative;
    }

    .instruction-actions {
        display: flex;
        gap: 6px;
        position: absolute;
        top: 0;
        right: 0;
        z-index: 5;
    }

    .instruction-text {
        white-space: pre-wrap;
        word-break: break-word;
        line-height: 1.7;
        color: var(--text-light);
        font-size: 0.95rem;
    }

    .attachments-section {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px dashed var(--border-color);
    }

    .attachments-label {
        color: var(--text-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .attachment-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(78, 195, 209, 0.1);
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.3);
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.85rem;
        margin-right: 8px;
        margin-bottom: 8px;
        transition: all 0.2s;
        font-weight: 500;
    }

        .attachment-link:hover {
            background: rgba(78, 195, 209, 0.2);
            border-color: var(--accent-cyan);
        }

    .side-panel {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        position: sticky;
        top: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .side-panel-title {
        color: var(--accent-cyan);
        font-weight: 600;
        margin-bottom: 18px;
        font-size: 1rem;
        letter-spacing: 0.5px;
    }

    .side-panel-text {
        color: var(--text-muted);
        font-size: 0.85rem;
        line-height: 1.7;
    }

    .side-panel-divider {
        border-color: var(--border-color);
        margin: 15px 0;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(152, 195, 121, 0.1);
        color: var(--success-color);
        border: 1px solid rgba(152, 195, 121, 0.3);
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        border: 2px dashed var(--border-color);
        border-radius: 10px;
        background: rgba(26, 35, 50, 0.5);
    }

    .loading-container {
        text-align: center;
        padding: 60px 20px;
    }

    .move-buttons {
        display: flex;
        gap: 4px;
    }
</style>

<div class="instruction-container p-4">
    <div class="page-header">
        <div class="header-text">
            <h1>Руководство оператора киберполигона</h1>
            <p>Информационно-аналитический департамент // Инструкции по работе с системой</p>
        </div>

        <AuthorizeView Roles="Admin">
            @* Переход на новую отдельную страницу *@
            <button type="button" class="btn-primary-gradient" @onclick="@(() => NavigationManager.NavigateTo("/instruction/edit"))">
                <RadzenIcon Icon="add" Style="font-size: 1.2rem; margin-top: -2px;" /> Новая инструкция
            </button>
        </AuthorizeView>
    </div>

    <div class="content-layout">
        <div>
            @if (isLoading)
            {
                <div class="loading-container">
                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color);" />
                    <p style="color: var(--text-muted); margin-top: 15px; font-size: 0.9rem;">ЧТЕНИЕ ДАННЫХ ИЗ РЕПОЗИТОРИЯ...</p>
                </div>
            }
            else if (!instructions.Any())
            {
                <div class="empty-state">
                    <RadzenIcon Icon="folder_open" Style="font-size: 3rem; color: var(--border-color); margin-bottom: 15px;" />
                    <p style="color: var(--text-muted); font-size: 0.95rem;">База знаний пуста. Добавьте первую инструкцию через терминал управления.</p>
                </div>
            }
            else
            {
                <RadzenAccordion Multiple="true" class="cyber-accordion">
                    <Items>
                        @for (int i = 0; i < instructions.Count; i++)
                        {
                            var item = instructions[i];
                            var index = i;

                            <RadzenAccordionItem Text="@item.Title" Icon="@item.IconName">
                                <div class="instruction-item">
                                    <AuthorizeView Roles="Admin">
                                        <div class="instruction-actions">
                                            <div class="move-buttons">
                                                <button class="btn-icon move" title="Вверх" disabled="@(index == 0)" @onclick="@(() => MoveInstruction(index, -1))">
                                                    <RadzenIcon Icon="arrow_upward" />
                                                </button>
                                                <button class="btn-icon move" title="Вниз" disabled="@(index == instructions.Count - 1)" @onclick="@(() => MoveInstruction(index, 1))">
                                                    <RadzenIcon Icon="arrow_downward" />
                                                </button>
                                            </div>
                                            @* Переход на редактирование по Id *@
                                            <button class="btn-icon edit" title="Редактировать" @onclick="@(() => NavigationManager.NavigateTo($"/instruction/edit/{item.Id}"))">
                                                <RadzenIcon Icon="edit" />
                                            </button>
                                            <button class="btn-icon delete" title="Удалить" @onclick="@(() => DeleteInstruction(item.Id))">
                                                <RadzenIcon Icon="delete" />
                                            </button>
                                        </div>
                                    </AuthorizeView>

                                    <div class="pe-5">
                                        <p class="instruction-text">@item.Description</p>

                                        @if (item.Attachments != null && item.Attachments.Any())
                                        {
                                            <div class="attachments-section">
                                                <div class="attachments-label">СВЯЗАННЫЕ ФАЙЛЫ:</div>
                                                <div>
                                                    @foreach (var file in item.Attachments)
                                                    {
                                                        <a href="@file.FilePath" download="@file.FileName" class="attachment-link">
                                                            <RadzenIcon Icon="file_download" style="font-size: 0.9rem;" /> @file.FileName
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </RadzenAccordionItem>
                        }
                    </Items>
                </RadzenAccordion>
            }
        </div>

        <div class="side-panel">
            <h5 class="side-panel-title">// ОБЩИЙ РЕГЛАМЕНТ ТЕСТИРОВАНИЯ</h5>
            <div class="side-panel-text">
                <p>1. Перед началом выполнения сценария убедитесь, что выделенный VPN-туннель стабилен и логи пишутся в SIEM.</p>
                <p>2. Любые действия, выходящие за рамки ТЗ сценария (сканирование подсетей департамента, брутфорс смежных узлов), классифицируются как нарушение регламента.</p>
                <p>3. Время прохождения попытки фиксируется автоматически. Кнопка «Завершить» отправляет слепок вашей сессии на проверку.</p>
                <hr class="side-panel-divider" />
                <div class="status-badge">
                    <RadzenIcon Icon="verified" style="font-size: 1rem;" /> СТАТУС ИАО.БЕЗ АКТИВЕН
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<InstructionModel> instructions = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            instructions = await InstructionService.GetAllAsync();
            instructions = instructions.OrderBy(i => i.Order).ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка загрузки", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // === ПЕРЕМЕЩЕНИЕ ===

    private async Task MoveInstruction(int currentIndex, int direction)
    {
        if (currentIndex + direction < 0 || currentIndex + direction >= instructions.Count) return;

        var currentItem = instructions[currentIndex];
        var swapItem = instructions[currentIndex + direction];

        // Меняем Order местами
        var tempOrder = currentItem.Order;
        currentItem.Order = swapItem.Order;
        swapItem.Order = tempOrder;

        try
        {
            await InstructionService.UpdateOrderAsync(currentItem);
            await InstructionService.UpdateOrderAsync(swapItem);

            NotificationService.Notify(NotificationSeverity.Success, "Система", "Порядок инструкций обновлён.");
            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка", ex.Message);
        }
    }

    // === УДАЛЕНИЕ ===

    private async Task DeleteInstruction(int id)
    {
        try
        {
            await InstructionService.DeleteAsync(id);
            NotificationService.Notify(NotificationSeverity.Warning, "Терминал", "Инструкция удалена.");
            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка удаления", ex.Message);
        }
    }
}