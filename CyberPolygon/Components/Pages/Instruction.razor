@page "/instruction"
@using CyberPolygon.Data.Models
@using CyberPolygon.Services
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer

@inject InstructionService InstructionService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Руководство оператора | Киберполигон</PageTitle>

<style>
    :root {
        --bg-dark: #0d1117;
        --bg-card: #161b22;
        --accent-blue: #00e5ff;
        --accent-purple: #b388ff;
        --border-color: #30363d;
        --text-main: #ffffff; /* Убеждаемся, что основной текст чисто белый */
        --text-muted: #8b949e;
    }

    .instruction-container {
        background-color: var(--bg-dark);
        min-height: 100vh;
        color: var(--text-main);
        font-family: 'Courier New', Courier, monospace;
    }

        /* Принудительно делаем текст светлым во всех базовых элементах */
        .instruction-container p,
        .instruction-container span,
        .instruction-container div,
        .instruction-container label {
            color: var(--text-main);
        }

    .text-muted {
        color: var(--text-muted) !important;
    }

    .header-block {
        border-bottom: 1px solid var(--border-color);
    }

    .page-title {
        font-family: monospace;
        font-weight: bold;
        letter-spacing: 1px;
        color: var(--text-main) !important;
    }

    .cyber-accordion {
        background-color: transparent !important;
        border: none !important;
    }

    ::deep .rz-accordion-header {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-main) !important;
        margin-bottom: 8px;
        border-radius: 4px;
        font-family: monospace;
    }

        ::deep .rz-accordion-header .rz-accordion-header-text,
        ::deep .rz-accordion-header .rz-accordion-toggle {
            color: var(--text-main) !important;
        }

    ::deep .rz-accordion-content {
        background-color: #161b22 !important;
        border: 1px solid var(--border-color) !important;
        border-top: none !important;
        color: #ffffff !important;
        padding: 20px !important;
        margin-top: -9px;
        margin-bottom: 15px;
        border-bottom-left-radius: 4px;
        border-bottom-right-radius: 4px;
    }

    /* Стилизация текстовых полей */
    ::deep .rz-textbox,
    ::deep .rz-textarea,
    ::deep .rz-dropdown {
        background-color: #0d1117 !important;
        color: #ffffff !important;
        border-color: var(--border-color) !important;
    }

    ::deep .rz-dropdown-label {
        color: #ffffff !important;
    }

    .form-control[type="file"] {
        background-color: #0d1117 !important;
        color: #ffffff !important;
        border: 1px solid var(--border-color) !important;
    }

        .form-control[type="file"]::file-selector-button {
            background-color: var(--bg-card);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            margin-right: 10px;
            padding: 4px 12px;
            border-radius: 4px;
            cursor: pointer;
        }

    /* Предотвращение выхода текста за рамки */
    .instruction-text-content {
        white-space: pre-wrap;
        word-break: break-word;
        overflow-wrap: break-word;
        font-family: sans-serif;
        line-height: 1.6;
        color: #ffffff !important;
    }

    .badge-cyber {
        font-family: monospace;
        font-size: 0.75rem;
        padding: 4px 8px;
        border-radius: 3px;
        font-weight: bold;
        text-transform: uppercase;
    }

    .bg-info-cyber {
        background: rgba(0, 229, 255, 0.1);
        color: #00e5ff !important;
        border: 1px solid rgba(0, 229, 255, 0.3);
    }

    .rules-card {
        background-color: #161b22;
        border: 1px solid #30363d;
        border-radius: 6px;
        color: #ffffff !important;
    }

    .admin-control-panel {
        background: rgba(179, 136, 255, 0.05);
        border: 1px dashed var(--accent-purple);
        border-radius: 6px;
    }
</style>

<style>
    .rz-dropdown-panel {
        background-color: #161b22 !important;
        border: 1px solid #30363d !important;
    }

    .rz-dropdown-items {
        background-color: #161b22 !important;
    }

    .rz-dropdown-item {
        color: #ffffff !important;
        background-color: transparent !important;
    }

        .rz-dropdown-item:hover,
        .rz-dropdown-item.rz-state-highlight {
            background-color: #30363d !important;
            color: #00e5ff !important;
        }
</style>

<div class="instruction-container p-4">
    <div class="d-flex align-items-center justify-content-between mb-4 header-block pb-3">
        <div class="d-flex align-items-center gap-3">
            <RadzenIcon Icon="help_center" Style="color: var(--accent-blue); font-size: 2rem;" />
            <div>
                <h1 class="page-title m-0">Руководство оператора киберполигона</h1>
                <p class="text-muted m-0" style="font-size: 0.85rem; font-family: monospace;">
                    ИНФОРМАЦИОННО-АНАЛИТИЧЕСКИЙ ДЕПАРТАМЕНТ // ИНСТРУКЦИИ ПО РАБОТЕ С СИСТЕМОЙ
                </p>
            </div>
        </div>

        <AuthorizeView Roles="Admin" Context="authHeaderContext">
            <RadzenButton Text="@(showAdminPanel ? "Закрыть терминал" : "Терминал управления")"
                          Icon="@(showAdminPanel ? "close" : "developer_board")"
                          ButtonStyle="@(showAdminPanel ? ButtonStyle.Secondary : ButtonStyle.Primary)"
                          Style="font-family: monospace;"
                          Click="@(() => showAdminPanel = !showAdminPanel)" />
        </AuthorizeView>
    </div>

    <AuthorizeView Roles="Admin" Context="authFormContext">
        @if (showAdminPanel)
        {
            <div class="admin-control-panel p-4 mb-4">
                <h4 class="text-white mb-3" style="font-family: monospace; color: var(--accent-purple) !important;">
                    <RadzenIcon Icon="add_moderator" class="me-2" /> РЕЖИМ МОДИФИКАЦИИ БАЗЫ ЗНАНИЙ
                </h4>

                <RadzenTemplateForm TItem="InstructionModel" Data="@newInstruction" Submit="HandleSubmit">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small d-block mb-1">НАЗВАНИЕ ИНСТРУКЦИИ</label>
                            <RadzenTextBox @bind-Value="@newInstruction.Title" Name="Title" class="w-100" />
                            <RadzenRequiredValidator Component="Title" Text="Укажите название" Popup="false" Style="color: var(--accent-purple); font-size:0.8rem; font-family: monospace;" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="text-muted small d-block mb-1">СИСТЕМНАЯ ИКОНКА (MATERIAL ICON)</label>
                            <RadzenDropDown @bind-Value="@newInstruction.IconName" Data="@availableIcons" class="w-100" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small d-block mb-1">СОДЕРЖАНИЕ / ИНСТРУКЦИЯ (ПОДДЕРЖИВАЕТСЯ ПЕРЕНОС СТРОК)</label>
                        <RadzenTextArea @bind-Value="@newInstruction.Description" Name="Description" Rows="4" class="w-100" Style="font-family: monospace;" />
                        <RadzenRequiredValidator Component="Description" Text="Заполните описание" Popup="false" Style="color: var(--accent-purple); font-size:0.8rem; font-family: monospace;" />
                    </div>

                    <div class="row align-items-start mb-3">
                        <div class="col-md-8">
                            <label class="text-muted small d-block mb-1">ВЛОЖЕНИЯ (МОЖНО ВЫБРАТЬ НЕСКОЛЬКО ФАЙЛОВ)</label>
                            <InputFile OnChange="LoadFiles" multiple class="form-control" style="font-family: monospace;" />

                            @if (uploadedFiles.Any())
                            {
                                <div class="mt-2 p-2" style="background: rgba(22, 27, 34, 0.8); border: 1px dashed var(--border-color); border-radius: 4px;">
                                    <span class="text-muted small d-block mb-1">Готовы к загрузке (@uploadedFiles.Count):</span>
                                    <ul class="list-unstyled m-0 small">
                                        @foreach (var file in uploadedFiles)
                                        {
                                            <li class="mb-1" style="color: var(--accent-blue);">
                                                <RadzenIcon Icon="attach_file" Style="font-size: 1rem; vertical-align: middle;" /> @file.Name
                                                <span class="text-muted ms-2">(@(file.Size / 1024) KB)</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                        <div class="col-md-4 text-end pt-4">
                            <RadzenButton ButtonType="ButtonType.Submit" Text="Инициализировать инструкцию" Icon="bolt" ButtonStyle="ButtonStyle.Success" />
                        </div>
                    </div>
                </RadzenTemplateForm>
            </div>
        }
    </AuthorizeView>

    <div class="row">
        <div class="col-lg-8 mb-4">
            @if (isLoading)
            {
                <div class="text-center p-5">
                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ButtonStyle="ButtonStyle.Info" />
                    <p class="text-muted mt-2 small">ЧТЕНИЕ ДАННЫХ ИЗ РЕПОЗИТОРИЯ...</p>
                </div>
            }
            else if (!instructions.Any())
            {
                <div class="text-center p-5 rules-card">
                    <RadzenIcon Icon="folder_open" Style="font-size: 3rem; color: var(--text-muted);" />
                    <p class="text-muted mt-2">База знаний пуста. Добавьте первую инструкцию через терминал управления.</p>
                </div>
            }
            else
            {
                <RadzenAccordion Multiple="true" class="cyber-accordion">
                    <Items>
                        @foreach (var item in instructions)
                        {
                            <RadzenAccordionItem Text="@item.Title" Icon="@item.IconName">
                                <div class="position-relative">
                                    <AuthorizeView Roles="Admin" Context="authDeleteContext">
                                        <div class="position-absolute top-0 end-0">
                                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                          Variant="Variant.Outlined" Tooltip="Удалить инструкцию"
                                                          Click="@(() => DeleteInstruction(item.Id))" />
                                        </div>
                                    </AuthorizeView>

                                    <div class="pe-5">
                                        <p class="instruction-text-content">
                                            @item.Description
                                        </p>

                                        @if (item.Attachments != null && item.Attachments.Any())
                                        {
                                            <div class="mt-3 pt-3" style="border-top: 1px dashed var(--border-color);">
                                                <span class="text-muted small d-block mb-2" style="font-family: monospace;">СВЯЗАННЫЕ ФАЙЛЫ:</span>
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var file in item.Attachments)
                                                    {
                                                        <a href="@file.FilePath" download="@file.FileName" class="badge-cyber bg-info-cyber text-decoration-none" style="cursor: pointer;">
                                                            <RadzenIcon Icon="file_download" Style="font-size: 0.9rem; vertical-align: middle;" class="me-1" />
                                                            @file.FileName
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </RadzenAccordionItem>
                        }
                    </Items>
                </RadzenAccordion>
            }
        </div>

        <div class="col-lg-4">
            <div class="rules-card p-4">
                <h5 class="rules-title mb-3" style="color: var(--accent-blue); font-weight: bold; font-family: monospace;">
                    // ОБЩИЙ РЕГЛАМЕНТ ТЕСТИРОВАНИЯ
                </h5>
                <div class="text-muted small" style="font-family: monospace; line-height: 1.5;">
                    <p>1. Перед началом выполнения сценария убедитесь, что выделенный VPN-туннель стабилен и логи пишутся в SIEM.</p>
                    <p>2. Любые действия, выходящие за рамки ТЗ сценария (сканирование подсетей департамента, брутфорс смежных узлов), классифицируются как нарушение регламента.</p>
                    <p>3. Время прохождения попытки фиксируется автоматически. Кнопка «Завершить» отправляет слепок вашей сессии на проверку.</p>
                    <hr style="border-color: var(--border-color);" />
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge-cyber bg-info-cyber">СТАТУС ИАО.БЕЗ</span>
                        <span class="text-white">АКТИВЕН</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<InstructionModel> instructions = new();
    private InstructionModel newInstruction = new();
    private bool isLoading = true;
    private bool showAdminPanel = false;

    // ИЗМЕНЕНИЕ: Теперь это список файлов
    private IReadOnlyList<IBrowserFile> uploadedFiles = new List<IBrowserFile>();
    private int maxAllowedFiles = 10;
    private long maxFileSize = 1024 * 1024 * 30; // 30 MB на один файл

    private readonly List<string> availableIcons = new()
    {
        "assignment", "terminal", "security", "shield", "bug_report",
        "lock", "visibility", "help_center", "description", "code", "lan"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            instructions = await InstructionService.GetAllAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка загрузки", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // ИЗМЕНЕНИЕ: Обработка нескольких файлов
    private void LoadFiles(InputFileChangeEventArgs e)
    {
        uploadedFiles = e.GetMultipleFiles(maxAllowedFiles);
    }

    private async Task HandleSubmit()
    {
        try
        {
            // Передаем коллекцию файлов в сервис
            await InstructionService.AddAsync(newInstruction, uploadedFiles);

            NotificationService.Notify(NotificationSeverity.Success, "Система", "Новая инструкция успешно интегрирована.");

            newInstruction = new InstructionModel();
            uploadedFiles = new List<IBrowserFile>(); // Сбрасываем список
            showAdminPanel = false;

            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Критическая ошибка", ex.Message);
        }
    }

    private async Task DeleteInstruction(int id)
    {
        try
        {
            await InstructionService.DeleteAsync(id);
            NotificationService.Notify(NotificationSeverity.Warning, "Терминал", "Инструкция удалена.");
            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка удаления", ex.Message);
        }
    }
}