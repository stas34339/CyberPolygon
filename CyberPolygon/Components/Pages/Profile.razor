@page "/profile"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager

<PageTitle>Личный кабинет</PageTitle>

<style>
    :root {
        --bg-dark: #1e1e1e; /* Основной фон */
        --bg-card: #252526; /* Фон карточек */
        --accent-blue: #00bfff; /* Голубой акцент */
        --accent-green: #64ffda; /* Зеленый успех */
        --border-color: #333333; /* Границы */
        --text-main: #e1e1e1; /* Основной текст */
        --text-muted: #9da5b4; /* Вторичный текст */
    }

    .dashboard-wrapper {
        background-color: var(--bg-dark);
        min-height: 100vh;
        color: var(--text-main);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    /* Адаптация карточек */
    .cyber-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 4px !important; /* Более строгие углы */
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        transition: all 0.2s ease-in-out;
    }

        .cyber-card:hover {
            border-color: var(--accent-blue) !important;
            box-shadow: 0 0 15px rgba(0, 191, 255, 0.1);
        }

    .stat-value {
        font-size: 3rem;
        font-weight: 700;
        color: var(--accent-blue);
        line-height: 1;
    }

    /* Стилизация таблицы Radzen под темный фон */
    .rz-datagrid {
        --rz-grid-header-background-color: #2d2d30;
        --rz-grid-header-color: var(--accent-blue);
        --rz-grid-cell-color: var(--text-main);
        border: none !important;
    }

    .rz-datagrid-data td {
        background-color: var(--bg-card) !important;
        border-bottom: 1px solid var(--border-color) !important;
    }

    .text-cyan {
        color: var(--accent-blue) !important;
    }

    .text-green {
        color: var(--accent-green) !important;
    }

    .text-muted {
        color: var(--text-muted) !important;
    }

    /* Оповещение в стиле статус-бара */
    .status-alert {
        background: rgba(45, 45, 48, 0.8) !important;
        border: 1px solid var(--border-color) !important;
        border-left: 4px solid var(--accent-blue) !important;
    }
</style>

<div class="dashboard-wrapper rz-p-4 rz-p-md-6">

    @* ВЕРХНЯЯ ПАНЕЛЬ СТАТУСА *@
    <RadzenAlert AlertStyle="AlertStyle.Base" Variant="Variant.Flat" AllowClose="false" class="rz-mb-6 status-alert">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenIcon Icon="dns" Style="color: var(--accent-blue);" />
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0 text-cyan" Style="font-weight: bold;">
                    Имя пользователя: @UserDisplayName
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0 text-muted">
                    Система мониторинга: <span class="text-green">ONLINE</span> | База сценариев: <span class="text-cyan">ПОДКЛЮЧЕНО</span>
                </RadzenText>
            </RadzenStack>
        </RadzenStack>
    </RadzenAlert>

    @* ОСНОВНЫЕ МЕТРИКИ *@
    <RadzenRow Gap="1rem" class="rz-mb-6">
        @* Количество сценариев *@
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard class="cyber-card">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Overline" class="text-muted">Всего сценариев в БД</RadzenText>
                    <div class="stat-value">@totalScenarios</div>
                    <RadzenText TextStyle="TextStyle.Caption" class="text-cyan">Доступно для запуска</RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @* Пройдено *@
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard class="cyber-card">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Overline" class="text-muted">Пройдено сценариев</RadzenText>
                    <div class="stat-value" style="color: var(--accent-green)">@completedCount</div>
                    <RadzenText TextStyle="TextStyle.Caption" class="text-green">Завершено успешно</RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @* Процент эффективности *@
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard class="cyber-card">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Overline" class="text-muted">Общая эффективность</RadzenText>
                    <div class="stat-value" style="color: #f1c40f">@successRate%</div>
                    <RadzenProgressBar Value="@successRate" ShowValue="false"
                                       ProgressBarStyle="ProgressBarStyle.Warning"
                                       Style="height: 6px; background: #333;" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    @* ЖУРНАЛ ПРОХОЖДЕНИЯ *@
    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenCard class="cyber-card" Style="padding: 0;">
                <div class="rz-p-4" style="border-bottom: 1px solid var(--border-color);">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="list_alt" class="text-cyan" />
                        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Архив завершенных сценариев</RadzenText>
                    </RadzenStack>
                </div>

                @if (completedScenariosList == null || !completedScenariosList.Any())
                {
                    <div class="rz-p-10" style="text-align: center; color: var(--text-muted);">
                        <RadzenIcon Icon="find_in_page" Style="font-size: 3rem; opacity: 0.2;" />
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-mt-2">Активных записей не обнаружено</RadzenText>
                        <RadzenButton Text="НАЧАТЬ ТРЕНИРОВКУ"
                                      ButtonStyle="ButtonStyle.Info"
                                      class="rz-mt-4"
                                      Click="@(() => NavigationManager.NavigateTo("scenario"))" />
                    </div>
                }
                else
                {
                    <RadzenDataGrid Data="@completedScenariosList" TItem="UserScenarioProgress" Density="Density.Default">
                        <Columns>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="СЦЕНАРИЙ">
                                <Template Context="data">
                                    @data.Scenario?.Title
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="UserScenarioProgress" Property="CompletedAt" Title="ДАТА ЗАВЕРШЕНИЯ" Width="200px" FormatString="{0:dd.MM.yyyy HH:mm}" />

                            <RadzenDataGridColumn TItem="UserScenarioProgress" Property="Score" Title="РЕЗУЛЬТАТ" Width="150px">
                                <Template Context="data">
                                    <span class="text-green">@data.Score XP</span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    private string UserDisplayName => user?.UserName ?? "Guest_User";
    private ApplicationUser? user;

    private int totalScenarios = 0;
    private int completedCount = 0;
    private double successRate = 0;

    // Используем конкретный тип, а не dynamic, чтобы RadzenDataGrid работал стабильно
    private List<UserScenarioProgress> completedScenariosList = new();

    [Inject] private IDbContextFactory<ApplicationDbContext> ContextFactory { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        using (var context = await ContextFactory.CreateDbContextAsync())
        {
            if (userId != null)
            {
                user = await context.Set<ApplicationUser>().FirstOrDefaultAsync(u => u.Id == userId);
            }

            // 1. Считаем общее количество сценариев
            totalScenarios = await context.Set<CyberScenario>().CountAsync();

            // 2. Получаем историю прогресса конкретного пользователя
            // Предполагаем, что у UserScenarioProgress есть навигационное свойство Scenario
            completedScenariosList = await context.Set<UserScenarioProgress>()
                .Include(p => p.Scenario)
                .Where(p => p.UserId == userId && p.IsCompleted)
                .OrderByDescending(p => p.CompletedAt)
                .ToListAsync();

            // 3. Вычисления
            completedCount = completedScenariosList.Count;

            if (totalScenarios > 0)
            {
                successRate = Math.Round(((double)completedCount / totalScenarios) * 100, 1);
            }
        }
    }
}