@page "/profile"
@using CyberPolygon.Data
@using CyberPolygon.Services
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@using System.Security.Claims
@using static CyberPolygon.Data.ApplicationDbContext
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject ScenarioSessionManager SessionManager
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject UserManagementService UserManagementService
@implements IDisposable
@rendermode InteractiveServer

<RadzenDialog />
<PageTitle>Личный кабинет | Киберполигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --bg-input: #1a2332;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .profile-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-muted);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1300px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

    .user-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-left: 4px solid var(--accent-cyan);
        border-radius: 10px;
        padding: 20px 25px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .user-name {
        color: var(--accent-light-blue);
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0;
    }

    .user-meta {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

        .user-meta span {
            color: var(--text-light);
            font-weight: 500;
        }

    .active-session-badge {
        background: rgba(78, 195, 209, 0.1);
        border: 1px solid var(--accent-cyan);
        border-radius: 8px;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cyber-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
        overflow: hidden;
        margin-bottom: 25px;
    }

        .cyber-card:hover {
            border-color: rgba(78, 195, 209, 0.3);
        }

    .tabs-navigation {
        display: flex;
        border-bottom: 2px solid var(--border-color);
        margin-bottom: 25px;
        gap: 5px;
        flex-wrap: wrap;
    }

    .tab-trigger {
        background: transparent;
        border: none;
        padding: 12px 24px;
        color: var(--text-muted);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .tab-trigger:hover {
            color: var(--text-light);
        }

        .tab-trigger.active {
            color: var(--accent-cyan);
            border-bottom: 2px solid var(--accent-cyan);
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        text-align: center;
    }

    .stat-label {
        color: var(--text-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .stat-value {
        font-size: 2.2rem;
        font-weight: bold;
    }

    .stat-sub {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 4px;
    }

    .text-cyan {
        color: var(--accent-cyan) !important;
    }

    .text-blue {
        color: var(--accent-blue) !important;
    }

    .text-light-blue {
        color: var(--accent-light-blue) !important;
    }

    .text-green {
        color: var(--success-color) !important;
    }

    .text-danger {
        color: var(--danger-color) !important;
    }

    .text-warning {
        color: var(--warning-color) !important;
    }

    .text-muted {
        color: var(--text-muted) !important;
    }

    .text-light {
        color: var(--text-light) !important;
    }

    .section-title {
        color: var(--accent-cyan);
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 0.5px;
    }

    .team-member-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid var(--border-color);
    }

        .team-member-row:last-child {
            border-bottom: none;
        }

    ::deep .rz-datagrid {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 8px !important;
    }

    ::deep .rz-grid-table thead th {
        background-color: #1a1d21 !important;
        color: var(--accent-cyan) !important;
        border-bottom: 1px solid var(--border-color) !important;
        border-right: 1px solid var(--border-color) !important;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    ::deep .rz-grid-table tbody tr {
        background-color: transparent !important;
        color: var(--text-muted) !important;
    }

        ::deep .rz-grid-table tbody tr:hover {
            background-color: var(--bg-card-hover) !important;
        }

    ::deep .rz-grid-table td {
        border-bottom: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-right: 1px solid var(--border-color) !important;
    }

    ::deep .rz-pager {
        background-color: #1a1d21 !important;
        border-top: 1px solid var(--border-color) !important;
        color: var(--text-muted) !important;
    }

    .rz-textbox, .rz-dropdown, .dark-input {
        background-color: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
    }

    .rz-dropdown-label {
        color: var(--text-light) !important;
    }

    .rz-dropdown-panel, .rz-autocomplete-panel {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 6px !important;
    }

    .rz-dropdown-items-wrapper {
        background-color: var(--bg-card) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
    }

        .rz-dropdown-item:hover {
            background-color: var(--bg-card-hover) !important;
            color: var(--accent-cyan) !important;
        }

    .team-badge {
        background: rgba(91, 163, 227, 0.15);
        color: var(--accent-blue);
        border: 1px solid rgba(91, 163, 227, 0.3);
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-badge-mini {
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .status-in-progress {
        background: rgba(78, 195, 209, 0.15);
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.4);
    }

    .status-completed {
        background: rgba(152, 195, 121, 0.15);
        color: var(--success-color);
        border: 1px solid rgba(152, 195, 121, 0.4);
    }

    .status-failed {
        background: rgba(224, 108, 117, 0.15);
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.4);
    }

    .rz-dialog {
        background-color: var(--bg-card) !important;
        color: var(--text-light) !important;
        border: 1px solid var(--border-color) !important;
    }

    .rz-dialog-title {
        color: var(--text-light) !important;
    }

    .rz-dialog-content {
        color: var(--text-light) !important;
    }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.85rem;
        box-shadow: 0 4px 15px rgba(78, 195, 209, 0.2);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
        }

    .btn-icon-danger {
        background: transparent;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.3);
        padding: 4px 6px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
    }

        .btn-icon-danger:hover {
            background: rgba(224, 108, 117, 0.1);
            border-color: var(--danger-color);
        }

    .btn-detail {
        background: transparent;
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.3);
        padding: 5px 10px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .btn-detail:hover {
            background: rgba(78, 195, 209, 0.1);
            border-color: var(--accent-cyan);
        }

    .loading-container {
        text-align: center;
        padding: 80px 20px;
    }

    .leaderboard-list {
        display: flex;
        flex-direction: column;
    }

    .leaderboard-row {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 14px 10px;
        border-bottom: 1px solid var(--border-color);
        transition: all 0.2s;
        border-radius: 6px;
    }

        .leaderboard-row:hover {
            background: rgba(78, 195, 209, 0.05);
        }

        .leaderboard-row:last-child {
            border-bottom: none;
        }

        .leaderboard-row.current-user {
            background: rgba(78, 195, 209, 0.08);
            border-left: 3px solid var(--accent-cyan);
            border-radius: 0 6px 6px 0;
        }

    .rank-col {
        width: 40px;
        text-align: center;
        flex-shrink: 0;
    }

    .rank-medal {
        font-size: 1.5rem;
    }

    .rank-number {
        color: var(--text-muted);
        font-weight: bold;
        font-size: 1rem;
    }

    .user-col {
        flex: 1;
        min-width: 0;
    }

    .user-name-text {
        color: var(--text-light);
        font-weight: 600;
        display: block;
        font-size: 0.9rem;
    }

    .current-user .user-name-text {
        color: var(--accent-cyan);
    }

    .user-group-text {
        color: var(--text-muted);
        font-size: 0.75rem;
    }

    .score-col {
        text-align: center;
        flex-shrink: 0;
        width: 70px;
    }

    .score-value {
        color: var(--accent-cyan);
        font-weight: bold;
        font-size: 1.1rem;
        display: block;
    }

    .score-label {
        color: var(--text-muted);
        font-size: 0.7rem;
        text-transform: uppercase;
    }

    .progress-col {
        width: 120px;
        flex-shrink: 0;
    }

    .mini-progress {
        height: 4px;
        background: var(--border-color);
        border-radius: 2px;
        overflow: hidden;
        margin-bottom: 4px;
    }

    .mini-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
        border-radius: 2px;
        transition: width 0.5s ease;
    }

        .mini-progress-fill.test-fill {
            background: linear-gradient(90deg, var(--success-color), var(--accent-cyan));
        }

    .completed-count {
        color: var(--text-muted);
        font-size: 0.7rem;
    }

    .test-stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .test-stat-item {
        text-align: center;
        padding: 15px;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
    }

    .test-stat-value {
        font-size: 1.8rem;
        font-weight: bold;
    }

    .test-stat-label {
        color: var(--text-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 4px;
    }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 25px;
        margin-bottom: 25px;
    }

    .admin-row {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .admin-row-input {
        flex: 1;
        min-width: 0;
    }

    .admin-row-btn {
        flex-shrink: 0;
    }

    .rz-datagrid td:last-child, .rz-datagrid th:last-child {
        padding-left: 4px !important;
        padding-right: 4px !important;
    }

    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
        display: block;
        font-weight: 600;
    }

    .user-form-input {
        background-color: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
        width: 100%;
    }
</style>

<div class="profile-container">
    @if (!isLoaded)
    {
        <div class="loading-container">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color); width: 300px; margin: 0 auto;" />
        </div>
    }
    else
    {
        <div class="page-header">
            <RadzenIcon Icon="account_circle" Style="color: var(--accent-cyan); font-size: 2.5rem;" />
            <h2 style="color: var(--accent-light-blue); margin: 0; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Личный кабинет</h2>
        </div>

        <div class="user-card">
            <div class="user-info">
                <RadzenIcon Icon="admin_panel_settings" Style="color: var(--accent-cyan); font-size: 3rem;" />
                <div>
                    <h3 class="user-name">@UserDisplayName</h3>
                    <div class="user-meta">
                        Подразделение: <span>@(user?.Group?.Name ?? "Не назначено")</span> |
                        Команда: <span>@(user?.Teams.Any() == true ? string.Join(", ", user.Teams.Select(t => t.Name)) : "Личное участие")</span>
                    </div>
                </div>
            </div>

            @if (activeScenario != null)
            {
                <div class="active-session-badge">
                    <RadzenIcon Icon="warning" style="color: var(--accent-cyan); font-size: 1.5rem;" />
                    <div>
                        <div style="color: var(--accent-cyan); font-weight: bold; font-size: 0.9rem;">Активная симуляция</div>
                        <div style="color: var(--text-light);">@activeScenario.Scenario.Title</div>
                        <div style="color: var(--text-muted); font-size: 0.8rem;">
                            Счет: <span style="color: var(--accent-cyan);">@activeScenario.Score XP</span> |
                            Прогресс: @activeScenarioQuestionsSolved / @activeScenarioTotalQuestions
                            @if (activeScenario.IsTeamAttempt)
                            {
                                <span class="team-badge" style="margin-left: 8px;">КОМАНДА</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="tabs-navigation">
            <button class="tab-trigger @(activeTabIndex == 0 ? "active" : "")" @onclick="() => activeTabIndex = 0"><RadzenIcon Icon="bar_chart" /> СТАТИСТИКА</button>
            <button class="tab-trigger @(activeTabIndex == 1 ? "active" : "")" @onclick="() => activeTabIndex = 1"><RadzenIcon Icon="leaderboard" /> РЕЙТИНГИ</button>
            @if (isAdmin)
            {
                <button class="tab-trigger @(activeTabIndex == 2 ? "active" : "")" @onclick="() => activeTabIndex = 2"><RadzenIcon Icon="admin_panel_settings" /> УПРАВЛЕНИЕ</button>
                <button class="tab-trigger @(activeTabIndex == 3 ? "active" : "")" @onclick="() => activeTabIndex = 3"><RadzenIcon Icon="person_add" /> ПОЛЬЗОВАТЕЛИ</button>
            }
        </div>

        @if (activeTabIndex == 0)
        {
            <h4 class="section-title"><RadzenIcon Icon="crisis_alert" /> Боевые сценарии</h4>
            <div class="stats-grid">
                <div class="cyber-card stat-card"><div class="stat-label">Доступно сценариев</div><div class="stat-value text-light-blue">@totalScenarios</div><div class="stat-sub">@soloScenarios одиночных / @teamScenarios командных</div></div>
                <div class="cyber-card stat-card"><div class="stat-label">Пройдено успешно</div><div class="stat-value text-green">@completedScenariosCount</div><div class="stat-sub">из @totalScenarios доступных</div></div>
                <div class="cyber-card stat-card"><div class="stat-label">Процент успеха</div><div class="stat-value text-cyan">@scenarioSuccessRate%</div><div class="stat-sub">@completedScenariosCount завершено из @totalAttemptsScenarios попыток</div></div>
                <div class="cyber-card stat-card"><div class="stat-label">Общий опыт (XP)</div><div class="stat-value text-warning">@totalScenarioScore XP</div><div class="stat-sub">заработано в сценариях</div></div>
            </div>

            <div class="cyber-card">
                <h4 class="section-title"><RadzenIcon Icon="history" /> Все попытки прохождения сценариев</h4>
                @if (!allScenarioAttempts.Any())
                {
                    <div class="text-center py-4 text-muted"><RadzenIcon Icon="cloud_off" Style="font-size: 2rem; color: var(--border-color);" /><br />Нет ни одной попытки прохождения</div>
                }
                else
                {
                    <RadzenDataGrid Data="@allScenarioAttempts" TItem="UserScenarioProgress" AllowPaging="true" PageSize="10">
                        <Columns>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="СЦЕНАРИЙ" Width="200px">
                                <Template Context="data"><span style="color: var(--text-light); font-weight: 500;">@(data.Scenario?.Title ?? "Неизвестный сценарий")</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="ТИП" Width="120px" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    @if (data.IsTeamAttempt)
                                    {
                                        <span class="team-badge">КОМАНДА</span>
                                    }
                                    else
                                    {

                                        <span style="color: var(--text-muted);">Одиночный</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="СТАТУС" Width="130px" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    @switch (data.Status)
                                    {
                                        case AttemptStatus.InProgress:
                                            <span class="status-badge-mini status-in-progress">В процессе</span>
                                            break;
                                        case AttemptStatus.Completed:

                                            <span class="status-badge-mini status-completed">Завершен</span>
                                            break;
                                        case AttemptStatus.Failed:

                                            <span class="status-badge-mini status-failed">Неудача</span>
                                            break;
                                        default:

                                            <span class="status-badge-mini" style="background: rgba(143,160,181,0.15); color: var(--text-muted); border: 1px solid var(--border-color);">@data.Status</span>
                                            break;
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="НАЧАЛО" Width="150px" TextAlign="TextAlign.Center">
                                <Template Context="data"><span style="font-size: 0.85rem;">@(data.StartedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="XP" Width="80px" TextAlign="TextAlign.Center">
                                <Template Context="data"><span style="color: var(--accent-cyan); font-weight: bold;">@data.Score XP</span></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>

            <h4 class="section-title"><RadzenIcon Icon="quiz" /> Тестовые задания</h4>
            <div class="stats-grid">
                <div class="cyber-card stat-card"><div class="stat-label">Доступно тестов</div><div class="stat-value text-light-blue">@totalTests</div><div class="stat-sub">трёх уровней сложности</div></div>
                <div class="cyber-card stat-card"><div class="stat-label">Пройдено успешно</div><div class="stat-value text-green">@completedTestsCount</div><div class="stat-sub">из @totalTests доступных</div></div>
                <div class="cyber-card stat-card"><div class="stat-label">Процент успеха</div><div class="stat-value text-cyan">@testSuccessRate%</div><div class="stat-sub">@completedTestsCount завершено из @totalAttemptsTests попыток</div></div>
