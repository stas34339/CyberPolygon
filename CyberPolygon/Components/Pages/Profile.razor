                    <div class="col-md-6 mb-3 text-end">
                        <button class="btn-primary-gradient" @onclick="CreateUser">
                            <RadzenIcon Icon="person_add" /> Создать пользователя
                        </button>
                    </div>
                </div>
            </div>

            <div class="cyber-card">
                <h4 class="section-title"><RadzenIcon Icon="people" /> Список пользователей (@usersList.Count)</h4>
                <RadzenDataGrid Data="@usersList" TItem="ApplicationUser" AllowPaging="true" PageSize="10">
                    <Columns>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="ЛОГИН" Width="200px">
                            <Template Context="u"><span style="color: var(--text-light);">@u.UserName</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="ФИО" Width="220px">
                            <Template Context="u"><span style="color: var(--text-light);">@u.LastName @u.FirstName @u.MiddleName</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="РОЛЬ" Width="120px" TextAlign="TextAlign.Center">
                            <Template Context="u">
                                @if (adminUserIds.Contains(u.Id))
                                {
                                    <span class="status-badge-mini status-completed">Админ</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted);">Пользователь</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="ПОДРАЗДЕЛЕНИЕ" Width="150px">
                            <Template Context="u"><span style="color: var(--text-muted);">@(u.Group?.Name ?? "—")</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="" Width="120px" TextAlign="TextAlign.Center">
                            <Template Context="u">
                                <button class="btn-detail" style="margin-right: 6px;" @onclick="@(() => ToggleAdminRole(u.Id))">
                                    <RadzenIcon Icon="swap_horiz" style="font-size: 0.9rem;" /> Роль
                                </button>
                                <button class="btn-icon-danger" @onclick="@(() => DeleteUser(u.Id))">
                                    <RadzenIcon Icon="delete" style="font-size: 0.9rem;" />
                                </button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    }
</div>

@if (showTeamModal && selectedUserForTeams != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); backdrop-filter: blur(6px); display: flex; justify-content: center; align-items: center; z-index: 9999;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; width: 500px; padding: 25px; box-shadow: 0 0 40px rgba(91, 163, 227, 0.2);">
            <h4 style="color: var(--accent-light-blue); margin: 0 0 10px 0;">Команды: @selectedUserForTeams.UserName</h4>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 20px;">Назначьте агента в команды его подразделения.</p>
            @{
                var availableTeams = selectedUserForTeams.GroupId != null ? teamsList.Where(t => t.GroupId == selectedUserForTeams.GroupId).ToList() : teamsList;
            }
            <div style="max-height: 250px; overflow-y: auto; background: var(--bg-main); border: 1px solid var(--border-color); padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                @if (!availableTeams.Any())
                {
                    <div class="text-danger">В подразделении нет команд.</div>
                }
                @foreach (var team in availableTeams)
                {
                    var isChecked = selectedUserForTeams.Teams != null && selectedUserForTeams.Teams.Any(t => t.Id == team.Id);
                    <div style="display: flex; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--border-color);"><RadzenCheckBox TValue="bool" Value="@isChecked" Change="@(async (val) => await ToggleTeamAssignment(selectedUserForTeams.Id, team.Id, val))" /><span style="color: var(--text-light);">@team.Name</span></div>
                }
            </div>
            <div class="text-right"><button class="btn-primary-gradient" @onclick="CloseTeamAssignmentModal">Закрыть</button></div>
        </div>
    </div>
}

@code {
    [Inject] private IDbContextFactory<ApplicationDbContext> ContextFactory { get; set; }
    private int activeTabIndex = 0; private bool isLoaded = false; private bool isAdmin = false;
    private string UserDisplayName = "Загрузка..."; private ApplicationUser? user;
    private UserScenarioProgress? activeScenario = null; private int activeScenarioQuestionsSolved = 0; private int activeScenarioTotalQuestions = 0;
    private int totalScenarios = 0; private int soloScenarios = 0; private int teamScenarios = 0;
    private int completedScenariosCount = 0; private int totalAttemptsScenarios = 0; private int totalScenarioScore = 0; private string scenarioSuccessRate = "0";
    private List<UserScenarioProgress> allScenarioAttempts = new();
    private int totalTests = 0; private int completedTestsCount = 0; private int totalAttemptsTests = 0;
    private string testSuccessRate = "0"; private string correctAnswersPercent = "0"; private int totalCorrectAnswers = 0; private int totalQuestionsAnswered = 0;
    private List<TestAttemptDto> allTestAttempts = new();

    // Поля для управления пользователями
    private UserCreationModel newUserModel = new();
    private HashSet<string> adminUserIds = new();

    public class TestAttemptDto { public string TestTitle { get; set; } = ""; public string Difficulty { get; set; } = ""; public string DifficultyText { get; set; } = ""; public AttemptStatus Status { get; set; } public DateTime? StartedAt { get; set; } public DateTime? CompletedAt { get; set; } public TimeSpan? TimeSpent { get; set; } public int CorrectAnswers { get; set; } public int TotalQuestions { get; set; } }
    public class TeamMemberDto { public string Id { get; set; } = ""; public string Name { get; set; } = ""; public int TotalScore { get; set; } }
    public class UserCreationModel { public string Login { get; set; } = string.Empty; public string Password { get; set; } = string.Empty; public string FirstName { get; set; } = string.Empty; public string LastName { get; set; } = string.Empty; public string MiddleName { get; set; } = string.Empty; public bool IsAdmin { get; set; } }

    private List<TeamMemberDto> myTeamMembers = new();
    private List<string> leaderboardCategories = new() { "Сценарии", "Тесты" }; private string selectedCategory = "Сценарии";
    private List<string> leaderboardFilters = new() { "Все подразделения", "Мое подразделение" }; private string selectedFilter = "Все подразделения";
    public class UserLeaderboardDto { public int Rank { get; set; } public string Name { get; set; } = ""; public string GroupName { get; set; } = ""; public int Score { get; set; } public int CompletedCount { get; set; } public int Percentile { get; set; } public bool IsCurrentUser { get; set; } }
    public class TeamLeaderboardDto { public int Rank { get; set; } public string Name { get; set; } = ""; public string GroupName { get; set; } = ""; public int Score { get; set; } public int CompletedCount { get; set; } public int Percentile { get; set; } public bool IsUserTeam { get; set; } }
    public class TestUserLeaderboardDto { public int Rank { get; set; } public string Name { get; set; } = ""; public string GroupName { get; set; } = ""; public int AverageScore { get; set; } public int CompletedCount { get; set; } public bool IsCurrentUser { get; set; } }
    public class TestLeaderboardStats { public int TotalTests { get; set; } public int TotalCompleted { get; set; } public int UniqueUsers { get; set; } public int OverallAverage { get; set; } }
    private List<UserLeaderboardDto> topUsers = new(); private List<TeamLeaderboardDto> topTeams = new();
    private List<TestUserLeaderboardDto> topTestUsers = new(); private TestLeaderboardStats testLeaderboardStats = new();
    private List<UserGroup> groupsList = new(); private List<UserTeam> teamsList = new(); private List<ApplicationUser> usersList = new();
    private List<UserScenarioProgress> allScenarioProgressList = new(); private List<UserTestProgress> allTestProgressList = new();
    private bool showTeamModal = false; private ApplicationUser? selectedUserForTeams;
    private string newGroupName = ""; private string newTeamName = ""; private int selectedGroupIdForTeam;

    protected override async Task OnInitializedAsync() { var s = await AuthProvider.GetAuthenticationStateAsync(); isAdmin = s.User.IsInRole("Admin"); await LoadBaseData(); await UpdateLeaderboards(); isLoaded = true; }

    private async Task LoadBaseData()
    {
        var s = await AuthProvider.GetAuthenticationStateAsync(); var uid = s.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        UserDisplayName = s.User.Identity?.Name ?? "Оперативник";
        using var c = await ContextFactory.CreateDbContextAsync();
        if (!string.IsNullOrEmpty(uid))
        {
            user = await c.Set<ApplicationUser>().Include(u => u.Group).Include(u => u.Teams).FirstOrDefaultAsync(u => u.Id == uid);
            activeScenario = await c.UserProgresses.Include(p => p.Scenario).ThenInclude(s => s.Questions).FirstOrDefaultAsync(p => p.UserId == uid && p.Status == AttemptStatus.InProgress);
            if (activeScenario != null) { activeScenarioTotalQuestions = activeScenario.Scenario.Questions.Count; activeScenarioQuestionsSolved = await c.Set<UserAnswerProgress>().CountAsync(a => a.UserScenarioProgressId == activeScenario.Id); }
            var av = await c.Scenarios.Where(s => s.IsVisible || isAdmin).ToListAsync(); totalScenarios = av.Count; soloScenarios = av.Count(s => s.Scope == VisibilityScope.Public || s.Scope == VisibilityScope.GroupOnly); teamScenarios = av.Count(s => s.Scope == VisibilityScope.TeamOnly);
            allScenarioAttempts = await c.UserProgresses.Include(p => p.Scenario).Where(p => p.UserId == uid).OrderByDescending(p => p.StartedAt).ToListAsync();
            completedScenariosCount = allScenarioAttempts.Count(p => p.Status == AttemptStatus.Completed); totalScenarioScore = allScenarioAttempts.Where(p => p.Status == AttemptStatus.Completed).Sum(s => s.Score); totalAttemptsScenarios = allScenarioAttempts.Count;
            scenarioSuccessRate = totalAttemptsScenarios > 0 ? ((int)Math.Round((double)completedScenariosCount / totalAttemptsScenarios * 100)).ToString() : "0";
            var at = await c.Set<CyberTest>().Where(t => t.IsVisible || isAdmin).ToListAsync(); totalTests = at.Count;
            var tps = await c.Set<UserTestProgress>().Include(tp => tp.Test).ThenInclude(t => t.Questions).Where(tp => tp.UserId == uid).OrderByDescending(tp => tp.CompletedAt).ToListAsync();
            totalAttemptsTests = tps.Count; completedTestsCount = tps.Count(tp => tp.Status == AttemptStatus.Completed);
            testSuccessRate = totalAttemptsTests > 0 ? ((int)Math.Round((double)completedTestsCount / totalAttemptsTests * 100)).ToString() : "0";
            totalCorrectAnswers = tps.Where(tp => tp.Status == AttemptStatus.Completed).Sum(tp => tp.Score); totalQuestionsAnswered = tps.Where(tp => tp.Status == AttemptStatus.Completed).Sum(tp => tp.Test?.Questions?.Count ?? 0);
            correctAnswersPercent = totalQuestionsAnswered > 0 ? ((int)Math.Round((double)totalCorrectAnswers / totalQuestionsAnswered * 100)).ToString() : "0";
            allTestAttempts = tps.Select(tp => new TestAttemptDto { TestTitle = tp.Test?.Title ?? "Тест", Difficulty = tp.Test?.Difficulty.ToString() ?? "", DifficultyText = tp.Test?.Difficulty switch { TestDifficulty.Easy => "Лёгкий", TestDifficulty.Medium => "Средний", TestDifficulty.Hard => "Сложный", _ => tp.Test?.Difficulty.ToString() ?? "" }, Status = tp.Status, StartedAt = tp.StartedAt, CompletedAt = tp.CompletedAt, TimeSpent = (tp.StartedAt.HasValue && tp.CompletedAt.HasValue) ? tp.CompletedAt.Value - tp.StartedAt.Value : null, CorrectAnswers = tp.Score, TotalQuestions = tp.Test?.Questions?.Count ?? 0 }).ToList();
            if (user?.Teams.Any() == true) { var tid = user.Teams.First().Id; var tu = await c.Set<UserTeam>().Where(t => t.Id == tid).SelectMany(t => t.Users).ToListAsync(); myTeamMembers.Clear(); foreach (var u in tu) { var sc = await c.UserProgresses.Where(p => p.UserId == u.Id && p.Status == AttemptStatus.Completed).SumAsync(p => p.Score); myTeamMembers.Add(new TeamMemberDto { Id = u.Id, Name = u.UserName ?? "Агент", TotalScore = sc }); } myTeamMembers = myTeamMembers.OrderByDescending(m => m.TotalScore).ToList(); }
        }
        if (isAdmin)
        {
            groupsList = await c.UserGroups.ToListAsync();
            teamsList = await c.UserTeams.Include(t => t.Group).ToListAsync();
            usersList = await c.Set<ApplicationUser>().Include(u => u.Group).Include(u => u.Teams).ToListAsync();
            allScenarioProgressList = await c.UserProgresses.Include(p => p.Scenario).OrderByDescending(p => p.StartedAt).ToListAsync();
            allTestProgressList = await c.Set<UserTestProgress>().Include(tp => tp.Test).OrderByDescending(tp => tp.StartedAt).ToListAsync();

            // Загружаем ID админов
            adminUserIds.Clear();
            foreach (var u in usersList)
            {
                if (await UserManagementService.IsUserAdminAsync(u.Id))
                    adminUserIds.Add(u.Id);
            }
        }
        else { teamsList = await c.UserTeams.ToListAsync(); }
    }

    private string GetDifficultyColor(string d) => d switch { "Easy" => "var(--success-color)", "Medium" => "var(--warning-color)", "Hard" => "var(--danger-color)", _ => "var(--text-muted)" };

    private async Task UpdateLeaderboards()
    {
        using var c = await ContextFactory.CreateDbContextAsync(); int? gid = user?.GroupId; bool f = selectedFilter == "Мое подразделение" && gid.HasValue; var cuid = user?.Id;
        if (selectedCategory == "Сценарии")
        {
            var uq = c.Set<ApplicationUser>().Include(u => u.Group).AsQueryable(); if (f) uq = uq.Where(u => u.GroupId == gid.Value); var au = await uq.ToListAsync(); topUsers.Clear(); int ms = 0;
            foreach (var u in au) { var pl = await c.UserProgresses.Where(p => p.UserId == u.Id && p.Status == AttemptStatus.Completed && !p.IsTeamAttempt).ToListAsync(); var sc = pl.Sum(p => p.Score); if (sc > ms) ms = sc; if (sc > 0) topUsers.Add(new UserLeaderboardDto { Name = u.UserName ?? "Агент", GroupName = u.Group?.Name ?? "", Score = sc, CompletedCount = pl.Count, IsCurrentUser = u.Id == cuid }); }
            topUsers = topUsers.OrderByDescending(u => u.Score).Take(15).ToList(); for (int i = 0; i < topUsers.Count; i++) { topUsers[i].Rank = i + 1; topUsers[i].Percentile = ms > 0 ? (int)Math.Round((double)topUsers[i].Score / ms * 100) : 0; }
            var tq = c.UserTeams.Include(t => t.Group).AsQueryable(); if (f) tq = tq.Where(t => t.GroupId == gid.Value); var at = await tq.ToListAsync(); topTeams.Clear(); ms = 0;
            var uti = user?.Teams?.Select(t => t.Id).ToList() ?? new List<int>();
            foreach (var t in at) { var pl = await c.UserProgresses.Where(p => p.TeamId == t.Id && p.Status == AttemptStatus.Completed && p.IsTeamAttempt).ToListAsync(); var sc = pl.Sum(p => p.Score); if (sc > ms) ms = sc; if (sc > 0) topTeams.Add(new TeamLeaderboardDto { Name = t.Name, GroupName = t.Group?.Name ?? "", Score = sc, CompletedCount = pl.Count, IsUserTeam = uti.Contains(t.Id) }); }
            topTeams = topTeams.OrderByDescending(t => t.Score).Take(15).ToList(); for (int i = 0; i < topTeams.Count; i++) { topTeams[i].Rank = i + 1; topTeams[i].Percentile = ms > 0 ? (int)Math.Round((double)topTeams[i].Score / ms * 100) : 0; }
        }
        else
        {
            var uq = c.Set<ApplicationUser>().Include(u => u.Group).AsQueryable(); if (f) uq = uq.Where(u => u.GroupId == gid.Value); var au = await uq.ToListAsync(); topTestUsers.Clear();
            foreach (var u in au) { var tps = await c.Set<UserTestProgress>().Include(tp => tp.Test).ThenInclude(t => t.Questions).Where(tp => tp.UserId == u.Id && tp.Status == AttemptStatus.Completed).ToListAsync(); if (tps.Any()) { double tpct = 0; foreach (var tp in tps) { int tq = tp.Test?.Questions?.Count ?? 0; if (tq > 0) tpct += (double)tp.Score / tq * 100; } topTestUsers.Add(new TestUserLeaderboardDto { Name = u.UserName ?? "Агент", GroupName = u.Group?.Name ?? "", AverageScore = (int)Math.Round(tpct / tps.Count), CompletedCount = tps.Count, IsCurrentUser = u.Id == cuid }); } }
            topTestUsers = topTestUsers.OrderByDescending(u => u.AverageScore).ThenByDescending(u => u.CompletedCount).Take(15).ToList(); for (int i = 0; i < topTestUsers.Count; i++) topTestUsers[i].Rank = i + 1;
            var allt = await c.Set<CyberTest>().Where(t => t.IsVisible || isAdmin).ToListAsync(); var act = await c.Set<UserTestProgress>().Include(tp => tp.Test).ThenInclude(t => t.Questions).Where(tp => tp.Status == AttemptStatus.Completed).ToListAsync();
            testLeaderboardStats = new TestLeaderboardStats { TotalTests = allt.Count, TotalCompleted = act.Count, UniqueUsers = act.Select(tp => tp.UserId).Distinct().Count(), OverallAverage = act.Any() ? (int)Math.Round(act.Average(tp => { int tq = tp.Test?.Questions?.Count ?? 0; return tq > 0 ? (double)tp.Score / tq * 100 : 0; })) : 0 };
        }
    }

    private void OpenTeamAssignmentModal(ApplicationUser u) { selectedUserForTeams = u; showTeamModal = true; }
    private void CloseTeamAssignmentModal() { showTeamModal = false; selectedUserForTeams = null; }
    private async Task ToggleTeamAssignment(string uid, int tid, bool assign) { using var c = await ContextFactory.CreateDbContextAsync(); var u = await c.Set<ApplicationUser>().Include(u => u.Teams).FirstOrDefaultAsync(u => u.Id == uid); var t = await c.UserTeams.FindAsync(tid); if (u != null && t != null) { if (assign && !u.Teams.Any(x => x.Id == tid)) u.Teams.Add(t); else if (!assign) { var tr = u.Teams.FirstOrDefault(x => x.Id == tid); if (tr != null) u.Teams.Remove(tr); } await c.SaveChangesAsync(); await LoadBaseData(); if (selectedUserForTeams?.Id == uid) selectedUserForTeams = usersList.FirstOrDefault(x => x.Id == uid); } }
    private async Task CreateGroup() { if (string.IsNullOrWhiteSpace(newGroupName)) return; using var c = await ContextFactory.CreateDbContextAsync(); c.UserGroups.Add(new UserGroup { Name = newGroupName }); await c.SaveChangesAsync(); newGroupName = ""; await LoadBaseData(); }
    private async Task CreateTeam() { if (string.IsNullOrWhiteSpace(newTeamName) || selectedGroupIdForTeam <= 0) return; using var c = await ContextFactory.CreateDbContextAsync(); c.UserTeams.Add(new UserTeam { Name = newTeamName, GroupId = selectedGroupIdForTeam }); await c.SaveChangesAsync(); newTeamName = ""; await LoadBaseData(); }
    private async Task UpdateUserGroup(string uid, int? gid) { using var c = await ContextFactory.CreateDbContextAsync(); var u = await c.Set<ApplicationUser>().FindAsync(uid); if (u != null) { u.GroupId = gid; await c.SaveChangesAsync(); } await LoadBaseData(); }
    private async Task DeleteGroup(int id) { var ok = await DialogService.Confirm("Удалить подразделение?", "Удаление", new ConfirmOptions { OkButtonText = "Удалить", CancelButtonText = "Отмена" }); if (ok == true) { using var c = await ContextFactory.CreateDbContextAsync(); var g = await c.UserGroups.FindAsync(id); if (g != null) { c.UserGroups.Remove(g); await c.SaveChangesAsync(); await LoadBaseData(); } } }
    private async Task DeleteTeam(int id) { var ok = await DialogService.Confirm("Удалить команду?", "Удаление", new ConfirmOptions { OkButtonText = "Удалить", CancelButtonText = "Отмена" }); if (ok == true) { using var c = await ContextFactory.CreateDbContextAsync(); var t = await c.UserTeams.FindAsync(id); if (t != null) { c.UserTeams.Remove(t); await c.SaveChangesAsync(); await LoadBaseData(); } } }
    private async Task ResetScenarioProgress(int id) { var ok = await DialogService.Confirm("Сбросить сессию?", "Сброс", new ConfirmOptions { OkButtonText = "Сбросить", CancelButtonText = "Отмена" }); if (ok == true) { using var c = await ContextFactory.CreateDbContextAsync(); var p = await c.UserProgresses.FindAsync(id); if (p != null) { c.UserProgresses.Remove(p); await c.SaveChangesAsync(); await LoadBaseData(); await UpdateLeaderboards(); } } }
    private async Task ResetTestProgress(int id) { var ok = await DialogService.Confirm("Сбросить сессию?", "Сброс", new ConfirmOptions { OkButtonText = "Сбросить", CancelButtonText = "Отмена" }); if (ok == true) { using var c = await ContextFactory.CreateDbContextAsync(); var p = await c.Set<UserTestProgress>().FindAsync(id); if (p != null) { c.Set<UserTestProgress>().Remove(p); await c.SaveChangesAsync(); await LoadBaseData(); await UpdateLeaderboards(); } } }

    // Методы для управления пользователями
    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(newUserModel.Login) || string.IsNullOrWhiteSpace(newUserModel.Password))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Ошибка", "Логин и пароль обязательны");
            return;
        }

        if (newUserModel.Password.Length < 6)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Ошибка", "Пароль должен содержать минимум 6 символов");
            return;
        }

        var (success, error) = await UserManagementService.CreateUserAsync(
            newUserModel.Login, newUserModel.Password,
            newUserModel.FirstName, newUserModel.LastName, newUserModel.MiddleName,
            newUserModel.IsAdmin
        );

        if (success)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Успех", $"Пользователь {newUserModel.Login} создан");
            newUserModel = new UserCreationModel();
            await LoadBaseData();
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, "Ошибка", error);
        }
    }

    private async Task DeleteUser(string userId)
    {
        if (userId == user?.Id)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Ошибка", "Нельзя удалить самого себя");
            return;
        }

        var ok = await DialogService.Confirm("Удалить пользователя навсегда? Это действие необратимо.", "Удаление пользователя", new ConfirmOptions { OkButtonText = "Удалить", CancelButtonText = "Отмена" });
        if (ok == true)
        {
            var result = await UserManagementService.DeleteUserAsync(userId);
            if (result)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Успех", "Пользователь удален");
                await LoadBaseData();
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Ошибка", "Не удалось удалить пользователя");
            }
        }
    }

    private async Task ToggleAdminRole(string userId)
    {
        if (userId == user?.Id)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Ошибка", "Нельзя изменить свою роль");
            return;
        }

        await UserManagementService.ToggleAdminRoleAsync(userId);
        await LoadBaseData();
        NotificationService.Notify(NotificationSeverity.Success, "Успех", "Роль пользователя изменена");
    }

    public void Dispose() { }
}