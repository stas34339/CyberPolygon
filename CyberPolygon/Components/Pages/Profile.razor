@page "/profile"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@rendermode InteractiveServer

<PageTitle>Личный кабинет | Киберполигон</PageTitle>

<style>
    /* ГЛОБАЛЬНЫЕ ЦВЕТА И СТИЛИ */
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-card-hover: #1e2d3d;
        --bg-input: #131924;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .cyber-card {
        background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-card-hover) 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    /* Уменьшенные отступы для компактных блоков */
    .cyber-card-compact {
        padding: 15px 20px;
    }

    /* ИНТЕРАКТИВНОСТЬ: Эффект парения для всех карточек статистики */
    .stat-card:hover {
        transform: translateY(-5px);
        border-color: var(--accent-cyan);
        box-shadow: 0 8px 25px rgba(78, 195, 209, 0.15);
    }

    .profile-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-light);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

    .user-card {
        border-left: 4px solid var(--accent-cyan);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        padding: 20px 25px;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 15px;
        flex: 1;
        min-width: 280px;
    }

    .user-name {
        color: var(--accent-light-blue);
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0 0 4px 0;
    }

    .user-meta {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

        .user-meta span {
            color: var(--text-light);
            font-weight: 500;
        }

    /* СИСТЕМА УРОВНЕЙ И ЗВАНИЙ */
    .user-level-block {
        width: 100%;
        margin-top: 12px;
    }

    .level-meta-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 6px;
    }

    .rank-badge-text {
        color: var(--warning-color);
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .xp-bar-container {
        height: 8px;
        background: var(--bg-input);
        border-radius: 4px;
        border: 1px solid var(--border-color);
        overflow: hidden;
    }

    .xp-bar-value {
        height: 100%;
        background: linear-gradient(90deg, var(--warning-color), var(--accent-cyan));
        border-radius: 4px;
        transition: width 1s ease-in-out;
        box-shadow: 0 0 8px rgba(78, 195, 209, 0.3);
    }

    /* КОМПОНОВКА РЯДА */
    .dashboard-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
        gap: 20px;
        margin-bottom: 0px;
    }

        .dashboard-row .cyber-card {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

    /* ИНТЕРАКТИВНАЯ ТЕПЛОВАЯ КАРТА (КОМПАКТНЫЙ РАЗМЕР) */
    .heatmap-wrapper {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .heatmap-inner {
        max-width: 320px;
        width: 100%;
        margin: 0 auto;
    }

    .heatmap-days-header {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 5px;
        width: 100%;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.7rem;
        font-weight: bold;
        margin-bottom: 4px;
    }

    .heatmap-grid-square {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 5px;
        width: 100%;
        margin: 0;
        padding: 10px;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .heatmap-square-cell {
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 4px;
        background-color: var(--bg-input);
        border: 1px solid rgba(255,255,255,0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.2);
        position: relative;
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s;
    }

        .heatmap-square-cell:hover {
            transform: scale(1.15) translateY(-2px);
            z-index: 2;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }

        .heatmap-square-cell[data-level="1"] {
            background-color: #1b4b3e;
            color: rgba(255,255,255,0.5);
        }

        .heatmap-square-cell[data-level="2"] {
            background-color: #216e4e;
            color: rgba(255,255,255,0.8);
        }

        .heatmap-square-cell[data-level="3"] {
            background-color: #30a14e;
            color: #fff;
            border-color: rgba(78, 195, 209, 0.4);
        }

        .heatmap-square-cell[data-level="4"] {
            background-color: #4ec3d1;
            color: #1a1d21;
            font-weight: bold;
            box-shadow: 0 0 10px rgba(78,195,209,0.6);
            border-color: var(--accent-cyan);
        }

        .heatmap-square-cell::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%) translateY(-8px);
            background: var(--bg-card-hover);
            color: var(--text-light);
            padding: 5px 8px;
            border-radius: 5px;
            font-size: 0.7rem;
            white-space: nowrap;
            border: 1px solid var(--accent-cyan);
            box-shadow: 0 4px 10px rgba(0,0,0,0.6);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
            z-index: 10;
        }

        .heatmap-square-cell:hover::after {
            opacity: 1;
        }

    /* ИНТЕРАКТИВНЫЙ ТЕРМИНАЛЬНЫЙ ЛОГ (КОМПАКТНЫЙ) */
    .terminal-feed {
        background-color: #0b0f17;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 10px 12px;
        font-family: 'Consolas', 'Courier New', Courier, monospace;
        font-size: 0.8rem;
        flex-grow: 1;
        height: 165px;
        overflow-y: auto;
        box-shadow: inset 0 0 15px rgba(0,0,0,0.9);
    }

    .terminal-line {
        margin-bottom: 4px;
        line-height: 1.4;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding: 2px 6px;
        border-radius: 4px;
        border-left: 2px solid transparent;
        transition: all 0.2s ease;
        cursor: default;
    }

        .terminal-line:hover {
            background: rgba(78, 195, 209, 0.08);
            border-left-color: var(--accent-cyan);
            padding-left: 10px;
        }

    .terminal-time {
        color: var(--text-muted);
        margin-right: 6px;
    }

    .terminal-tag {
        font-weight: bold;
        margin-right: 6px;
        padding: 2px 4px;
        border-radius: 3px;
        font-size: 0.7rem;
    }

    .tag-success {
        background: rgba(152, 195, 121, 0.15);
        color: var(--success-color);
    }

    .tag-failed {
        background: rgba(224, 108, 117, 0.15);
        color: var(--danger-color);
    }

    .tag-progress {
        background: rgba(78, 195, 209, 0.15);
        color: var(--accent-cyan);
    }

    /* МИНИ КАРТОЧКИ */
    .stats-grid-mini {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 15px;
    }

    .stat-card {
        text-align: center;
        padding: 15px !important;
        margin-bottom: 0 !important;
        cursor: default;
    }

    .stat-label {
        color: var(--accent-cyan);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
        font-weight: 600;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: bold;
        line-height: 1.2;
    }

    .stat-sub {
        font-size: 0.7rem;
        color: var(--text-muted);
        margin-top: 2px;
    }

    /* КОМАНДНЫЙ РАСТЕР */
    .team-roster-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 10px;
        margin-top: 15px;
    }

    .roster-card {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s ease;
    }

        .roster-card:hover {
            background: rgba(78, 195, 209, 0.05);
            border-color: rgba(78, 195, 209, 0.3);
            transform: translateY(-2px);
        }

        .roster-card.is-me {
            background: rgba(78, 195, 209, 0.08);
            border-color: var(--accent-cyan);
        }

    .roster-avatar {
        width: 36px;
        height: 36px;
        border-radius: 6px;
        background: #131924;
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: var(--text-muted);
        flex-shrink: 0;
    }

    .roster-card.is-me .roster-avatar {
        color: var(--accent-cyan);
        border-color: var(--accent-cyan);
        background: rgba(78, 195, 209, 0.1);
    }

    .roster-info {
        flex-grow: 1;
        min-width: 0;
    }

    .roster-name {
        font-weight: 600;
        color: var(--text-light);
        font-size: 0.85rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 2px;
    }

    .roster-card.is-me .roster-name {
        color: var(--accent-cyan);
    }

    .roster-xp-bar {
        height: 4px;
        background: var(--bg-input);
        border-radius: 2px;
        overflow: hidden;
        margin-top: 4px;
    }

    .roster-xp-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--warning-color), var(--accent-cyan));
        border-radius: 2px;
    }

    .roster-xp-text {
        font-size: 0.75rem;
        color: var(--warning-color);
        font-weight: bold;
        font-family: monospace;
    }

    /* ОСТАЛЬНЫЕ КОМПОНЕНТЫ */
    .active-session-badge {
        background: rgba(78, 195, 209, 0.05);
        border: 1px dashed var(--accent-cyan);
        border-radius: 8px;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 300px;
        flex: 1;
        transition: all 0.3s;
        cursor: pointer;
    }

        .active-session-badge:hover {
            background: rgba(78, 195, 209, 0.1);
            box-shadow: 0 0 15px rgba(78, 195, 209, 0.3);
        }

    .tabs-navigation {
        display: flex;
        border-bottom: 2px solid var(--border-color);
        margin-bottom: 20px;
        gap: 5px;
        flex-wrap: wrap;
    }

    .tab-trigger {
        background: transparent;
        border: none;
        padding: 10px 20px;
        color: var(--text-muted);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .tab-trigger:hover {
            color: var(--text-light);
        }

        .tab-trigger.active {
            color: var(--accent-cyan);
            border-bottom: 2px solid var(--accent-cyan);
        }

    .text-cyan {
        color: var(--accent-cyan) !important;
    }

    .text-light-blue {
        color: var(--accent-light-blue) !important;
    }

    .text-green {
        color: var(--success-color) !important;
    }

    .text-warning {
        color: var(--warning-color) !important;
    }

    .section-title {
        color: var(--accent-cyan);
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    ::deep .rz-datagrid {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 8px !important;
    }

    ::deep .rz-grid-table thead th {
        background-color: #1a1d21 !important;
        color: var(--accent-cyan) !important;
        border-bottom: 1px solid var(--border-color) !important;
        border-right: 1px solid var(--border-color) !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        padding: 8px 6px !important;
    }

    ::deep .rz-grid-table tbody tr {
        background-color: transparent !important;
        color: var(--text-muted) !important;
        transition: background-color 0.2s;
    }

        ::deep .rz-grid-table tbody tr:hover {
            background-color: rgba(78, 195, 209, 0.08) !important;
        }

    ::deep .rz-grid-table td {
        border-bottom: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-right: 1px solid var(--border-color) !important;
        padding: 8px 6px !important;
        font-size: 0.8rem;
    }

    ::deep .rz-pager {
        background-color: #1a1d21 !important;
        border-top: 1px solid var(--border-color) !important;
        color: var(--text-muted) !important;
        padding: 5px !important;
    }

    .team-badge {
        background: rgba(91, 163, 227, 0.15);
        color: var(--accent-blue);
        border: 1px solid rgba(91, 163, 227, 0.3);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .status-badge-mini {
        font-size: 0.7rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 2px 6px;
        border-radius: 3px;
        display: inline-block;
        white-space: nowrap;
    }

    .status-in-progress {
        background: rgba(78, 195, 209, 0.15);
        color: var(--accent-cyan);
        border: 1px solid rgba(78, 195, 209, 0.4);
    }

    .status-completed {
        background: rgba(152, 195, 121, 0.15);
        color: var(--success-color);
        border: 1px solid rgba(152, 195, 121, 0.4);
    }

    .status-failed {
        background: rgba(224, 108, 117, 0.15);
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.4);
    }

    .loading-container {
        text-align: center;
        padding: 80px 20px;
    }

    /* ==========================================================
           НОВЫЕ СТИЛИ ДЛЯ ИНТЕРАКТИВНОЙ ВКЛАДКИ "РЕЙТИНГИ"
           ========================================================== */
    .cyber-filter-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        padding: 20px;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        margin-bottom: 25px;
    }

    .dark-input {
        background-color: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
        transition: all 0.3s;
    }

        .dark-input:focus {
            border-color: var(--accent-cyan) !important;
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.2) !important;
        }

    .leaderboard-container-layout {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
        gap: 25px;
    }

    .platform-radar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding: 10px 15px;
        background: rgba(78, 195, 209, 0.02);
        border: 1px solid rgba(78, 195, 209, 0.1);
        border-radius: 6px;
    }

    .leaderboard-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .leaderboard-row {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 14px 18px;
        border: 1px solid var(--border-color);
        background: rgba(20, 27, 38, 0.4);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 8px;
        position: relative;
    }

        .leaderboard-row:hover {
            background: rgba(78, 195, 209, 0.04);
            transform: scale(1.01) translateX(4px);
            border-color: rgba(78, 195, 209, 0.4);
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);
        }

        /* Подсветка призовых мест (Топ-3) */
        .leaderboard-row[data-rank="1"] {
            border-color: rgba(229, 192, 123, 0.4);
            background: linear-gradient(90deg, rgba(229, 192, 123, 0.03) 0%, rgba(20, 27, 38, 0.4) 100%);
        }

        .leaderboard-row[data-rank="2"] {
            border-color: rgba(143, 160, 181, 0.4);
            background: linear-gradient(90deg, rgba(143, 160, 181, 0.03) 0%, rgba(20, 27, 38, 0.4) 100%);
        }

        .leaderboard-row[data-rank="3"] {
            border-color: rgba(183, 107, 60, 0.4);
            background: linear-gradient(90deg, rgba(183, 107, 60, 0.03) 0%, rgba(20, 27, 38, 0.4) 100%);
        }

        /* Выделение тебя / твоей команды */
        .leaderboard-row.current-user {
            border-left: 4px solid var(--accent-cyan) !important;
            border-color: rgba(78, 195, 209, 0.5);
            background: rgba(78, 195, 209, 0.06) !important;
            animation: currentTrackPulse 3s infinite ease-in-out;
        }

    @@keyframes currentTrackPulse {
        0%, 100% {
            box-shadow: inset 0 0 10px rgba(78, 195, 209, 0.05);
        }

        50% {
            box-shadow: inset 0 0 20px rgba(78, 195, 209, 0.15);
            border-color: var(--accent-cyan);
        }
    }

    .rank-col {
        width: 45px;
        text-align: center;
        flex-shrink: 0;
    }

    .rank-medal {
        font-size: 1.6rem;
        filter: drop-shadow(0 0 6px rgba(225,225,225,0.2));
    }

    .rank-number {
        color: var(--text-muted);
        font-weight: 900;
        font-size: 1.2rem;
        font-family: monospace;
    }

    .user-col {
        flex: 1;
        min-width: 0;
    }

    .user-name-text {
        color: var(--text-light);
        font-weight: 700;
        display: block;
        font-size: 1rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .current-user .user-name-text {
        color: var(--accent-cyan);
        text-shadow: 0 0 10px rgba(78, 195, 209, 0.2);
    }

    .user-group-text {
        color: var(--text-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        font-family: monospace;
        letter-spacing: 0.5px;
    }

    .score-col {
        text-align: center;
        flex-shrink: 0;
        width: 90px;
        border-left: 1px dashed var(--border-color);
        border-right: 1px dashed var(--border-color);
        padding: 0 10px;
    }

    .score-value {
        color: var(--accent-cyan);
        font-weight: bold;
        font-size: 1.3rem;
        display: block;
        font-family: monospace;
    }

    .score-label {
        color: var(--text-muted);
        font-size: 0.7rem;
        text-transform: uppercase;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .progress-col {
        width: 140px;
        flex-shrink: 0;
        padding-left: 10px;
    }

    .mini-progress {
        height: 6px;
        background: rgba(0,0,0,0.5);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 6px;
        border: 1px solid rgba(255,255,255,0.03);
    }

    .mini-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
        border-radius: 3px;
        transition: width 0.5s ease;
    }

        .mini-progress-fill.test-fill {
            background: linear-gradient(90deg, var(--success-color), var(--accent-cyan));
        }

    .completed-count {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 700;
        display: block;
        text-align: right;
    }
</style>

<div class="profile-container">
    @if (!isLoaded)
    {
        <div class="loading-container">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="background-color: var(--border-color); width: 300px; margin: 0 auto;" />
        </div>
    }
    else
    {
        <div class="page-header">
            <RadzenIcon Icon="account_circle" Style="color: var(--accent-cyan); font-size: 2.5rem;" />
            <h2 style="color: var(--accent-light-blue); margin: 0; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Личный кабинет</h2>
        </div>

        <div class="cyber-card user-card">
            <div class="user-info">
                <RadzenIcon Icon="admin_panel_settings" Style="color: var(--accent-cyan); font-size: 3.5rem;" />
                <div style="flex: 1;">
                    <h3 class="user-name">@UserDisplayFullName</h3>
                    <div class="user-meta">
                        Подразделение: <span>@(user?.Group?.Name ?? "Не назначено")</span> | Команда: <span>@(user?.Teams.Any() == true ? string.Join(", ", user.Teams.Select(t => t.Name)) : "Личное участие")</span>
                    </div>

                    @{
                        string rankName = GetRankName(totalScenarioScore);
                        int prevXp = GetPrevRankXp(totalScenarioScore);
                        int nextXp = GetNextRankXp(totalScenarioScore);
                        int currentProgressScore = totalScenarioScore - prevXp;
                        int neededProgressScore = nextXp - prevXp;
                        int barPct = neededProgressScore > 0 ? (int)Math.Round((double)currentProgressScore / neededProgressScore * 100) : 100;
                    }
                    <div class="user-level-block">
                        <div class="level-meta-row">
                            <span class="rank-badge-text"><RadzenIcon Icon="military_tech" Style="vertical-align: text-bottom; font-size:1.1rem;" /> @rankName</span>
                            <span style="font-size: 0.8rem; font-family: monospace; color: var(--text-light);">@totalScenarioScore / @nextXp XP</span>
                        </div>
                        <div class="xp-bar-container">
                            <div class="xp-bar-value" style="width: @(barPct)%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            @if (activeScenario != null)
            {
                <div class="active-session-badge" @onclick="GoToActiveTerminal" title="Нажмите, чтобы продолжить">
                    <RadzenIcon Icon="warning" Style="color: var(--accent-cyan); font-size: 1.8rem;" />
                    <div style="flex: 1;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div style="color: var(--accent-cyan); font-weight: bold; font-size: 0.85rem; text-transform: uppercase;">Активная симуляция</div>
                            <RadzenIcon Icon="arrow_forward" Style="color: var(--accent-cyan); font-size: 1.2rem;" />
                        </div>
                        <div style="color: var(--text-light); font-weight: bold; font-size: 1rem; margin-top: 2px;">@activeScenario.Scenario.Title</div>
                        <div style="color: var(--text-muted); font-size: 0.75rem; margin-top: 3px;">
                            Счет: <span style="color: var(--accent-cyan);">@activeScenario.Score XP</span> | Прогресс: @activeScenarioQuestionsSolved / @activeScenarioTotalQuestions
                            @if (activeScenario.IsTeamAttempt)
                            {
                                <span class="team-badge" style="margin-left: 6px;">КОМАНДА</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="tabs-navigation">
            <button class="tab-trigger @(activeTabIndex == 0 ? "active" : "")" @onclick="() => activeTabIndex = 0"><RadzenIcon Icon="bar_chart" /> ДАШБОРД</button>
            <button class="tab-trigger @(activeTabIndex == 1 ? "active" : "")" @onclick="() => activeTabIndex = 1"><RadzenIcon Icon="leaderboard" /> РЕЙТИНГИ</button>
        </div>

        @if (activeTabIndex == 0)
        {
            <div class="dashboard-row mb-4">
                <div class="cyber-card cyber-card-compact">
                    <h4 class="section-title"><RadzenIcon Icon="calendar_month" /> Журнал активности (30 дней)</h4>
                    <div class="heatmap-wrapper">
                        <div class="heatmap-inner">
                            <div class="heatmap-days-header">
                                <span>ПН</span><span>ВТ</span><span>СР</span><span>ЧТ</span><span>ПТ</span><span>СБ</span><span>ВС</span>
                            </div>
                            <div class="heatmap-grid-square">
                                @{
                                    DateTime startDate = DateTime.Today.AddDays(-34);
                                    for (int i = 0; i < 35; i++)
                                    {
                                        var dateToCheck = startDate.AddDays(i);
                                        int activityLevel = GetActivityLevelForDate(dateToCheck);
                                        string tooltipText = $"{dateToCheck.ToString("dd MMM yyyy")}: {(activityLevel == 0 ? "Нет активности" : $"Операций: {activityLevel}")}";

                                        <div class="heatmap-square-cell" data-level="@activityLevel" data-tooltip="@tooltipText">
                                            @(dateToCheck.Day)
                                        </div>
                                    }
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2" style="width: 100%; font-size: 0.65rem; color: var(--text-muted); padding: 0 5px;">
                                <span>Редко</span>
                                <div class="d-flex gap-2">
                                    <div class="heatmap-square-cell" data-level="0" style="width:12px; height:12px; font-size:0; margin:0;"></div>
                                    <div class="heatmap-square-cell" data-level="1" style="width:12px; height:12px; font-size:0; margin:0;"></div>
                                    <div class="heatmap-square-cell" data-level="2" style="width:12px; height:12px; font-size:0; margin:0;"></div>
                                    <div class="heatmap-square-cell" data-level="3" style="width:12px; height:12px; font-size:0; margin:0;"></div>
                                    <div class="heatmap-square-cell" data-level="4" style="width:12px; height:12px; font-size:0; margin:0;"></div>
                                </div>
                                <span>Часто</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cyber-card cyber-card-compact">
                    <h4 class="section-title"><RadzenIcon Icon="terminal" /> Терминал событий</h4>
                    <div class="terminal-feed">
                        @if (!allScenarioAttempts.Any())
                        {
                            <div class="terminal-line"><span class="terminal-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="terminal-tag tag-failed">SYSTEM</span> Логи пусты.</div>
                        }
                        else
                        {
                            @foreach (var attempt in allScenarioAttempts.Take(15))
                            {
                                <div class="terminal-line" title="@attempt.Scenario?.Title">
                                    <span class="terminal-time">[@(attempt.StartedAt?.ToString("dd.MM HH:mm") ?? "00.00")]</span>
                                    @if (attempt.Status == AttemptStatus.Completed)
                                    {
                                        <span class="terminal-tag tag-success">SUCCESS</span> <span style="color: var(--text-light);">Пройден сценарий. +@attempt.Score XP.</span>
                                    }
                                    else if (attempt.Status == AttemptStatus.Failed)
                                    {
                                        <span class="terminal-tag tag-failed">FAILED</span> <span style="color: var(--danger-color);">Симуляция провалена (Таймаут).</span>
                                    }
                                    else
                                    {
                                        <span class="terminal-tag tag-progress">RUNNING</span> <span style="color: var(--accent-cyan);">Запущена сессия платформы.</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            @if (user?.Teams.Any() == true)
            {
                <div class="cyber-card mb-4">
                    <h4 class="section-title"><RadzenIcon Icon="groups" /> Боевой расчет: @user.Teams.First().Name</h4>
                    @if (myTeamMembers.Any())
                    {
                        int maxTeamXp = myTeamMembers.Max(m => m.TotalScore);
                        maxTeamXp = maxTeamXp > 0 ? maxTeamXp : 1;

                        <div class="team-roster-grid">
                            @for (int i = 0; i < myTeamMembers.Count; i++)
                            {
                                var member = myTeamMembers[i];
                                bool isMe = member.Id == user?.Id;
                                int rank = i + 1;
                                int barWidth = (int)Math.Round((double)member.TotalScore / maxTeamXp * 100);

                                <div class="roster-card @(isMe ? "is-me" : "")">
                                    <div class="roster-avatar"><RadzenIcon Icon="@(isMe ? "manage_accounts" : "person")" /></div>
                                    <div class="roster-info">
                                        <div class="roster-name" title="@member.Name">@member.Name @(isMe ? "(Вы)" : "")</div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="roster-xp-text">@member.TotalScore XP</span>
                                            @if (rank == 1)
                                            {
                                                <span style="font-size: 0.6rem; color: var(--warning-color); text-transform: uppercase; border: 1px solid var(--warning-color); padding: 1px 4px; border-radius: 3px;">Лидер</span>
                                            }
                                        </div>
                                        <div class="roster-xp-bar"><div class="roster-xp-fill" style="width: @(barWidth)%;"></div></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <div class="row">
                <div class="col-xl-6 mb-4">
                    <h4 class="section-title"><RadzenIcon Icon="crisis_alert" /> Сценарии и симуляции</h4>
                    <div class="stats-grid-mini">
                        <div class="cyber-card stat-card"><div class="stat-label">Доступно</div><div class="stat-value text-light-blue">@totalScenarios</div><div class="stat-sub">на платформе</div></div>
                        <div class="cyber-card stat-card"><div class="stat-label">Пройдено</div><div class="stat-value text-green">@completedScenariosCount</div><div class="stat-sub">успешно</div></div>
                        <div class="cyber-card stat-card"><div class="stat-label">Win Rate</div><div class="stat-value text-cyan">@scenarioSuccessRate%</div><div class="stat-sub">за @totalAttemptsScenarios попыток</div></div>
                        <div class="cyber-card stat-card"><div class="stat-label">Опыт (XP)</div><div class="stat-value text-warning">@totalScenarioScore</div><div class="stat-sub">заработано</div></div>
                    </div>

                    <div class="cyber-card p-0" style="overflow: hidden;">
                        <div class="p-3 border-bottom border-dark"><h4 class="section-title m-0" style="font-size: 0.85rem;">Журнал симуляций</h4></div>
                        <RadzenDataGrid Data="@allScenarioAttempts" TItem="UserScenarioProgress" AllowPaging="true" PageSize="5" Style="border: none !important; border-radius: 0 !important;">
                            <Columns>
                                <RadzenDataGridColumn TItem="UserScenarioProgress" Title="СЦЕНАРИЙ">
                                    <Template Context="data">
                                        <div style="color: var(--text-light); font-weight: 500; font-size: 0.8rem; white-space: normal; line-height: 1.2;">
                                            @(data.Scenario?.Title ?? "Неизвестный сценарий")
                                            @if (data.IsTeamAttempt)
                                            {
                                                <span class="team-badge" style="margin-left: 4px; padding: 1px 4px; font-size: 0.6rem;">👥</span>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="UserScenarioProgress" Title="СТАТУС" Width="95px" TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        @switch (data.Status)
                                        {
                                            case AttemptStatus.InProgress:
                                                <span class="status-badge-mini status-in-progress">В процессе</span>
                                                break;
                                            case AttemptStatus.Completed:

                                                <span class="status-badge-mini status-completed">Успех</span>
                                                break;
                                            case AttemptStatus.Failed:

                                                <span class="status-badge-mini status-failed">Провал</span>
                                                break;
                                            default:

                                                <span class="status-badge-mini" style="background: rgba(143,160,181,0.15); color: var(--text-muted); border: 1px solid var(--border-color);">@data.Status</span>
                                                break;
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="UserScenarioProgress" Title="ДАТА" Width="100px" TextAlign="TextAlign.Center">
                                    <Template Context="data"><span style="font-size: 0.75rem; color: var(--text-muted);">@(data.StartedAt?.ToString("dd.MM.yy") ?? "—")</span></Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="UserScenarioProgress" Title="XP" Width="70px" TextAlign="TextAlign.Center">
                                    <Template Context="data"><span style="color: var(--accent-cyan); font-weight: bold; font-size: 0.8rem;">@data.Score</span></Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>

                <div class="col-xl-6 mb-4">
                    <h4 class="section-title"><RadzenIcon Icon="quiz" /> Академические тесты</h4>
                    <div class="stats-grid-mini">
                        <div class="cyber-card stat-card"><div class="stat-label">Доступно</div><div class="stat-value text-light-blue">@totalTests</div><div class="stat-sub">в каталоге</div></div>
                        <div class="cyber-card stat-card"><div class="stat-label">Пройдено</div><div class="stat-value text-green">@completedTestsCount</div><div class="stat-sub">успешно</div></div>
                        <div class="cyber-card stat-card"><div class="stat-label">Точность</div><div class="stat-value text-cyan">@correctAnswersPercent%</div><div class="stat-sub">верных ответов</div></div>
                        <div class="cyber-card stat-card"><div class="stat-label">Попыток</div><div class="stat-value text-warning">@totalAttemptsTests</div><div class="stat-sub">всего запусков</div></div>
                    </div>

                    <div class="cyber-card p-0" style="overflow: hidden;">
                        <div class="p-3 border-bottom border-dark"><h4 class="section-title m-0" style="font-size: 0.85rem;">Журнал тестирования</h4></div>
                        <RadzenDataGrid Data="@allTestAttempts" TItem="TestAttemptDto" AllowPaging="true" PageSize="5" Style="border: none !important; border-radius: 0 !important;">
                            <Columns>
                                <RadzenDataGridColumn TItem="TestAttemptDto" Title="ТЕСТ">
                                    <Template Context="data">
                                        <div style="color: var(--text-light); font-weight: 500; font-size: 0.8rem; white-space: normal; line-height: 1.2;">
                                            @data.TestTitle
                                            <span style="font-size: 0.65rem; color: @GetDifficultyColor(data.Difficulty); display: block; margin-top: 2px;">@data.DifficultyText</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="TestAttemptDto" Title="СТАТУС" Width="95px" TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        @switch (data.Status)
                                        {
                                            case AttemptStatus.InProgress:
                                                <span class="status-badge-mini status-in-progress">В процессе</span>
                                                break;
                                            case AttemptStatus.Completed:

                                                <span class="status-badge-mini status-completed">Успех</span>
                                                break;
                                            case AttemptStatus.Failed:

                                                <span class="status-badge-mini status-failed">Провал</span>
                                                break;
                                            default:

                                                <span class="status-badge-mini" style="background: rgba(143,160,181,0.15); color: var(--text-muted); border: 1px solid var(--border-color);">@data.Status</span>
                                                break;
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="TestAttemptDto" Title="ДАТА" Width="100px" TextAlign="TextAlign.Center">
                                    <Template Context="data"><span style="font-size: 0.75rem; color: var(--text-muted);">@(data.StartedAt?.ToString("dd.MM.yy") ?? "—")</span></Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="TestAttemptDto" Title="%" Width="65px" TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        @{
                                            var pct = data.TotalQuestions > 0 ? (int)Math.Round((double)data.CorrectAnswers / data.TotalQuestions * 100) : 0;
                                        }
                                        <span style="color: @(pct >= 80 ? "var(--success-color)" : pct >= 50 ? "var(--warning-color)" : "var(--danger-color)"); font-weight: bold; font-size: 0.8rem;">@pct%</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="TestAttemptDto" Title="" Width="15px" Sortable="false" Filterable="false" />
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </div>
            </div>
        }
        else if (activeTabIndex == 1)
        {
            <div class="cyber-filter-bar">
                <div class="d-flex align-items-center gap-4 flex-wrap" style="flex: 1; min-width: 280px;">
                    <div class="d-flex align-items-center gap-2">
                        <span style="color: var(--text-muted); font-weight: 700; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px;">Категория:</span>
                        <RadzenDropDown Data="@leaderboardCategories" @bind-Value="selectedCategory" Change="@UpdateLeaderboards" Style="width: 160px;" class="dark-input" />
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span style="color: var(--text-muted); font-weight: 700; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px;">Отдел:</span>
                        <RadzenDropDown Data="@leaderboardFilters" @bind-Value="selectedFilter" Change="@UpdateLeaderboards" Style="width: 220px;" class="dark-input" />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2" style="width: 300px; max-width: 100%;">
                    <RadzenTextBox Placeholder="Поиск позывного или команды..." Style="width: 100%; font-family: monospace;" class="dark-input"
                                   @bind-Value="@searchQuery"
                                   @oninput="@(e => { searchQuery = e.Value?.ToString() ?? string.Empty; StateHasChanged(); })" />
                </div>
            </div>

            @if (selectedCategory == "Сценарии")
            {
                <div class="leaderboard-container-layout">
                    <div class="cyber-card" style="margin-bottom: 0;">
                        <div class="platform-radar-header">
                            <h4 style="color: var(--accent-cyan); font-weight: 800; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px; margin: 0;">
                                <RadzenIcon Icon="emoji_events" style="color: #e5c07b; margin-top:-2px; margin-right:6px;" /> Оперативники
                            </h4>
                            <span style="font-family: monospace; font-size: 0.8rem; color: var(--text-muted);">АКТИВНО_ЗАПИСЕЙ: @topUsers.Count</span>
                        </div>

                        @{
                            var filteredUsers = topUsers.Where(u => string.IsNullOrEmpty(searchQuery) || u.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
                        }

                        @if (!filteredUsers.Any())
                        {
                            <div class="text-center py-5" style="color: var(--text-light); font-weight: 600; border: 1px dashed var(--border-color); border-radius: 8px; background: rgba(0,0,0,0.2);">Записи соответствия критериям не найдены</div>
                        }
                        else
                        {
                            <div class="leaderboard-list">
                                @foreach (var item in filteredUsers)
                                {
                                    <div class="leaderboard-row @(item.IsCurrentUser ? "current-user" : "")" data-rank="@item.Rank">
                                        <div class="rank-col">
                                            @if (item.Rank == 1)
                                            {
                                                <span class="rank-medal">🥇</span>
                                            }
                                            else if (item.Rank == 2)
                                            {

                                                <span class="rank-medal">🥈</span>
                                            }
                                            else if (item.Rank == 3)
                                            {

                                                <span class="rank-medal">🥉</span>
                                            }
                                            else
                                            {

                                                <span class="rank-number">#@item.Rank</span>
                                            }
                                        </div>
                                        <div class="user-col">
                                            <span class="user-name-text">@item.Name @(item.IsCurrentUser ? " (Вы)" : "")</span>
                                            @if (selectedFilter == "Все подразделения")
                                            {
                                                <span class="user-group-text">@item.GroupName</span>
                                            }
                                        </div>
                                        <div class="score-col">
                                            <span class="score-value">@item.Score</span>
                                            <span class="score-label">XP</span>
                                        </div>
                                        <div class="progress-col">
                                            <div class="mini-progress" title="Процент доминирования: @item.Percentile%">
                                                <div class="mini-progress-fill" style="width: @item.Percentile%;"></div>
                                            </div>
                                            <span class="completed-count">@item.CompletedCount миссий</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="cyber-card" style="margin-bottom: 0;">
                        <div class="platform-radar-header">
                            <h4 style="color: var(--accent-cyan); font-weight: 800; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px; margin: 0;">
                                <RadzenIcon Icon="military_tech" style="color: #98c379; margin-top:-2px; margin-right:6px;" /> Командные расчеты
                            </h4>
                            <span style="font-family: monospace; font-size: 0.8rem; color: var(--text-muted);">ОТДЕЛОВ_В_СЕТИ: @topTeams.Count</span>
                        </div>

                        @{
                            var filteredTeams = topTeams.Where(t => string.IsNullOrEmpty(searchQuery) || t.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
                        }

                        @if (!filteredTeams.Any())
                        {
                            <div class="text-center py-5" style="color: var(--text-light); font-weight: 600; border: 1px dashed var(--border-color); border-radius: 8px; background: rgba(0,0,0,0.2);">Подходящие тактические группы отсутствуют</div>
                        }
                        else
                        {
                            <div class="leaderboard-list">
                                @foreach (var item in filteredTeams)
                                {
                                    <div class="leaderboard-row @(item.IsUserTeam ? "current-user" : "")" data-rank="@item.Rank">
                                        <div class="rank-col">
                                            @if (item.Rank == 1)
                                            {
                                                <span class="rank-medal">🥇</span>
                                            }
                                            else if (item.Rank == 2)
                                            {

                                                <span class="rank-medal">🥈</span>
                                            }
                                            else if (item.Rank == 3)
                                            {

                                                <span class="rank-medal">🥉</span>
                                            }
                                            else
                                            {

                                                <span class="rank-number">#@item.Rank</span>
                                            }
                                        </div>
                                        <div class="user-col">
                                            <span class="user-name-text">@item.Name @(item.IsUserTeam ? " (Ваша)" : "")</span>
                                            @if (selectedFilter == "Все подразделения")
                                            {
                                                <span class="user-group-text">@item.GroupName</span>
                                            }
                                        </div>
                                        <div class="score-col">
                                            <span class="score-value">@item.Score</span>
                                            <span class="score-label">XP</span>
                                        </div>
                                        <div class="progress-col">
                                            <div class="mini-progress" title="Рейтинговый перцентиль: @item.Percentile%">
                                                <div class="mini-progress-fill" style="width: @item.Percentile%;"></div>
                                            </div>
                                            <span class="completed-count">@item.CompletedCount вылетов</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (selectedCategory == "Тесты")
            {
                <div class="leaderboard-container-layout">
                    <div class="cyber-card" style="margin-bottom: 0;">
                        <div class="platform-radar-header">
                            <h4 style="color: var(--accent-cyan); font-weight: 800; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px; margin: 0;">
                                <RadzenIcon Icon="emoji_events" style="color: #e5c07b; margin-top:-2px; margin-right:6px;" /> Успеваемость (Академия)
                            </h4>
                            <span style="font-family: monospace; font-size: 0.8rem; color: var(--text-muted);">СОРТИРОВКА: СР_БАЛЛ</span>
                        </div>

                        @{
                            var filteredTestUsers = topTestUsers.Where(u => string.IsNullOrEmpty(searchQuery) || u.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
                        }

                        @if (!filteredTestUsers.Any())
                        {
                            <div class="text-center py-5" style="color: var(--text-light); font-weight: 600; border: 1px dashed var(--border-color); border-radius: 8px; background: rgba(0,0,0,0.2);">Агенты по данному запросу не найдены</div>
                        }
                        else
                        {
                            <div class="leaderboard-list">
                                @foreach (var item in filteredTestUsers)
                                {
                                    <div class="leaderboard-row @(item.IsCurrentUser ? "current-user" : "")" data-rank="@item.Rank">
                                        <div class="rank-col">
                                            @if (item.Rank == 1)
                                            {
                                                <span class="rank-medal">🥇</span>
                                            }
                                            else if (item.Rank == 2)
                                            {

                                                <span class="rank-medal">🥈</span>
                                            }
                                            else if (item.Rank == 3)
                                            {

                                                <span class="rank-medal">🥉</span>
                                            }
                                            else
                                            {

                                                <span class="rank-number">#@item.Rank</span>
                                            }
                                        </div>
                                        <div class="user-col">
                                            <span class="user-name-text">@item.Name</span>
                                            @if (selectedFilter == "Все подразделения")
                                            {
                                                <span class="user-group-text">@item.GroupName</span>
                                            }
                                        </div>
                                        <div class="score-col">
                                            <span class="score-value">@item.AverageScore%</span>
                                            <span class="score-label">Ср. Точность</span>
                                        </div>
                                        <div class="progress-col">
                                            <div class="mini-progress" title="Средний балл: @item.AverageScore%">
                                                <div class="mini-progress-fill test-fill" style="width: @item.AverageScore%;"></div>
                                            </div>
                                            <span class="completed-count">@item.CompletedCount тестов</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="cyber-card" style="margin-bottom: 0;">
                        <div class="platform-radar-header">
                            <h4 style="color: var(--accent-cyan); font-weight: 800; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px; margin: 0;">
                                <RadzenIcon Icon="quiz" style="color: var(--accent-cyan); margin-top:-2px; margin-right:6px;" /> Глобальная телеметрия
                            </h4>
                            <span style="font-family: monospace; font-size: 0.8rem; color: var(--success-color);">SYSTEM_ACTIVE</span>
                        </div>
                        <div class="stats-grid-mini" style="grid-template-columns: 1fr; margin-bottom: 0;">
                            <div class="cyber-card stat-card" style="display: flex; justify-content: space-between; align-items: center; padding: 20px !important;">
                                <div style="text-align: left;">
                                    <div class="stat-label">Всего тестов в базе</div>
                                    <div class="stat-sub">Доступно для прохождения</div>
                                </div>
                                <div class="stat-value text-light-blue" style="font-size: 2.5rem;">@testLeaderboardStats.TotalTests</div>
                            </div>
                            <div class="cyber-card stat-card" style="display: flex; justify-content: space-between; align-items: center; padding: 20px !important;">
                                <div style="text-align: left;">
                                    <div class="stat-label">Тестов завершено</div>
                                    <div class="stat-sub">Успешных попыток</div>
                                </div>
                                <div class="stat-value text-green" style="font-size: 2.5rem;">@testLeaderboardStats.TotalCompleted</div>
                            </div>
                            <div class="cyber-card stat-card" style="display: flex; justify-content: space-between; align-items: center; padding: 20px !important;">
                                <div style="text-align: left;">
                                    <div class="stat-label">Агентов в системе</div>
                                    <div class="stat-sub">Уникальных участников</div>
                                </div>
                                <div class="stat-value text-cyan" style="font-size: 2.5rem;">@testLeaderboardStats.UniqueUsers</div>
                            </div>
                            <div class="cyber-card stat-card" style="display: flex; justify-content: space-between; align-items: center; padding: 20px !important;">
                                <div style="text-align: left;">
                                    <div class="stat-label">Средний балл базы</div>
                                    <div class="stat-sub">Точность по платформе</div>
                                </div>
                                <div class="stat-value text-warning" style="font-size: 2.5rem;">@testLeaderboardStats.OverallAverage%</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    // Локальная переменная для мгновенной фильтрации лидербордов на стороне клиента
    private string searchQuery = string.Empty;
}