@if (showTeamModal && selectedUserForTeams != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); backdrop-filter: blur(6px); display: flex; justify-content: center; align-items: center; z-index: 9999;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; width: 500px; padding: 25px; box-shadow: 0 0 40px rgba(91, 163, 227, 0.2);">
            <h4 style="color: var(--accent-light-blue); margin: 0 0 10px 0;">Команды: @selectedUserForTeams.UserName</h4>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 20px;">Назначьте агента в команды его подразделения.</p>

            @{
                var availableTeams = selectedUserForTeams.GroupId != null ? teamsList.Where(t => t.GroupId == selectedUserForTeams.GroupId).ToList() : teamsList;
            }

            <div style="max-height: 250px; overflow-y: auto; background: var(--bg-main); border: 1px solid var(--border-color); padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                @if (!availableTeams.Any())
                {
                    <div class="text-danger">В подразделении нет команд.</div>
                }
                @foreach (var team in availableTeams)
                {
                    var isChecked = selectedUserForTeams.Teams != null && selectedUserForTeams.Teams.Any(t => t.Id == team.Id);
                    <div style="display: flex; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--border-color);">
                        <RadzenCheckBox TValue="bool" Value="@isChecked" Change="@(async (val) => await ToggleTeamAssignment(selectedUserForTeams.Id, team.Id, val))" />
                        <span style="color: var(--text-light);">@team.Name</span>
                    </div>
                }
            </div>

            <div class="text-right">
                <button class="btn-primary-gradient" @onclick="CloseTeamAssignmentModal">Закрыть</button>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private IDbContextFactory<ApplicationDbContext> ContextFactory { get; set; }

    private int activeTabIndex = 0;
    private bool isLoaded = false;
    private bool isAdmin = false;
    private string UserDisplayName = "Загрузка...";
    private ApplicationUser? user;

    private UserScenarioProgress? activeScenario = null;
    private int activeScenarioQuestionsSolved = 0;
    private int activeScenarioTotalQuestions = 0;
    private int totalScenarios = 0;
    private int soloScenarios = 0;
    private int teamScenarios = 0;
    private int completedScenariosCount = 0;
    private int totalAttemptsScenarios = 0;
    private int totalScenarioScore = 0;
    private string scenarioSuccessRate = "0";
    private List<UserScenarioProgress> completedScenariosList = new();

    private int totalTests = 0;
    private int completedTestsCount = 0;
    private int totalAttemptsTests = 0;
    private string testSuccessRate = "0";
    private string correctAnswersPercent = "0";
    private int totalCorrectAnswers = 0;
    private int totalQuestionsAnswered = 0;
    private List<TestProgressDto> completedTestsList = new();

    public class TestProgressDto
    {
        public string TestTitle { get; set; } = "";
        public string Difficulty { get; set; } = "";
        public string DifficultyText { get; set; } = "";
        public int CorrectAnswers { get; set; }
        public int TotalQuestions { get; set; }
        public DateTime? CompletedAt { get; set; }
    }

    public class TeamMemberDto { public string Id { get; set; } = ""; public string Name { get; set; } = ""; public int TotalScore { get; set; } }
    private List<TeamMemberDto> myTeamMembers = new();

    private List<string> leaderboardCategories = new() { "Сценарии", "Тесты" };
    private string selectedCategory = "Сценарии";
    private List<string> leaderboardFilters = new() { "Все подразделения", "Мое подразделение" };
    private string selectedFilter = "Все подразделения";

    public class UserLeaderboardDto
    {
        public int Rank { get; set; }
        public string Name { get; set; } = "";
        public string GroupName { get; set; } = "";
        public int Score { get; set; }
        public int CompletedCount { get; set; }
        public int Percentile { get; set; }
        public bool IsCurrentUser { get; set; }
    }

    public class TeamLeaderboardDto
    {
        public int Rank { get; set; }
        public string Name { get; set; } = "";
        public string GroupName { get; set; } = "";
        public int Score { get; set; }
        public int CompletedCount { get; set; }
        public int Percentile { get; set; }
        public bool IsUserTeam { get; set; }
    }

    public class TestUserLeaderboardDto
    {
        public int Rank { get; set; }
        public string Name { get; set; } = "";
        public string GroupName { get; set; } = "";
        public int AverageScore { get; set; }
        public int CompletedCount { get; set; }
        public bool IsCurrentUser { get; set; }
    }

    public class TestLeaderboardStats
    {
        public int TotalTests { get; set; }
        public int TotalCompleted { get; set; }
        public int UniqueUsers { get; set; }
        public int OverallAverage { get; set; }
    }

    private List<UserLeaderboardDto> topUsers = new();
    private List<TeamLeaderboardDto> topTeams = new();
    private List<TestUserLeaderboardDto> topTestUsers = new();
    private TestLeaderboardStats testLeaderboardStats = new();

    private List<UserGroup> groupsList = new();
    private List<UserTeam> teamsList = new();
    private List<ApplicationUser> usersList = new();
    private List<UserScenarioProgress> allScenarioProgressList = new();
    private List<UserTestProgress> allTestProgressList = new();
    private bool showTeamModal = false;
    private ApplicationUser? selectedUserForTeams;
    private string newGroupName = "";
    private string newTeamName = "";
    private int selectedGroupIdForTeam;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");
        await LoadBaseData();
        await UpdateLeaderboards();
        isLoaded = true;
    }

    private async Task LoadBaseData()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        UserDisplayName = authState.User.Identity?.Name ?? "Оперативник";

        using var context = await ContextFactory.CreateDbContextAsync();
        if (!string.IsNullOrEmpty(userId))
        {
            user = await context.Set<ApplicationUser>()
                .Include(u => u.Group)
                .Include(u => u.Teams)
                .FirstOrDefaultAsync(u => u.Id == userId);

            activeScenario = await context.UserProgresses
                .Include(p => p.Scenario).ThenInclude(s => s.Questions)
                .FirstOrDefaultAsync(p => p.UserId == userId && p.Status == AttemptStatus.InProgress);

            if (activeScenario != null)
            {
                activeScenarioTotalQuestions = activeScenario.Scenario.Questions.Count;
                activeScenarioQuestionsSolved = await context.Set<UserAnswerProgress>()
                    .CountAsync(a => a.UserScenarioProgressId == activeScenario.Id);
            }

            var allVisible = await context.Scenarios.Where(s => s.IsVisible || isAdmin).ToListAsync();
            totalScenarios = allVisible.Count;
            soloScenarios = allVisible.Count(s => s.Scope == VisibilityScope.Public || s.Scope == VisibilityScope.GroupOnly);
            teamScenarios = allVisible.Count(s => s.Scope == VisibilityScope.TeamOnly);

            completedScenariosList = await context.UserProgresses
                .Include(p => p.Scenario)
                .Where(p => p.UserId == userId && p.Status == AttemptStatus.Completed)
                .OrderByDescending(p => p.CompletedAt)
                .ToListAsync();

            completedScenariosCount = completedScenariosList.Count;
            totalScenarioScore = completedScenariosList.Sum(s => s.Score);
            totalAttemptsScenarios = await context.UserProgresses.CountAsync(p => p.UserId == userId);
            scenarioSuccessRate = totalAttemptsScenarios > 0 ? ((int)Math.Round((double)completedScenariosCount / totalAttemptsScenarios * 100)).ToString() : "0";

            var allTests = await context.Set<CyberTest>().Where(t => t.IsVisible || isAdmin).ToListAsync();
            totalTests = allTests.Count;

            var testProgresses = await context.Set<UserTestProgress>()
                .Include(tp => tp.Test).ThenInclude(t => t.Questions)
                .Where(tp => tp.UserId == userId)
                .OrderByDescending(tp => tp.CompletedAt)
                .ToListAsync();

            totalAttemptsTests = testProgresses.Count;
            completedTestsCount = testProgresses.Count(tp => tp.Status == AttemptStatus.Completed);
            testSuccessRate = totalAttemptsTests > 0 ? ((int)Math.Round((double)completedTestsCount / totalAttemptsTests * 100)).ToString() : "0";

            totalCorrectAnswers = testProgresses.Where(tp => tp.Status == AttemptStatus.Completed).Sum(tp => tp.Score);
            totalQuestionsAnswered = testProgresses.Where(tp => tp.Status == AttemptStatus.Completed)
                .Sum(tp => tp.Test?.Questions?.Count ?? 0);
            correctAnswersPercent = totalQuestionsAnswered > 0
                ? ((int)Math.Round((double)totalCorrectAnswers / totalQuestionsAnswered * 100)).ToString()
                : "0";

            var completedTests = testProgresses.Where(tp => tp.Status == AttemptStatus.Completed).ToList();
            completedTestsList = completedTests.Select(tp => new TestProgressDto
            {
                TestTitle = tp.Test?.Title ?? "Тест",
                Difficulty = tp.Test?.Difficulty.ToString() ?? "",
                DifficultyText = tp.Test?.Difficulty switch
                {
                    TestDifficulty.Easy => "Лёгкий",
                    TestDifficulty.Medium => "Средний",
                    TestDifficulty.Hard => "Сложный",
                    _ => tp.Test?.Difficulty.ToString() ?? ""
                },
                CorrectAnswers = tp.Score,
                TotalQuestions = tp.Test?.Questions?.Count ?? 0,
                CompletedAt = tp.CompletedAt
            }).ToList();

            if (user?.Teams.Any() == true)
            {
                var myTeamId = user.Teams.First().Id;
                var teamUsers = await context.Set<UserTeam>()
                    .Where(t => t.Id == myTeamId)
                    .SelectMany(t => t.Users)
                    .ToListAsync();

                myTeamMembers.Clear();
                foreach (var tu in teamUsers)
                {
                    var uScore = await context.UserProgresses.Where(p => p.UserId == tu.Id && p.Status == AttemptStatus.Completed).SumAsync(p => p.Score);
                    myTeamMembers.Add(new TeamMemberDto { Id = tu.Id, Name = tu.UserName ?? "Агент", TotalScore = uScore });
                }
                myTeamMembers = myTeamMembers.OrderByDescending(m => m.TotalScore).ToList();
            }
        }

        if (isAdmin)
        {
            groupsList = await context.UserGroups.ToListAsync();
            teamsList = await context.UserTeams.Include(t => t.Group).ToListAsync();
            usersList = await context.Set<ApplicationUser>().Include(u => u.Group).Include(u => u.Teams).ToListAsync();
            allScenarioProgressList = await context.UserProgresses.Include(p => p.Scenario).OrderByDescending(p => p.StartedAt).ToListAsync();
            allTestProgressList = await context.Set<UserTestProgress>().Include(tp => tp.Test).OrderByDescending(tp => tp.StartedAt).ToListAsync();
        }
        else
        {
            teamsList = await context.UserTeams.ToListAsync();
        }
    }

    private string GetDifficultyColor(string difficulty)
    {
        return difficulty switch
        {
            "Easy" => "var(--success-color)",
            "Medium" => "var(--warning-color)",
            "Hard" => "var(--danger-color)",
            _ => "var(--text-muted)"
        };
    }

    private async Task UpdateLeaderboards()
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        int? myGroupId = user?.GroupId;
        bool filterByGroup = selectedFilter == "Мое подразделение" && myGroupId.HasValue;
        var currentUserId = user?.Id;

        if (selectedCategory == "Сценарии")
        {
            var usersQuery = context.Set<ApplicationUser>().Include(u => u.Group).AsQueryable();
            if (filterByGroup) usersQuery = usersQuery.Where(u => u.GroupId == myGroupId.Value);
            var allUsers = await usersQuery.ToListAsync();
            topUsers.Clear();
            int maxScore = 0;
            foreach (var u in allUsers)
            {
                var progressList = await context.UserProgresses.Where(p => p.UserId == u.Id && p.Status == AttemptStatus.Completed && !p.IsTeamAttempt).ToListAsync();
                var score = progressList.Sum(p => p.Score);
                if (score > maxScore) maxScore = score;
                if (score > 0) topUsers.Add(new UserLeaderboardDto { Name = u.UserName ?? "Агент", GroupName = u.Group?.Name ?? "Без подразделения", Score = score, CompletedCount = progressList.Count, IsCurrentUser = u.Id == currentUserId });
            }
            topUsers = topUsers.OrderByDescending(u => u.Score).Take(15).ToList();
            for (int i = 0; i < topUsers.Count; i++) { topUsers[i].Rank = i + 1; topUsers[i].Percentile = maxScore > 0 ? (int)Math.Round((double)topUsers[i].Score / maxScore * 100) : 0; }

            var teamsQuery = context.UserTeams.Include(t => t.Group).AsQueryable();
            if (filterByGroup) teamsQuery = teamsQuery.Where(t => t.GroupId == myGroupId.Value);
            var allTeams = await teamsQuery.ToListAsync();
            topTeams.Clear();
            maxScore = 0;
            var userTeamIds = user?.Teams?.Select(t => t.Id).ToList() ?? new List<int>();
            foreach (var t in allTeams)
            {
                var progressList = await context.UserProgresses.Where(p => p.TeamId == t.Id && p.Status == AttemptStatus.Completed && p.IsTeamAttempt).ToListAsync();
                var score = progressList.Sum(p => p.Score);
                if (score > maxScore) maxScore = score;
                if (score > 0) topTeams.Add(new TeamLeaderboardDto { Name = t.Name, GroupName = t.Group?.Name ?? "", Score = score, CompletedCount = progressList.Count, IsUserTeam = userTeamIds.Contains(t.Id) });
            }
            topTeams = topTeams.OrderByDescending(t => t.Score).Take(15).ToList();
            for (int i = 0; i < topTeams.Count; i++) { topTeams[i].Rank = i + 1; topTeams[i].Percentile = maxScore > 0 ? (int)Math.Round((double)topTeams[i].Score / maxScore * 100) : 0; }
        }
        else if (selectedCategory == "Тесты")
        {
            var usersQuery = context.Set<ApplicationUser>().Include(u => u.Group).AsQueryable();
            if (filterByGroup) usersQuery = usersQuery.Where(u => u.GroupId == myGroupId.Value);
            var allUsers = await usersQuery.ToListAsync();
            topTestUsers.Clear();
            foreach (var u in allUsers)
            {
                var testProgresses = await context.Set<UserTestProgress>().Include(tp => tp.Test).ThenInclude(t => t.Questions).Where(tp => tp.UserId == u.Id && tp.Status == AttemptStatus.Completed).ToListAsync();
                if (testProgresses.Any())
                {
                    double totalPercent = 0;
                    foreach (var tp in testProgresses) { int totalQ = tp.Test?.Questions?.Count ?? 0; if (totalQ > 0) totalPercent += (double)tp.Score / totalQ * 100; }
                    int avgScore = (int)Math.Round(totalPercent / testProgresses.Count);
                    topTestUsers.Add(new TestUserLeaderboardDto { Name = u.UserName ?? "Агент", GroupName = u.Group?.Name ?? "Без подразделения", AverageScore = avgScore, CompletedCount = testProgresses.Count, IsCurrentUser = u.Id == currentUserId });
                }
            }
            topTestUsers = topTestUsers.OrderByDescending(u => u.AverageScore).ThenByDescending(u => u.CompletedCount).Take(15).ToList();
            for (int i = 0; i < topTestUsers.Count; i++) topTestUsers[i].Rank = i + 1;

            var allTests = await context.Set<CyberTest>().Where(t => t.IsVisible || isAdmin).ToListAsync();
            var allCompletedTests = await context.Set<UserTestProgress>().Include(tp => tp.Test).ThenInclude(t => t.Questions).Where(tp => tp.Status == AttemptStatus.Completed).ToListAsync();
            testLeaderboardStats = new TestLeaderboardStats
            {
                TotalTests = allTests.Count,
                TotalCompleted = allCompletedTests.Count,
                UniqueUsers = allCompletedTests.Select(tp => tp.UserId).Distinct().Count(),
                OverallAverage = allCompletedTests.Any() ? (int)Math.Round(allCompletedTests.Average(tp => { int totalQ = tp.Test?.Questions?.Count ?? 0; return totalQ > 0 ? (double)tp.Score / totalQ * 100 : 0; })) : 0
            };
        }
    }

    private void OpenTeamAssignmentModal(ApplicationUser targetUser) { selectedUserForTeams = targetUser; showTeamModal = true; }
    private void CloseTeamAssignmentModal() { showTeamModal = false; selectedUserForTeams = null; }

    private async Task ToggleTeamAssignment(string userId, int teamId, bool assign)
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        var dbUser = await context.Set<ApplicationUser>().Include(u => u.Teams).FirstOrDefaultAsync(u => u.Id == userId);
        var dbTeam = await context.UserTeams.FindAsync(teamId);
        if (dbUser != null && dbTeam != null)
        {
            if (assign && !dbUser.Teams.Any(t => t.Id == teamId)) dbUser.Teams.Add(dbTeam);
            else if (!assign) { var teamToRemove = dbUser.Teams.FirstOrDefault(t => t.Id == teamId); if (teamToRemove != null) dbUser.Teams.Remove(teamToRemove); }
            await context.SaveChangesAsync();
            await LoadBaseData();
            if (selectedUserForTeams != null && selectedUserForTeams.Id == userId) selectedUserForTeams = usersList.FirstOrDefault(u => u.Id == userId);
        }
    }

    private async Task CreateGroup() { if (string.IsNullOrWhiteSpace(newGroupName)) return; using var context = await ContextFactory.CreateDbContextAsync(); context.UserGroups.Add(new UserGroup { Name = newGroupName }); await context.SaveChangesAsync(); newGroupName = ""; await LoadBaseData(); }
    private async Task CreateTeam() { if (string.IsNullOrWhiteSpace(newTeamName) || selectedGroupIdForTeam <= 0) return; using var context = await ContextFactory.CreateDbContextAsync(); context.UserTeams.Add(new UserTeam { Name = newTeamName, GroupId = selectedGroupIdForTeam }); await context.SaveChangesAsync(); newTeamName = ""; await LoadBaseData(); }
    private async Task UpdateUserGroup(string userId, int? groupId) { using var context = await ContextFactory.CreateDbContextAsync(); var targetUser = await context.Set<ApplicationUser>().FindAsync(userId); if (targetUser != null) { targetUser.GroupId = groupId; await context.SaveChangesAsync(); } await LoadBaseData(); }

    private async Task DeleteGroup(int groupId)
    {
        var confirm = await DialogService.Confirm("Вы уверены, что хотите удалить подразделение?", "Удаление", new ConfirmOptions() { OkButtonText = "Удалить", CancelButtonText = "Отмена" });
        if (confirm == true) { using var context = await ContextFactory.CreateDbContextAsync(); var group = await context.UserGroups.FindAsync(groupId); if (group != null) { context.UserGroups.Remove(group); await context.SaveChangesAsync(); await LoadBaseData(); } }
    }

    private async Task DeleteTeam(int teamId)
    {
        var confirm = await DialogService.Confirm("Удалить команду?", "Удаление", new ConfirmOptions() { OkButtonText = "Удалить", CancelButtonText = "Отмена" });
        if (confirm == true) { using var context = await ContextFactory.CreateDbContextAsync(); var team = await context.UserTeams.FindAsync(teamId); if (team != null) { context.UserTeams.Remove(team); await context.SaveChangesAsync(); await LoadBaseData(); } }
    }

    private async Task ResetScenarioProgress(int progressId)
    {
        var confirm = await DialogService.Confirm("Сбросить эту сессию сценария? Все очки будут аннулированы.", "Сброс прогресса", new ConfirmOptions() { OkButtonText = "Сбросить", CancelButtonText = "Отмена" });
        if (confirm == true) { using var context = await ContextFactory.CreateDbContextAsync(); var progress = await context.UserProgresses.FindAsync(progressId); if (progress != null) { context.UserProgresses.Remove(progress); await context.SaveChangesAsync(); await LoadBaseData(); await UpdateLeaderboards(); } }
    }

    private async Task ResetTestProgress(int progressId)
    {
        var confirm = await DialogService.Confirm("Сбросить эту сессию теста? Все результаты будут аннулированы.", "Сброс прогресса", new ConfirmOptions() { OkButtonText = "Сбросить", CancelButtonText = "Отмена" });
        if (confirm == true) { using var context = await ContextFactory.CreateDbContextAsync(); var progress = await context.Set<UserTestProgress>().FindAsync(progressId); if (progress != null) { context.Set<UserTestProgress>().Remove(progress); await context.SaveChangesAsync(); await LoadBaseData(); await UpdateLeaderboards(); } }
    }

