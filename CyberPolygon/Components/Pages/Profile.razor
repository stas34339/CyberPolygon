                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 25px;">
                    <div class="cyber-card">
                        <h4 class="section-title"><RadzenIcon Icon="emoji_events" style="color: #e5c07b;" /> Топ оперативников (тесты)</h4>
                        @if (!topTestUsers.Any())
                        {
                            <div class="text-center py-4 text-muted">Нет данных</div>
                        }
                        else
                        {
                            <div class="leaderboard-list">
                                @foreach (var item in topTestUsers)
                                {
                                    <div class="leaderboard-row @(item.IsCurrentUser ? "current-user" : "")">
                                        <div class="rank-col">
                                            @if (item.Rank == 1)
                                            {
                                                <span class="rank-medal">🥇</span>
                                            }
                                            else if (item.Rank == 2)
                                            {

                                                <span class="rank-medal">🥈</span>
                                            }
                                            else if (item.Rank == 3)
                                            {

                                                <span class="rank-medal">🥉</span>
                                            }
                                            else
                                            {

                                                <span class="rank-number">@item.Rank</span>
                                            }
                                        </div>
                                        <div class="user-col">
                                            <span class="user-name-text">@item.Name</span>
                                            @if (selectedFilter == "Все подразделения")
                                            {
                                                <span class="user-group-text">@item.GroupName</span>
                                            }
                                        </div>
                                        <div class="score-col"><span class="score-value">@item.AverageScore%</span><span class="score-label">средний балл</span></div>
                                        <div class="progress-col"><div class="mini-progress"><div class="mini-progress-fill test-fill" style="width: @item.AverageScore%;"></div></div><span class="completed-count">@item.CompletedCount тестов</span></div>
