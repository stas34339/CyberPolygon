@page "/profile"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@using System.Security.Claims
@using static CyberPolygon.Data.ApplicationDbContext
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject ScenarioSessionManager SessionManager
@inject NotificationService NotificationService
@inject DialogService DialogService
@implements IDisposable
@rendermode InteractiveServer

<RadzenDialog />
<PageTitle>Личный кабинет | Киберполигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #24272c;
        --bg-card-hover: #2a2e36;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-danger: #e06c75;
        --border-color: #343a42;
    }

    .dashboard-wrapper {
        background-color: var(--bg-main);
        min-height: 100vh;
        color: var(--text-muted);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .cyber-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 6px !important;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        transition: border-color 0.3s ease;
    }

    .stat-value {
        font-size: 2.2rem;
        font-weight: bold;
        color: var(--text-light);
    }

    .text-cyan { color: var(--accent-cyan) !important; }
    .text-blue { color: var(--accent-blue) !important; }
    .text-green { color: #98c379 !important; }
    .text-danger { color: var(--accent-danger) !important; }
    .text-muted { color: var(--text-muted) !important; }

    /* Табы */
    .tabs-navigation {
        display: flex;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 20px;
        gap: 5px;
    }

    .tab-trigger {
        background: transparent;
        border: none;
        padding: 12px 24px;
        color: var(--text-muted);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
    }

    .tab-trigger:hover { color: var(--text-light); }
    .tab-trigger.active {
        color: var(--accent-cyan);
        border-bottom: 2px solid var(--accent-cyan);
        background-color: rgba(78, 195, 209, 0.05);
    }

    /* Таблицы */
    ::deep .rz-datagrid { background-color: var(--bg-card) !important; border: 1px solid var(--border-color) !important; }
    ::deep .rz-grid-table thead th { background-color: #1a1d21 !important; color: var(--accent-cyan) !important; border-bottom: 1px solid var(--border-color) !important; }
    ::deep .rz-grid-table tbody tr { background-color: transparent !important; color: var(--text-muted) !important; }
    ::deep .rz-grid-table td { border-bottom: 1px solid var(--border-color) !important; color: var(--text-light) !important; }
    ::deep .rz-pager { background-color: #1a1d21 !important; border-top: 1px solid var(--border-color) !important; color: var(--text-muted) !important; }

    
    .rz-textbox, .rz-dropdown {
        background-color: var(--bg-main) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
    }

    .rz-dropdown-label {
        color: var(--text-light) !important;
    }

    .rz-dropdown-panel {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
    }

    .rz-dropdown-items-wrapper {
        background-color: var(--bg-card) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
    }

    .rz-dropdown-item:hover {
        background-color: var(--bg-card-hover) !important;
        color: var(--accent-cyan) !important;
    }

    .rz-dropdown-item.rz-state-highlight {
        background-color: var(--accent-blue) !important;
        color: #1e1e1e !important;
        font-weight: bold;
    }
    
    .team-badge {
        background-color: rgba(91, 163, 227, 0.15);
        color: var(--accent-blue);
        border: 1px solid var(--accent-blue);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.8rem;
    }
    /* Исправление текста в диалоговых окнах Radzen */
    .rz-dialog {
        background-color: var(--bg-card) !important;
        color: var(--text-light) !important;
        border: 1px solid var(--border-color) !important;
    }

    .rz-dialog-title {
        color: var(--text-light) !important;
    }

    .rz-dialog-content {
        color: var(--text-light) !important;
    }

    /* Исправление выпадающих списков (глобально для порталов) */
    .rz-dropdown-panel, .rz-autocomplete-panel {
        background-color: var(--bg-card) !important;
        color: var(--text-light) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
    }

        .rz-dropdown-item:hover {
            background-color: var(--bg-card-hover) !important;
        }
</style>

<div class="dashboard-wrapper p-4">
    @if (!isLoaded)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="width: 300px; background-color: var(--border-color);" />
        </div>
    }
    else
    {
        <div class="p-4 mb-4 cyber-card d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <RadzenIcon Icon="account_circle" Style="color: var(--accent-cyan); font-size: 3.5rem;" />
                <div>
                    <h3 class="m-0" style="color: var(--text-light); font-weight: bold;">@UserDisplayName</h3>
                    <div class="text-muted" style="font-size: 0.9rem;">
                        Подразделение: <span style="color: var(--text-light);">@(user?.Group?.Name ?? "Не назначено")</span> | 
                        Команда: <span style="color: var(--text-light);">@(user?.Teams.Any() == true ? string.Join(", ", user.Teams.Select(t => t.Name)) : "Личное участие")</span>
                    </div>
                </div>
            </div>
            
            @if (activeScenario != null)
            {
                <div style="background: rgba(78, 195, 209, 0.1); border: 1px solid var(--accent-cyan); border-radius: 6px; padding: 10px 20px;">
                    <div class="text-cyan mb-1" style="font-size: 0.8rem; font-weight: bold; text-transform: uppercase;">
                        <RadzenIcon Icon="warning" Style="font-size: 1rem; vertical-align: middle; margin-right: 5px;" /> Активная симуляция
                    </div>
                    <div style="color: var(--text-light); font-weight: bold;">@activeScenario.Scenario.Title</div>
                    <div class="text-muted" style="font-size: 0.85rem;">
                        Текущий счет: <span class="text-cyan">@activeScenario.Score XP</span> | Прогресс: @activeScenarioQuestionsSolved / @activeScenarioTotalQuestions
                        @if(activeScenario.IsTeamAttempt) { <span class="team-badge ml-2" style="padding: 2px 8px; font-size: 0.75rem;">КОМАНДА</span> }
                    </div>
                </div>
            }
        </div>

        <div class="tabs-navigation">
            <button class="tab-trigger @(activeTabIndex == 0 ? "active" : "")" @onclick="() => activeTabIndex = 0">
                <RadzenIcon Icon="bar_chart" Style="vertical-align: middle;" /> СТАТИСТИКА
            </button>
            <button class="tab-trigger @(activeTabIndex == 1 ? "active" : "")" @onclick="() => activeTabIndex = 1">
                <RadzenIcon Icon="leaderboard" Style="vertical-align: middle;" /> РЕЙТИНГИ КОМАНД И АГЕНТОВ
            </button>
            @if (isAdmin)
            {
                <button class="tab-trigger @(activeTabIndex == 2 ? "active" : "")" @onclick="() => activeTabIndex = 2">
                    <RadzenIcon Icon="admin_panel_settings" Style="vertical-align: middle;" /> УПРАВЛЕНИЕ АДМИНА
                </button>
            }
        </div>

        <div class="tab-content-body">
            
            @if (activeTabIndex == 0)
            {
                <RadzenRow Gap="1.5rem" class="mb-4">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenCard class="cyber-card text-center">
                            <span class="text-muted text-uppercase d-block mb-2" style="font-size: 0.85rem;">Доступно симуляций</span>
                            <div class="d-flex justify-content-center align-items-baseline gap-2">
                                <span class="stat-value">@totalScenarios</span>
                                <span class="text-muted" style="font-size: 0.9rem;">(@soloScenarios одиночных / @teamScenarios командных)</span>
                            </div>
                        </RadzenCard>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenCard class="cyber-card text-center">
                            <span class="text-muted text-uppercase d-block mb-2" style="font-size: 0.85rem;">Успешные прохождения</span>
                            <div class="stat-value text-green">@completedCount</div>
                        </RadzenCard>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenCard class="cyber-card text-center">
                            <span class="text-muted text-uppercase d-block mb-2" style="font-size: 0.85rem;">Общий заработанный опыт</span>
                            <div class="stat-value text-cyan">@totalUserScore XP</div>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>

                @if (user?.Teams.Any() == true)
                {
                    <div class="cyber-card p-4 mb-4">
                        <h5 class="text-light mb-3"><RadzenIcon Icon="group" Style="color: var(--accent-blue);" /> Моя команда (@user.Teams.First().Name)</h5>
                        <RadzenDataGrid Data="@myTeamMembers" TItem="TeamMemberDto" class="custom-grid">
                            <Columns>
                                <RadzenDataGridColumn TItem="TeamMemberDto" Title="АГЕНТ">
                                    <Template Context="member">
                                        <span style="color: @(member.Id == user.Id ? "var(--accent-cyan)" : "var(--text-light)"); font-weight: @(member.Id == user.Id ? "bold" : "normal");">
                                            @member.Name @(member.Id == user.Id ? "(Вы)" : "")
                                        </span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="TeamMemberDto" Property="TotalScore" Title="ВКЛАД В КОМАНДУ (XP)" Width="150px" TextAlign="TextAlign.Center">
                                    <Template Context="member">
                                        <span class="text-green font-weight-bold">@member.TotalScore XP</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }

                <div class="cyber-card p-4">
                    <h5 class="text-light mb-3"><RadzenIcon Icon="history" Style="color: var(--accent-blue);" /> Архив завершенных сценариев</h5>
                    <RadzenDataGrid Data="@completedScenariosList" TItem="UserScenarioProgress" class="custom-grid" AllowPaging="true" PageSize="10">
                        <Columns>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="НАЗВАНИЕ СЦЕНАРИЯ">
                                <Template Context="data">
                                    <span style="color: var(--text-light); font-weight: 500;">@data.Scenario?.Title</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="ТИП МИССИИ" Width="200px">
                                <Template Context="data">
                                    @if (data.IsTeamAttempt)
                                    {
                                        var teamName = teamsList.FirstOrDefault(t => t.Id == data.TeamId)?.Name ?? "Неизвестная команда";
                                        <span class="team-badge" style="white-space: normal; display: inline-block; word-break: break-word;">КОМАНДА: @teamName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">ОДИНОЧНАЯ</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Property="CompletedAt" Title="ВРЕМЯ ФИКСАЦИИ" FormatString="{0:dd.MM.yyyy HH:mm}" Width="160px" />
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="ПОЛУЧЕННЫЙ ОПЫТ" Width="140px" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    <span class="text-green font-weight-bold">+@data.Score XP</span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }

            else if (activeTabIndex == 1)
            {
                <div class="mb-4 d-flex justify-content-end align-items-center gap-3">
                    <span class="text-muted">Фильтр топа:</span>
                    <RadzenDropDown Data="@leaderboardFilters" @bind-Value="selectedFilter" Change="@UpdateLeaderboards" Style="width: 250px;" />
                </div>

                <RadzenRow Gap="1.5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <div class="cyber-card p-4">
                            <h5 class="text-light mb-3"><RadzenIcon Icon="emoji_events" Style="color: #e5c07b;" /> Топ Оперативников</h5>
                            <RadzenDataGrid Data="@topUsers" TItem="UserLeaderboardDto">
                                <Columns>
                                    <RadzenDataGridColumn TItem="UserLeaderboardDto" Title="#" Width="50px" TextAlign="TextAlign.Center">
                                        <Template Context="item">
                                            <span style="color: @(item.Rank == 1 ? "#e5c07b" : (item.Rank == 2 ? "#d1d5db" : (item.Rank == 3 ? "#d97706" : "var(--text-muted)"))); font-weight: bold;">
                                                @item.Rank
                                            </span>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="UserLeaderboardDto" Title="АГЕНТ">
                                        <Template Context="item">
                                            <div style="color: var(--text-light); font-weight: 500;">@item.Name</div>
                                            @if (selectedFilter == "Все подразделения") { <div style="font-size: 0.75rem; color: var(--text-muted);">@item.GroupName</div> }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="UserLeaderboardDto" Property="Score" Title="XP" Width="80px" TextAlign="TextAlign.Center">
                                        <Template Context="item"><span class="text-cyan font-weight-bold">@item.Score</span></Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <div class="cyber-card p-4">
                            <h5 class="text-light mb-3"><RadzenIcon Icon="military_tech" Style="color: #98c379;" /> Топ Команд</h5>
                            <RadzenDataGrid Data="@topTeams" TItem="TeamLeaderboardDto">
                                <Columns>
                                    <RadzenDataGridColumn TItem="TeamLeaderboardDto" Title="#" Width="50px" TextAlign="TextAlign.Center">
                                        <Template Context="item">
                                            <span style="color: @(item.Rank == 1 ? "#e5c07b" : (item.Rank == 2 ? "#d1d5db" : (item.Rank == 3 ? "#d97706" : "var(--text-muted)"))); font-weight: bold;">
                                                @item.Rank
                                            </span>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="TeamLeaderboardDto" Title="КОМАНДА">
                                        <Template Context="item">
                                            <div style="color: var(--text-light); font-weight: 500;">@item.Name</div>
                                            @if (selectedFilter == "Все подразделения") { <div style="font-size: 0.75rem; color: var(--text-muted);">@item.GroupName</div> }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="TeamLeaderboardDto" Property="Score" Title="XP" Width="80px" TextAlign="TextAlign.Center">
                                        <Template Context="item"><span class="text-green font-weight-bold">@item.Score</span></Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </div>
                    </RadzenColumn>
                </RadzenRow>
            }

            else if (activeTabIndex == 2 && isAdmin)
            {
                <RadzenRow Gap="1.5rem" class="mb-4">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenCard class="cyber-card h-100">
                            <h5 class="text-light mb-3"><RadzenIcon Icon="lan" Style="color: var(--accent-cyan);" /> УПРАВЛЕНИЕ ПОДРАЗДЕЛЕНИЯМИ</h5>
                            <div class="d-flex gap-2 mb-3">
                                <RadzenTextBox @bind-Value="@newGroupName" Placeholder="Название нового подразделения" class="flex-grow-1" />
                                <RadzenButton Text="Добавить" Icon="add" ButtonStyle="ButtonStyle.Info" Click="@CreateGroup" Style="background: var(--accent-cyan); color: #1e1e1e;" />
                            </div>
                            <RadzenDataGrid Data="@groupsList" TItem="UserGroup" Height="220px">
                                <Columns>
                                    <RadzenDataGridColumn TItem="UserGroup" Property="Name" Title="ПОДРАЗДЕЛЕНИЕ" />
                                    <RadzenDataGridColumn TItem="UserGroup" Title="УДАЛИТЬ" Width="80px" TextAlign="TextAlign.Center">
                                        <Template Context="grp">
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined" Click="@(async () => await DeleteGroup(grp.Id))" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenCard>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenCard class="cyber-card h-100">
                            <h5 class="text-light mb-3"><RadzenIcon Icon="group" Style="color: var(--accent-cyan);" /> УПРАВЛЕНИЕ КОМАНДАМИ</h5>
                            <div class="mb-2">
                                <RadzenDropDown TValue="int" Data="@groupsList" TextProperty="Name" ValueProperty="Id" @bind-Value="@selectedGroupIdForTeam" Placeholder="Выберите подразделение" style="width: 100%;" />
                            </div>
                            <div class="d-flex gap-2 mb-3">
                                <RadzenTextBox @bind-Value="@newTeamName" Placeholder="Название команды" class="flex-grow-1" />
                                <RadzenButton Text="Создать" Icon="group_add" ButtonStyle="ButtonStyle.Success" Click="@CreateTeam" Style="background: #98c379; color: #1e1e1e;" />
                            </div>
                            <RadzenDataGrid Data="@teamsList" TItem="UserTeam" Height="170px">
                                <Columns>
                                    <RadzenDataGridColumn TItem="UserTeam" Title="КОМАНДА">
                                        <Template Context="t"><span style="color: var(--text-light);">@t.Name</span><br/><span style="font-size:0.75rem;color:var(--text-muted);">@t.Group.Name</span></Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="UserTeam" Title="УДАЛИТЬ" Width="80px" TextAlign="TextAlign.Center">
                                        <Template Context="tm">
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined" Click="@(async () => await DeleteTeam(tm.Id))" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>

                <div class="cyber-card p-4 mb-4">
                    <h5 class="text-light mb-3"><RadzenIcon Icon="assignment_ind" Style="color: var(--accent-blue);" /> РАСПРЕДЕЛЕНИЕ ОПЕРАТИВНИКОВ</h5>
                    <RadzenDataGrid Data="@usersList" TItem="ApplicationUser" AllowPaging="true" PageSize="10">
                        <Columns>
                            <RadzenDataGridColumn TItem="ApplicationUser" Property="UserName" Title="АГЕНТ" />
                            <RadzenDataGridColumn TItem="ApplicationUser" Title="ПОДРАЗДЕЛЕНИЕ">
                                <Template Context="usr">
                                    <RadzenDropDown TValue="int?" Data="@groupsList" TextProperty="Name" ValueProperty="Id" Value="@usr.GroupId"
                                                    Change="@(async (args) => await UpdateUserGroup(usr.Id, args != null ? (int?)Convert.ToInt32(args) : null))"
                                                    Placeholder="Нет подразделения" AllowClear="true" style="width: 100%;" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ApplicationUser" Title="КОМАНДЫ" TextAlign="TextAlign.Center">
                                <Template Context="usr">
                                    <RadzenButton Text="Управление составом" Icon="settings" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Variant="Variant.Outlined" Click="@(() => OpenTeamAssignmentModal(usr))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>

                <div class="cyber-card p-4 mb-4" style="overflow-x: auto;">
                    <h5 class="text-light mb-3"><RadzenIcon Icon="restart_alt" Style="color: var(--accent-danger);" /> УПРАВЛЕНИЕ СЕССИЯМИ И СБРОС РЕЗУЛЬТАТОВ</h5>

                    <RadzenDataGrid Data="@allProgressList" TItem="UserScenarioProgress" AllowPaging="true" PageSize="5">
                        <Columns>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="ОБЪЕКТ" Width="250px">
                                <Template Context="p">
                                    <div style="white-space: normal; word-break: break-all;">
                                        @if (p.IsTeamAttempt)
                                        {
                                            <span>👥 @(teamsList.FirstOrDefault(t => t.Id == p.TeamId)?.Name ?? "Команда")</span>
                                        }
                                        else
                                        {

                                            <span>👤 @(usersList.FirstOrDefault(u => u.Id == p.UserId)?.UserName ?? "Пользователь")</span>
                                        }
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="СЦЕНАРИЙ" Width="200px" />
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="СТАТУС" Width="100px" />
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Property="Score" Title="XP" Width="80px" />
                            <RadzenDataGridColumn TItem="UserScenarioProgress" Title="ДЕЙСТВИЕ" Width="120px" TextAlign="TextAlign.Center">
                                <Template Context="p">
                                    <RadzenButton Text="Сбросить" Icon="refresh" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Variant="Variant.Outlined" Click="@(() => ResetProgress(p.Id))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }
        </div>
    }
</div>

@* МОДАЛЬНОЕ ОКНО УПРАВЛЕНИЯ КОМАНДАМИ ПОЛЬЗОВАТЕЛЯ *@
@if (showTeamModal && selectedUserForTeams != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.8); backdrop-filter: blur(3px); display: flex; justify-content: center; align-items: center; z-index: 9999;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 6px; width: 500px; padding: 20px;">
            <h4 style="color: var(--text-light); margin-top: 0;">Команды: @selectedUserForTeams.UserName</h4>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Назначьте агента в команды его подразделения.</p>
            
            @{ var availableTeams = selectedUserForTeams.GroupId != null ? teamsList.Where(t => t.GroupId == selectedUserForTeams.GroupId).ToList() : teamsList; }
            
            <div style="max-height: 250px; overflow-y: auto; background: var(--bg-main); border: 1px solid var(--border-color); padding: 10px; border-radius: 4px; margin-bottom: 20px;">
                @if(!availableTeams.Any()) { <div class="text-danger">В подразделении нет команд.</div> }
                @foreach (var team in availableTeams)
                {
                    var isChecked = selectedUserForTeams.Teams != null && selectedUserForTeams.Teams.Any(t => t.Id == team.Id);
                    <div style="display: flex; align-items: center; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--border-color);">
                        <RadzenCheckBox TValue="bool" Value="@isChecked" Change="@(async (val) => await ToggleTeamAssignment(selectedUserForTeams.Id, team.Id, val))" />
                        <span style="color: var(--text-light);">@team.Name</span>
                    </div>
                }
            </div>
            
            <div class="text-right">
                <RadzenButton Text="Закрыть" ButtonStyle="ButtonStyle.Secondary" Click="CloseTeamAssignmentModal" />
            </div>
        </div>
    </div>
}

@code {
    [Inject] private IDbContextFactory<ApplicationDbContext> ContextFactory { get; set; }

    private int activeTabIndex = 0;
    private bool isLoaded = false;
    private bool isAdmin = false;
    private string UserDisplayName = "Загрузка...";
    private ApplicationUser? user;

    // Вкладка 0 (Статистика)
    private UserScenarioProgress? activeScenario = null;
    private int activeScenarioQuestionsSolved = 0;
    private int activeScenarioTotalQuestions = 0;
    
    private int totalScenarios = 0;
    private int soloScenarios = 0;
    private int teamScenarios = 0;
    
    private int completedCount = 0;
    private int totalUserScore = 0;
    private List<UserScenarioProgress> completedScenariosList = new();
    
    // Моя команда
    public class TeamMemberDto { public string Id { get; set; } = ""; public string Name { get; set; } = ""; public int TotalScore { get; set; } }
    private List<TeamMemberDto> myTeamMembers = new();

    // Вкладка 1 (Рейтинги)
    private List<string> leaderboardFilters = new() { "Все подразделения", "Мое подразделение" };
    private string selectedFilter = "Все подразделения";
    
    public class UserLeaderboardDto { public int Rank { get; set; } public string Name { get; set; } = ""; public string GroupName { get; set; } = ""; public int Score { get; set; } }
    public class TeamLeaderboardDto { public int Rank { get; set; } public string Name { get; set; } = ""; public string GroupName { get; set; } = ""; public int Score { get; set; } }
    
    private List<UserLeaderboardDto> topUsers = new();
    private List<TeamLeaderboardDto> topTeams = new();

    // Вкладка 2 (Админ)
    private List<UserGroup> groupsList = new();
    private List<UserTeam> teamsList = new();
    private List<ApplicationUser> usersList = new();
    private List<UserScenarioProgress> allProgressList = new();
    private bool showTeamModal = false;
    private ApplicationUser? selectedUserForTeams;
    private string newGroupName = "";
    private string newTeamName = "";
    private int selectedGroupIdForTeam;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");

        await LoadBaseData();
        await UpdateLeaderboards();
        isLoaded = true;
    }

    private async Task LoadBaseData()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        UserDisplayName = authState.User.Identity?.Name ?? "Оперативник";

        using var context = await ContextFactory.CreateDbContextAsync();
        if (!string.IsNullOrEmpty(userId))
        {
            user = await context.Set<ApplicationUser>()
                .Include(u => u.Group)
                .Include(u => u.Teams)
                .FirstOrDefaultAsync(u => u.Id == userId);
                
            activeScenario = await context.UserProgresses
                .Include(p => p.Scenario).ThenInclude(s => s.Questions)
                .FirstOrDefaultAsync(p => p.UserId == userId && p.Status == AttemptStatus.InProgress);
                
            if (activeScenario != null)
            {
                activeScenarioTotalQuestions = activeScenario.Scenario.Questions.Count;
                activeScenarioQuestionsSolved = await context.Set<UserAnswerProgress>()
                    .CountAsync(a => a.UserScenarioProgressId == activeScenario.Id);
            }
        }

        var allVisible = await context.Scenarios.Where(s => s.IsVisible || isAdmin).ToListAsync();
        totalScenarios = allVisible.Count;
        soloScenarios = allVisible.Count(s => s.Scope == VisibilityScope.Public || s.Scope == VisibilityScope.GroupOnly);
        teamScenarios = allVisible.Count(s => s.Scope == VisibilityScope.TeamOnly);

        completedScenariosList = await context.UserProgresses
            .Include(p => p.Scenario)
            .Where(p => p.UserId == userId && p.Status == AttemptStatus.Completed)
            .OrderByDescending(p => p.CompletedAt)
            .ToListAsync();
            
        completedCount = completedScenariosList.Count;
        totalUserScore = completedScenariosList.Sum(s => s.Score);

        if (user?.Teams.Any() == true)
        {
            var myTeamId = user.Teams.First().Id;
            var teamUsers = await context.Set<UserTeam>()
                .Where(t => t.Id == myTeamId)
                .SelectMany(t => t.Users)
                .ToListAsync();
                
            myTeamMembers.Clear();
            foreach(var tu in teamUsers)
            {
                var uScore = await context.UserProgresses.Where(p => p.UserId == tu.Id && p.Status == AttemptStatus.Completed).SumAsync(p => p.Score);
                myTeamMembers.Add(new TeamMemberDto { Id = tu.Id, Name = tu.UserName ?? "Агент", TotalScore = uScore });
            }
            myTeamMembers = myTeamMembers.OrderByDescending(m => m.TotalScore).ToList();
        }

        if (isAdmin)
        {
            groupsList = await context.UserGroups.ToListAsync();
            teamsList = await context.UserTeams.Include(t => t.Group).ToListAsync();
            usersList = await context.Set<ApplicationUser>().Include(u => u.Group).Include(u => u.Teams).ToListAsync();
            
            allProgressList = await context.UserProgresses
                .Include(p => p.Scenario)
                .OrderByDescending(p => p.StartedAt)
                .ToListAsync();
        }
        else
        {
            teamsList = await context.UserTeams.ToListAsync();
        }
    }

    private async Task UpdateLeaderboards()
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        
        int? myGroupId = user?.GroupId;
        bool filterByGroup = selectedFilter == "Мое подразделение" && myGroupId.HasValue;

        var usersQuery = context.Set<ApplicationUser>().Include(u => u.Group).AsQueryable();
        if (filterByGroup) usersQuery = usersQuery.Where(u => u.GroupId == myGroupId.Value);
        
        var allUsers = await usersQuery.ToListAsync();
        topUsers.Clear();
        foreach (var u in allUsers)
        {
            var score = await context.UserProgresses.Where(p => p.UserId == u.Id && p.Status == AttemptStatus.Completed && !p.IsTeamAttempt).SumAsync(p => p.Score);
            if (score > 0) topUsers.Add(new UserLeaderboardDto { Name = u.UserName ?? "Агент", GroupName = u.Group?.Name ?? "Без подразделения", Score = score });
        }
        topUsers = topUsers.OrderByDescending(u => u.Score).Select((u, index) => { u.Rank = index + 1; return u; }).Take(10).ToList();

        var teamsQuery = context.UserTeams.Include(t => t.Group).AsQueryable();
        if (filterByGroup) teamsQuery = teamsQuery.Where(t => t.GroupId == myGroupId.Value);
        
        var allTeams = await teamsQuery.ToListAsync();
        topTeams.Clear();
        foreach(var t in allTeams)
        {
            var score = await context.UserProgresses.Where(p => p.TeamId == t.Id && p.Status == AttemptStatus.Completed && p.IsTeamAttempt).SumAsync(p => p.Score);
            if (score > 0) topTeams.Add(new TeamLeaderboardDto { Name = t.Name, GroupName = t.Group?.Name ?? "", Score = score });
        }
        topTeams = topTeams.OrderByDescending(t => t.Score).Select((t, index) => { t.Rank = index + 1; return t; }).Take(10).ToList();
    }

    // === АДМИН МЕТОДЫ ===
    private void OpenTeamAssignmentModal(ApplicationUser targetUser) { selectedUserForTeams = targetUser; showTeamModal = true; }
    private void CloseTeamAssignmentModal() { showTeamModal = false; selectedUserForTeams = null; }

    private async Task ToggleTeamAssignment(string userId, int teamId, bool assign)
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        var dbUser = await context.Set<ApplicationUser>().Include(u => u.Teams).FirstOrDefaultAsync(u => u.Id == userId);
        var dbTeam = await context.UserTeams.FindAsync(teamId);

        if (dbUser != null && dbTeam != null)
        {
            if (assign && !dbUser.Teams.Any(t => t.Id == teamId)) dbUser.Teams.Add(dbTeam);
            else if (!assign) { var teamToRemove = dbUser.Teams.FirstOrDefault(t => t.Id == teamId); if (teamToRemove != null) dbUser.Teams.Remove(teamToRemove); }
            await context.SaveChangesAsync();
            await LoadBaseData();
            if (selectedUserForTeams != null && selectedUserForTeams.Id == userId) selectedUserForTeams = usersList.FirstOrDefault(u => u.Id == userId);
        }
    }

    private async Task CreateGroup() { if (string.IsNullOrWhiteSpace(newGroupName)) return; using var context = await ContextFactory.CreateDbContextAsync(); context.UserGroups.Add(new UserGroup { Name = newGroupName }); await context.SaveChangesAsync(); newGroupName = ""; await LoadBaseData(); }
    private async Task CreateTeam() { if (string.IsNullOrWhiteSpace(newTeamName) || selectedGroupIdForTeam <= 0) return; using var context = await ContextFactory.CreateDbContextAsync(); context.UserTeams.Add(new UserTeam { Name = newTeamName, GroupId = selectedGroupIdForTeam }); await context.SaveChangesAsync(); newTeamName = ""; await LoadBaseData(); }
    private async Task UpdateUserGroup(string userId, int? groupId) { using var context = await ContextFactory.CreateDbContextAsync(); var targetUser = await context.Set<ApplicationUser>().FindAsync(userId); if (targetUser != null) { targetUser.GroupId = groupId; await context.SaveChangesAsync(); } await LoadBaseData(); }

    private async Task DeleteGroup(int groupId)
    {
        var confirm = await DialogService.Confirm("Вы уверены, что хотите удалить подразделение? Это действие нельзя отменить.", "Удаление", new ConfirmOptions() { OkButtonText = "Удалить", CancelButtonText = "Отмена" });
        if (confirm == true)
        {
            using var context = await ContextFactory.CreateDbContextAsync();
            var group = await context.UserGroups.FindAsync(groupId);
            if (group != null) { context.UserGroups.Remove(group); await context.SaveChangesAsync(); await LoadBaseData(); NotificationService.Notify(NotificationSeverity.Success, "Удалено", "Подразделение удалено."); }
        }
    }

    private async Task DeleteTeam(int teamId)
    {
        var confirm = await DialogService.Confirm("Удалить команду?", "Удаление", new ConfirmOptions() { OkButtonText = "Удалить", CancelButtonText = "Отмена" });
        if (confirm == true)
        {
            using var context = await ContextFactory.CreateDbContextAsync();
            var team = await context.UserTeams.FindAsync(teamId);
            if (team != null) { context.UserTeams.Remove(team); await context.SaveChangesAsync(); await LoadBaseData(); NotificationService.Notify(NotificationSeverity.Success, "Удалено", "Команда удалена."); }
        }
    }

    // МЕТОД СБРОСА РЕЗУЛЬТАТОВ / СЕССИЙ
    private async Task ResetProgress(int progressId)
    {
        var confirm = await DialogService.Confirm("Вы действительно хотите полностью сбросить эту сессию? Все набранные очки будут аннулированы.", "Сброс прогресса", new ConfirmOptions() { OkButtonText = "Сбросить", CancelButtonText = "Отмена" });
        if (confirm == true)
        {
            using var context = await ContextFactory.CreateDbContextAsync();
            var progress = await context.UserProgresses.FindAsync(progressId);
            if (progress != null)
            {
                context.UserProgresses.Remove(progress);
                await context.SaveChangesAsync();
                NotificationService.Notify(NotificationSeverity.Warning, "Система", "Прогресс успешно сброшен.");
                await LoadBaseData();
                await UpdateLeaderboards();
            }
        }
    }

    public void Dispose() { }
}