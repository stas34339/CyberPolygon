@page "/admin/test/edit"
@page "/admin/test/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@using CyberPolygon.Services
@using System.IO
@attribute [Authorize]
@inject TestService TestService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject CatalogUpdateService CatalogUpdateService

@rendermode InteractiveServer

<PageTitle>@(Id.HasValue ? "Редактирование теста" : "Новый тест") | Киберполигон</PageTitle>

<style>
    /* Строгая киберпанк-тема */
    :root {
        --bg-main: #0b0f17;
        --bg-card: #131924;
        --bg-card-hover: #1a2435;
        --bg-input: #131924;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --warning-color: #e5c07b;
        --danger-color: #e06c75;
    }

    html, body {
        background-color: var(--bg-main) !important;
    }

    /* Обертка на всю ширину для однородного фона */
    .full-page-wrapper {
        background-color: var(--bg-main) !important;
        min-height: calc(100vh - 60px);
        width: 100%;
        padding: 30px 20px;
        box-sizing: border-box;
    }

    .page-container {
        color: var(--text-light);
        max-width: 1400px;
        margin: 0 auto;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 35px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
        gap: 20px;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

    .header-text h1 {
        color: var(--accent-cyan);
        font-weight: 800;
        text-transform: uppercase;
        margin: 0 0 8px 0;
        font-size: 1.8rem;
        letter-spacing: 2px;
        text-shadow: 0 0 15px rgba(78, 195, 209, 0.3);
    }

    .header-text p {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* === ОБОЛОЧКА (CYBER-SHELL) === */
    .cyber-shell {
        background-color: rgba(19, 25, 36, 0.6);
        border: 1px solid rgba(78, 195, 209, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(78, 195, 209, 0.05);
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .cyber-shell-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 25px;
        background: linear-gradient(90deg, rgba(78,195,209,0.1) 0%, transparent 100%);
        border-bottom: 1px solid rgba(78, 195, 209, 0.3);
        font-family: 'Courier New', Courier, monospace;
    }

    .shell-title {
        color: var(--accent-cyan);
        font-size: 0.95rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .shell-status {
        color: var(--text-muted);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    .status-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background-color: var(--accent-light-blue);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--accent-light-blue);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(126, 200, 248, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0);
        }
    }

    .cyber-shell-body {
        padding: 30px;
    }

    /* Внутренние карточки-секции */
    .cyber-section {
        background-color: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 25px;
        height: 100%;
    }

    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
        font-weight: 700;
    }

    /* === СТИЛИЗАЦИЯ ВКЛАДОК RADZEN === */
    .custom-tabs, .rz-tabview-panels, .rz-tabview-panel {
        overflow: visible !important;
        contain: none !important;
    }

        .custom-tabs .rz-tabview-nav {
            background: transparent !important;
            border-bottom: 2px solid var(--border-color) !important;
            margin-bottom: 25px;
            gap: 5px;
        }

            .custom-tabs .rz-tabview-nav li {
                background: transparent !important;
                border: 1px solid transparent !important;
                border-bottom: none !important;
                border-radius: 8px 8px 0 0 !important;
                transition: all 0.3s ease;
            }

                .custom-tabs .rz-tabview-nav li a {
                    color: var(--text-muted) !important;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    padding: 12px 20px !important;
                    border-bottom: 3px solid transparent !important;
                }

                .custom-tabs .rz-tabview-nav li:hover {
                    background-color: rgba(255, 255, 255, 0.03) !important;
                }

                /* АКТИВНАЯ ВКЛАДКА */
                .custom-tabs .rz-tabview-nav li.rz-tabview-selected {
                    background: linear-gradient(180deg, rgba(78, 195, 209, 0.15) 0%, rgba(19, 25, 36, 0) 100%) !important;
                    border: 1px solid rgba(78, 195, 209, 0.3) !important;
                    border-bottom: none !important;
                }

                    .custom-tabs .rz-tabview-nav li.rz-tabview-selected a {
                        border-bottom: 3px solid var(--accent-cyan) !important;
                    }

                        .custom-tabs .rz-tabview-nav li.rz-tabview-selected a span,
                        .custom-tabs .rz-tabview-nav li.rz-tabview-selected a i {
                            color: var(--accent-cyan) !important;
                            text-shadow: 0 0 10px rgba(78, 195, 209, 0.5) !important;
                        }

        .custom-tabs .rz-tabview-panels {
            background: transparent !important;
            border: none !important;
            padding: 0 !important;
        }

    /* Инпуты Radzen */
    .dark-input, .rz-textbox, .rz-textarea, .rz-dropdown, .rz-numeric {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
        transition: all 0.3s ease;
    }

        .rz-textbox:focus, .rz-textarea:focus, .rz-dropdown:focus, .rz-numeric:focus {
            border-color: var(--accent-cyan) !important;
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.2) !important;
        }

        .rz-textbox::placeholder, .rz-textarea::placeholder {
            color: #5b6b7a !important;
            font-style: normal;
        }

    .rz-dropdown-panel, .rz-popup {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--accent-cyan) !important;
        box-shadow: 0 10px 25px rgba(0,0,0,0.8) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
        padding: 10px 15px !important;
    }

        .rz-dropdown-item:hover {
            background-color: rgba(78, 195, 209, 0.15) !important;
            color: var(--accent-cyan) !important;
        }

    /* Radzen HTML Editor */
    .rz-html-editor {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 6px !important;
        overflow: hidden;
    }

        .rz-html-editor .rz-html-editor-toolbar {
            background-color: rgba(0,0,0,0.3) !important;
            border-bottom: 1px solid var(--border-color) !important;
        }

        .rz-html-editor .rz-html-editor-content {
            background-color: var(--bg-input) !important;
            color: var(--text-light) !important;
        }

    /* Кнопки */
    .btn-main {
        background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
        color: var(--bg-main);
        font-weight: 800;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-main:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(78, 195, 209, 0.4);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-outline-light:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-light);
            border-color: var(--text-muted);
        }

    .btn-delete-icon {
        background: transparent;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.3);
        border-radius: 6px;
        padding: 5px 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-delete-icon:hover {
            background: rgba(224, 108, 117, 0.1);
            border-color: var(--danger-color);
        }

    /* Заголовки (Задания) */
    .sticky-questions-header {
        position: sticky;
        top: 85px;
        z-index: 100;
        background: rgba(19, 25, 36, 0.95);
        backdrop-filter: blur(10px);
        padding: 15px 25px;
        border-radius: 8px;
        border: 1px solid var(--accent-cyan);
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

    .option-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        background: rgba(0,0,0,0.3);
        padding: 8px 12px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .option-correct-toggle .rz-chkbox-box {
        border-color: var(--border-color) !important;
        background-color: var(--bg-input) !important;
    }

    .option-correct-toggle.rz-state-active .rz-chkbox-box {
        background-color: var(--success-color) !important;
        border-color: var(--success-color) !important;
    }

    /* Добавление пользователей */
    .added-item-row {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--border-color);
        padding: 10px 15px;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
        transition: border-color 0.2s;
    }

        .added-item-row:hover {
            border-color: rgba(78, 195, 209, 0.4);
        }

    /* ЗОНА ЗАГРУЗКИ */
    .upload-zone {
        position: relative;
        border: 1px dashed var(--accent-cyan);
        border-radius: 8px;
        padding: 30px 20px;
        text-align: center;
        background: rgba(78, 195, 209, 0.03);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        overflow: hidden;
    }

        .upload-zone:hover {
            background: rgba(78, 195, 209, 0.1);
            box-shadow: inset 0 0 20px rgba(78, 195, 209, 0.1);
        }

    .upload-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 10;
    }

    .upload-icon {
        font-size: 3rem;
        color: var(--accent-cyan);
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    .upload-zone:hover .upload-icon {
        transform: translateY(-4px);
        filter: drop-shadow(0 0 10px rgba(78, 195, 209, 0.6));
    }
</style>

<div class="full-page-wrapper">
    <div class="page-container">
        <div class="page-header">
            <div class="header-text">
                <h1>@(Id.HasValue ? "Редактирование теста" : "Создание теста")</h1>
                <p>Информационно-аналитический департамент // Оценка компетенций</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn-main" @onclick="OnSave">
                    <RadzenIcon Icon="save" Style="font-size: 1.2rem;" /> Сохранить в БД
                </button>
                <button type="button" class="btn-outline-light" @onclick="Cancel">Отмена</button>
            </div>
        </div>

        <RadzenTemplateForm TItem="CyberTest" Data="@Item" Submit="@OnSave">

            <div class="cyber-shell">
                <div class="cyber-shell-header">
                    <div class="shell-title">
                        <RadzenIcon Icon="quiz" Style="font-size: 1.2rem;" />
                        SYS.ADMIN_TERMINAL // TEST_BUILDER
                    </div>
                    <div class="shell-status">
                        <span class="status-dot"></span>
                        ONLINE
                    </div>
                </div>

                <div class="cyber-shell-body">
                    <RadzenTabs @bind-SelectedIndex="@selectedTabIndex" class="w-100 custom-tabs">
                        <Tabs>
                            <!-- ТАБ 1: ОСНОВНОЕ -->
                            <RadzenTabsItem>
                                <Template Context="tab1">
                                    <span style="color: @(IsStep1Valid ? "var(--success-color)" : "var(--text-light)"); font-weight: @(IsStep1Valid ? "bold" : "normal");">
                                        <RadzenIcon Icon="@(IsStep1Valid ? "check_circle" : "info")" Style="vertical-align: middle; margin-right: 6px;" />1. Основное
                                    </span>
                                </Template>
                                <ChildContent>
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="cyber-section">
                                                <div class="mb-4">
                                                    <label class="cyber-label">Название теста</label>
                                                    <RadzenTextBox @bind-Value="@Item.Title" class="w-100 dark-input" Placeholder="Введите название..." />
                                                </div>
                                                <div class="mb-4">
                                                    <label class="cyber-label">Краткое описание</label>
                                                    <RadzenTextArea @bind-Value="@Item.ShortDescription" class="w-100 dark-input" Rows="2" Placeholder="Отображается на карточке..." />
                                                </div>
                                                <div class="mb-2">
                                                    <label class="cyber-label">Полное описание / Легенда</label>
                                                    <RadzenHtmlEditor @bind-Value="@Item.FullDescription" style="height: 350px;" class="dark-input" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="cyber-section">
                                                <h5 style="color: var(--accent-cyan); margin-bottom: 20px; font-weight: 800; text-transform: uppercase;">Метаданные</h5>
                                                <div class="mb-4">
                                                    <label class="cyber-label">Теги</label>
                                                    <RadzenTextBox @bind-Value="@Item.Tags" class="w-100 dark-input" Placeholder="theory, sec..." />
                                                </div>
                                                <div class="mb-4">
                                                    <label class="cyber-label">Сложность</label>
                                                    <RadzenDropDown @bind-Value="@Item.Difficulty" TValue="TestDifficulty" Data="@(Enum.GetValues(typeof(TestDifficulty)).Cast<TestDifficulty>())" class="w-100 dark-input">
                                                        <Template Context="diffContext">@(diffContext switch { TestDifficulty.Easy => "Легкий", TestDifficulty.Medium => "Средний", _ => "Сложный" })</Template>
                                                    </RadzenDropDown>
                                                </div>
                                                <div class="mb-2">
                                                    <label class="cyber-label">Лимит времени (минуты)</label>
                                                    <RadzenNumeric @bind-Value="@Item.DurationInMinutes" Min="0" class="w-100 dark-input" />
                                                    <small style="color: var(--warning-color); font-weight: 600; margin-top: 8px; display: block; font-size: 0.8rem; letter-spacing: 0.5px;">
                                                        <RadzenIcon Icon="info" Style="font-size: 0.9rem; vertical-align: middle; margin-top: -2px;" /> Оставьте 0 для прохождения без таймера
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </ChildContent>
                            </RadzenTabsItem>

                            <!-- ТАБ 2: ВОПРОСЫ -->
                            <RadzenTabsItem>
                                <Template Context="tab2">
                                    <span style="color: @(IsStep2Valid ? "var(--success-color)" : "var(--text-light)"); font-weight: @(IsStep2Valid ? "bold" : "normal");">
                                        <RadzenIcon Icon="@(IsStep2Valid ? "check_circle" : "quiz")" Style="vertical-align: middle; margin-right: 6px;" />2. Вопросы
                                    </span>
                                </Template>
                                <ChildContent>
                                    <div class="sticky-questions-header">
                                        <div style="font-weight: 800; font-size: 1rem; color: var(--accent-light-blue); text-transform: uppercase;">
                                            Вопросов в тесте: <span style="color: var(--accent-cyan);">@Item.Questions.Count</span>
                                        </div>
                                        <button type="button" class="btn-main" style="padding: 8px 16px; font-size: 0.8rem;" @onclick="AddQuestion">
                                            <RadzenIcon Icon="add" Style="font-size: 1rem;" /> Добавить вопрос
                                        </button>
                                    </div>

                                    @if (!Item.Questions.Any())
                                    {
                                        <div class="text-center p-5" style="color: var(--text-muted); border: 1px dashed var(--border-color); border-radius: 8px;">Список заданий пуст. Добавьте первый вопрос.</div>
                                    }

                                    @foreach (var q in Item.Questions)
                                    {
                                        var index = Item.Questions.IndexOf(q);
                                        <div class="cyber-section mb-4" @key="q">
                                            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2" style="border-color: rgba(255,255,255,0.05) !important;">
                                                <span style="color: var(--accent-cyan); font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">ВОПРОС №@(index + 1)</span>
                                                <button type="button" class="btn-delete-icon" style="padding: 2px 6px;" @onclick="@(() => Item.Questions.Remove(q))"><RadzenIcon Icon="close" /></button>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-9 mb-3">
                                                    <label class="cyber-label">Формулировка вопроса</label>
                                                    <RadzenTextArea @bind-Value="@q.Text" class="w-100 dark-input" Rows="2" />
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="cyber-label">Тип вопроса</label>
                                                    <RadzenDropDown @bind-Value="@q.Type" TValue="QuestionType" Data="@(Enum.GetValues(typeof(QuestionType)).Cast<QuestionType>())" class="w-100 dark-input">
                                                        <Template Context="typeContext">@(typeContext switch { QuestionType.ManualText => "Ввод текста", QuestionType.SingleChoice => "Один вариант", _ => "Несколько вариантов" })</Template>
                                                    </RadzenDropDown>
                                                </div>
                                            </div>

                                            <div class="mt-2" style="background: rgba(0,0,0,0.3); padding: 20px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                                                @if (q.Type == QuestionType.ManualText)
                                                {
                                                    <label class="cyber-label" style="color: var(--success-color) !important;">Эталонный ответ</label>
                                                    <RadzenTextBox @bind-Value="@q.CorrectTextAnswer" class="w-100 dark-input" Placeholder="Ожидаемый текст" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                                        <label class="cyber-label" style="margin: 0; color: var(--accent-light-blue) !important;">Варианты ответов</label>
                                                        <button type="button" class="btn-outline-light" style="padding: 4px 10px; font-size: 0.75rem;" @onclick="() => AddOption(q)">
                                                            <RadzenIcon Icon="add" Style="font-size: 0.9rem; margin-top: -2px;" /> Добавить вариант
                                                        </button>
                                                    </div>
                                                    @foreach (var opt in q.Options)
                                                    {
                                                        <div class="option-row">
                                                            <div title="Отметьте, если это правильный ответ">
                                                                <RadzenCheckBox @bind-Value="@opt.IsCorrect" class="option-correct-toggle" TValue="bool" />
                                                            </div>
                                                            <RadzenTextBox @bind-Value="@opt.Text" class="w-100 dark-input" Placeholder="Текст варианта..." />
                                                            <button type="button" class="btn-delete-icon text-danger" style="padding: 2px 6px;" @onclick="() => q.Options.Remove(opt)">
                                                                <RadzenIcon Icon="close" Style="font-size: 0.9rem;" />
                                                            </button>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </ChildContent>
                            </RadzenTabsItem>

                            <!-- ТАБ 3: ДОСТУП -->
                            <RadzenTabsItem>
                                <Template Context="tab3">
                                    <span style="color: @(IsStep3Valid ? "var(--success-color)" : "var(--text-light)"); font-weight: @(IsStep3Valid ? "bold" : "normal");">
                                        <RadzenIcon Icon="@(IsStep3Valid ? "check_circle" : "vpn_key")" Style="vertical-align: middle; margin-right: 6px;" />3. Доступ
                                    </span>
                                </Template>
                                <ChildContent>
                                    <div class="cyber-section">
                                        <div class="text-center mb-4">
                                            <RadzenIcon Icon="person" Style="font-size: 3rem; color: var(--accent-blue);" />
                                            <h4 class="mt-3 text-light" style="font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Доступ курсантов</h4>
                                            <p class="text-muted" style="font-size: 0.9rem;">Оставьте список пустым для общего доступа, либо укажите конкретных пользователей.</p>
                                        </div>
                                        <hr style="border-color: var(--border-color); margin-bottom: 25px;" />

                                        <label class="cyber-label">Добавление пользователей</label>
                                        <div class="d-flex gap-3 flex-wrap">
                                            <RadzenDropDown @bind-Value="@selectedUserIdToAdd" TValue="string" Data="@users" ValueProperty="Id" TextProperty="UserName" class="flex-grow-1 dark-input" Placeholder="Выберите пользователя..." AllowClear="true" />
                                            <button type="button" class="btn-outline-light" style="padding: 0 20px; font-size: 0.8rem;" @onclick="AddUserToList">
                                                <RadzenIcon Icon="add" /> Добавить
                                            </button>
                                            <button type="button" class="btn-outline-light" style="padding: 0 20px; font-size: 0.8rem; border-color: var(--accent-blue); color: var(--accent-blue);" @onclick="AddAllUsersToList">
                                                <RadzenIcon Icon="done_all" /> Всех
                                            </button>
                                        </div>

                                        <div class="mt-4">
                                            @foreach (var u in addedUsers)
                                            {
                                                <div class="added-item-row">
                                                    <span style="color: var(--text-light); font-weight: 600;">
                                                        <RadzenIcon Icon="account_circle" Style="vertical-align: middle; margin-right: 8px; color: var(--accent-blue);" /> @u.UserName
                                                    </span>
                                                    <button type="button" class="btn-delete-icon" style="padding: 2px 6px;" @onclick="() => RemoveUserFromList(u)">
                                                        <RadzenIcon Icon="close" Style="font-size: 0.9rem;" />
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </ChildContent>
                            </RadzenTabsItem>

                            <!-- ТАБ 4: МАТЕРИАЛЫ -->
                            <RadzenTabsItem>
                                <Template Context="tab4">
                                    <span style="color: @(IsStep4Valid ? "var(--success-color)" : "var(--text-light)"); font-weight: @(IsStep4Valid ? "bold" : "normal");">
                                        <RadzenIcon Icon="@(IsStep4Valid ? "check_circle" : "layers")" Style="vertical-align: middle; margin-right: 6px;" />4. Материалы
                                    </span>
                                </Template>
                                <ChildContent>
                                    <div class="cyber-section">
                                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--border-color) !important;">
                                            <label class="cyber-label" style="margin: 0;">Дополнительные документы для теста</label>
                                            <button type="button" class="btn-outline-light" style="padding: 8px 16px;" @onclick="AddDocumentSlot">
                                                <RadzenIcon Icon="add" Style="font-size: 1rem; margin-top: -2px;" /> Добавить слот файла
                                            </button>
                                        </div>

                                        @if (!Item.Documents.Any())
                                        {
                                            <div class="text-center p-4" style="border: 1px dashed var(--border-color); border-radius: 8px;">
                                                <RadzenIcon Icon="folder_open" Style="font-size: 3rem; color: var(--text-muted); margin-bottom: 10px; display: block;" />
                                                <span style="color: var(--text-light); opacity: 0.8;">Файлы к тесту не прикреплены. Нажмите "Добавить слот файла".</span>
                                            </div>
                                        }

                                        @foreach (var doc in Item.Documents)
                                        {
                                            <div class="p-4 mb-4 rounded" style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color);" @key="doc">
                                                <div class="d-flex gap-3 mb-4">
                                                    <RadzenTextBox @bind-Value="@doc.Title" Placeholder="Название документа" class="w-100 dark-input" />
                                                    <button type="button" class="btn-delete-icon" @onclick="@(() => Item.Documents.Remove(doc))"><RadzenIcon Icon="close" /></button>
                                                </div>

                                                <label class="upload-zone" style="border-color: @(string.IsNullOrEmpty(doc.FilePath) ? "var(--accent-cyan)" : "var(--success-color)")">
                                                    <InputFile OnChange="@(e => UploadDocumentToDb(e, doc))" class="upload-input" />
                                                    @if (!string.IsNullOrEmpty(doc.FilePath))
                                                    {
                                                        <RadzenIcon Icon="check_circle" Style="font-size: 2.5rem; color: var(--success-color);" />
                                                        <span style="color: var(--success-color); font-weight: bold; font-size: 1.1rem; text-transform: uppercase;">Файл загружен</span>
                                                    }
                                                    else
                                                    {
                                                        <RadzenIcon Icon="cloud_upload" class="upload-icon" />
                                                        <span style="color: var(--accent-light-blue); font-weight: 700; font-size: 1.05rem; text-transform: uppercase;">Выбрать файл для слота</span>
                                                        <small style="color: var(--text-muted); font-size: 0.8rem;">Макс. размер файла: 25 МБ</small>
                                                    }
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </ChildContent>
                            </RadzenTabsItem>

                            <!-- ТАБ 5: ГОТОВО -->
                            <RadzenTabsItem>
                                <Template Context="tab5">
                                    <span style="color: var(--text-light);">
                                        <RadzenIcon Icon="verified" Style="vertical-align: middle; margin-right: 6px;" />5. Сохранение
                                    </span>
                                </Template>
                                <ChildContent>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="cyber-section">
                                                <h4 style="color: var(--accent-light-blue); margin-bottom: 25px; font-weight: 800; text-transform: uppercase;">Краткий обзор конфигурации</h4>
                                                <ul class="list-unstyled" style="font-size: 1.05rem; line-height: 2.2;">
                                                    <li><strong style="color: var(--text-muted);">Название:</strong> <span style="color: var(--text-light);">@(string.IsNullOrWhiteSpace(Item.Title) ? "Не указано" : Item.Title)</span></li>
                                                    <li><strong style="color: var(--text-muted);">Вопросов:</strong> <span style="color: var(--accent-cyan); font-weight: bold;">@Item.Questions.Count шт.</span></li>
                                                    <li><strong style="color: var(--text-muted);">Доступ:</strong> <span style="color: var(--warning-color); font-weight: bold;">@(addedUsers.Any() ? "Ограниченный" : "Открытый")</span></li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="cyber-section text-center" style="padding: 40px 20px;">
                                                <h4 style="color: var(--text-light); margin-bottom: 30px; font-weight: 700; text-transform: uppercase;">Режим публикации</h4>
                                                <div class="d-flex justify-content-center gap-4 flex-wrap">
                                                    <button type="button" class="btn-outline-light" style="border-color: @(Item.IsVisible ? "var(--success-color)" : "var(--border-color)"); color: @(Item.IsVisible ? "var(--success-color)" : "var(--text-muted)");" @onclick="() => Item.IsVisible = true">
                                                        <RadzenIcon Icon="visibility" Style="margin-right: 5px;" /> ОТКРЫТЬ ДОСТУП
                                                    </button>
                                                    <button type="button" class="btn-outline-light" style="border-color: @(!Item.IsVisible ? "var(--warning-color)" : "var(--border-color)"); color: @(!Item.IsVisible ? "var(--warning-color)" : "var(--text-muted)");" @onclick="() => Item.IsVisible = false">
                                                        <RadzenIcon Icon="visibility_off" Style="margin-right: 5px;" /> В ЧЕРНОВИК
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </ChildContent>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                </div>
            </div>
        </RadzenTemplateForm>
    </div>
</div>