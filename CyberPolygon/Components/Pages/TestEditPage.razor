@page "/admin/test/edit"
@page "/admin/test/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@using CyberPolygon.Services
@using System.IO

@inject TestService TestService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject CatalogUpdateService CatalogUpdateService

@rendermode InteractiveServer

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-input: #131924;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --warning-color: #e5c07b;
        --danger-color: #e06c75;
    }

    .page-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-light);
        max-width: 1300px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: sticky;
        top: 0;
        background-color: var(--bg-main);
        z-index: 1050;
    }

    .custom-tabs, .rz-tabview-panels, .rz-tabview-panel {
        overflow: visible !important;
        contain: none !important;
    }

    .sticky-questions-header {
        position: sticky;
        top: 85px;
        z-index: 1000;
        background: rgba(26, 35, 50, 0.95);
        backdrop-filter: blur(10px);
        padding: 15px 25px;
        border-radius: 10px;
        border: 1px solid var(--accent-cyan);
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

    .rz-dropdown-panel {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
    }

        .rz-dropdown-item:hover {
            background-color: rgba(78, 195, 209, 0.15) !important;
            color: var(--accent-cyan) !important;
        }

    .dark-input, .rz-textbox, .rz-textarea, .rz-dropdown, .rz-numeric, .rz-html-editor {
        background-color: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
    }

    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
        display: block;
        font-weight: 600;
    }

    .cyber-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .custom-tabs .rz-tabview-nav {
        background: transparent !important;
        border-bottom: 2px solid var(--border-color) !important;
        margin-bottom: 25px;
    }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .btn-outline-light:hover {
            background: rgba(255,255,255,0.05);
        }

    .btn-delete-icon {
        background: transparent;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.3);
        border-radius: 6px;
        padding: 5px 10px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-delete-icon:hover {
            background: rgba(224, 108, 117, 0.15);
        }

    .upload-zone {
        position: relative;
        border: 2px dashed var(--accent-cyan);
        border-radius: 10px;
        padding: 30px 20px;
        text-align: center;
        background: rgba(78, 195, 209, 0.05);
        cursor: pointer;
    }

        .upload-zone:hover {
            background: rgba(78, 195, 209, 0.15);
            border-color: var(--accent-light-blue);
        }

        .upload-zone input[type=file] {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            opacity: 0;
            cursor: pointer;
        }

    .added-item-row {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        padding: 10px 15px;
        border-radius: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
    }

    .option-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        background: rgba(0,0,0,0.2);
        padding: 8px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .option-correct-toggle .rz-chkbox-box {
        border-color: var(--border-color) !important;
        background-color: var(--bg-input) !important;
    }

    .option-correct-toggle.rz-state-active .rz-chkbox-box {
        background-color: var(--success-color) !important;
        border-color: var(--success-color) !important;
    }
</style>

<div class="page-container">
    <div class="page-header">
        <h2 style="color: var(--accent-light-blue); margin: 0; font-weight: 700; text-transform: uppercase;">
            @(Id.HasValue ? "Редактирование теста" : "Создание теста")
        </h2>
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn-primary-gradient" style="background: linear-gradient(135deg, #98c379 0%, #5ba3e3 100%);" @onclick="OnSave">
                <RadzenIcon Icon="save" Style="font-size: 1.2rem;" /> Сохранить в БД
            </button>
            <button class="btn-outline-light" @onclick="Cancel">Отмена</button>
        </div>
    </div>

    <RadzenTemplateForm TItem="CyberTest" Data="@Item" Submit="@OnSave">
        <RadzenTabs @bind-SelectedIndex="@selectedTabIndex" class="w-100 custom-tabs">
            <Tabs>
                <RadzenTabsItem>
                    <Template Context="tab1"><span style="color: @(IsStep1Valid ? "var(--success-color)" : "var(--text-light)"); font-weight: @(IsStep1Valid ? "bold" : "normal");"><RadzenIcon Icon="@(IsStep1Valid ? "check_circle" : "info")" Style="vertical-align: middle; margin-right: 6px;" />1. Основное</span></Template>
                    <ChildContent>
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-4"><label class="cyber-label">Название теста</label><RadzenTextBox @bind-Value="@Item.Title" class="w-100 dark-input" Placeholder="Введите название..." /></div>
                                <div class="mb-4"><label class="cyber-label">Краткое описание</label><RadzenTextArea @bind-Value="@Item.ShortDescription" class="w-100 dark-input" Rows="2" Placeholder="Отображается на карточке..." /></div>
                                <div class="mb-4"><label class="cyber-label">Полное описание / Легенда</label><RadzenHtmlEditor @bind-Value="@Item.FullDescription" style="height: 300px;" class="dark-input" /></div>
                            </div>
                            <div class="col-md-4">
                                <div class="cyber-card">
                                    <h5 style="color: var(--accent-cyan); margin-bottom: 20px;">Метаданные</h5>
                                    <div class="mb-4"><label class="cyber-label">Теги</label><RadzenTextBox @bind-Value="@Item.Tags" class="w-100 dark-input" Placeholder="theory, sec..." /></div>
                                    <div class="mb-4">
                                        <label class="cyber-label">Сложность</label>
                                        <RadzenDropDown @bind-Value="@Item.Difficulty" TValue="TestDifficulty" Data="@(Enum.GetValues(typeof(TestDifficulty)).Cast<TestDifficulty>())" class="w-100 dark-input">
                                            <Template Context="diffContext">@(diffContext switch { TestDifficulty.Easy => "Легкий", TestDifficulty.Medium => "Средний", _ => "Сложный" })</Template>
                                        </RadzenDropDown>
                                    </div>
                                    <div class="mb-4"><label class="cyber-label">Время на тест (мин)</label><RadzenNumeric @bind-Value="@Item.DurationInMinutes" Min="0" class="w-100 dark-input" /><small class="text-muted">0 — без лимита</small></div>
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </RadzenTabsItem>

                <RadzenTabsItem>
                    <Template Context="tab2"><span style="color: @(IsStep2Valid ? "var(--success-color)" : "var(--text-light)"); font-weight: @(IsStep2Valid ? "bold" : "normal");"><RadzenIcon Icon="@(IsStep2Valid ? "check_circle" : "quiz")" Style="vertical-align: middle; margin-right: 6px;" />2. Вопросы</span></Template>
                    <ChildContent>
                        <div class="sticky-questions-header">
                            <div style="font-weight: bold; color: var(--text-light);">Вопросов в тесте: <span style="color: var(--accent-cyan);">@Item.Questions.Count</span></div>
                            <button type="button" class="btn-primary-gradient" @onclick="AddQuestion"><RadzenIcon Icon="add" Style="font-size: 1.2rem; margin-top: -2px;" /> Добавить вопрос</button>
                        </div>
                        @if (!Item.Questions.Any())
                        {
                            <div class="text-center p-5 text-muted">Нет вопросов.</div>
                        }
                        @foreach (var q in Item.Questions)
                        {
                            var index = Item.Questions.IndexOf(q);
                            <div class="cyber-card mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span style="color: var(--accent-cyan); font-weight: bold; font-size: 1.1rem;">ВОПРОС №@(index + 1)</span>
                                    <button type="button" class="btn-delete-icon" @onclick="@(() => Item.Questions.Remove(q))"><RadzenIcon Icon="delete" /></button>
                                </div>
                                <div class="row">
                                    <div class="col-md-9 mb-3"><label class="cyber-label">Формулировка вопроса</label><RadzenTextArea @bind-Value="@q.Text" class="w-100 dark-input" Rows="2" /></div>
                                    <div class="col-md-3 mb-3">
                                        <label class="cyber-label">Тип вопроса</label>
                                        <RadzenDropDown @bind-Value="@q.Type" TValue="QuestionType" Data="@(Enum.GetValues(typeof(QuestionType)).Cast<QuestionType>())" class="w-100 dark-input">
                                            <Template Context="typeContext">@(typeContext switch { QuestionType.ManualText => "Ввод текста", QuestionType.SingleChoice => "Один вариант", _ => "Несколько вариантов" })</Template>
                                        </RadzenDropDown>
                                    </div>
                                </div>
                                <div class="mt-2" style="background: rgba(0,0,0,0.2); padding: 15px; border-radius: 8px; border: 1px dashed var(--border-color);">
                                    @if (q.Type == QuestionType.ManualText)
                                    {
                                        <label class="cyber-label" style="color: var(--success-color) !important;">Эталонный ответ</label>
                                        <RadzenTextBox @bind-Value="@q.CorrectTextAnswer" class="w-100 dark-input" Placeholder="Ожидаемый текст" />
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label class="cyber-label" style="margin: 0; color: var(--accent-light-blue) !important;">Варианты ответов</label>
                                            <button type="button" class="btn-outline-light" style="padding: 4px 10px; font-size: 0.8rem;" @onclick="() => AddOption(q)"><RadzenIcon Icon="add" Style="font-size: 1rem; margin-top: -2px;" /> Добавить вариант</button>
                                        </div>
                                        @foreach (var opt in q.Options)
                                        {
                                            <div class="option-row">
                                                <div title="Правильный ответ?"><RadzenCheckBox @bind-Value="@opt.IsCorrect" class="option-correct-toggle" TValue="bool" /></div>
                                                <RadzenTextBox @bind-Value="@opt.Text" class="w-100 dark-input" Placeholder="Текст варианта..." />
                                                <button type="button" class="btn-delete-icon" style="padding: 2px 5px;" @onclick="() => q.Options.Remove(opt)"><RadzenIcon Icon="close" Style="font-size: 0.9rem;" /></button>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </ChildContent>
                </RadzenTabsItem>

                <RadzenTabsItem>
                    <Template Context="tab3"><span style="color: @(IsStep3Valid ? "var(--success-color)" : "var(--text-light)"); font-weight: @(IsStep3Valid ? "bold" : "normal");"><RadzenIcon Icon="@(IsStep3Valid ? "check_circle" : "vpn_key")" Style="vertical-align: middle; margin-right: 6px;" />3. Доступ</span></Template>
                    <ChildContent>
                        <div class="cyber-card">
                            <div class="text-center mb-4">
                                <RadzenIcon Icon="person" Style="font-size: 3rem; color: var(--accent-blue);" />
                                <h4 class="mt-3 text-light">Индивидуальное тестирование</h4>
                                <p class="text-muted" style="font-size: 0.9rem;">Оставьте список пустым для доступа всем, либо добавьте конкретных пользователей.</p>
                            </div>
                            <hr style="border-color: var(--border-color);" />
                            <label class="cyber-label">Добавление пользователей</label>
                            <div class="d-flex gap-2">
                                <RadzenDropDown @bind-Value="@selectedUserIdToAdd" TValue="string" Data="@users" ValueProperty="Id" TextProperty="UserName" class="w-100 dark-input" Placeholder="Выберите пользователя..." AllowClear="true" />
                                <button type="button" class="btn-outline-light" style="padding: 0 15px;" @onclick="AddUserToList"><RadzenIcon Icon="add" /> Добавить</button>
                                <button type="button" class="btn-outline-light" style="padding: 0 15px; border-color: var(--accent-blue); color: var(--accent-blue);" @onclick="AddAllUsersToList"><RadzenIcon Icon="done_all" /> Всех</button>
                            </div>
                            <div class="mt-3">
                                @foreach (var u in addedUsers)
                                {
                                    <div class="added-item-row">
                                        <span style="color: var(--text-light);"><RadzenIcon Icon="account_circle" Style="vertical-align: middle; margin-right: 8px; color: var(--accent-blue);" /> @u.UserName</span>
                                        <button type="button" class="btn-delete-icon" @onclick="() => RemoveUserFromList(u)"><RadzenIcon Icon="close" Style="font-size: 1rem;" /></button>
                                    </div>
                                }
                            </div>
                        </div>
                    </ChildContent>
                </RadzenTabsItem>

                <RadzenTabsItem>
                    <Template Context="tab4"><span style="color: @(IsStep4Valid ? "var(--success-color)" : "var(--text-light)"); font-weight: @(IsStep4Valid ? "bold" : "normal");"><RadzenIcon Icon="@(IsStep4Valid ? "check_circle" : "layers")" Style="vertical-align: middle; margin-right: 6px;" />4. Материалы</span></Template>
                    <ChildContent>
                        <div class="cyber-card">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="cyber-label">Документы и методички</label>
                                <button type="button" class="btn-outline-light" style="padding: 4px 10px; font-size: 0.8rem; border-color: var(--accent-blue); color: var(--accent-blue);" @onclick="AddDocumentSlot"><RadzenIcon Icon="add" Style="font-size: 1rem; margin-top: -2px;" /> Добавить файл</button>
                            </div>
                            @if (!Item.Documents.Any())
                            {
                                <p class="text-muted text-center mt-4">Файлы не прикреплены.</p>
                            }
                            @foreach (var doc in Item.Documents)
                            {
                                <div class="p-3 mb-2 rounded" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color);">
                                    <div class="d-flex gap-2 mb-2"><RadzenTextBox @bind-Value="@doc.Title" Placeholder="Название документа" class="w-100 dark-input" /><button type="button" class="btn-delete-icon" @onclick="@(() => Item.Documents.Remove(doc))"><RadzenIcon Icon="close" /></button></div>
                                    <div class="upload-zone" style="padding: 15px;">
                                        <InputFile OnChange="@(e => UploadDocumentToDb(e, doc))" />
                                        @if (!string.IsNullOrEmpty(doc.FilePath))
                                        {
                                            <span style="color: var(--success-color); font-weight: bold;">Файл загружен</span>
                                        }
                                        else
                                        {

                                            <span style="color: var(--text-light); font-weight: 500;">Кликните для выбора файла</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </ChildContent>
                </RadzenTabsItem>

                <RadzenTabsItem>
                    <Template Context="tab5"><span style="color: var(--text-light);"><RadzenIcon Icon="verified" Style="vertical-align: middle; margin-right: 6px;" />5. Сохранение</span></Template>
                    <ChildContent>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="cyber-card">
                                    <h4 style="color: var(--accent-light-blue); margin-bottom: 20px;">Краткий обзор конфигурации</h4>
                                    <ul class="list-unstyled" style="font-size: 1.05rem; line-height: 2;">
                                        <li><strong style="color: var(--accent-cyan);">Название:</strong> @(string.IsNullOrWhiteSpace(Item.Title) ? "Не указано" : Item.Title)</li>
                                        <li><strong style="color: var(--accent-cyan);">Вопросов:</strong> @Item.Questions.Count шт.</li>
                                        <li><strong style="color: var(--accent-cyan);">Доступ:</strong> @(addedUsers.Any() ? "Ограниченный" : "Открытый")</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="cyber-card text-center" style="padding: 40px 20px;">
                                    <h4 style="color: var(--accent-cyan); margin-bottom: 25px;">Режим публикации</h4>
                                    <div class="d-flex justify-content-center gap-3 mb-4 flex-wrap">
                                        <button type="button" class="btn-outline-light" style="padding: 15px 30px; border-color: @(Item.IsVisible ? "var(--success-color)" : "var(--border-color)"); background: @(Item.IsVisible ? "rgba(152,195,121,0.1)" : "transparent");" @onclick="() => Item.IsVisible = true"><RadzenIcon Icon="visibility" Style="vertical-align: middle; margin-right: 8px;" /> ОТКРЫТЬ ДОСТУП</button>
                                        <button type="button" class="btn-outline-light" style="padding: 15px 30px; border-color: @(!Item.IsVisible ? "var(--warning-color)" : "var(--border-color)"); background: @(!Item.IsVisible ? "rgba(229,192,123,0.1)" : "transparent");" @onclick="() => Item.IsVisible = false"><RadzenIcon Icon="visibility_off" Style="vertical-align: middle; margin-right: 8px;" /> В ЧЕРНОВИК</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </RadzenTemplateForm>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private CyberTest Item { get; set; } = new();
    private List<ApplicationUser> users = new();
    private string? selectedUserIdToAdd;
    private List<ApplicationUser> addedUsers = new();
    private int selectedTabIndex = 0;

    private bool IsStep1Valid => !string.IsNullOrWhiteSpace(Item.Title);
    private bool IsStep2Valid => Item.Questions.Any() && Item.Questions.All(q => !string.IsNullOrWhiteSpace(q.Text) && (q.Type == QuestionType.ManualText ? !string.IsNullOrWhiteSpace(q.CorrectTextAnswer) : q.Options.Any()));
    private bool IsStep3Valid => true;
    private bool IsStep4Valid => true;

    protected override async Task OnInitializedAsync()
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        users = await context.Set<ApplicationUser>().AsNoTracking().ToListAsync();

        if (Id.HasValue)
        {
            Item = await context.Set<CyberTest>().Include(t => t.Questions).ThenInclude(q => q.Options).Include(t => t.Documents).FirstOrDefaultAsync(t => t.Id == Id.Value) ?? new CyberTest();
            if (!string.IsNullOrEmpty(Item.AllowedUserIds))
            {
                var userIds = Item.AllowedUserIds.Split(',', StringSplitOptions.RemoveEmptyEntries);
                addedUsers = users.Where(u => userIds.Contains(u.Id)).ToList();
            }
        }
        else
        {
            Item = new CyberTest { Questions = new(), Documents = new(), IsVisible = false, Scope = VisibilityScope.Public, Difficulty = TestDifficulty.Easy };
        }
    }

    private void AddUserToList() { if (!string.IsNullOrEmpty(selectedUserIdToAdd) && !addedUsers.Any(u => u.Id == selectedUserIdToAdd)) { var u = users.FirstOrDefault(x => x.Id == selectedUserIdToAdd); if (u != null) addedUsers.Add(u); } selectedUserIdToAdd = null; }
    private void AddAllUsersToList() { var missing = users.Where(u => !addedUsers.Any(au => au.Id == u.Id)).ToList(); if (missing.Any()) addedUsers.AddRange(missing); }
    private void RemoveUserFromList(ApplicationUser user) => addedUsers.Remove(user);
    private void AddQuestion() => Item.Questions.Add(new TestQuestion { Type = QuestionType.ManualText, Options = new() });
    private void AddOption(TestQuestion q) => q.Options.Add(new TestOption());
    private void AddDocumentSlot() => Item.Documents.Add(new TestDocument());

    private async Task UploadDocumentToDb(InputFileChangeEventArgs e, TestDocument doc)
    {
        try { using var ms = new MemoryStream(); await e.File.OpenReadStream(1024 * 1024 * 25).CopyToAsync(ms); doc.FilePath = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}"; if (string.IsNullOrWhiteSpace(doc.Title)) doc.Title = e.File.Name; }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Ошибка документа", ex.Message); }
    }

    private async Task OnSave()
    {
        Item.AllowedTeamIds = null;
        Item.AllowedUserIds = addedUsers.Any() ? string.Join(",", addedUsers.Select(u => u.Id)) : null;
        Item.Scope = string.IsNullOrEmpty(Item.AllowedUserIds) ? VisibilityScope.Public : VisibilityScope.GroupOnly;

        if (!IsStep1Valid) { NotificationService.Notify(NotificationSeverity.Warning, "Ошибка", "Заполните название на 1-й вкладке."); selectedTabIndex = 0; return; }
        if (!IsStep2Valid) { NotificationService.Notify(NotificationSeverity.Warning, "Ошибка", "Добавьте вопросы и заполните к ним ответы."); selectedTabIndex = 1; return; }

        using var context = await ContextFactory.CreateDbContextAsync();
        if (Item.Id == 0) context.Set<CyberTest>().Add(Item); else context.Set<CyberTest>().Update(Item);
        await context.SaveChangesAsync();

        // СИГНАЛ: Сообщаем каталогу, что нужно обновиться!
        CatalogUpdateService.NotifyCatalogChanged();

        NotificationService.Notify(NotificationSeverity.Success, "Успех", "Тест сохранен!");
        NavigationManager.NavigateTo("tests");
    }

    private void Cancel() => NavigationManager.NavigateTo("tests");
}