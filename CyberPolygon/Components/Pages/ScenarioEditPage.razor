@page "/scenario/edit"
@page "/scenario/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@using CyberPolygon.Services
@using System.IO
@using CyberPolygon.Models
@inject ScenarioService ScenarioService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject CatalogUpdateService CatalogUpdateService

@rendermode InteractiveServer

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --bg-input: #131924;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-blue: #5ba3e3;
        --accent-cyan: #4ec3d1;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --warning-color: #e5c07b;
        --danger-color: #e06c75;
    }

    .page-container {
        background-color: var(--bg-main);
        min-height: calc(100vh - 60px);
        color: var(--text-light);
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: sticky;
        top: 0;
        background-color: var(--bg-main);
        z-index: 1050;
    }

    .custom-tabs, .rz-tabview-panels, .rz-tabview-panel {
        overflow: visible !important;
        contain: none !important;
    }

    .sticky-questions-header {
        position: sticky;
        top: 85px;
        z-index: 1000;
        background: rgba(26, 35, 50, 0.95);
        backdrop-filter: blur(10px);
        padding: 15px 25px;
        border-radius: 10px;
        border: 1px solid var(--accent-cyan);
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

    .rz-dropdown-panel, .rz-popup {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
    }

        .rz-dropdown-item:hover {
            background-color: rgba(78, 195, 209, 0.15) !important;
            color: var(--accent-cyan) !important;
        }

    .dark-input, .rz-textbox, .rz-textarea, .rz-dropdown, .rz-numeric, .rz-html-editor {
        background-color: var(--bg-input) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
    }

        /* СВЕТЛЫЕ ПЛЕЙСХОЛДЕРЫ ДЛЯ ВСЕХ ПОЛЕЙ */
        .dark-input::placeholder, .rz-textbox::placeholder, .rz-textarea::placeholder {
            color: #8fa0b5 !important;
            opacity: 0.9 !important;
            font-style: italic;
        }

    ::-webkit-input-placeholder {
        color: #8fa0b5 !important;
        opacity: 0.9 !important;
        font-style: italic;
    }

    ::-moz-placeholder {
        color: #8fa0b5 !important;
        opacity: 0.9 !important;
        font-style: italic;
    }

    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
        display: block;
        font-weight: 600;
    }

    .cyber-card {
        background: linear-gradient(135deg, #1a2332 0%, #1e2d3d 100%);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        transition: border-color 0.3s;
    }

    .custom-tabs .rz-tabview-nav {
        background: transparent !important;
        border-bottom: 2px solid var(--border-color) !important;
        margin-bottom: 25px;
    }

    .btn-primary-gradient {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary-gradient:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 25px rgba(78, 195, 209, 0.4);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-color);
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .btn-outline-light:hover {
            background: rgba(255,255,255,0.05);
        }

    .btn-delete-icon {
        background: transparent;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.3);
        border-radius: 6px;
        padding: 5px 10px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-delete-icon:hover {
            background: rgba(224, 108, 117, 0.15);
        }

    .scroll-list-panel {
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        height: 300px;
        overflow-y: auto;
        padding: 8px;
    }

        .scroll-list-panel.selected {
            border-color: rgba(152, 195, 121, 0.3);
            background: rgba(0, 0, 0, 0.2);
        }

    .list-item-inline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        padding: 6px 10px;
        border-radius: 6px;
        margin-bottom: 6px;
        gap: 8px;
        transition: 0.2s;
    }

        .list-item-inline:hover {
            background: rgba(78, 195, 209, 0.05);
            border-color: rgba(78, 195, 209, 0.4);
        }

        .list-item-inline.active-item {
            border-color: rgba(152, 195, 121, 0.4);
            background: rgba(152, 195, 121, 0.05);
        }

        .list-item-inline .item-text {
            font-size: 0.85rem;
            color: var(--text-light);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex-grow: 1;
        }

    .btn-item-action {
        background: transparent;
        border-radius: 4px;
        padding: 2px;
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }

        .btn-item-action.add {
            color: var(--accent-cyan);
            border: 1px solid rgba(78, 195, 209, 0.3);
        }

            .btn-item-action.add:hover {
                background: rgba(78, 195, 209, 0.2);
                border-color: var(--accent-cyan);
            }

        .btn-item-action.remove {
            color: var(--danger-color);
            border: 1px solid rgba(224, 108, 117, 0.3);
        }

            .btn-item-action.remove:hover {
                background: rgba(224, 108, 117, 0.2);
                border-color: var(--danger-color);
            }

    /* ЗОНА ЗАГРУЗКИ */
    .upload-zone {
        position: relative;
        border: 2px dashed var(--accent-cyan);
        border-radius: 8px;
        padding: 25px 20px;
        text-align: center;
        background: rgba(78, 195, 209, 0.05);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        overflow: hidden;
    }

        .upload-zone:hover {
            background: rgba(78, 195, 209, 0.15);
            border-color: var(--accent-light-blue);
            box-shadow: 0 4px 15px rgba(78, 195, 209, 0.2);
        }

        .upload-zone input[type=file] {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            opacity: 0;
            cursor: pointer;
            z-index: 2;
        }

    .upload-icon {
        font-size: 2.5rem;
        color: var(--accent-cyan);
        transition: transform 0.3s ease, color 0.3s ease;
    }

    .upload-zone:hover .upload-icon {
        transform: translateY(-4px);
        color: var(--accent-light-blue);
    }

    /* ХОЛСТ КОНСТРУКТОРА */
    .canvas-container {
        width: 100%;
        height: 600px;
        background-color: #131924;
        background-image: radial-gradient(rgba(78, 195, 209, 0.15) 1px, transparent 1px);
        background-size: 25px 25px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        position: relative;
        overflow: hidden;
        cursor: crosshair;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
    }

    .canvas-device {
        position: absolute;
        width: 44px;
        height: 44px;
        margin-left: -22px;
        margin-top: -22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.6);
        border: 2px solid var(--accent-cyan);
        background: #1a2332;
        cursor: pointer;
        transition: transform 0.15s;
        z-index: 10;
    }

        .canvas-device:hover {
            transform: scale(1.15);
            z-index: 100;
        }

        .canvas-device.selected-dev {
            border-color: var(--success-color);
            box-shadow: 0 0 15px var(--success-color);
            background: #131924;
        }

        .canvas-device i {
            font-size: 1.3rem;
            color: var(--text-light);
        }

        .canvas-device.selected-dev i {
            color: var(--success-color);
        }

    .device-caption {
        position: absolute;
        top: 48px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(19, 25, 36, 0.9);
        color: #fff;
        font-size: 0.75rem;
        padding: 2px 8px;
        border-radius: 4px;
        white-space: nowrap;
        border: 1px solid var(--border-color);
        pointer-events: none;
    }
</style>

<RadzenComponents />

<div class="page-container">
    <div class="page-header">
        <h2 style="color: var(--accent-light-blue); margin: 0; font-weight: 700; text-transform: uppercase;">
            @(Id.HasValue ? "Редактирование сценария" : "Создание сценария")
        </h2>
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn-primary-gradient" @onclick="OnSave">
                <RadzenIcon Icon="save" Style="font-size: 1.2rem;" /> Сохранить в БД
            </button>
            <button type="button" class="btn-outline-light" @onclick="Cancel">Отмена</button>
        </div>
    </div>

    <RadzenTemplateForm TItem="CyberScenario" Data="@Item" Submit="@OnSave">
        <RadzenTabs @bind-SelectedIndex="@selectedTabIndex" class="w-100 custom-tabs">
            <Tabs>
                <RadzenTabsItem>
                    <Template Context="tabContext1"><span style="color: @(IsStep1Valid ? "var(--success-color)" : "var(--text-light)");"><RadzenIcon Icon="@(IsStep1Valid ? "check_circle" : "info")" Style="vertical-align: middle; margin-right: 6px;" /> 1. Основное</span></Template>
                    <ChildContent>
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-4">
                                    <label class="cyber-label">Название сценария</label>
                                    <RadzenTextBox @bind-Value="@Item.Title" class="w-100 rz-textbox" Placeholder="Например: Взлом корпоративного домена..." />
                                </div>
                                <div class="mb-4">
                                    <label class="cyber-label">Краткое описание (для превью)</label>
                                    <RadzenTextArea @bind-Value="@Item.Description" class="w-100 rz-textarea" Rows="3" Placeholder="В этом сценарии курсантам предстоит проанализировать логи..." />
                                </div>
                                <div class="mb-4">
                                    <label class="cyber-label">Подробная легенда и вводная информация</label>
                                    <RadzenHtmlEditor @bind-Value="@Item.Legend" style="height: 350px;" class="rz-html-editor" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="cyber-card">
                                    <h5 style="color: var(--accent-cyan); margin-bottom: 20px;">Метаданные</h5>
                                    <div class="mb-4">
                                        <label class="cyber-label">Теги (через запятую)</label>
                                        <RadzenTextBox @bind-Value="@Item.Tags" class="w-100 rz-textbox" Placeholder="linux, active-directory, nmap..." />
                                    </div>
                                    <div class="mb-4">
                                        <label class="cyber-label">Уровень сложности</label>
                                        <RadzenDropDown @bind-Value="@Item.Difficulty" TValue="string" Data="@difficulties" class="w-100 rz-dropdown" />
                                    </div>
                                    <div class="mb-4">
                                        <label class="cyber-label">Лимит времени (минуты)</label>
                                        <RadzenNumeric @bind-Value="@Item.DurationInMinutes" Min="0" class="w-100 rz-numeric" />
                                        <small class="text-muted" style="color: var(--text-light) !important; opacity: 0.8;">Оставьте 0 для прохождения без таймера</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </RadzenTabsItem>

                <RadzenTabsItem>
                    <Template Context="tabContext2"><span style="color: @(IsStep2Valid ? "var(--success-color)" : "var(--text-light)");"><RadzenIcon Icon="@(IsStep2Valid ? "check_circle" : "quiz")" Style="vertical-align: middle; margin-right: 6px;" /> 2. Задания</span></Template>
                    <ChildContent>
                        <div class="sticky-questions-header">
                            <div style="width: 50%;">
                                <label class="cyber-label">Формат выдачи заданий</label>
                                <RadzenDropDown @bind-Value="@Item.GameMode" TValue="ScenarioGameMode" Data="@(Enum.GetValues(typeof(ScenarioGameMode)))" class="w-100 rz-dropdown">
                                    <Template Context="modeContext">
                                        @((ScenarioGameMode)modeContext == ScenarioGameMode.AllAtOnce ? "Доступны все задания сразу" : "Открывать строго по очереди")
                                    </Template>
                                </RadzenDropDown>
                            </div>
                            <button type="button" class="btn-primary-gradient" @onclick="AddQuestion">
                                <RadzenIcon Icon="add" Style="font-size: 1.2rem; margin-top: -2px;" /> <span>Новый флаг</span>
                            </button>
                        </div>
                        @if (!Item.Questions.Any())
                        {
                            <div class="text-center p-5" style="color: var(--text-light); opacity: 0.8;">Список заданий пуст. Добавьте первый вопрос.</div>
                        }
                        @for (int i = 0; i < Item.Questions.Count; i++)
                        {
                            var q = Item.Questions[i];
                            <div class="cyber-card mb-3" @key="q">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span style="color: var(--accent-cyan); font-weight: bold;">ЗАДАНИЕ №@(i + 1)</span>
                                    <button type="button" class="btn-delete-icon" @onclick="@(() => Item.Questions.Remove(q))"><RadzenIcon Icon="delete" /></button>
                                </div>
                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <label class="cyber-label">Формулировка задачи</label>
                                        <RadzenTextBox @bind-Value="@q.Text" class="w-100 rz-textbox" Placeholder="Найдите скрытый порт на сервере..." />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="cyber-label" style="color: var(--success-color) !important;">Эталонный ответ (Сам Флаг)</label>
                                        <RadzenTextBox @bind-Value="@q.CorrectAnswer" class="w-100 rz-textbox" Placeholder="8080" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="cyber-label" style="color: var(--accent-blue) !important;">Пример ответа (Подсказка формата)</label>
                                        <RadzenTextBox @bind-Value="@q.ExampleAnswer" class="w-100 rz-textbox" Placeholder="Например: flag{...} или IP-адрес" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="cyber-label">Награда за успех (+ XP)</label>
                                        <RadzenNumeric @bind-Value="@q.AwardPoints" Min="1" class="w-100 rz-numeric" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="cyber-label">Штраф за неверную попытку (- XP)</label>
                                        <RadzenNumeric @bind-Value="@q.PenaltyPoints" Min="0" class="w-100 rz-numeric" />
                                    </div>
                                </div>
                            </div>
                        }
                    </ChildContent>
                </RadzenTabsItem>

                <RadzenTabsItem>
                    <Template Context="tabContext3"><span style="color: var(--text-light);"><RadzenIcon Icon="vpn_key" Style="vertical-align: middle; margin-right: 6px;" /> 3. Доступ</span></Template>
                    <ChildContent>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="cyber-card" style="cursor: pointer; border-color: @(!isIndividual ? "var(--success-color)" : "var(--border-color)")" @onclick="SetTeamMode">
                                    <div class="text-center"><RadzenIcon Icon="groups" Style="font-size: 3rem; color: var(--warning-color);" /><h4 class="mt-3 text-light">Командный режим</h4></div>
                                    @if (!isIndividual)
                                    {
                                        <div class="row mt-3" @onclick:stopPropagation="true">
                                            <div class="col-6"><div class="scroll-list-panel">@foreach (var x in teams.Where(t => !addedTeams.Any(at => at.Id == t.Id))){
                                                <div class="list-item-inline"><span>👥 @x.Name</span><button type="button" class="btn-item-action add" @onclick="() => addedTeams.Add(x)"><RadzenIcon Icon="add" /></button></div>
                                            }
                                        </div></div>
                                        <div class="col-6"><div class="scroll-list-panel selected">@foreach (var t in addedTeams.ToList()){
                                            <div class="list-item-inline"><span>👥 @t.Name</span><button type="button" class="btn-item-action remove" @onclick="() => addedTeams.Remove(t)"><RadzenIcon Icon="remove" /></button></div>
                                        }
                                    </div></div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="cyber-card" style="cursor: pointer; border-color: @(isIndividual ? "var(--success-color)" : "var(--border-color)")" @onclick="SetIndividualMode">
                            <div class="text-center"><RadzenIcon Icon="person" Style="font-size: 3rem; color: var(--accent-blue);" /><h4 class="mt-3 text-light">Одиночный режим</h4></div>
                            @if (isIndividual)
                            {
                                <div class="row mt-3" @onclick:stopPropagation="true">
                                    <div class="col-6"><div class="scroll-list-panel">@foreach (var x in users.Where(u => !addedUsers.Any(au => au.Id == u.Id))){
                                        <div class="list-item-inline"><span>👤 @GetUserDisplayName(x)</span><button type="button" class="btn-item-action add" @onclick="() => addedUsers.Add(x)"><RadzenIcon Icon="add" /></button></div>
                                    }
                                </div></div>
                                <div class="col-6"><div class="scroll-list-panel selected">@foreach (var u in addedUsers.ToList()){
                                    <div class="list-item-inline"><span>👤 @GetUserDisplayName(u)</span><button type="button" class="btn-item-action remove" @onclick="() => addedUsers.Remove(u)"><RadzenIcon Icon="remove" /></button></div>
                                }
                            </div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </ChildContent>
</RadzenTabsItem>

<RadzenTabsItem>
    <Template Context="tabContext4"><span style="color: var(--text-light);"><RadzenIcon Icon="layers" Style="vertical-align: middle; margin-right: 6px;" /> 4. Материалы</span></Template>
    <ChildContent>
        <div class="cyber-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="cyber-label">Дополнительные файлы для скачивания (Pcap, логи, скрипты)</label>
                <button type="button" class="btn-outline-light" @onclick="AddDocumentSlot"><RadzenIcon Icon="add" Style="font-size: 1rem; margin-top: -2px;" /> Добавить файл</button>
            </div>

            @if (!Item.Documents.Any())
            {
                <div class="text-center p-4">
                    <RadzenIcon Icon="folder_open" Style="font-size: 3rem; color: var(--text-muted); margin-bottom: 10px; display: block;" />
                    <span style="color: var(--text-light); opacity: 0.8;">Файлы к сценарию пока не прикреплены. Нажмите кнопку "Добавить файл".</span>
                </div>
            }

            @foreach (var doc in Item.Documents)
            {
                <div class="p-3 mb-3 rounded" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color);" @key="doc">
                    <div class="d-flex gap-2 mb-3">
                        <RadzenTextBox @bind-Value="@doc.Title" Placeholder="Название документа (например: Дамп трафика .pcap)" class="w-100 rz-textbox" />
                        <button type="button" class="btn-delete-icon" @onclick="@(() => Item.Documents.Remove(doc))"><RadzenIcon Icon="close" /></button>
                    </div>

                    <div class="upload-zone" style="border-color: @(string.IsNullOrEmpty(doc.FilePath) ? "var(--accent-cyan)" : "var(--success-color)")">
                        <InputFile OnChange="@(e => UploadDocumentToDb(e, doc))" />
                        @if (!string.IsNullOrEmpty(doc.FilePath))
                        {
                            <RadzenIcon Icon="check_circle" Style="font-size: 2.5rem; color: var(--success-color);" />
                            <span style="color: var(--success-color); font-weight: bold; font-size: 1.1rem;">Файл загружен и готов!</span>
                        }
                        else
                        {
                            <RadzenIcon Icon="cloud_upload" class="upload-icon" />
                            <span style="color: var(--text-light); font-weight: 500; font-size: 1.05rem;">Кликните или перетащите файл сюда</span>
                            <small style="color: var(--text-light); opacity: 0.7; font-size: 0.8rem;">Поддерживаются любые форматы (макс. 25 МБ)</small>
                        }
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</RadzenTabsItem>

                <RadzenTabsItem>
                    <Template Context="tabContext5">
                        <span style="color: var(--accent-cyan); font-weight: bold;">
                            <RadzenIcon Icon="router" Style="vertical-align: middle; margin-right: 6px;" /> 5. Топология сети
                        </span>
                    </Template>
                    <ChildContent>
                        <div class="row">
                            <div class="col-md-5">
                                <div class="sticky-questions-header" style="top: 0; margin-bottom: 15px; padding: 10px 15px;">
                                    <span style="font-weight: bold; font-size: 1.1rem;">Узлов на карте: @Item.Devices.Count</span>
                                    <button type="button" class="btn-primary-gradient" style="padding: 6px 14px; font-size: 0.85rem;" @onclick="AddDevice">
                                        <RadzenIcon Icon="add" Style="font-size: 1rem;" /> Добавить ПК
                                    </button>
                                </div>
                                <div style="max-height: 400px; overflow-y: auto; padding-right: 5px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 10px;">
                                    @for (int j = 0; j < Item.Devices.Count; j++)
                                    {
                                        var d = Item.Devices[j];
                                        <div class="p-3 mb-3 rounded position-relative" style="background: @(selectedDevice == d ? "rgba(152,195,121,0.08)" : "rgba(0,0,0,0.2)"); border: 1px solid @(selectedDevice == d ? "var(--success-color)" : "var(--border-color)"); cursor: pointer;" @onclick="() => selectedDevice = d" @key="d">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <strong style="color: @(selectedDevice == d ? "var(--success-color)" : "var(--accent-cyan)"); font-size: 1.1rem;">#@(j + 1): @(string.IsNullOrWhiteSpace(d.Name) ? "Новый узел" : d.Name)</strong>
                                                <button type="button" class="btn-delete-icon" style="padding: 2px 6px;" @onclick="@(() => { Item.Devices.Remove(d); if (selectedDevice == d) selectedDevice = null; })"><RadzenIcon Icon="close" /></button>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-6">
                                                    <span style="font-size: 0.75rem; color: var(--text-light); opacity: 0.85; display:block; margin-bottom:4px;">Имя в системе:</span>
                                                    <input type="text" class="form-control form-control-sm dark-input" placeholder="Напр: DC-01" @bind="d.Name" />
                                                </div>
                                                <div class="col-6">
                                                    <span style="font-size: 0.75rem; color: var(--text-light); opacity: 0.85; display:block; margin-bottom:4px;">IP-адрес:</span>
                                                    <input type="text" class="form-control form-control-sm dark-input" placeholder="10.0.0.5" @bind="d.IpAddress" />
                                                </div>
                                                <div class="col-6">
                                                    <span style="font-size: 0.75rem; color: var(--text-light); opacity: 0.85; display:block; margin-bottom:4px;">ОС:</span>
                                                    <input type="text" class="form-control form-control-sm dark-input" placeholder="Windows Server" @bind="d.Os" />
                                                </div>
                                                <div class="col-6">
                                                    <span style="font-size: 0.75rem; color: var(--text-light); opacity: 0.85; display:block; margin-bottom:4px;">Открытые порты:</span>
                                                    <input type="text" class="form-control form-control-sm dark-input" placeholder="22, 80, 443" @bind="d.OpenPorts" />
                                                </div>
                                                <div class="col-4">
                                                    <span style="font-size: 0.75rem; color: var(--text-light); opacity: 0.85; display:block; margin-bottom:4px;">Иконка узла:</span>
                                                    <select class="form-select form-select-sm dark-input text-light" @bind="d.Type">
                                                        <option value="dns">🖧 Сервер</option>
                                                        <option value="router">🌐 Роутер</option>
                                                        <option value="computer">💻 ПК</option>
                                                        <option value="security">🛡 Фаервол</option>
                                                        <option value="laptop">📱 Ноутбук</option>
                                                    </select>
                                                </div>
                                                <div class="col-4">
                                                    <span style="font-size: 0.75rem; color: var(--text-light); opacity: 0.85; display:block; margin-bottom:4px;">Позиция X:</span>
                                                    <input type="number" class="form-control form-control-sm dark-input" @bind="d.MapX" />
                                                </div>
                                                <div class="col-4">
                                                    <span style="font-size: 0.75rem; color: var(--text-light); opacity: 0.85; display:block; margin-bottom:4px;">Позиция Y:</span>
                                                    <input type="number" class="form-control form-control-sm dark-input" @bind="d.MapY" />
                                                </div>
                                                <div class="col-12">
                                                    <span style="font-size: 0.75rem; color: var(--text-light); opacity: 0.85; display:block; margin-bottom:4px;">Описание (подсказка):</span>
                                                    <input type="text" class="form-control form-control-sm dark-input" placeholder="Главный контроллер домена..." @bind="d.Description" />
                                                </div>

                                                <div class="col-12 mt-2" style="background: rgba(0,0,0,0.3); padding: 10px; border-radius: 6px; border: 1px dashed var(--border-color);">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span style="font-size: 0.75rem; color: var(--accent-cyan); text-transform: uppercase; font-weight: bold;">Установленное ПО</span>
                                                        <button type="button" class="btn-outline-light" style="padding: 2px 8px; font-size: 0.7rem;" @onclick="@(() => d.Applications.Add(new DeviceApplication()))">
                                                            <RadzenIcon Icon="add" Style="font-size: 0.8rem; margin-top:-2px;" /> Добавить ПО
                                                        </button>
                                                    </div>
                                                    @if (!d.Applications.Any())
                                                    {
                                                        <div style="font-size: 0.75rem; color: var(--text-muted); font-style: italic;">Приложения не добавлены.</div>
                                                    }
                                                    @foreach (var app in d.Applications)
                                                    {
                                                        <div class="d-flex gap-2 mb-2 align-items-center" @key="app">
                                                            <input type="text" class="form-control form-control-sm dark-input" placeholder="Название (напр. Apache)" @bind="app.Name" />
                                                            <input type="text" class="form-control form-control-sm dark-input" placeholder="Версия" @bind="app.Version" style="width: 80px;" />
                                                            <button type="button" class="btn-delete-icon text-danger" style="padding: 2px 4px;" @onclick="() => d.Applications.Remove(app)"><RadzenIcon Icon="close" Style="font-size:0.9rem;" /></button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                                    <span class="cyber-label" style="margin:0;">Линии связи</span>
                                    <button type="button" class="btn-outline-light" style="padding: 4px 10px; font-size: 0.75rem;" @onclick="AddConnection"><RadzenIcon Icon="add" Style="font-size: 0.9rem; margin-top:-2px;" /> Добавить кабель</button>
                                </div>
                                <div style="max-height: 200px; overflow-y: auto;">
                                    @foreach (var c in Item.Connections)
                                    {
                                        <div class="p-2 mb-2 rounded" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color);" @key="c">
                                            <div class="row g-2 align-items-center">
                                                <div class="col-4">
                                                    <select class="form-select form-select-sm dark-input text-light" style="font-size: 0.8rem;" value="@Item.Devices.IndexOf(c.FromDevice ?? Item.Devices.FirstOrDefault(dev => dev.Id == c.FromDeviceId && dev.Id != 0))" @onchange="@(e => SetConnectionFrom(c, e.Value))">
                                                        <option value="-1" disabled>Откуда...</option>
                                                        @for (int i = 0; i < Item.Devices.Count; i++)
                                                        {
                                                            <option value="@i">@Item.Devices[i].Name</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-1 text-center px-0"><RadzenIcon Icon="arrow_right_alt" Style="color: var(--text-light); opacity: 0.8;" /></div>
                                                <div class="col-4">
                                                    <select class="form-select form-select-sm dark-input text-light" style="font-size: 0.8rem;" value="@Item.Devices.IndexOf(c.ToDevice ?? Item.Devices.FirstOrDefault(dev => dev.Id == c.ToDeviceId && dev.Id != 0))" @onchange="@(e => SetConnectionTo(c, e.Value))">
                                                        <option value="-1" disabled>Куда...</option>
                                                        @for (int i = 0; i < Item.Devices.Count; i++)
                                                        {
                                                            <option value="@i">@Item.Devices[i].Name</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-2 px-0">
                                                    <select class="form-select form-select-sm dark-input text-light" style="font-size: 0.8rem;" @bind="c.LinkType">
                                                        <option value="Ethernet">LAN</option>
                                                        <option value="VPN">VPN</option>
                                                    </select>
                                                </div>
                                                <div class="col-1 text-end">
                                                    <button type="button" class="btn-delete-icon" style="padding: 2px 4px;" @onclick="() => Item.Connections.Remove(c)"><RadzenIcon Icon="close" Style="font-size: 0.9rem;" /></button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-md-7">
                                <label class="cyber-label text-center mb-2">Виртуальный полигон</label>
                                <div class="canvas-container" @onclick="HandleCanvasClick">
                                    <svg style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; overflow: visible;">
                                        @foreach (var conn in Item.Connections)
                                        {
                                            var fromNode = conn.FromDevice ?? Item.Devices.FirstOrDefault(d => d.Id == conn.FromDeviceId && d.Id != 0);
                                            var toNode = conn.ToDevice ?? Item.Devices.FirstOrDefault(d => d.Id == conn.ToDeviceId && d.Id != 0);

                                            if (fromNode != null && toNode != null)
                                            {
                                                string dashArray = conn.LinkType == "VPN" ? "6,6" : "0";
                                                <line x1="@fromNode.MapX" y1="@fromNode.MapY" x2="@toNode.MapX" y2="@toNode.MapY" stroke="rgba(78, 195, 209, 0.6)" stroke-width="2" stroke-dasharray="@dashArray" />
                                            }
                                        }
                                    </svg>

                                    @foreach (var dev in Item.Devices)
                                    {
                                        var currentDev = dev;
                                        <div class="canvas-device @(selectedDevice == currentDev ? "selected-dev" : "")" style="left: @(currentDev.MapX)px; top: @(currentDev.MapY)px;" @onclick="() => selectedDevice = currentDev" @onclick:stopPropagation="true" @key="currentDev">
                                            <RadzenIcon Icon="@(string.IsNullOrEmpty(currentDev.Type) ? "dns" : currentDev.Type)" />
                                            <div class="device-caption">@(string.IsNullOrWhiteSpace(currentDev.Name) ? "Без имени" : currentDev.Name)</div>
                                        </div>
                                    }
                                </div>
                                <div class="text-center mt-2" style="font-size:0.8rem; color: var(--text-light); opacity: 0.8;">Выберите ПК слева, а затем кликните по сетке полигона, чтобы задать его позицию.</div>
                            </div>
                        </div>
                    </ChildContent>
                </RadzenTabsItem>

<RadzenTabsItem>
    <Template Context="tabContext6"><span style="color: var(--text-light);"><RadzenIcon Icon="verified" Style="vertical-align: middle; margin-right: 6px;" /> 6. Готово</span></Template>
    <ChildContent>
        <div class="row">
            <div class="col-md-6"><div class="cyber-card"><h4 style="color: var(--accent-light-blue); margin-bottom: 20px;">Краткая сводка</h4><ul class="list-unstyled" style="line-height: 2;"><li><strong>Название:</strong> @(string.IsNullOrEmpty(Item.Title) ? "Без названия" : Item.Title)</li><li><strong>Сетевых узлов:</strong> @Item.Devices.Count шт.</li><li><strong>Связей:</strong> @Item.Connections.Count шт.</li></ul></div></div>
            <div class="col-md-6"><div class="cyber-card text-center" style="padding: 40px 20px;"><div class="d-flex justify-content-center gap-3 mb-4"><button type="button" class="btn-outline-light" style="border-color: @(Item.IsVisible ? "var(--success-color)" : "var(--border-color)");" @onclick="() => Item.IsVisible = true">ОТКРЫТЬ ДОСТУП ИГРОКАМ</button><button type="button" class="btn-outline-light" style="border-color: @(!Item.IsVisible ? "var(--warning-color)" : "var(--border-color)");" @onclick="() => Item.IsVisible = false">СОХРАНИТЬ В ЧЕРНОВИК</button></div></div></div>
        </div>
    </ChildContent>
</RadzenTabsItem>
</Tabs>
</RadzenTabs>
</RadzenTemplateForm>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private CyberScenario Item { get; set; } = new();

    private List<ApplicationUser> users = new();
    private List<UserTeam> teams = new();
    private List<ApplicationUser> addedUsers = new();
    private List<UserTeam> addedTeams = new();

    private ScenarioDevice? selectedDevice;
    private int selectedTabIndex = 0;
    private bool isIndividual = true;
    private readonly List<string> difficulties = new() { "Легкий", "Средний", "Сложный" };

    private bool IsStep1Valid => !string.IsNullOrWhiteSpace(Item.Title);
    private bool IsStep2Valid => Item.Questions.Any() && Item.Questions.All(q => !string.IsNullOrWhiteSpace(q.Text) && !string.IsNullOrWhiteSpace(q.CorrectAnswer));

    protected override async Task OnInitializedAsync()
    {
        using var context = await ContextFactory.CreateDbContextAsync();
        users = await context.Set<ApplicationUser>().AsNoTracking().ToListAsync();
        teams = await context.Set<UserTeam>().AsNoTracking().ToListAsync();

        if (Id.HasValue)
        {
            Item = await context.Scenarios
                .Include(s => s.Questions)
                .Include(s => s.Documents)
                .Include(s => s.Devices)
                .Include(s => s.Connections)
                .FirstOrDefaultAsync(s => s.Id == Id.Value) ?? new CyberScenario();

            isIndividual = Item.Scope != VisibilityScope.TeamOnly;

            if (!string.IsNullOrEmpty(Item.AllowedUserIds)) { var userIds = Item.AllowedUserIds.Split(',', StringSplitOptions.RemoveEmptyEntries); addedUsers = users.Where(u => userIds.Contains(u.Id)).ToList(); }
            if (!string.IsNullOrEmpty(Item.AllowedTeamIds)) { var teamIds = Item.AllowedTeamIds.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(int.Parse); addedTeams = teams.Where(t => teamIds.Contains(t.Id)).ToList(); }
        }
        else
        {
            Item = new CyberScenario { Questions = new List<ScenarioQuestion>(), Documents = new List<ScenarioDocument>(), Devices = new List<ScenarioDevice>(), Connections = new List<ScenarioConnection>(), IsVisible = false, GameMode = ScenarioGameMode.AllAtOnce };
        }
    }

    private void SetIndividualMode() => isIndividual = true;
    private void SetTeamMode() => isIndividual = false;
    private string GetUserDisplayName(ApplicationUser? u) => u != null ? $"{u.LastName} {u.FirstName}".Trim() : "User";
    private void AddQuestion() => Item.Questions.Add(new ScenarioQuestion { AwardPoints = 10, PenaltyPoints = 5 });
    private void AddDocumentSlot() => Item.Documents.Add(new ScenarioDocument());

    private void AddDevice()
    {
        var newDev = new ScenarioDevice { Name = $"Узел {Item.Devices.Count + 1}", MapX = 100, MapY = 100, Type = "dns" };
        Item.Devices.Add(newDev);
        selectedDevice = newDev;
    }

    private void AddConnection()
    {
        if (Item.Devices.Count >= 2) { Item.Connections.Add(new ScenarioConnection { FromDevice = Item.Devices[0], ToDevice = Item.Devices[1], LinkType = "Ethernet" }); }
        else { NotificationService.Notify(NotificationSeverity.Info, "Внимание", "Добавьте минимум 2 устройства для связи."); }
    }

    private void SetConnectionFrom(ScenarioConnection c, object val) { if (int.TryParse(val?.ToString(), out int idx) && idx >= 0) { c.FromDevice = Item.Devices[idx]; c.FromDeviceId = c.FromDevice.Id; } }
    private void SetConnectionTo(ScenarioConnection c, object val) { if (int.TryParse(val?.ToString(), out int idx) && idx >= 0) { c.ToDevice = Item.Devices[idx]; c.ToDeviceId = c.ToDevice.Id; } }

    private void HandleCanvasClick(MouseEventArgs e)
    {
        if (selectedDevice != null) { selectedDevice.MapX = (int)e.OffsetX; selectedDevice.MapY = (int)e.OffsetY; StateHasChanged(); }
    }

    private async Task UploadDocumentToDb(InputFileChangeEventArgs e, ScenarioDocument doc)
    {
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(maxAllowedSize: 1024 * 1024 * 25).CopyToAsync(ms);
        doc.FilePath = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        if (string.IsNullOrWhiteSpace(doc.Title)) doc.Title = e.File.Name;
    }

    private async Task OnSave()
    {
        Item.SchemaPath = "INTERNAL_BUILDER";
        if (isIndividual) { Item.AllowedTeamIds = null; Item.AllowedUserIds = addedUsers.Any() ? string.Join(",", addedUsers.Select(u => u.Id)) : null; Item.Scope = string.IsNullOrEmpty(Item.AllowedUserIds) ? VisibilityScope.Public : VisibilityScope.GroupOnly; }
        else { Item.AllowedUserIds = null; Item.AllowedTeamIds = addedTeams.Any() ? string.Join(",", addedTeams.Select(t => t.Id)) : null; Item.Scope = VisibilityScope.TeamOnly; }

        using var context = await ContextFactory.CreateDbContextAsync();
        if (Item.Id == 0) context.Scenarios.Add(Item); else context.Scenarios.Update(Item);

        await context.SaveChangesAsync();
        CatalogUpdateService.NotifyCatalogChanged();
        NotificationService.Notify(NotificationSeverity.Success, "Успех", "Сценарий сохранен!");
        NavigationManager.NavigateTo("scenario");
    }
    private void Cancel() => NavigationManager.NavigateTo("scenario");
}