@page "/scenario/edit"
@page "/scenario/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data
@using CyberPolygon.Services
@using System.IO
@using CyberPolygon.Models
@inject ScenarioService ScenarioService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject CatalogUpdateService CatalogUpdateService
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@(Id.HasValue ? "Редактирование сценария" : "Новый сценарий") | Киберполигон</PageTitle>

<style>
    /* Строгая киберпанк-тема */
    :root {
        --bg-main: #0b0f17;
        --bg-card: #131924;
        --bg-card-hover: #1a2435;
        --bg-input: #131924;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --accent-light-blue: #7ec8f8;
        --border-color: #2a3a4a;
        --success-color: #98c379;
        --warning-color: #e5c07b;
        --danger-color: #e06c75;
    }

    html, body {
        background-color: var(--bg-main) !important;
    }

    /* Обертка на всю ширину для однородного фона */
    .full-page-wrapper {
        background-color: var(--bg-main) !important;
        min-height: calc(100vh - 60px);
        width: 100%;
        padding: 30px 20px;
        box-sizing: border-box;
    }

    .page-container {
        color: var(--text-light);
        max-width: 1400px;
        margin: 0 auto;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 35px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        position: relative;
        gap: 20px;
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.5);
        }

    .header-text h1 {
        color: var(--accent-cyan);
        font-weight: 800;
        text-transform: uppercase;
        margin: 0 0 8px 0;
        font-size: 1.8rem;
        letter-spacing: 2px;
        text-shadow: 0 0 15px rgba(78, 195, 209, 0.3);
    }

    .header-text p {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* === ОБОЛОЧКА (CYBER-SHELL) === */
    .cyber-shell {
        background-color: rgba(19, 25, 36, 0.6);
        border: 1px solid rgba(78, 195, 209, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(78, 195, 209, 0.05);
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .cyber-shell-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 25px;
        background: linear-gradient(90deg, rgba(78,195,209,0.1) 0%, transparent 100%);
        border-bottom: 1px solid rgba(78, 195, 209, 0.3);
        font-family: 'Courier New', Courier, monospace;
    }

    .shell-title {
        color: var(--accent-cyan);
        font-size: 0.95rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .shell-status {
        color: var(--text-muted);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    .status-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background-color: var(--accent-light-blue);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--accent-light-blue);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(126, 200, 248, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(126, 200, 248, 0);
        }
    }

    .cyber-shell-body {
        padding: 30px;
    }

    /* Внутренние карточки-секции */
    .cyber-section {
        background-color: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 25px;
        height: 100%;
    }

        .cyber-section.interactive:hover {
            border-color: var(--accent-cyan);
            background-color: rgba(78, 195, 209, 0.05);
        }

    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
        font-weight: 700;
    }

    /* === СТИЛИЗАЦИЯ ВКЛАДОК RADZEN === */
    .custom-tabs, .rz-tabview-panels, .rz-tabview-panel {
        overflow: visible !important;
        contain: none !important;
    }

        .custom-tabs .rz-tabview-nav {
            background: transparent !important;
            border-bottom: 2px solid var(--border-color) !important;
            margin-bottom: 25px;
            gap: 5px; /* Разделяем вкладки */
        }

            .custom-tabs .rz-tabview-nav li {
                background: transparent !important;
                border: 1px solid transparent !important;
                border-bottom: none !important;
                border-radius: 8px 8px 0 0 !important;
                transition: all 0.3s ease;
            }

                .custom-tabs .rz-tabview-nav li a {
                    color: var(--text-muted) !important;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    padding: 12px 20px !important;
                    border-bottom: 3px solid transparent !important;
                }

                .custom-tabs .rz-tabview-nav li:hover {
                    background-color: rgba(255, 255, 255, 0.03) !important;
                }

                /* АКТИВНАЯ ВКЛАДКА */
                .custom-tabs .rz-tabview-nav li.rz-tabview-selected {
                    background: linear-gradient(180deg, rgba(78, 195, 209, 0.15) 0%, rgba(19, 25, 36, 0) 100%) !important;
                    border: 1px solid rgba(78, 195, 209, 0.3) !important;
                    border-bottom: none !important;
                }

                    .custom-tabs .rz-tabview-nav li.rz-tabview-selected a {
                        border-bottom: 3px solid var(--accent-cyan) !important;
                    }

                        /* Подсветка текста и иконок ТОЛЬКО для активной вкладки (перебивает inline-стили) */
                        .custom-tabs .rz-tabview-nav li.rz-tabview-selected a span,
                        .custom-tabs .rz-tabview-nav li.rz-tabview-selected a i {
                            color: var(--accent-cyan) !important;
                            text-shadow: 0 0 10px rgba(78, 195, 209, 0.5) !important;
                        }

        .custom-tabs .rz-tabview-panels {
            background: transparent !important;
            border: none !important;
            padding: 0 !important;
        }

    /* Инпуты Radzen */
    .dark-input, .rz-textbox, .rz-textarea, .rz-dropdown, .rz-numeric {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
        border-radius: 6px !important;
        transition: all 0.3s ease;
    }

        .dark-input:focus, .rz-textbox:focus, .rz-textarea:focus, .rz-dropdown:focus, .rz-numeric:focus {
            border-color: var(--accent-cyan) !important;
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.2) !important;
            outline: none !important;
        }

        /* Делаем placeholder светлее и добавляем поддержку всех полей */
        .dark-input::placeholder, .rz-textbox::placeholder, .rz-textarea::placeholder {
            color: #8fa0b5 !important; /* Используем более светлый цвет var(--text-muted) */
            opacity: 0.8 !important; /* Убираем прозрачность, которую иногда накидывает браузер */
            font-style: italic;
        }
    По

        .rz-textbox:focus, .rz-textarea:focus, .rz-dropdown:focus, .rz-numeric:focus {
            border-color: var(--accent-cyan) !important;
            box-shadow: 0 0 10px rgba(78, 195, 209, 0.2) !important;
        }

        .rz-textbox::placeholder, .rz-textarea::placeholder {
            color: #5b6b7a !important;
            font-style: normal;
        }

    .rz-dropdown-panel, .rz-popup {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--accent-cyan) !important;
        box-shadow: 0 10px 25px rgba(0,0,0,0.8) !important;
    }

    .rz-dropdown-item {
        color: var(--text-light) !important;
        background-color: transparent !important;
        padding: 10px 15px !important;
    }

        .rz-dropdown-item:hover {
            background-color: rgba(78, 195, 209, 0.15) !important;
            color: var(--accent-cyan) !important;
        }

    /* Radzen HTML Editor */
    .rz-html-editor {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 6px !important;
        overflow: hidden;
    }

        .rz-html-editor .rz-html-editor-toolbar {
            background-color: rgba(0,0,0,0.3) !important;
            border-bottom: 1px solid var(--border-color) !important;
        }

        .rz-html-editor .rz-html-editor-content {
            background-color: var(--bg-input) !important;
            color: var(--text-light) !important;
        }

    /* Кнопки */
    .btn-main {
        background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
        color: var(--bg-main);
        font-weight: 800;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-main:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(78, 195, 209, 0.4);
        }

    .btn-outline-light {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 10px 24px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-outline-light:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-light);
            border-color: var(--text-muted);
        }

    .btn-delete-icon {
        background: transparent;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.3);
        border-radius: 6px;
        padding: 5px 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-delete-icon:hover {
            background: rgba(224, 108, 117, 0.1);
            border-color: var(--danger-color);
        }

    .btn-item-action {
        background: transparent;
        border-radius: 4px;
        padding: 2px;
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }

        .btn-item-action.add {
            color: var(--accent-cyan);
            border: 1px solid rgba(78, 195, 209, 0.3);
        }

            .btn-item-action.add:hover {
                background: rgba(78, 195, 209, 0.2);
                border-color: var(--accent-cyan);
            }

        .btn-item-action.remove {
            color: var(--danger-color);
            border: 1px solid rgba(224, 108, 117, 0.3);
        }

            .btn-item-action.remove:hover {
                background: rgba(224, 108, 117, 0.2);
                border-color: var(--danger-color);
            }

    /* Листы (Пользователи/Команды) */
    .scroll-list-panel {
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        height: 300px;
        overflow-y: auto;
        padding: 10px;
    }

        .scroll-list-panel.selected {
            border-color: rgba(152, 195, 121, 0.3);
            background: rgba(0, 0, 0, 0.2);
        }

    .list-item-inline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        padding: 8px 12px;
        border-radius: 6px;
        margin-bottom: 8px;
        gap: 8px;
        transition: 0.2s;
    }

        .list-item-inline:hover {
            background: rgba(78, 195, 209, 0.05);
            border-color: rgba(78, 195, 209, 0.4);
        }

        .list-item-inline .item-text {
            font-size: 0.85rem;
            color: var(--text-light);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex-grow: 1;
        }

    /* Заголовки (Задания) */
    .sticky-questions-header {
        position: sticky;
        top: 85px;
        z-index: 100;
        background: rgba(19, 25, 36, 0.95);
        backdrop-filter: blur(10px);
        padding: 15px 25px;
        border-radius: 8px;
        border: 1px solid var(--accent-cyan);
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

    /* ЗОНА ЗАГРУЗКИ */
    .upload-zone {
        position: relative;
        border: 1px dashed var(--accent-cyan);
        border-radius: 8px;
        padding: 30px 20px;
        text-align: center;
        background: rgba(78, 195, 209, 0.03);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        overflow: hidden;
    }

        .upload-zone:hover {
            background: rgba(78, 195, 209, 0.1);
            box-shadow: inset 0 0 20px rgba(78, 195, 209, 0.1);
        }

    .upload-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 10;
    }

    .upload-icon {
        font-size: 3rem;
        color: var(--accent-cyan);
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    .upload-zone:hover .upload-icon {
        transform: translateY(-4px);
        filter: drop-shadow(0 0 10px rgba(78, 195, 209, 0.6));
    }

    /* ХОЛСТ КОНСТРУКТОРА */
    .canvas-container {
        width: 100%;
        height: 600px;
        background-color: var(--bg-main);
        background-image: radial-gradient(rgba(78, 195, 209, 0.15) 1px, transparent 1px);
        background-size: 25px 25px;
        border: 1px dashed var(--accent-cyan);
        border-radius: 8px;
        position: relative;
        overflow: hidden;
        cursor: crosshair;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
    }

    .canvas-device {
        position: absolute;
        width: 44px;
        height: 44px;
        margin-left: -22px;
        margin-top: -22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.6);
        border: 2px solid var(--accent-cyan);
        background: #1a2332;
        cursor: pointer;
        transition: transform 0.15s;
        z-index: 10;
    }

        .canvas-device:hover {
            transform: scale(1.15);
            z-index: 100;
        }

        .canvas-device.selected-dev {
            border-color: var(--success-color);
            box-shadow: 0 0 15px var(--success-color);
            background: #131924;
        }

        .canvas-device i {
            font-size: 1.3rem;
            color: var(--text-light);
        }

        .canvas-device.selected-dev i {
            color: var(--success-color);
        }

    .device-caption {
        position: absolute;
        top: 48px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(19, 25, 36, 0.9);
        color: #fff;
        font-size: 0.75rem;
        padding: 2px 8px;
        border-radius: 4px;
        white-space: nowrap;
        border: 1px solid var(--border-color);
        pointer-events: none;
    }
</style>

<RadzenComponents />

<div class="full-page-wrapper">
    <div class="page-container">
        <div class="page-header">
            <div class="header-text">
                <h1>@(Id.HasValue ? "Редактирование сценария" : "Создание сценария")</h1>
                <p>Информационно-аналитический департамент // Конструктор симуляций</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn-main" @onclick="OnSave">
                    <RadzenIcon Icon="save" Style="font-size: 1.2rem;" /> Сохранить в БД
                </button>
                <button type="button" class="btn-outline-light" @onclick="Cancel">Отмена</button>
            </div>
        </div>

        <RadzenTemplateForm TItem="CyberScenario" Data="@Item" Submit="@OnSave">

            <div class="cyber-shell">
                <div class="cyber-shell-header">
                    <div class="shell-title">
                        <RadzenIcon Icon="crisis_alert" Style="font-size: 1.2rem;" />
                        SYS.ADMIN_TERMINAL // SCENARIO_BUILDER
                    </div>
                    <div class="shell-status">
                        <span class="status-dot"></span>
                        ONLINE
                    </div>
                </div>

                <div class="cyber-shell-body">
                    <RadzenTabs @bind-SelectedIndex="@selectedTabIndex" class="w-100 custom-tabs">
                        <Tabs>
                            <!-- ТАБ 1: ОСНОВНОЕ -->
                            <RadzenTabsItem>
                                <Template Context="tabContext1">
                                    <span style="color: @(IsStep1Valid ? "var(--success-color)" : "var(--text-light)");">
                                        <RadzenIcon Icon="@(IsStep1Valid ? "check_circle" : "info")" Style="vertical-align: middle; margin-right: 6px;" /> 1. Основное
                                    </span>
                                </Template>
                                <ChildContent>
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="cyber-section">
                                                <div class="mb-4">
                                                    <label class="cyber-label">Название сценария</label>
                                                    <RadzenTextBox @bind-Value="@Item.Title" class="w-100 rz-textbox" Placeholder="Например: Взлом корпоративного домена..." />
                                                </div>
                                                <div class="mb-4">
                                                    <label class="cyber-label">Краткое описание (для превью)</label>
                                                    <RadzenTextArea @bind-Value="@Item.Description" class="w-100 rz-textarea" Rows="3" Placeholder="В этом сценарии курсантам предстоит проанализировать логи..." />
                                                </div>
                                                <div class="mb-2">
                                                    <label class="cyber-label">Подробная легенда и вводная информация</label>
                                                    <RadzenHtmlEditor @bind-Value="@Item.Legend" style="height: 350px;" class="rz-html-editor" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="cyber-section">
                                                <h5 style="color: var(--accent-cyan); margin-bottom: 20px; font-weight: 800; text-transform: uppercase;">Метаданные</h5>
                                                <div class="mb-4">
                                                    <label class="cyber-label">Теги (через запятую)</label>
                                                    <RadzenTextBox @bind-Value="@Item.Tags" class="w-100 rz-textbox" Placeholder="linux, active-directory, nmap..." />
                                                </div>
                                                <div class="mb-4">
                                                    <label class="cyber-label">Уровень сложности</label>
                                                    <RadzenDropDown @bind-Value="@Item.Difficulty" TValue="string" Data="@difficulties" class="w-100 rz-dropdown" />
                                                </div>
                                                <div class="mb-2">
                                                    <label class="cyber-label">Лимит времени (минуты)</label>
                                                    <RadzenNumeric @bind-Value="@Item.DurationInMinutes" Min="0" class="w-100 rz-numeric" />
                                                    <small style="color: var(--warning-color); font-weight: 600; margin-top: 8px; display: block; font-size: 0.8rem; letter-spacing: 0.5px;">
                                                        <RadzenIcon Icon="info" Style="font-size: 0.9rem; vertical-align: middle; margin-top: -2px;" /> Оставьте 0 для прохождения без таймера
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </ChildContent>
                            </RadzenTabsItem>

                            <!-- ТАБ 2: ЗАДАНИЯ -->
                            <RadzenTabsItem>
                                <Template Context="tabContext2">
                                    <span style="color: @(IsStep2Valid ? "var(--success-color)" : "var(--text-light)");">
                                        <RadzenIcon Icon="@(IsStep2Valid ? "check_circle" : "quiz")" Style="vertical-align: middle; margin-right: 6px;" /> 2. Задания
                                    </span>
                                </Template>
                                <ChildContent>
                                    <div class="sticky-questions-header">
                                        <div style="width: 50%;">
                                            <label class="cyber-label">Формат выдачи заданий</label>
                                            <RadzenDropDown @bind-Value="@Item.GameMode" TValue="ScenarioGameMode" Data="@(Enum.GetValues(typeof(ScenarioGameMode)))" class="w-100 rz-dropdown">
                                                <Template Context="modeContext">
                                                    @((ScenarioGameMode)modeContext == ScenarioGameMode.AllAtOnce ? "Доступны все задания сразу" : "Открывать строго по очереди")
                                                </Template>
                                            </RadzenDropDown>
                                        </div>
                                        <button type="button" class="btn-main" @onclick="AddQuestion">
                                            <RadzenIcon Icon="add" Style="font-size: 1.2rem; margin-top: -2px;" /> <span>Новый флаг</span>
                                        </button>
                                    </div>

                                    @if (!Item.Questions.Any())
                                    {
                                        <div class="text-center p-5" style="color: var(--text-muted); border: 1px dashed var(--border-color); border-radius: 8px;">Список заданий пуст. Добавьте первый вопрос.</div>
                                    }
                                    @for (int i = 0; i < Item.Questions.Count; i++)
                                    {
                                        var q = Item.Questions[i];
                                        <div class="cyber-section mb-4" @key="q">
                                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2" style="border-color: var(--border-color) !important;">
                                                <span style="color: var(--accent-cyan); font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">ЗАДАНИЕ №@(i + 1)</span>
                                                <button type="button" class="btn-delete-icon" @onclick="@(() => Item.Questions.Remove(q))"><RadzenIcon Icon="delete" /></button>
                                            </div>
                                            <div class="row">
                                                <div class="col-12 mb-4">
                                                    <label class="cyber-label">Формулировка задачи</label>
                                                    <RadzenTextBox @bind-Value="@q.Text" class="w-100 rz-textbox" Placeholder="Найдите скрытый порт на сервере..." />
                                                </div>
                                                <div class="col-md-6 mb-4">
                                                    <label class="cyber-label" style="color: var(--success-color) !important;">Эталонный ответ (Сам Флаг)</label>
                                                    <RadzenTextBox @bind-Value="@q.CorrectAnswer" class="w-100 rz-textbox" Placeholder="8080" />
                                                </div>
                                                <div class="col-md-6 mb-4">
                                                    <label class="cyber-label" style="color: var(--accent-blue) !important;">Пример ответа (Подсказка формата)</label>
                                                    <RadzenTextBox @bind-Value="@q.ExampleAnswer" class="w-100 rz-textbox" Placeholder="Например: flag{...} или IP-адрес" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="cyber-label">Награда за успех (+ XP)</label>
                                                    <RadzenNumeric @bind-Value="@q.AwardPoints" Min="1" class="w-100 rz-numeric" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="cyber-label">Штраф за ошибку (- XP)</label>
                                                    <RadzenNumeric @bind-Value="@q.PenaltyPoints" Min="0" class="w-100 rz-numeric" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </ChildContent>
                            </RadzenTabsItem>

                            <!-- ТАБ 3: ДОСТУП -->
                            <RadzenTabsItem>
                                <Template Context="tabContext3">
                                    <span style="color: var(--text-light);"><RadzenIcon Icon="vpn_key" Style="vertical-align: middle; margin-right: 6px;" /> 3. Доступ</span>
                                </Template>
                                <ChildContent>
                                    <div class="cyber-section mb-4" style="border-color: @(Item.IsExclusiveAccess ? "var(--warning-color)" : "var(--border-color)");">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <label class="cyber-label" style="font-size: 1rem; color: @(Item.IsExclusiveAccess ? "var(--warning-color)" : "var(--accent-cyan)") !important;">
                                                    <RadzenIcon Icon="pan_tool" Style="margin-top: -2px; margin-right: 5px;" /> Монопольный режим (По очереди)
                                                </label>
                                                <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 5px;">
                                                    Если включено, инфраструктура блокируется: следующий игрок не сможет запустить симуляцию, пока предыдущий её не завершит.
                                                </div>
                                            </div>
                                            <RadzenSwitch @bind-Value="@Item.IsExclusiveAccess" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="cyber-section interactive" style="cursor: pointer; border-color: @(!isIndividual ? "var(--success-color)" : "var(--border-color)")" @onclick="SetTeamMode">
                                                <div class="text-center">
                                                    <RadzenIcon Icon="groups" Style="font-size: 3rem; color: var(--warning-color);" />
                                                    <h4 class="mt-3 text-light" style="font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Командный режим</h4>
                                                </div>
                                                @if (!isIndividual)
                                                {
                                                    <div class="row mt-4" @onclick:stopPropagation="true">
                                                        <div class="col-6">
                                                            <div class="scroll-list-panel">
                                                                @foreach (var x in teams.Where(t => !addedTeams.Any(at => at.Id == t.Id)))
                                                                {
                                                                    <div class="list-item-inline">
                                                                        <span class="item-text">👥 @x.Name</span>
                                                                        <button type="button" class="btn-item-action add" @onclick="() => addedTeams.Add(x)"><RadzenIcon Icon="add" /></button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="scroll-list-panel selected">
                                                                @foreach (var t in addedTeams.ToList())
                                                                {
                                                                    <div class="list-item-inline">
                                                                        <span class="item-text">👥 @t.Name</span>
                                                                        <button type="button" class="btn-item-action remove" @onclick="() => addedTeams.Remove(t)"><RadzenIcon Icon="remove" /></button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="cyber-section interactive" style="cursor: pointer; border-color: @(isIndividual ? "var(--success-color)" : "var(--border-color)")" @onclick="SetIndividualMode">
                                                <div class="text-center">
                                                    <RadzenIcon Icon="person" Style="font-size: 3rem; color: var(--accent-blue);" />
                                                    <h4 class="mt-3 text-light" style="font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Одиночный режим</h4>
                                                </div>
                                                @if (isIndividual)
                                                {
                                                    <div class="row mt-4" @onclick:stopPropagation="true">
                                                        <div class="col-6">
                                                            <div class="scroll-list-panel">
                                                                @foreach (var x in users.Where(u => !addedUsers.Any(au => au.Id == u.Id)))
                                                                {
                                                                    <div class="list-item-inline">
                                                                        <span class="item-text">👤 @GetUserDisplayName(x)</span>
                                                                        <button type="button" class="btn-item-action add" @onclick="() => addedUsers.Add(x)"><RadzenIcon Icon="add" /></button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="scroll-list-panel selected">
                                                                @foreach (var u in addedUsers.ToList())
                                                                {
                                                                    <div class="list-item-inline">
                                                                        <span class="item-text">👤 @GetUserDisplayName(u)</span>
                                                                        <button type="button" class="btn-item-action remove" @onclick="() => addedUsers.Remove(u)"><RadzenIcon Icon="remove" /></button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </ChildContent>
                            </RadzenTabsItem>

                            <!-- ТАБ 4: МАТЕРИАЛЫ -->
                            <RadzenTabsItem>
                                <Template Context="tabContext4"><span style="color: var(--text-light);"><RadzenIcon Icon="layers" Style="vertical-align: middle; margin-right: 6px;" /> 4. Материалы</span></Template>
                                <ChildContent>
                                    <div class="cyber-section">
                                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--border-color) !important;">
                                            <label class="cyber-label" style="margin: 0;">Дополнительные файлы для скачивания (Pcap, логи, скрипты)</label>
                                            <button type="button" class="btn-outline-light" style="padding: 8px 16px;" @onclick="AddDocumentSlot">
                                                <RadzenIcon Icon="add" Style="font-size: 1rem; margin-top: -2px;" /> Добавить слот файла
                                            </button>
                                        </div>

                                        @if (!Item.Documents.Any())
                                        {
                                            <div class="text-center p-4" style="border: 1px dashed var(--border-color); border-radius: 8px;">
                                                <RadzenIcon Icon="folder_open" Style="font-size: 3rem; color: var(--text-muted); margin-bottom: 10px; display: block;" />
                                                <span style="color: var(--text-light); opacity: 0.8;">Файлы к сценарию пока не прикреплены. Нажмите кнопку "Добавить слот файла".</span>
                                            </div>
                                        }

                                        @foreach (var doc in Item.Documents)
                                        {
                                            <div class="p-4 mb-4 rounded" style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color);" @key="doc">
                                                <div class="d-flex gap-3 mb-4">
                                                    <RadzenTextBox @bind-Value="@doc.Title" Placeholder="Название документа (например: Дамп трафика .pcap)" class="w-100 rz-textbox" />
                                                    <button type="button" class="btn-delete-icon" @onclick="@(() => Item.Documents.Remove(doc))"><RadzenIcon Icon="close" /></button>
                                                </div>

                                                <div class="upload-zone" style="border-color: @((doc.Content == null || doc.Content.Length == 0) ? "var(--accent-cyan)" : "var(--success-color)")">
                                                    <InputFile class="upload-input" OnChange="@(e => UploadDocumentToDb(e, doc))" />

                                                    @if (doc.Content != null && doc.Content.Length > 0)
                                                    {
                                                        <RadzenIcon Icon="check_circle" Style="font-size: 2.5rem; color: var(--success-color);" />
                                                        <span style="color: var(--success-color); font-weight: bold; font-size: 1.1rem; text-transform: uppercase;">Файл загружен</span>
                                                    }
                                                    else
                                                    {
                                                        <RadzenIcon Icon="cloud_upload" class="upload-icon" />
                                                        <span style="color: var(--accent-light-blue); font-weight: 700; font-size: 1.05rem; text-transform: uppercase;">Выбрать файл для слота</span>
                                                        <small style="color: var(--text-muted); font-size: 0.8rem;">Поддерживаются любые форматы (макс. 25 МБ)</small>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </ChildContent>
                            </RadzenTabsItem>

                            <!-- ТАБ 5: ТОПОЛОГИЯ СЕТИ -->
                            <RadzenTabsItem>
                                <Template Context="tabContext5">
                                    <span style="color: var(--text-light);">
                                        <RadzenIcon Icon="router" Style="vertical-align: middle; margin-right: 6px;" /> 5. Топология сети
                                    </span>
                                </Template>
                                <ChildContent>
                                    <div class="row">
                                        <div class="col-md-5">
                                            <div class="sticky-questions-header" style="top: 0; margin-bottom: 15px; padding: 15px;">
                                                <span style="font-weight: 800; font-size: 1rem; color: var(--accent-light-blue); text-transform: uppercase;">Узлов на карте: @Item.Devices.Count</span>
                                                <button type="button" class="btn-main" style="padding: 8px 16px; font-size: 0.8rem;" @onclick="AddDevice">
                                                    <RadzenIcon Icon="add" Style="font-size: 1rem;" /> Добавить ПК
                                                </button>
                                            </div>

                                            <div style="max-height: 400px; overflow-y: auto; padding-right: 10px; border-bottom: 1px dashed var(--border-color); padding-bottom: 15px; margin-bottom: 15px;">
                                                @for (int j = 0; j < Item.Devices.Count; j++)
                                                {
                                                    var d = Item.Devices[j];
                                                    <div class="cyber-section mb-3" style="padding: 15px; background: @(selectedDevice == d ? "rgba(152,195,121,0.05)" : "rgba(0,0,0,0.2)"); border-color: @(selectedDevice == d ? "var(--success-color)" : "var(--border-color)"); cursor: pointer;" @onclick="() => selectedDevice = d" @key="d">
                                                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2" style="border-color: rgba(255,255,255,0.05) !important;">
                                                            <strong style="color: @(selectedDevice == d ? "var(--success-color)" : "var(--accent-cyan)"); font-size: 1rem; text-transform: uppercase; letter-spacing: 1px;">#@(j + 1): @(string.IsNullOrWhiteSpace(d.Name) ? "Новый узел" : d.Name)</strong>
                                                            <button type="button" class="btn-delete-icon" style="padding: 2px 6px;" @onclick="@(() => { Item.Devices.Remove(d); if (selectedDevice == d) selectedDevice = null; })"><RadzenIcon Icon="close" /></button>
                                                        </div>

                                                        <div class="row g-3">
                                                            <div class="col-6">
                                                                <span class="cyber-label" style="font-size: 0.7rem;">Имя в системе:</span>
                                                                <input type="text" class="form-control form-control-sm dark-input" placeholder="Напр: DC-01" @bind="d.Name" />
                                                            </div>
                                                            <div class="col-6">
                                                                <span class="cyber-label" style="font-size: 0.7rem;">IP-адрес:</span>
                                                                <input type="text" class="form-control form-control-sm dark-input" placeholder="10.0.0.5" @bind="d.IpAddress" />
                                                            </div>
                                                            <div class="col-6">
                                                                <span class="cyber-label" style="font-size: 0.7rem;">ОС:</span>
                                                                <input type="text" class="form-control form-control-sm dark-input" placeholder="Windows Server" @bind="d.Os" />
                                                            </div>
                                                            <div class="col-6">
                                                                <span class="cyber-label" style="font-size: 0.7rem;">Открытые порты:</span>
                                                                <input type="text" class="form-control form-control-sm dark-input" placeholder="22, 80, 443" @bind="d.OpenPorts" />
                                                            </div>
                                                            <div class="col-4">
                                                                <span class="cyber-label" style="font-size: 0.7rem;">Иконка узла:</span>
                                                                <select class="form-select form-select-sm dark-input text-light" @bind="d.Type">
                                                                    <option value="dns">🖧 Сервер</option>
                                                                    <option value="router">🌐 Роутер</option>
                                                                    <option value="computer">💻 ПК</option>
                                                                    <option value="security">🛡 Фаервол</option>
                                                                    <option value="laptop">📱 Ноутбук</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-4">
                                                                <span class="cyber-label" style="font-size: 0.7rem;">Позиция X:</span>
                                                                <input type="number" class="form-control form-control-sm dark-input" @bind="d.MapX" />
                                                            </div>
                                                            <div class="col-4">
                                                                <span class="cyber-label" style="font-size: 0.7rem;">Позиция Y:</span>
                                                                <input type="number" class="form-control form-control-sm dark-input" @bind="d.MapY" />
                                                            </div>
                                                            <div class="col-12">
                                                                <span class="cyber-label" style="font-size: 0.7rem;">Описание (подсказка):</span>
                                                                <input type="text" class="form-control form-control-sm dark-input" placeholder="Главный контроллер домена..." @bind="d.Description" />
                                                            </div>
                                                            <!-- БЛОК ИНТЕГРАЦИИ VMWARE -->
                                                            <div class="col-12 mt-3" style="background: rgba(78, 195, 209, 0.05); padding: 10px 15px; border-radius: 6px; border: 1px solid rgba(78, 195, 209, 0.2);">
                                                                <div class="d-flex align-items-center mb-2">
                                                                    <RadzenIcon Icon="terminal" Style="color: var(--accent-cyan); font-size: 1.1rem; margin-right: 8px;" />
                                                                    <span class="cyber-label" style="margin: 0; font-size: 0.75rem;">Интеграция с гипервизором (Опционально)</span>
                                                                </div>
                                                                <div class="row g-2">
                                                                    <div class="col-4">
                                                                        <input type="text" class="form-control form-control-sm dark-input" placeholder="Имя ВМ в vCenter" @bind="d.VmName" />
                                                                    </div>
                                                                    <div class="col-4">
                                                                        <input type="text" class="form-control form-control-sm dark-input" placeholder="Логин (ОС/Домен)" @bind="d.DomainLogin" />
                                                                    </div>
                                                                    <div class="col-4">
                                                                        <input type="text" class="form-control form-control-sm dark-input" placeholder="Пароль" @bind="d.DomainPassword" />
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-12 mt-3" style="background: rgba(0,0,0,0.3); padding: 15px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                                    <span class="cyber-label" style="font-size: 0.75rem; margin:0;">Установленное ПО</span>
                                                                    <button type="button" class="btn-outline-light" style="padding: 4px 10px; font-size: 0.75rem;" @onclick="@(() => d.Applications.Add(new DeviceApplication()))">
                                                                        <RadzenIcon Icon="add" Style="font-size: 0.9rem; margin-top:-2px;" /> Добавить ПО
                                                                    </button>
                                                                </div>
                                                                @if (!d.Applications.Any())
                                                                {
                                                                    <div style="font-size: 0.8rem; color: var(--text-muted); font-style: italic;">Приложения не добавлены.</div>
                                                                }
                                                                @foreach (var app in d.Applications)
                                                                {
                                                                    <div class="d-flex gap-2 mb-2 align-items-center" @key="app">
                                                                        <input type="text" class="form-control form-control-sm dark-input" placeholder="Название (напр. Apache)" @bind="app.Name" />
                                                                        <input type="text" class="form-control form-control-sm dark-input" placeholder="Версия" @bind="app.Version" style="width: 80px;" />
                                                                        <button type="button" class="btn-delete-icon text-danger" style="padding: 4px 6px;" @onclick="() => d.Applications.Remove(app)"><RadzenIcon Icon="close" Style="font-size:0.9rem;" /></button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                                                <span class="cyber-label" style="margin:0; font-size: 1rem;">Линии связи</span>
                                                <button type="button" class="btn-outline-light" style="padding: 6px 12px; font-size: 0.8rem;" @onclick="AddConnection"><RadzenIcon Icon="add" Style="font-size: 0.9rem; margin-top:-2px;" /> Добавить кабель</button>
                                            </div>
                                            <div style="max-height: 200px; overflow-y: auto;">
                                                @foreach (var c in Item.Connections)
                                                {
                                                    <div class="p-2 mb-2 rounded" style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color);" @key="c">
                                                        <div class="row g-2 align-items-center">
                                                            <div class="col-4">
                                                                <select class="form-select form-select-sm dark-input text-light" style="font-size: 0.85rem;" value="@Item.Devices.IndexOf(c.FromDevice ?? Item.Devices.FirstOrDefault(dev => dev.Id == c.FromDeviceId && dev.Id != 0))" @onchange="@(e => SetConnectionFrom(c, e.Value))">
                                                                    <option value="-1" disabled>Откуда...</option>
                                                                    @for (int i = 0; i < Item.Devices.Count; i++)
                                                                    {
                                                                        <option value="@i">@Item.Devices[i].Name</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-1 text-center px-0"><RadzenIcon Icon="arrow_right_alt" Style="color: var(--accent-cyan);" /></div>
                                                            <div class="col-4">
                                                                <select class="form-select form-select-sm dark-input text-light" style="font-size: 0.85rem;" value="@Item.Devices.IndexOf(c.ToDevice ?? Item.Devices.FirstOrDefault(dev => dev.Id == c.ToDeviceId && dev.Id != 0))" @onchange="@(e => SetConnectionTo(c, e.Value))">
                                                                    <option value="-1" disabled>Куда...</option>
                                                                    @for (int i = 0; i < Item.Devices.Count; i++)
                                                                    {
                                                                        <option value="@i">@Item.Devices[i].Name</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-2 px-0">
                                                                <select class="form-select form-select-sm dark-input text-light" style="font-size: 0.85rem;" @bind="c.LinkType">
                                                                    <option value="Ethernet">LAN</option>
                                                                    <option value="VPN">VPN</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-1 text-end">
                                                                <button type="button" class="btn-delete-icon" style="padding: 4px 6px;" @onclick="() => Item.Connections.Remove(c)"><RadzenIcon Icon="close" Style="font-size: 0.9rem;" /></button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="col-md-7">
                                            <label class="cyber-label text-center mb-3" style="font-size: 1rem;">Виртуальный полигон (Предпросмотр)</label>
                                            <div class="canvas-container" @onclick="HandleCanvasClick">
                                                <svg style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; overflow: visible;">
                                                    @foreach (var conn in Item.Connections)
                                                    {
                                                        var fromNode = conn.FromDevice ?? Item.Devices.FirstOrDefault(d => d.Id == conn.FromDeviceId && d.Id != 0);
                                                        var toNode = conn.ToDevice ?? Item.Devices.FirstOrDefault(d => d.Id == conn.ToDeviceId && d.Id != 0);

                                                        if (fromNode != null && toNode != null)
                                                        {
                                                            string dashArray = conn.LinkType == "VPN" ? "6,6" : "0";
                                                            <line x1="@fromNode.MapX" y1="@fromNode.MapY" x2="@toNode.MapX" y2="@toNode.MapY" stroke="rgba(78, 195, 209, 0.6)" stroke-width="2" stroke-dasharray="@dashArray" />
                                                        }
                                                    }
                                                </svg>

                                                @foreach (var dev in Item.Devices)
                                                {
                                                    var currentDev = dev;
                                                    <div class="canvas-device @(selectedDevice == currentDev ? "selected-dev" : "")" style="left: @(currentDev.MapX)px; top: @(currentDev.MapY)px;" @onclick="() => selectedDevice = currentDev" @onclick:stopPropagation="true" @key="currentDev">
                                                        <RadzenIcon Icon="@(string.IsNullOrEmpty(currentDev.Type) ? "dns" : currentDev.Type)" />
                                                        <div class="device-caption">@(string.IsNullOrWhiteSpace(currentDev.Name) ? "Без имени" : currentDev.Name)</div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="text-center mt-3" style="font-size:0.85rem; color: var(--text-light); opacity: 0.8;">Выберите ПК слева, а затем кликните по сетке полигона, чтобы задать его позицию.</div>
                                        </div>
                                    </div>
                                </ChildContent>
                            </RadzenTabsItem>

                            <!-- ТАБ 6: ГОТОВО -->
                            <RadzenTabsItem>
                                <Template Context="tabContext6"><span style="color: var(--text-light);"><RadzenIcon Icon="verified" Style="vertical-align: middle; margin-right: 6px;" /> 6. Готово</span></Template>
                                <ChildContent>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="cyber-section">
                                                <h4 style="color: var(--accent-light-blue); margin-bottom: 25px; font-weight: 800; text-transform: uppercase;">Краткая сводка</h4>
                                                <ul class="list-unstyled" style="line-height: 2.2; font-size: 1.05rem;">
                                                    <li><strong style="color: var(--text-muted);">Название:</strong> <span style="color: var(--text-light);">@(string.IsNullOrEmpty(Item.Title) ? "Без названия" : Item.Title)</span></li>
                                                    <li><strong style="color: var(--text-muted);">Сетевых узлов:</strong> <span style="color: var(--accent-cyan); font-weight: bold;">@Item.Devices.Count шт.</span></li>
                                                    <li><strong style="color: var(--text-muted);">Линий связи:</strong> <span style="color: var(--accent-cyan); font-weight: bold;">@Item.Connections.Count шт.</span></li>
                                                    <li><strong style="color: var(--text-muted);">Заданий:</strong> <span style="color: var(--warning-color); font-weight: bold;">@Item.Questions.Count шт.</span></li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="cyber-section text-center" style="padding: 50px 20px;">
                                                <h4 style="color: var(--text-light); margin-bottom: 30px; font-weight: 700; text-transform: uppercase;">Публикация сценария</h4>
                                                <div class="d-flex justify-content-center gap-4 flex-wrap">
                                                    <button type="button" class="btn-outline-light" style="border-color: @(Item.IsVisible ? "var(--success-color)" : "var(--border-color)"); color: @(Item.IsVisible ? "var(--success-color)" : "var(--text-muted)");" @onclick="() => Item.IsVisible = true">
                                                        <RadzenIcon Icon="visibility" Style="margin-right: 5px;" /> ОТКРЫТЬ ДОСТУП ИГРОКАМ
                                                    </button>
                                                    <button type="button" class="btn-outline-light" style="border-color: @(!Item.IsVisible ? "var(--warning-color)" : "var(--border-color)"); color: @(!Item.IsVisible ? "var(--warning-color)" : "var(--text-muted)");" @onclick="() => Item.IsVisible = false">
                                                        <RadzenIcon Icon="visibility_off" Style="margin-right: 5px;" /> СОХРАНИТЬ В ЧЕРНОВИК
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </ChildContent>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                </div>
            </div>
        </RadzenTemplateForm>
    </div>
</div>