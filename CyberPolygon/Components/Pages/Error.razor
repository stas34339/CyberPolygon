@page "/error"
@inject NavigationManager NavigationManager

<div class="error-wrapper">
    <div class="cyber-error-card">
        <RadzenIcon Icon="report_problem" Style="font-size: 6rem; color: #ff4444; margin-bottom: 1rem; filter: drop-shadow(0 0 10px #ff4444);" />

        <h1 class="glitch-text">CRITICAL SYSTEM FAILURE</h1>
        <p class="error-msg">Произошла ошибка в работе модуля системы. Пожалуйста, выполните принудительную реинициализацию.</p>

        <div class="mt-4">
            <a href="/" class="cyber-btn cyber-btn-error">
                <RadzenIcon Icon="error"></RadzenIcon>
                ПЕРЕЗАГРУЗИТЬ СИСТЕМУ
            </a>
        </div>
    </div>
</div>

<style>
    .error-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        /* Фон убран, наследует фон страницы */
        font-family: 'Courier New', Courier, monospace;
    }

    .cyber-error-card {
        text-align: center;
        padding: 40px;
        /* Фон карточки сохранен */
        background: rgba(25, 25, 25, 0.95);
        border: 1px solid #ff4444;
        border-radius: 8px;
        box-shadow: 0 0 20px rgba(255, 68, 68, 0.2);
        max-width: 500px;
    }

    .glitch-text {
        font-size: 2.5rem;
        color: #ff4444;
        text-transform: uppercase;
        margin-bottom: 20px;
        letter-spacing: 2px;
    }

    .error-msg {
        color: #e1e1e1; /* Светлый текст для читаемости внутри карточки */
        font-size: 1.1rem;
    }
    /* Базовые стили для обоих типов ссылок */
    /* Базовые настройки кнопки */
    .cyber-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px; /* Расстояние между иконкой и текстом */
        padding: 12px 24px;
        font-family: 'Courier New', Courier, monospace;
        text-transform: uppercase;
        text-decoration: none !important; /* Убираем подчеркивание */
        font-weight: bold;
        border-radius: 4px;
        border: 1px solid;
        transition: all 0.3s ease;
        cursor: pointer;
        text-align:center;
    }

        /* Эффект наведения */
        .cyber-btn:hover {
            text-decoration: none !important;
            transform: translateY(-2px);
            box-shadow: 0 0 15px currentColor;
        }

    /* ВАРИАНТ: КРАСНЫЙ (Для Error) */
    .cyber-btn-error {
        border-color: #ff4444;
        color: #ff4444;
        background: rgba(255, 68, 68, 0.1);
    }

        .cyber-btn-error:hover {
            background: #ff4444;
            color: #fff;
        }
</style>