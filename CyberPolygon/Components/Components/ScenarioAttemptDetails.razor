@page "/admin/scenario-attempt/{ProgressId:int}"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@using static CyberPolygon.Data.ApplicationDbContext
@using System.Threading

@* Добавляем интерфейс IDisposable для безопасного уничтожения таймера *@
@implements IDisposable

@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Детали попытки сценария | Киберполигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --border-color: #2a3a4a;
        --text-light: #cbe0f5;
        --text-muted: #8fa0b5;
        --accent-cyan: #4ec3d1;
        --accent-blue: #5ba3e3;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px 20px;
        background: var(--bg-main);
        min-height: 100vh;
    }

    .card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 20px;
        position: relative;
    }

    h2 {
        color: var(--accent-cyan);
        margin-bottom: 20px;
    }

    /* СТИЛИ LIVE ИНДИКАТОРА */
    .live-indicator {
        position: absolute;
        top: 25px;
        right: 25px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: bold;
        font-size: 0.85rem;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.4);
        padding: 5px 12px;
        border-radius: 20px;
        background: rgba(224, 108, 117, 0.1);
    }

    .pulse-dot {
        width: 10px;
        height: 10px;
        background-color: var(--danger-color);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--danger-color);
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(224, 108, 117, 0.7);
        }

        70% {
            transform: scale(1);
            box-shadow: 0 0 0 6px rgba(224, 108, 117, 0);
        }

        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(224, 108, 117, 0);
        }
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .info-item label {
        color: var(--text-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        display: block;
    }

    .info-item span {
        color: var(--text-light);
        font-size: 1rem;
    }

    /* КОМАНДНЫЙ РАСЧЕТ И БЕЙДЖИ ОПЕРАТИВНИКОВ */
    .team-roster {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px dashed var(--border-color);
    }

    .roster-label {
        width: 100%;
        color: var(--text-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .member-badge {
        background: rgba(78, 195, 209, 0.1);
        border: 1px solid rgba(78, 195, 209, 0.3);
        color: var(--text-light);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .question-card {
        background: rgba(0,0,0,0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 15px;
    }

        .question-card.correct {
            border-color: var(--success-color);
            background: rgba(152,195,121,0.05);
        }

        .question-card.wrong {
            border-color: var(--danger-color);
            background: rgba(224,108,117,0.05);
        }

    .answer-box {
        background: #0d1117;
        border-radius: 6px;
        padding: 12px;
        margin-top: 10px;
        font-family: monospace;
    }

    /* БЕЙДЖ АВТОРА ОТВЕТА ВНУТРИ КАРТОЧКИ ВОПРОСА */
    .author-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(91, 163, 227, 0.1);
        border: 1px solid rgba(91, 163, 227, 0.4);
        color: var(--accent-blue);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .btn-back {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        margin-bottom: 20px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .badge-success {
        background: rgba(152,195,121,0.15);
        color: var(--success-color);
        border: 1px solid rgba(152,195,121,0.4);
    }

    .badge-danger {
        background: rgba(224,108,117,0.15);
        color: var(--danger-color);
        border: 1px solid rgba(224,108,117,0.4);
    }

    .badge-warning {
        background: rgba(229,192,123,0.15);
        color: var(--warning-color);
        border: 1px solid rgba(229,192,123,0.4);
    }
</style>

<div class="container">
    <button class="btn-back" @onclick="GoBack">
        <RadzenIcon Icon="arrow_back" /> Назад к управлению
    </button>

    @if (progress == null)
    {
        <div class="card text-center">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </div>
    }
    else
    {
        <div class="card">
            @if (progress.Status == AttemptStatus.InProgress)
            {
                <div class="live-indicator"><div class="pulse-dot"></div> LIVE МОНИТОРИНГ</div>
            }

            <h2>Попытка: @(scenario?.Title ?? "Сценарий")</h2>

            <div class="info-grid">
                <div class="info-item"><label>Пользователь / Команда</label><span style="color: var(--accent-cyan); font-weight:600;">@userName</span></div>
                <div class="info-item"><label>Тип</label><span>@(progress.IsTeamAttempt ? "Командный" : "Одиночный")</span></div>
                <div class="info-item"><label>Статус</label><span>@progress.Status</span></div>
                <div class="info-item"><label>Начало</label><span>@(progress.StartedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</span></div>
                <div class="info-item"><label>Завершение</label><span>@(progress.CompletedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</span></div>
                <div class="info-item"><label>XP</label><span style="color: var(--accent-cyan); font-weight: bold;">@progress.Score</span></div>
                @if (progress.TimeSpent.HasValue)
                {
                    <div class="info-item"><label>Затрачено времени</label><span>@($"{progress.TimeSpent.Value.Hours}ч {progress.TimeSpent.Value.Minutes}м {progress.TimeSpent.Value.Seconds}с")</span></div>
                }
            </div>

            @if (progress.IsTeamAttempt && teamMembers.Any())
            {
                <div class="team-roster">
                    <div class="roster-label">Состав боевого расчета:</div>
                    @foreach (var member in teamMembers)
                    {
                        <div class="member-badge">
                            <RadzenIcon Icon="person" style="font-size: 0.9rem; color: var(--accent-cyan);" />
                            @member.LastName @member.FirstName
                        </div>
                    }
                </div>
            }
        </div>

        <h3 style="color: var(--accent-cyan); margin-bottom: 15px;">Ответы на вопросы (@answers.Count(a => a.IsCorrect) из @questions.Count верно)</h3>

        @foreach (var q in questions)
        {
            var answer = answers.FirstOrDefault(a => a.QuestionId == q.Id);
            bool isCorrect = answer?.IsCorrect ?? false;
            <div class="question-card @(answer == null ? "" : isCorrect ? "correct" : "wrong")">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;">
                    <h4 style="color: var(--text-light); margin: 0; flex-grow: 1;">Вопрос: @q.Text</h4>

                    <div style="text-align: right; flex-shrink: 0; margin-left: 15px;">
                        @if (answer != null)
                        {
                            <span class="badge @(isCorrect ? "badge-success" : "badge-danger")" style="margin-bottom: 4px; display: block;">@(isCorrect ? "Верно" : "Неверно")</span>

                            @* ОТОБРАЖЕНИЕ АВТОРА ОТВЕТА *@
                            @if (answer.User != null)
                            {
                                <div class="author-badge">
                                    <RadzenIcon Icon="assignment_turned_in" style="font-size:0.85rem;" />
                                    Ответил: @answer.User.LastName @answer.User.FirstName[0].
                                </div>
                            }
                        }
                        else
                        {
                            <span class="badge badge-warning">Не отвечено</span>
                        }
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div>
                        <label style="color: var(--text-muted); font-size: 0.8rem;">Эталонный ответ:</label>
                        <div class="answer-box" style="color: var(--success-color);">@q.CorrectAnswer</div>
                    </div>
                    <div>
                        <label style="color: var(--text-muted); font-size: 0.8rem;">Ответ пользователя:</label>
                        <div class="answer-box" style="color: @(isCorrect ? "var(--success-color)" : "var(--danger-color)");">
                            @(answer?.LastSubmittedAnswer ?? "—")
                        </div>
                    </div>
                </div>
                @if (answer != null)
                {
                    <div style="margin-top: 8px; font-size: 0.85rem; color: var(--text-muted);">
                        Попыток: @answer.FailedAttempts |
                        Награда за вопрос: +@q.AwardPoints XP |
                        Штраф: -@q.PenaltyPoints XP |
                        Последнее обновление: @answer.UpdatedAt.ToString("dd.MM.yyyy HH:mm:ss")
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public int ProgressId { get; set; }

    private UserScenarioProgress? progress;
    private CyberScenario? scenario;
    private List<ScenarioQuestion> questions = new();
    private List<UserAnswerProgress> answers = new();
    private string userName = "—";

    private List<ApplicationUser> teamMembers = new();
    private Timer? _pollingTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadProgressDataAsync();

        // Запуск фонового таймера автоматического обновления каждые 3 секунды
        _pollingTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadProgressDataAsync();
                StateHasChanged(); // Перерисовываем интерфейс
            });
        }, null, 3000, 3000);
    }

    private async Task LoadProgressDataAsync()
    {
        using var context = await ContextFactory.CreateDbContextAsync();

        // Добавляем .Include(p => p.Team).ThenInclude(t => t.Users) для загрузки командного контекста
        progress = await context.UserProgresses
            .Include(p => p.Scenario)
            .Include(p => p.Team).ThenInclude(t => t.Users)
            .FirstOrDefaultAsync(p => p.Id == ProgressId);

        if (progress != null)
        {
            scenario = progress.Scenario;
            questions = await context.ScenarioQuestions.Where(q => q.CyberScenarioId == progress.CyberScenarioId).ToListAsync();

            // Загружаем ответы и включаем автора флага (.Include(a => a.User))
            answers = await context.Set<ApplicationDbContext.UserAnswerProgress>()
                .Include(a => a.User)
                .Where(a => a.UserScenarioProgressId == ProgressId)
                .ToListAsync();

            if (!string.IsNullOrEmpty(progress.UserId))
            {
                var user = await context.Users.FindAsync(progress.UserId);
                userName = (user != null) ? $"{user.LastName} {user.FirstName}".Trim() : progress.UserId;
                if (string.IsNullOrWhiteSpace(userName)) userName = user?.UserName ?? progress.UserId;
            }
            else if (progress.TeamId.HasValue && progress.Team != null)
            {
                userName = progress.Team.Name;
                teamMembers = progress.Team.Users.ToList();
            }

            // Выключаем таймер, если сессия уже завершена
            if (progress.Status == AttemptStatus.Completed || progress.Status == AttemptStatus.Failed)
            {
                _pollingTimer?.Change(Timeout.Infinite, 0);
            }
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/admin");
    }

    // Безопасно уничтожаем таймер при закрытии страницы браузером
    public void Dispose()
    {
        _pollingTimer?.Dispose();
    }
}