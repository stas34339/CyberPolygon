@using Microsoft.EntityFrameworkCore
@using CyberPolygon.Data

@inject ScenarioService ScenarioService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ApplicationDbContext DbContext

<head>
    <link rel="stylesheet" href="@Assets["_content/Radzen.Blazor/css/Standard-Dark.css"]" />
</head>

<RadzenTemplateForm TItem="CyberScenario" Data="@Item" Submit="@OnSave">
    <div class="row custom-editor-form" style="padding-right: 10px;">
        <div class="col-md-9 mb-3">
            <label class="cyber-label">Название</label>
            <RadzenTextBox @bind-Value="@Item.Title" class="w-100 dark-input" />
        </div>

        <div class="col-md-3 mb-3 d-flex flex-column justify-content-end">
            <label class="cyber-label">Доступен пользователям</label>
            <div class="d-flex align-items-center" style="height: 35px;">
                <RadzenSwitch @bind-Value="@Item.IsVisible" />
            </div>
        </div>

        <div class="col-12 mb-3">
            <label class="cyber-label">Краткое описание</label>
            <RadzenTextArea @bind-Value="@Item.Description" class="w-100 dark-input" Style="height:60px;" />
        </div>

        @* БЛОК УПРАВЛЕНИЯ ДОСТУПОМ *@
        <div class="col-md-4 mb-3">
            <label class="cyber-label">Уровень доступа</label>
            <RadzenDropDown @bind-Value="@Item.Scope" TValue="VisibilityScope"
                            Data="@(Enum.GetValues(typeof(VisibilityScope)))" class="w-100 dark-input">
                <Template Context="scope">
                    @if ((VisibilityScope)scope == VisibilityScope.Public)
                    {
                        <span style="color: #98c379;">Всем (Публично)</span>
                    }
                    else if ((VisibilityScope)scope == VisibilityScope.GroupOnly)
                    {
                        <span style="color: var(--accent-cyan);">Только группе</span>
                    }
                    else if ((VisibilityScope)scope == VisibilityScope.TeamOnly)
                    {
                        <span style="color: #e5c07b;">Только команде</span>
                    }
                </Template>
            </RadzenDropDown>
        </div>

        @if (Item.Scope == VisibilityScope.GroupOnly)
        {
            <div class="col-md-8 mb-3">
                <label class="cyber-label">Выберите учебную группу</label>
                <RadzenDropDown @bind-Value="@Item.TargetGroupId" TValue="int?" Data="@groups"
                                ValueProperty="Id" TextProperty="Name"
                                class="w-100 dark-input" Style="color: var(--rz-text-color-base-200)" Placeholder="Укажите группу из базы..." />
            </div>
        }
        else if (Item.Scope == VisibilityScope.TeamOnly)
        {
            <div class="col-md-8 mb-3">
                <label class="cyber-label">Выберите команду</label>
                <RadzenDropDown @bind-Value="@Item.TargetTeamId" TValue="int?" Data="@teams"
                                ValueProperty="Id" TextProperty="Name"
                                class="w-100 dark-input" Style="color: var(--rz-text-color-base-200)" Placeholder="Укажите команду из базы..." />
            </div>
        }
        else
        {
            <div class="col-md-8 mb-3 d-flex align-items-center">
                <span style="color: var(--text-muted); font-size: 0.85rem; margin-top: 20px;">
                    <RadzenIcon Icon="info" class="rz-mr-1" style="font-size: 1rem; vertical-align: middle;" />
                    Сценарий будет доступен в общем списке для всех курсантов.
                </span>
            </div>
        }

        <div class="col-md-4 mb-3">
            <label class="cyber-label">Режим выполнения теста</label>
            <RadzenDropDown @bind-Value="@Item.GameMode" TValue="ScenarioGameMode"
                            Data="@(Enum.GetValues(typeof(ScenarioGameMode)))" class="w-100 dark-input">
                <Template Context="mode">
                    @if ((ScenarioGameMode)mode == ScenarioGameMode.AllAtOnce)
                    {
                        <span style="color: var(--text-light);">Доступны все сразу</span>
                    }
                    else
                    {
                        <span style="color: var(--text-light);">Последовательно</span>
                    }
                </Template>
            </RadzenDropDown>
        </div>

        <div class="col-md-4 mb-3">
            <label class="cyber-label">Лимит времени (минуты)</label>
            <RadzenNumeric @bind-Value="@Item.DurationInMinutes" Min="0" Max="360" class="w-100 dark-input" Placeholder="0" />
            <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-top: 2px;">0 — без ограничений времени</span>
        </div>

        <div class="col-md-4 mb-3">
            <label class="cyber-label">Схема (загрузка файла)</label>
            <InputFile OnChange="HandleFileUpload" class="form-control bg-dark text-white border-secondary" style="height: 35px; padding: 4px 12px;" />
        </div>

        @* ПОЛЕ ЗАГРУЗКИ ДОКУМЕНТАЦИИ *@
        <div class="col-12 mb-3">
            <RadzenFieldset Text="Прикрепленные документы">
                @foreach (var doc in Item.Documents)
                {
                    <div class="row align-items-center rz-mb-2">
                        <div class="col-md-5">
                            <RadzenTextBox @bind-Value="doc.Title" Placeholder="Название (например, 'Инструкция')" class="w-100 dark-input" />
                        </div>
                        <div class="col-md-6">
                            @if (string.IsNullOrEmpty(doc.FilePath))
                            {
                                <InputFile OnChange="@(async e => await UploadDocumentAsync(e, doc))" class="form-control bg-dark text-white border-secondary" />
                            }
                            else
                            {
                                <RadzenText TextStyle="TextStyle.Caption" style="color: #98c379;">
                                    <RadzenIcon Icon="check_circle" class="rz-mr-1" /> Загружен: @doc.FilePath
                                </RadzenText>
                            }
                        </div>
                        <div class="col-md-1 text-right">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                          Click="@(() => Item.Documents.Remove(doc))" />
                        </div>
                    </div>
                }

                <RadzenButton Text="Добавить документ" Icon="add" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Flat" Size="ButtonSize.Small" class="rz-mt-3"
                              Click="@(() => Item.Documents.Add(new ScenarioDocument()))" />
            </RadzenFieldset>
        </div>

        <RadzenTabs class="w-100 mt-3 custom-tabs">
            <Tabs>
                <RadzenTabsItem Text="Легенда">
                    <RadzenHtmlEditor @bind-Value="@Item.Legend" style="height: 250px; background: var(--bg-card); color: var(--text-light);" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Задания и Вопросы">
                    <div class="questions-container p-2">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 style="color: var(--accent-cyan); margin:0;">Конструктор интерактивного теста</h5>
                            <RadzenButton Text="Добавить вопрос" Icon="add" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                                          Click="@AddQuestion" />
                        </div>

                        @if (!Item.Questions.Any())
                        {
                            <div class="text-center p-4 border border-danger border-dashed rounded"
                                 style="color: #e06c75; background: rgba(224, 108, 117, 0.05); border-color: var(--border-color) !important;">
                                <RadzenIcon Icon="warning" class="rz-mr-2" />
                                Внимание: Задания не добавлены. Сохранение сценария заблокировано.
                            </div>
                        }

                        @foreach (var q in Item.Questions)
                        {
                            var index = Item.Questions.IndexOf(q);
                            <div class="question-card mb-3 p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary">
                                    <span style="color: var(--accent-cyan); font-weight:bold;">Вопрос №@(index + 1)</span>
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined"
                                                  Click="@(() => RemoveQuestion(q))" />
                                </div>
                                <div class="row">
                                    <div class="col-12 mb-2">
                                        <label class="cyber-sub-label">Формулировка вопроса</label>
                                        <RadzenTextBox @bind-Value="@q.Text" Placeholder="Например: Какой порт использует SSH?" class="w-100 dark-input" />
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label class="cyber-sub-label" style="color: #98c379;">Эталонный ответ (Пример ответа)</label>
                                        <RadzenTextBox @bind-Value="@q.CorrectAnswer" Placeholder="Например: 22" class="w-100 dark-input success-border" />
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="cyber-sub-label" style="color: #e5c07b;">Награда (+ баллы)</label>
                                        <RadzenNumeric @bind-Value="@q.AwardPoints" Min="1" class="w-100 dark-input" />
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="cyber-sub-label" style="color: #e06c75;">Штраф (- баллы)</label>
                                        <RadzenNumeric @bind-Value="@q.PenaltyPoints" Min="0" class="w-100 dark-input" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </div>

    <div class="mt-4 text-right d-flex justify-content-end">
        <RadzenButton Text="Сохранить изменения" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Info" class="px-4" />
    </div>
</RadzenTemplateForm>

<style>
    .cyber-label {
        color: var(--accent-cyan) !important;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 5px;
        display: block;
    }

    .cyber-sub-label {
        color: var(--text-muted);
        font-size: 0.8rem;
        margin-bottom: 3px;
        display: block;
    }

    .dark-input, .dark-input input {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-light) !important;
    }

    .success-border {
        border: 1px solid #98c379 !important;
    }

    .question-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 6px;
    }

    .custom-tabs .rz-tabview-nav li:not(.rz-tabview-selected) a span {
        color: var(--text-muted) !important;
    }

    .custom-tabs .rz-tabview-nav li.rz-tabview-selected a span {
        color: var(--accent-cyan) !important;
    }

    .rz-button {
        transition: all 0.2s ease;
    }

        .rz-button:hover {
            filter: brightness(1.1);
            transform: scale(1.02);
        }

        .rz-button:active {
            transform: scale(0.98);
        }
</style>

@code {
    [Parameter] public CyberScenario Item { get; set; } = new();

    private bool isUploading = false;
    private IEnumerable<UserGroup> groups = new List<UserGroup>();
    private IEnumerable<UserTeam> teams = new List<UserTeam>();

    protected override async Task OnInitializedAsync()
    {
        Item.Questions ??= new List<ScenarioQuestion>();
        Item.Documents ??= new List<ScenarioDocument>();

        try
        {
            groups = await DbContext.UserGroups.AsNoTracking().ToListAsync();
            teams = await DbContext.UserTeams.AsNoTracking().ToListAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Ошибка БД",
                Detail = "Не удалось загрузить списки групп или команд."
            });
        }
    }

    void AddQuestion() => Item.Questions.Add(new ScenarioQuestion { AwardPoints = 10, PenaltyPoints = 5 });
    void RemoveQuestion(ScenarioQuestion q) => Item.Questions.Remove(q);

    async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        Item.SchemaPath = await ScenarioService.UploadSchemaAsync(e.File);
    }

    async Task OnSave()
    {
        if (Item.Scope == VisibilityScope.Public)
        {
            Item.TargetGroupId = null;
            Item.TargetTeamId = null;
        }
        else if (Item.Scope == VisibilityScope.GroupOnly)
        {
            Item.TargetTeamId = null;
            if (Item.TargetGroupId == null)
            {
                ShowError("Необходимо выбрать конкретную учебную группу.");
                return;
            }
        }
        else if (Item.Scope == VisibilityScope.TeamOnly)
        {
            Item.TargetGroupId = null;
            if (Item.TargetTeamId == null)
            {
                ShowError("Необходимо выбрать конкретную команду.");
                return;
            }
        }

        if (Item.Questions == null || !Item.Questions.Any())
        {
            ShowError("Сценарий должен содержать минимум одно задание. Перейдите на вкладку 'Задания и Вопросы'.");
            return;
        }

        await ScenarioService.SaveAsync(Item);
        DialogService.Close(true);
    }

    private void ShowError(string detail)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Warning,
            Summary = "Внимание",
            Detail = detail,
            Duration = 5000
        });
    }

    private async Task UploadDocumentAsync(InputFileChangeEventArgs e, ScenarioDocument doc)
    {
        doc.FilePath = await ScenarioService.UploadSchemaAsync(e.File);
        if (string.IsNullOrWhiteSpace(doc.Title))
        {
            doc.Title = e.File.Name;
        }
    }
}