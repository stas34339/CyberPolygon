@page "/admin/test-attempt/{ProgressId:int}"
@using CyberPolygon.Data
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@using System.Threading

@* Добавляем интерфейс IDisposable для безопасного уничтожения таймера *@
@implements IDisposable

@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Детали попытки теста | Киберполигон</PageTitle>

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #1a2332;
        --border-color: #2a3a4a;
        --text-light: #cbe0f5;
        --text-muted: #8fa0b5;
        --accent-cyan: #4ec3d1;
        --success-color: #98c379;
        --danger-color: #e06c75;
        --warning-color: #e5c07b;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px 20px;
        background: var(--bg-main);
        min-height: 100vh;
    }

    .card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 20px;
        position: relative;
    }

    h2 {
        color: var(--accent-cyan);
        margin-bottom: 20px;
    }

    /* СТИЛИ LIVE ИНДИКАТОРА */
    .live-indicator {
        position: absolute;
        top: 25px;
        right: 25px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: bold;
        font-size: 0.85rem;
        color: var(--danger-color);
        border: 1px solid rgba(224, 108, 117, 0.4);
        padding: 5px 12px;
        border-radius: 20px;
        background: rgba(224, 108, 117, 0.1);
    }

    .pulse-dot {
        width: 10px;
        height: 10px;
        background-color: var(--danger-color);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--danger-color);
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(224, 108, 117, 0.7);
        }

        70% {
            transform: scale(1);
            box-shadow: 0 0 0 6px rgba(224, 108, 117, 0);
        }

        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(224, 108, 117, 0);
        }
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .info-item label {
        color: var(--text-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        display: block;
    }

    .info-item span {
        color: var(--text-light);
        font-size: 1rem;
    }

    .question-card {
        background: rgba(0,0,0,0.2);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 15px;
    }

        .question-card.correct {
            border-color: var(--success-color);
            background: rgba(152,195,121,0.05);
        }

        .question-card.wrong {
            border-color: var(--danger-color);
            background: rgba(224,108,117,0.05);
        }

    .option-item {
        padding: 10px 15px;
        margin: 6px 0;
        border-radius: 6px;
        background: #0d1117;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .option-item.correct-option {
            background: rgba(152,195,121,0.2);
            border: 1px solid var(--success-color);
        }

        .option-item.selected-wrong {
            background: rgba(224,108,117,0.2);
            border: 1px solid var(--danger-color);
        }

    .btn-back {
        background: linear-gradient(135deg, #4ec3d1 0%, #5ba3e3 100%);
        color: #1a1d21;
        font-weight: bold;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        margin-bottom: 20px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .badge-success {
        background: rgba(152,195,121,0.15);
        color: var(--success-color);
        border: 1px solid rgba(152,195,121,0.4);
    }

    .badge-danger {
        background: rgba(224,108,117,0.15);
        color: var(--danger-color);
        border: 1px solid rgba(224,108,117,0.4);
    }

    .badge-warning {
        background: rgba(229,192,123,0.15);
        color: var(--warning-color);
        border: 1px solid rgba(229,192,123,0.4);
    }
</style>

<div class="container">
    <button class="btn-back" @onclick="GoBack">
        <RadzenIcon Icon="arrow_back" /> Назад к управлению
    </button>

    @if (progress == null)
    {
        <div class="card text-center">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </div>
    }
    else
    {
        <div class="card">
            @if (progress.Status == AttemptStatus.InProgress)
            {
                <div class="live-indicator"><div class="pulse-dot"></div> LIVE МОНИТОРИНГ</div>
            }

            <h2>Попытка: @(test?.Title ?? "Тест")</h2>

            <div class="card p-0" style="border:none; background:transparent; margin:0;">
                <div class="info-grid">
                    <div class="info-item"><label>Пользователь</label><span>@userName</span></div>
                    <div class="info-item"><label>Статус</label><span>@progress.Status</span></div>
                    <div class="info-item"><label>Начало</label><span>@(progress.StartedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</span></div>
                    <div class="info-item"><label>Завершение</label><span>@(progress.CompletedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</span></div>
                    <div class="info-item">
                        <label>Результат</label>
                        <span style="color: var(--accent-cyan); font-weight: bold;">
                            @progress.Score / @(test?.Questions?.Count ?? 0) (@percentage%)
                        </span>
                    </div>
                    <div class="info-item"><label>Сложность</label><span>@(test?.Difficulty.ToString() ?? "—")</span></div>
                </div>
            </div>
        </div>

        <h3 style="color: var(--accent-cyan); margin-bottom: 15px;">Вопросы и ответы (@userAnswers.Count(a => a.IsCorrect) из @questions.Count верно)</h3>

        @foreach (var q in questions)
        {
            var userAnswer = userAnswers.FirstOrDefault(a => a.QuestionId == q.Id);

            var selectedIds = GetSelectedOptionIds(userAnswer);
            var correctOptionIds = q.Options.Where(o => o.IsCorrect).Select(o => o.Id).ToList();
            bool isCorrect = userAnswer?.IsCorrect ?? false;

            <div class="question-card @(userAnswer == null ? "" : isCorrect ? "correct" : "wrong")">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;">
                    <h4 style="color: var(--text-light); margin: 0;">Вопрос @(questions.IndexOf(q) + 1): @q.Text</h4>
                    @if (userAnswer != null)
                    {
                        <span class="badge @(isCorrect ? "badge-success" : "badge-danger")">@(isCorrect ? "Верно" : "Неверно")</span>
                    }
                    else
                    {
                        <span class="badge badge-warning">Не отвечено</span>
                    }
                </div>

                @foreach (var opt in q.Options)
                {
                    string cssClass = "option-item";
                    string indicator = "";

                    if (correctOptionIds.Contains(opt.Id))
                    {
                        cssClass += " correct-option";
                        indicator = " ✓ (правильный ответ)";
                    }
                    if (selectedIds.Contains(opt.Id) && !correctOptionIds.Contains(opt.Id))
                    {
                        cssClass += " selected-wrong";
                        indicator = " ✗ (выбран ошибочно)";
                    }
                    else if (selectedIds.Contains(opt.Id) && correctOptionIds.Contains(opt.Id))
                    {
                        indicator = " ✓ (выбран верно)";
                    }

                    <div class="@cssClass">
                        <span style="color: var(--text-light);">@opt.Text</span>
                        <span style="color: @(correctOptionIds.Contains(opt.Id) ? "var(--success-color)" : selectedIds.Contains(opt.Id) ? "var(--danger-color)" : "var(--text-muted)"); font-size: 0.85rem;">@indicator</span>
                    </div>
                }

                @if (userAnswer != null)
                {
                    <div style="margin-top: 10px; font-size: 0.85rem; color: var(--text-muted);">
                        Ответ дан: @userAnswer.AnsweredAt.ToString("dd.MM.yyyy HH:mm:ss")
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public int ProgressId { get; set; }

    private UserTestProgress? progress;
    private CyberTest? test;
    private List<TestQuestion> questions = new();
    private List<UserTestAnswer> userAnswers = new();
    private string userName = "—";
    private int percentage = 0;

    private Timer? _pollingTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadTestDataAsync();

        // Запуск фонового таймера автоматического обновления каждые 3 секунды
        _pollingTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadTestDataAsync();
                StateHasChanged(); // Перерисовываем интерфейс с новыми данными
            });
        }, null, 3000, 3000);
    }

    private async Task LoadTestDataAsync()
    {
        using var context = await ContextFactory.CreateDbContextAsync();

        progress = await context.Set<UserTestProgress>()
                    .Include(p => p.Test)
                    .ThenInclude(t => t.Questions)
                    .ThenInclude(q => q.Options)
                    .FirstOrDefaultAsync(p => p.Id == ProgressId);

        if (progress != null)
        {
            test = progress.Test;
            questions = test?.Questions ?? new();

            userAnswers = await context.Set<UserTestAnswer>()
                            .Where(a => a.UserTestProgressId == ProgressId)
                            .ToListAsync();

            percentage = questions.Count > 0 ? (int)Math.Round((double)progress.Score / questions.Count * 100) : 0;

            if (!string.IsNullOrEmpty(progress.UserId))
            {
                var user = await context.Users.FindAsync(progress.UserId);
                userName = (user != null) ? $"{user.LastName} {user.FirstName}".Trim() : progress.UserId;
                if (string.IsNullOrWhiteSpace(userName)) userName = user?.UserName ?? progress.UserId;
            }

            // Останавливаем таймер, если тест завершен курсантом или время вышло
            if (progress.Status == AttemptStatus.Completed || progress.Status == AttemptStatus.Failed)
            {
                _pollingTimer?.Change(Timeout.Infinite, 0);
            }
        }
    }

    // Безопасное извлечение ID выбранных вариантов ответа через рефлексию
    private List<int> GetSelectedOptionIds(UserTestAnswer? answer)
    {
        if (answer == null) return new List<int>();
        var type = answer.GetType();

        var selectedIdsProp = type.GetProperty("SelectedOptionIds");
        if (selectedIdsProp != null)
        {
            var value = selectedIdsProp.GetValue(answer)?.ToString();
            if (!string.IsNullOrEmpty(value))
            {
                return value.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(id => int.TryParse(id.Trim(), out int parsed) ? parsed : -1)
                    .Where(id => id > 0)
                    .ToList();
            }
        }

        var singleIdProp = type.GetProperty("SelectedOptionId");
        if (singleIdProp != null)
        {
            var value = singleIdProp.GetValue(answer);
            if (value != null && value is int intValue && intValue > 0)
            {
                return new List<int> { intValue };
            }
        }

        var optionIdProp = type.GetProperty("OptionId");
        if (optionIdProp != null)
        {
            var value = optionIdProp.GetValue(answer);
            if (value != null && value is int intValue && intValue > 0)
            {
                return new List<int> { intValue };
            }
        }

        return new List<int>();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/admin");
    }

    // Уничтожаем таймер при закрытии страницы или уходе администратора с вкладки
    public void Dispose()
    {
        _pollingTimer?.Dispose();
    }
}