<div class="scenario-details-wrapper">
    @* --- ДОБАВЛЯЕМ ЗАГОЛОВОК СЮДА, С CSS ЗАЩИТОЙ --- *@
    <div class="details-header-wrapper">
        <h2 class="details-main-title">@Item.Title</h2>
    </div>
    @* ---------------------------------------------- *@

    <RadzenTabs RenderMode="TabRenderMode.Client" class="custom-tabs">
        <Tabs>
            <RadzenTabsItem Text="Легенда" Icon="history_edu">
                <div class="details-content-box">
                    <h4 class="details-subtitle">Оперативная сводка (Легенда)</h4>
                    <div class="rich-text-area">
                        @((MarkupString)Item.Legend)
                    </div>
                </div>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Схема" Icon="hub">
                <div class="details-content-box text-center">
                    <h4 class="details-subtitle">Архитектура сети</h4>
                    @if (!string.IsNullOrEmpty(Item.SchemaPath))
                    {
                        <div class="schema-container">
                            <img src="@Item.SchemaPath" alt="Схема сети" class="img-fluid rounded shadow-lg" style="border: 1px solid #00eeff; max-height: 450px;" />
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary mt-3">Схема для данного сценария не загружена.</div>
                    }
                </div>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Задание" Icon="terminal">
                <div class="details-content-box">
                    <h4 class="details-subtitle" style="color: #00eeff;">Поставленная задача:</h4>
                    <div class="rich-text-area">
                        @((MarkupString)Item.Task)
                    </div>
                    <div class="mt-4 pt-3 border-top border-secondary">
                        <RadzenButton Text="Начать выполнение" Icon="play_arrow" ButtonStyle="ButtonStyle.Info" class="w-100" />
                    </div>
                </div>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</div>

<style>
    /* --- НОВЫЕ СТИЛИ ДЛЯ ЗАЩИТЫ ЗАГОЛОВКА В КАРТОЧКЕ --- */
    .details-header-wrapper {
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(0, 238, 255, 0.2); /* Тонкая cyan полоса под заголовком */
    }

    .details-main-title {
        font-size: 2.2rem;
        font-weight: bold;
        color: #00eeff; /* Cyber Cyan */
        margin: 0;
        /* МАГИЯ ХАРДКОРНОГО РАЗРЫВА 11111... ДЛЯ КАРТОЧКИ */
        display: block;
        width: 100%;
        max-width: 100%;
        word-break: break-all; /* Самое важное свойство! */
        overflow-wrap: break-word; /* Fallback */
        /* Не добавляем line-clamp, пусть заголовок занимает столько строк, сколько нужно в карточке */
    }
    /* -------------------------------------------------- */

    .details-content-box {
        padding: 20px;
        min-height: 400px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 8px;
    }

    .details-subtitle {
        color: #e1e4e8;
        font-weight: bold;
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .rich-text-area {
        color: #b0b8c1;
        line-height: 1.6;
        /* Рекомендую добавить и сюда, на случай если в богатом тексте будет 1111... */
        word-break: break-all;
        overflow-wrap: break-word;
    }

    .schema-container {
        padding: 10px;
        background: #000;
        display: inline-block;
        border-radius: 4px;
    }
</style>

@code {
    // Этот параметр принимает данные о сценарии из главной страницы
    [Parameter] public CyberScenario Item { get; set; } = new();
}