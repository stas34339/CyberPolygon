@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject ScenarioService ScenarioService
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService

<style>
    :root {
        --bg-main: #1e1e1e;
        --bg-card: #24272c;
        --text-muted: #8fa0b5;
        --text-light: #cbe0f5;
        --accent-cyan: #4ec3d1;
        --border-color: #343a42;
    }

    /* ПЕРЕКРАШИВАЕМ ФОН ДИАЛОГОВОГО ОКНА RADZEN */
    .rz-dialog-wrapper .rz-dialog,
    .rz-dialog-content {
        background-color: var(--bg-main) !important;
        color: var(--text-muted) !important;
    }

    .rz-dialog-titlebar {
        background-color: var(--bg-card) !important;
        color: var(--text-light) !important;
        border-bottom: 1px solid var(--border-color) !important;
    }

    .scenario-details-wrapper {
        background-color: var(--bg-main);
        color: var(--text-muted);
        padding: 10px;
    }

    .details-header-wrapper {
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border-color);
    }

    .details-main-title {
        font-size: 2.2rem;
        font-weight: bold;
        color: var(--text-light);
        word-break: break-all;
    }

    .details-subtitle {
        color: var(--accent-cyan);
    }

    .details-content-box {
        padding: 20px;
        min-height: 400px;
        background: var(--bg-card);
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .rich-text-area {
        color: var(--text-light) !important;
    }

    /* Настройка табов */
    .custom-tabs .rz-tabview-nav {
        background: transparent !important;
        border-bottom: 1px solid var(--border-color);
    }

        .custom-tabs .rz-tabview-nav li:not(.rz-tabview-selected) a span {
            color: var(--text-muted) !important;
        }

        .custom-tabs .rz-tabview-nav li.rz-tabview-selected a span {
            color: var(--accent-cyan) !important;
        }

    /* Таблица админа внутри деталей */
    .rz-datagrid {
        background-color: transparent !important;
        border: none !important;
    }

    .rz-grid-table thead th {
        background-color: rgba(0,0,0,0.2) !important;
        color: var(--accent-cyan) !important;
        border-bottom: 1px solid var(--border-color) !important;
    }

    .rz-grid-table tbody tr {
        background-color: transparent !important;
    }

    .rz-grid-table td {
        border-bottom: 1px solid var(--border-color) !important;
        color: var(--text-muted) !important;
    }

    .rz-pager {
        background-color: transparent !important;
        border-top: 1px solid var(--border-color) !important;
        color: var(--text-muted) !important;
    }
</style>

<div class="scenario-details-wrapper">
    <div class="details-header-wrapper d-flex justify-content-between align-items-center">
        <h2 class="details-main-title">@Item.Title</h2>
    </div>

    <RadzenTabs RenderMode="TabRenderMode.Client" class="custom-tabs">
        <Tabs>
            @if (!string.IsNullOrWhiteSpace(Item.Legend))
            {
                <RadzenTabsItem Text="Легенда" Icon="history_edu">
                    <div class="details-content-box">
                        <h4 class="details-subtitle">Оперативная сводка (Легенда)</h4>
                        <div class="rich-text-area">
                            @((MarkupString)Item.Legend)
                        </div>
                    </div>
                </RadzenTabsItem>
            }

            @if (!string.IsNullOrEmpty(Item.SchemaPath))
            {
                <RadzenTabsItem Text="Схема" Icon="hub">
                    <div class="details-content-box text-center">
                        <h4 class="details-subtitle">Архитектура сети</h4>
                        <div class="schema-container">
                            <img src="@Item.SchemaPath" alt="Схема сети" class="img-fluid rounded shadow-lg"
                                 style="border: 1px solid var(--accent-cyan); max-height: 400px;" />
                        </div>
                    </div>
                </RadzenTabsItem>
            }

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <RadzenTabsItem Text="Управление (Админ)" Icon="admin_panel_settings">
                        <div class="details-content-box" style="border: 1px solid var(--border-color);">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h4 class="details-subtitle mb-0" style="color: #e06c75;">Статистика прохождений</h4>
                                <RadzenButton Text="Сбросить ВСЕ" Icon="delete_forever" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@ResetProgress" />
                            </div>

                            @if (completedUsers == null || !completedUsers.Any())
                            {
                                <div style="color: var(--text-muted);">Пока никто не прошёл этот сценарий.</div>
                            }
                            else
                            {
                                <RadzenDataGrid Data="@completedUsers" TItem="UserScenarioProgressDto" AllowPaging="true" PageSize="5">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="UserScenarioProgressDto" Title="Пользователь">
                                            <Template Context="data">
                                                <div class="d-flex flex-column">
                                                    <span style="color: var(--text-light); font-weight: 500;">@data.UserName</span>
                                                    <span style="color: var(--text-muted); font-size: 0.8rem;">@data.Email</span>
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="UserScenarioProgressDto" Property="Score" Title="Баллы" Width="100px" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                <b style="color: var(--accent-cyan);">@data.Score XP</b>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="UserScenarioProgressDto" Title="Статус" Width="120px" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @if (data.Status == AttemptStatus.Completed)
                                                {
                                                    <span style="color: #98c379;">Завершён</span>
                                                }
                                                else if (data.Status == AttemptStatus.InProgress)
                                                {
                                                    <span style="color: var(--accent-cyan);">В процессе</span>
                                                }
                                                else if (data.Status == AttemptStatus.Failed)
                                                {
                                                    <span style="color: #e06c75;">Провален</span>
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="UserScenarioProgressDto" Title="Действия" Width="100px" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                <RadzenButton Icon="restart_alt" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.ExtraSmall"
                                                              Click="@(async () => await ResetSingleUser(data.UserId))" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </div>
                    </RadzenTabsItem>
                </Authorized>
            </AuthorizeView>
        </Tabs>
    </RadzenTabs>
</div>

@code {
    [Parameter] public CyberScenario Item { get; set; } = new();
    private List<UserScenarioProgressDto> completedUsers = new();
    private bool isAdmin = false;
    public class UserQuestionState
    {
        public ScenarioQuestion Question { get; set; } = new();
        public string UserAnswer { get; set; } = string.Empty;
        public bool IsCorrect { get; set; } = false;
        public string FeedbackMessage { get; set; } = string.Empty;
    }

    private List<UserQuestionState> questionStates = new();
    private int totalScore = 0;

    private string currentUserId = string.Empty;
    private bool isAlreadyCompleted = false;
    private int savedScore = 0;
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            isAdmin = user.IsInRole("Admin");

            if (isAdmin)
            {
                await LoadAdminData();
            }

            var progress = await ScenarioService.GetUserProgressAsync(currentUserId, Item.Id);
            if (progress != null && progress.Status == AttemptStatus.Completed)
            {
                isAlreadyCompleted = true;
                savedScore = progress.Score;
                totalScore = savedScore;
                return;
            }
        }

        if (Item?.Questions != null)
        {
            questionStates = Item.Questions.Select(q => new UserQuestionState { Question = q }).ToList();
        }
    }

    private async Task CheckAnswer(UserQuestionState state)
    {
        if (string.IsNullOrWhiteSpace(state.UserAnswer)) return;
        bool isRight = string.Equals(state.UserAnswer.Trim(), state.Question.CorrectAnswer.Trim(), StringComparison.OrdinalIgnoreCase);

        if (isRight)
        {
            state.IsCorrect = true;
            state.FeedbackMessage = $"✓ Успешно! Вы получили +{state.Question.AwardPoints} XP.";
            totalScore += state.Question.AwardPoints;
        }
        else
        {
            state.FeedbackMessage = $"❌ Допущена ошибка. Штраф: -{state.Question.PenaltyPoints} XP. Попробуйте еще раз.";
            totalScore -= state.Question.PenaltyPoints;
        }

        if (questionStates.All(q => q.IsCorrect) && !string.IsNullOrEmpty(currentUserId))
        {
            await ScenarioService.CompleteUserProgressAsync(currentUserId, Item.Id, totalScore);
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e, UserQuestionState state)
    {
        if (e.Key == "Enter")
        {
            await CheckAnswer(state);
        }
    }

    private async Task ResetProgress()
    {
        await ScenarioService.ResetAllProgressForScenarioAsync(Item.Id);
        isAlreadyCompleted = false;
        totalScore = 0;
        foreach (var q in questionStates)
        {
            q.IsCorrect = false;
            q.UserAnswer = string.Empty;
            q.FeedbackMessage = string.Empty;
        }

        if (isAdmin)
        {
            await LoadAdminData();
        }

        NotificationService.Notify(NotificationSeverity.Success, "Система", "Прогресс всех пользователей обнулён.");
    }

    private async Task LoadAdminData()
    {
        completedUsers = await ScenarioService.GetAllProgressForScenarioAsync(Item.Id);
    }

    private async Task ResetSingleUser(string targetUserId)
    {
        await ScenarioService.ResetUserProgressAsync(targetUserId, Item.Id);
        await LoadAdminData();

        if (targetUserId == currentUserId)
        {
            isAlreadyCompleted = false;
            totalScore = 0;
            foreach (var q in questionStates)
            {
                q.IsCorrect = false;
                q.UserAnswer = string.Empty;
                q.FeedbackMessage = string.Empty;
            }
        }

        NotificationService.Notify(NotificationSeverity.Info, "Система", "Прогресс пользователя обнулён.");
    }
}