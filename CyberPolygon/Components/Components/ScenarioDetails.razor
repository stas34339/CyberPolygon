@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject ScenarioService ScenarioService
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env

<div class="scenario-details-wrapper">
    <div class="details-header-wrapper d-flex justify-content-between align-items-center">
        <h2 class="details-main-title">@Item.Title</h2>
    </div>

    <RadzenTabs RenderMode="TabRenderMode.Client" class="custom-tabs">
        <Tabs>
            @if (!string.IsNullOrWhiteSpace(Item.Legend))
            {
                <RadzenTabsItem Text="Легенда" Icon="history_edu">
                    <div class="details-content-box">
                        <h4 class="details-subtitle">Оперативная сводка (Легенда)</h4>
                        <div class="rich-text-area">
                            @((MarkupString)Item.Legend)
                        </div>
                    </div>
                </RadzenTabsItem>
            }

            @if (!string.IsNullOrEmpty(Item.SchemaPath))
            {
                <RadzenTabsItem Text="Схема" Icon="hub">
                    <div class="details-content-box text-center" style="height: 500px; display: flex; flex-direction: column;">
                        <h4 class="details-subtitle mb-3">Архитектура сети</h4>
                        <div class="schema-container" style="flex-grow: 1; height: 420px; border: 1px dashed var(--accent-cyan); background: #0d1117; overflow: hidden; padding: 0;">
                            @if (isXmlSchema)
                            {
                                @* Фрейм для превью *@
                                <iframe id="drawio-details-iframe" style="width: 100%; height: 100%; border: none; background: #0d1117;"></iframe>
                            }
                            else
                            {
                                <div style="overflow: auto; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                                    <img src="@Item.SchemaPath" alt="Схема сети" class="img-fluid rounded shadow-lg" style="border: 1px solid var(--accent-cyan); max-height: 380px;" />
                                </div>
                            }
                        </div>
                    </div>
                </RadzenTabsItem>
            }

        </Tabs>
    </RadzenTabs>
</div>

@code {
    [Parameter] public CyberScenario Item { get; set; } = new();

    // Базовые переменные из твоего старого кода
    private List<UserScenarioProgressDto> completedUsers = new();
    private bool isAdmin = false;
    private string currentUserId = string.Empty;
    private bool isAlreadyCompleted = false;
    private int savedScore = 0;
    private int totalScore = 0;

    // --- ПЕРЕМЕННЫЕ ДЛЯ ИНТЕРАКТИВНОЙ СХЕМЫ ---
    private bool isXmlSchema = false;
    private string schemaXmlContent = string.Empty;
    private bool isViewerLoaded = false;

    public class UserQuestionState
    {
        public ScenarioQuestion Question { get; set; } = new();
        public string UserAnswer { get; set; } = string.Empty;
        public bool IsCorrect { get; set; } = false;
        public string FeedbackMessage { get; set; } = string.Empty;
    }

    private List<UserQuestionState> questionStates = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            isAdmin = user.IsInRole("Admin");

            if (isAdmin)
            {
                await LoadAdminData();
            }

            var progress = await ScenarioService.GetUserProgressAsync(currentUserId, Item.Id);
            if (progress != null && progress.Status == AttemptStatus.Completed)
            {
                isAlreadyCompleted = true;
                savedScore = progress.Score;
                totalScore = savedScore;
            }
        }

        if (Item?.Questions != null && questionStates.Count == 0)
        {
            questionStates = Item.Questions.Select(q => new UserQuestionState { Question = q }).ToList();
        }

        // Чтение файла схемы (с учетом .xml, .drawio и .drawioa)
        if (!string.IsNullOrEmpty(Item.SchemaPath) &&
           (Item.SchemaPath.EndsWith(".xml", StringComparison.OrdinalIgnoreCase) ||
            Item.SchemaPath.EndsWith(".drawio", StringComparison.OrdinalIgnoreCase) ||
            Item.SchemaPath.EndsWith(".drawioa", StringComparison.OrdinalIgnoreCase)))
        {
            isXmlSchema = true;
            try
            {
                var filePath = Path.Combine(Env.WebRootPath, Item.SchemaPath.TrimStart('/'));
                if (System.IO.File.Exists(filePath))
                {
                    schemaXmlContent = await System.IO.File.ReadAllTextAsync(filePath);
                }
            }
            catch { /* Игнорируем ошибку */ }
        }
    }

    // Отрисовка схемы через iframe
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isXmlSchema && !string.IsNullOrEmpty(schemaXmlContent) && !isViewerLoaded)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("setupDrawIoViewer", "drawio-details-iframe", schemaXmlContent);
                isViewerLoaded = true;
            }
            catch { }
        }
    }

    private async Task CheckAnswer(UserQuestionState state)
    {
        if (string.IsNullOrWhiteSpace(state.UserAnswer)) return;
        bool isRight = string.Equals(state.UserAnswer.Trim(), state.Question.CorrectAnswer.Trim(), StringComparison.OrdinalIgnoreCase);

        if (isRight)
        {
            state.IsCorrect = true;
            state.FeedbackMessage = $"✓ Успешно! Вы получили +{state.Question.AwardPoints} XP.";
            totalScore += state.Question.AwardPoints;
        }
        else
        {
            state.FeedbackMessage = $"❌ Допущена ошибка. Штраф: -{state.Question.PenaltyPoints} XP. Попробуйте еще раз.";
            totalScore -= state.Question.PenaltyPoints;
        }

        if (questionStates.All(q => q.IsCorrect) && !string.IsNullOrEmpty(currentUserId))
        {
            await ScenarioService.CompleteUserProgressAsync(currentUserId, Item.Id, totalScore);
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e, UserQuestionState state)
    {
        if (e.Key == "Enter")
        {
            await CheckAnswer(state);
        }
    }

    private async Task ResetProgress()
    {
        await ScenarioService.ResetAllProgressForScenarioAsync(Item.Id);
        isAlreadyCompleted = false;
        totalScore = 0;
        foreach (var q in questionStates)
        {
            q.IsCorrect = false;
            q.UserAnswer = string.Empty;
            q.FeedbackMessage = string.Empty;
        }

        if (isAdmin)
        {
            await LoadAdminData();
        }

        NotificationService.Notify(NotificationSeverity.Success, "Система", "Прогресс всех пользователей обнулён.");
    }

    private async Task LoadAdminData()
    {
        completedUsers = await ScenarioService.GetAllProgressForScenarioAsync(Item.Id);
    }

    private async Task ResetSingleUser(string targetUserId)
    {
        await ScenarioService.ResetUserProgressAsync(targetUserId, Item.Id);
        await LoadAdminData();

        if (targetUserId == currentUserId)
        {
            isAlreadyCompleted = false;
            totalScore = 0;
            foreach (var q in questionStates)
            {
                q.IsCorrect = false;
                q.UserAnswer = string.Empty;
                q.FeedbackMessage = string.Empty;
            }
        }

        NotificationService.Notify(NotificationSeverity.Info, "Система", "Прогресс пользователя обнулён.");
    }
}