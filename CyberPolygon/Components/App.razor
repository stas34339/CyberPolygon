    <script src="java/console-interop.js"></script>
    <script>
        window.setupDrawIoViewer = function (iframeId, xmlContent) {
        var iframe = document.getElementById(iframeId);
        if (!iframe) return;

        // Создаем безопасный слушатель ответов от Draw.io
        var handleMessage = function (e) {
        if (e.source === iframe.contentWindow) {
        try {
        var data = JSON.parse(e.data);
        // Когда iframe загрузился и готов ("init"), передаем ему наш XML код
        if (data.event === 'init') {
        iframe.contentWindow.postMessage(JSON.stringify({
        action: 'load',
        xml: xmlContent
        }), '*');

        // Удаляем слушатель, чтобы не вешать память браузера
        window.removeEventListener('message', handleMessage);
        }
        } catch (err) {
        // Игнорируем не-JSON сообщения
        }
        }
        };

        window.addEventListener('message', handleMessage);

        // Загружаем официальный темный плеер Draw.io со спиннером загрузки
        iframe.src = "https://viewer.diagrams.net/?embed=1&ui=dark&spin=1&proto=json&nav=1";
        };
    </script>
    <script>
            window.downloadFileFromBlob = function(fileName, htmlContent) {
                // \ufeff - это BOM (Byte Order Mark), он жизненно необходим, чтобы Word правильно прочитал кириллицу (русские буквы)
                var blob = new Blob(['\ufeff', htmlContent], { type: 'application/msword;charset=utf-8' });
                var url = URL.createObjectURL(blob);
                var anchorElement = document.createElement('a');
                anchorElement.href = url;
                anchorElement.download = fileName;
                document.body.appendChild(anchorElement);
                anchorElement.click();
                document.body.removeChild(anchorElement);
                URL.revokeObjectURL(url);
            };
    </script>
</body>

</html>
